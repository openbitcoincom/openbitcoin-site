var fx=el("is-fx"),fctx=fx.getContext("2d"),coins=[],fxRaf=null;
function burst(nCoins){
  if(reduce)return;
  var w=fx.parentNode.clientWidth,h=fx.parentNode.clientHeight,dpr=window.devicePixelRatio||1;
  fx.width=w*dpr;fx.height=h*dpr;fctx.setTransform(dpr,0,0,dpr,0,0);
  for(var i=0;i<nCoins;i++)coins.push({
    x:w/2+(Math.random()-.5)*w*.5,y:h/2,
    vx:(Math.random()-.5)*260,vy:-(140+Math.random()*260),
    r:4+Math.random()*5,a:Math.random()*6.3,va:(Math.random()-.5)*10,life:1});
  if(!fxRaf){var last=performance.now();
    (function step(t){
      var dt=Math.min(0.05,(t-last)/1000);last=t;
      var W=fx.width/(window.devicePixelRatio||1),H=fx.height/(window.devicePixelRatio||1);
      fctx.clearRect(0,0,W,H);
      for(var k=coins.length-1;k>=0;k--){
        var cn=coins[k];
        cn.vy+=760*dt;cn.x+=cn.vx*dt;cn.y+=cn.vy*dt;cn.a+=cn.va*dt;cn.life-=dt*0.7;
        if(cn.life<=0||cn.y>H+20){coins.splice(k,1);continue;}
        fctx.save();fctx.translate(cn.x,cn.y);fctx.rotate(cn.a);fctx.globalAlpha=Math.min(1,cn.life*2);
        fctx.scale(1,0.55+0.45*Math.abs(Math.sin(cn.a*2)));
        fctx.beginPath();fctx.arc(0,0,cn.r,0,6.3);fctx.fillStyle="#F7931A";fctx.fill();
        fctx.lineWidth=1.4;fctx.strokeStyle="#B96A00";fctx.stroke();
        fctx.restore();
      }
      if(coins.length)fxRaf=requestAnimationFrame(step);
      else{fxRaf=null;fctx.clearRect(0,0,W,H);}
    })(last);
  }
}

