  .is-rowhead{display:flex;align-items:baseline;gap:10px;min-width:0}
  .is-rn{flex:none;font:700 8.5px var(--mono);letter-spacing:.18em;color:#A98F65}
  .is-klab{flex:none;font:600 7.5px var(--mono);letter-spacing:.14em;color:#A98F65;text-transform:uppercase}
  .is-klab2{display:block;margin-top:5px}
  .is-key{display:block;margin-top:3px;font:600 9px/1.5 var(--mono);letter-spacing:.05em;
    word-break:break-all;color:#6B5A3E;min-height:14px}
  .is-key span.is-spinch{color:#C98A2E}
  .is-key span.is-setch{color:#A98F65}
  .is-addr{min-width:0;margin-top:3px}
  .is-addr b{display:block;font:700 13.5px var(--mono);color:#F0E9DE;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-height:18px}
  .is-addr b em{font-style:normal;color:#F7931A}
  .is-addr b u{text-decoration:none;color:#FFD9A0;text-shadow:0 0 9px rgba(255,166,60,.65)}
  .is-matchrow{display:flex;align-items:center;justify-content:flex-end;gap:6px;margin-top:5px;min-height:20px}
  .is-mchip{font:700 9px var(--mono);letter-spacing:.12em;color:#97815A;
    border:1px dashed #4A3B24;border-radius:6px;padding:3px 8px}
  .is-mchip.is-mwarm{color:#FFB84D;border-color:rgba(247,147,26,.6);border-style:solid}
  .is-row.is-won{box-shadow:inset 0 0 0 1px rgba(247,147,26,.8),inset 0 0 26px rgba(247,147,26,.25)}
  .is-stamp{position:absolute;right:10px;top:8px;pointer-events:none;
    font:700 10px var(--mono);letter-spacing:.2em;color:#A98F65;
    border:1.5px solid #6B5A3E;border-radius:5px;padding:3px 8px;transform:rotate(-4deg);
    opacity:0;transition:opacity .18s ease}
  .is-stamp.is-show{opacity:1;animation:is-stampin .28s cubic-bezier(.2,1.6,.4,1)}
  @keyframes is-stampin{from{transform:rotate(-4deg) scale(1.7);opacity:0}to{transform:rotate(-4deg) scale(1);opacity:1}}
  .is-stamp.is-tr{color:#FFB84D;border-color:rgba(247,147,26,.7)}
  .is-fx{position:absolute;inset:0;pointer-events:none}

  
  .is-console{display:flex;align-items:stretch;gap:10px;margin-top:10px}
  .is-console2{margin-top:8px}
  .is-led{flex:1;min-width:0;background:#0A0705;border:1px solid #35291A;border-radius:9px;
    padding:7px 10px 8px;box-shadow:inset 0 2px 8px rgba(0,0,0,.7)}
  .is-led i{display:block;font:700 8px var(--mono);letter-spacing:.16em;text-transform:uppercase;color:#A98F65;font-style:normal;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .is-led b{display:block;font:700 clamp(15px,3.6vw,19px) var(--mono);color:#FFD9A0;margin-top:3px;
    font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
    text-shadow:0 0 9px rgba(255,166,60,.35)}
  .is-draws{flex:0 0 auto;display:flex;align-items:center;gap:6px;background:#0A0705;
    border:1px solid #35291A;border-radius:9px;padding:5px 10px;box-shadow:inset 0 2px 8px rgba(0,0,0,.7)}
  .is-dlab{font:700 8px var(--mono);letter-spacing:.16em;text-transform:uppercase;color:#A98F65}
  .is-dbtn{min-width:40px;min-height:40px;background:#191410;border:1px solid #35291A;border-radius:7px;
    font:700 12px var(--mono);color:#B99B6B;cursor:pointer}
  .is-dbtn:hover{color:#FFD9A0;border-color:#5A452A}
  .is-dbtn[aria-pressed="true"]{background:rgba(247,147,26,.16);border-color:rgba(247,147,26,.65);color:#FFB84D}
  .is-dbtn.is-dim,.is-reset.is-dim{opacity:.45;cursor:default}
  .is-fbtn{min-width:46px;font-size:11px;padding:0 7px}
  
  .is-console2{flex-wrap:wrap}
  .is-console2 .is-draws{flex:1 1 auto;justify-content:center}
  .is-console2 .is-dbtn{flex:1 1 auto}
  .is-spinrow{flex:1 1 100%;display:flex;gap:8px;align-items:stretch}
  .is-spinrow .is-spin{flex:1;min-height:52px}
  .is-spinrow .is-small{flex:0 0 auto;align-items:stretch}
  .is-spinrow .is-mini{height:auto;min-height:52px;width:42px}
  
  .is-spin{flex:1;min-width:110px;min-height:52px;position:relative;overflow:hidden;
    background:linear-gradient(180deg,#FFC983 0%,#F7931A 48%,#D97800 100%);
    color:#241200;border:1px solid rgba(122,58,0,.65);border-radius:11px;cursor:pointer;
    font:700 16px var(--mono);letter-spacing:.14em;text-transform:uppercase;
    text-shadow:0 1px 0 rgba(255,255,255,.35);
    box-shadow:0 5px 18px rgba(247,147,26,.3),inset 0 1px 0 rgba(255,255,255,.3),inset 0 -3px 8px rgba(122,58,0,.35)}
  .is-spin::after{content:"";position:absolute;top:-40%;bottom:-40%;width:34%;left:-45%;
    background:linear-gradient(105deg,transparent,rgba(255,255,255,.5),transparent);
    transform:skewX(-18deg);animation:is-sheen 3.4s ease-in-out infinite;pointer-events:none}
  @keyframes is-sheen{0%,55%{left:-45%}90%,100%{left:120%}}
  .is-spin:hover{background:linear-gradient(180deg,#FFD9A0 0%,#FFA733 48%,#E07E06 100%)}
  .is-spin:active{transform:translateY(1px)}
  .is-spin.is-busy{opacity:.6;cursor:default}
  .is-spin.is-busy::after{animation:none}
  .is-small{display:flex;gap:6px;align-items:center}
  .is-mini{width:40px;height:40px;display:flex;align-items:center;justify-content:center;
    background:#191410;border:1px solid #35291A;border-radius:8px;color:#B99B6B;cursor:pointer}
  .is-mini:hover{color:#FFD9A0;border-color:#5A452A}
  .is-mini[aria-pressed="true"]{border-color:rgba(247,147,26,.55);color:#FFB84D}
  .is-mini svg{width:17px;height:17px}
  .is-autoN{font:700 12px var(--mono);color:#FFB84D}
  .is-autopick{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:6px;margin-top:10px;width:100%;
    background:#0A0705;border:1px solid #35291A;border-radius:9px;padding:6px 10px;
    box-shadow:inset 0 2px 8px rgba(0,0,0,.7)}
  .is-autopick[hidden]{display:none}
  .is-acancel{min-width:34px;color:#8F7A57}
  .is-msg{min-height:30px;margin-top:8px;text-align:center;
