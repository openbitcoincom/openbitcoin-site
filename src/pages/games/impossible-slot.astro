    row.classList.toggle("is-got",led.tk.indexOf(row.getAttribute("data-kind"))>=0);
  });
}
/* match-depth odds label: each character is 1 in 32 (bech32) / 1 in 58 (base58) */
function depthOdds(d,famKey){
  var base=(famKey==="p2pkh"||famKey==="p2sh")?58:32;
  var x=Math.pow(base,d);
  if(x>=1e15)return (x/1e15).toFixed(1).replace(/\.0$/,"")+" quadrillion";
  if(x>=1e12)return (x/1e12).toFixed(1).replace(/\.0$/,"")+" trillion";
  if(x>=1e9)return (x/1e9).toFixed(1).replace(/\.0$/,"")+" billion";
  if(x>=1e6)return (x/1e6).toFixed(1).replace(/\.0$/,"")+" million";
  return fmt(Math.round(x));
}
function matchDepth(a,b,pfx){
  if(a.length!==b.length)return 0; /* different lengths cannot fully match */
  var d=0;
  for(var i=pfx;i<a.length;i++){
    if(a.charAt(i)===b.charAt(i))d++;else break;
  }
  return d;
}

/* ---------------- the spin ---------------- */
var NOMATCH_LINES=[
  "No match. The space is 10⁴⁸ wide; you are one.",
  "No match. Bitcoin remains secure; inconvenient, but reassuring.",
  "No match. The odds on the plate are not decoration.",
  "No match. Somewhere in the 10⁴⁸, the machine's address sits alone.",
  "No match. This is what 2¹⁶⁰ feels like from the inside."
];
function delay(ms){return new Promise(function(rs){setTimeout(rs,ms);});}
function spin(){
  if(spinning)return;
  spinning=true;paintSpin();
  autoLastStart=performance.now();
  ac(); /* wake audio inside the user gesture */
  var k=draws,active=rows.slice(0,k);
  say("Drawing "+FAMILIES[fam].name+" keys: one for the machine, "+k+" for you…");
  if(live)live.textContent="Spinning: "+k+" reel"+(k===1?"":"s")+" against the machine's fresh address.";
  active.forEach(clearRow);
  houseAddrEl.innerHTML="&nbsp;";
  Promise.all([drawOne(fam)].concat(active.map(function(){return drawOne(fam);}))).then(function(ds){
    var house=ds[0],players=ds.slice(1);
    var pfx=FAMILIES[fam].pfx;
    /* theater: the machine reveals its target first, then the reels chase it */
    var t0=fastMode?60:300;
    setTimeout(function(){
      typeAddr(houseAddrEl,house.addr,pfx,function(){});
    },instant()?0:(fastMode?30:80));
    active.forEach(function(rw,i){
      setTimeout(function(){
        keyScramble(rw,players[i].wif,function(){
          typeAddr(rw.addrEl,players[i].addr,pfx,function(){});
        });
      },instant()?0:t0+i*(fastMode?25:160));
    });
    var settleAt=instant()?120:(fastMode?360+(k-1)*25:2000+(k-1)*160);
    delay(settleAt).then(function(){
      settleAll(active,players,house,pfx);
    });
  }).catch(function(e){
    spinning=false;paintSpin();
    say("The draw failed in the browser ("+(e&&e.message?e.message:"error")+"). Nothing was counted; spin again.");
    if(autoLeft>0)autoStop();
  });
}

function settleAll(active,players,house,pfx){
  var winners=[],trophies=[],bestD=0;
  var perRow=instant()?0:(fastMode?70:340);
  active.forEach(function(rw,i){
    var p=players[i];
    var full=(p.addr===house.addr);
    var d=full?(p.addr.length-pfx):matchDepth(p.addr,house.addr,pfx);
    setTimeout(function(){
      led.k++;
      paintAddr(rw.addrEl,p.addr,pfx,d);
      if(full){winners.push({rw:rw,d:p});return;}
      if(d>bestD)bestD=d;
      if(d>led.bm)led.bm=d;
      /* the chip ticks the depth up with a little sound per character */
      rw.chipEl.hidden=false;
      rw.chipEl.className="is-mchip"+(d>=2?" is-mwarm":"");
      rw.chipEl.textContent="MATCH "+d+(d>0?" · 1 IN "+depthOdds(d,p.fam):"");
      if(d>0&&!reduce)for(var s=1;s<=Math.min(d,6);s++)(function(s2){setTimeout(function(){sMatchTick(s2);},s2*90);})(s);
      /* depth d contains every depth beneath it, so a deep match lights the
         whole ladder up to it; one plate, all the checkmarks */
      var newKinds=[];
      if(d>=4)for(var dd=4;dd<=Math.min(10,d);dd++)if(led.tk.indexOf("d"+dd)<0)newKinds.push("d"+dd);
      if(newKinds.length){
        newKinds.forEach(function(kk){led.tk.push(kk);});
        led.tn++;
        led.tr.unshift({a:p.addr+"  vs  "+house.addr,l:"match depth "+d+" · about 1 in "+depthOdds(d,p.fam),n:led.k,w:p.wif});
        led.tr=led.tr.slice(0,60);
        trophies.push({d:d,p:p});
        rw.el.classList.add("is-won");
        stamp(rw,"DEPTH "+d,"is-tr");
        sTrophy();burst(30);
      }else{
        var tr=scanTrophy(p.addr,p.fam);
        if(tr){
          led.tk.push(tr.k);
          led.tn++;
          led.tr.unshift({a:p.addr,l:tr.l,n:led.k,w:p.wif});
          led.tr=led.tr.slice(0,60);
          trophies.push({t:tr,p:p});
          rw.el.classList.add("is-won");
          stamp(rw,"TROPHY","is-tr");
          sTrophy();burst(26);
        }else{
          stamp(rw,"NO MATCH №"+fmt(led.k));
          sStamp();
        }
      }
      paintCounters();
    },perRow*i+ (reduce?0:(fastMode?40:120)));
  });
  var total=perRow*(active.length-1)+(reduce?60:(fastMode?160:400));
  setTimeout(function(){
    led.s++;
    if(winners.length){matchWin(winners[0],house);}
    else if(trophies.length){
      var t=trophies[0];
      say(t.d?
        ("Depth "+t.d+": your reel shared "+t.d+" leading characters with the machine, about 1 in "+depthOdds(t.d,t.p.fam)+". Into the trophy case."):
        ("No coins, but look at it: "+t.p.addr+" ("+t.t.l+"). Into the trophy case; nobody will ever own it."),true);
    }else{
      /* Infinity%5 is NaN, which would mute the live region for the whole
         unlimited run; count spins instead to keep the every-5th cadence */
      say(NOMATCH_LINES[led.s%NOMATCH_LINES.length],false,
        autoLeft>1&&(autoLeft===Infinity?led.s%5!==0:autoLeft%5!==0));
    }
    var mHit=checkMilestones();
    if(mHit&&!winners.length){
      sTrophy();burst(40);
      say("MILESTONE: "+mHit[1]+". "+mHit[2],true);
    }
    saveLed();paintCounters();paintTrophies();paintTable();
    spinning=false;paintSpin();
    maybeAutoNext();
  },total+(fastMode?50:120));
}

/* the never-branch, honest if it ever runs: no coins, no risk, one story */
function matchWin(w,house){
  autoStop();
  led.bm=w.d.addr.length-FAMILIES[w.d.fam].pfx;
  w.rw.el.classList.add("is-won");
  stamp(w.rw,"FULL MATCH","is-tr");
  paintAddr(w.rw.addrEl,w.d.addr,FAMILIES[w.d.fam].pfx,w.d.addr.length);
  /* the full match contains every depth: light the whole ladder */
  for(var dd=4;dd<=10;dd++)if(led.tk.indexOf("d"+dd)<0)led.tk.push("d"+dd);
  saveLed();paintCounters();paintTable();
  var mir=el("is-mir");if(mir)mir.hidden=false;
  say("FULL MATCH: your reel drew "+w.d.addr+", the machine's exact address. 1 in 2¹⁶⁰. Read the panel below.",true);
  try{
    if(!reduce){
      cab.classList.add("is-shake");setTimeout(function(){cab.classList.remove("is-shake");},600);
      burst(120);
    }
    sWin();
  }catch(e){}
}

spinBtn.addEventListener("click",function(e){
  if(e.detail>0)this.blur();
  spin();
});
/* the wipe wants a second press: milestones and trophies are not reborn */
var resetTimer=null;
function disarmReset(){
  if(resetTimer){clearTimeout(resetTimer);resetTimer=null;}
  var rb=el("is-reset");
  rb.textContent="Reset everything";
  rb.classList.remove("is-armed");
}
el("is-reset").addEventListener("click",function(){
  if(spinning)return;
  var rb=this;
  if(!resetTimer){
    rb.textContent="Sure?";
    rb.classList.add("is-armed");
    resetTimer=setTimeout(disarmReset,4000);
    return;
  }
  disarmReset();
  autoStop();
  led={s:0,k:0,bm:0,tn:0,tr:[],tk:[],ms:[]};
  saveLed();paintCounters();paintTrophies();paintTable();
  rows.forEach(restRow);
  houseAddrEl.textContent="none yet; spin to deal one";
  say("Wiped. The key space does not remember you either.");
});
document.addEventListener("keydown",function(e){
  if(e.altKey||e.ctrlKey||e.metaKey||e.shiftKey||e.repeat)return;
  var k=e.key;
  if(k!==" "&&k!=="Enter")return;
  var tg=e.target;
  if(tg&&tg.closest){
    if(tg.closest("input,select,textarea,a"))return;
    if(tg.closest("button"))return;
  }
  var r=stage.getBoundingClientRect();
  if(r.bottom<0||r.top>window.innerHeight)return;
  e.preventDefault();spin();
});

/* ---------------- the lever ---------------- */
var arm=el("is-arm"),dragging=false,dragY0=0,armAngle=0;
function pullAndSpin(){
  arm.classList.remove("is-pull");
  void arm.offsetWidth;
  arm.classList.add("is-pull");
  spin();
}
if(arm){
  arm.addEventListener("pointerdown",function(e){
    if(e.button!==0||!e.isPrimary)return;
    dragging=true;dragY0=e.clientY;armAngle=0;
    arm.setPointerCapture(e.pointerId);
    arm.classList.remove("is-pull");
    e.preventDefault();
  });
  arm.addEventListener("pointermove",function(e){
    if(!dragging)return;
    armAngle=Math.max(0,Math.min(46,(e.clientY-dragY0)*0.55));
    arm.style.transform="rotate("+armAngle+"deg)";
  });
  function release(){
    if(!dragging)return;
    dragging=false;
    arm.style.transform="";
    if(armAngle>30||armAngle<4)pullAndSpin();
    armAngle=0;
  }
  arm.addEventListener("pointerup",release);
  arm.addEventListener("pointercancel",release);
}

/* ---------------- fullscreen ---------------- */
var fsBtn=el("is-fs");
function fsActive(){return document.fullscreenElement===stage||stage.classList.contains("is-fake");}
function setInertOutside(on){
  var node=stage;
  while(node&&node!==document.body){
    var p=node.parentElement;
    if(!p)break;
    for(var i=0;i<p.children.length;i++){
      var sib=p.children[i];
      if(sib===node)continue;
      if(on)sib.setAttribute("inert","");
      else sib.removeAttribute("inert");
    }
    node=p;
  }
}
function paintFs(){
  var open=el("is-fs-open"),close=el("is-fs-close"),on=fsActive();
  if(open)open.hidden=on;if(close)close.hidden=!on;
  fsBtn.setAttribute("aria-pressed",on?"true":"false");
}
function exitFake(){
  stage.classList.remove("is-fake");
  document.documentElement.classList.remove("is-lock");
  setInertOutside(false);
  paintFs();
}
function fsToggle(){
  if(document.fullscreenElement){document.exitFullscreen();return;}
  if(stage.classList.contains("is-fake")){exitFake();return;}
  if(stage.requestFullscreen){
    stage.requestFullscreen().then(paintFs).catch(function(){
      stage.classList.add("is-fake");document.documentElement.classList.add("is-lock");
      setInertOutside(true);paintFs();
    });
  }else{
    stage.classList.add("is-fake");document.documentElement.classList.add("is-lock");
    setInertOutside(true);paintFs();
  }
}
fsBtn.addEventListener("click",fsToggle);
document.addEventListener("fullscreenchange",paintFs);
document.addEventListener("keydown",function(e){
  if(e.key==="Escape"&&stage.classList.contains("is-fake"))exitFake();
});

/* ---------------- boot ---------------- */
paintCounters();paintTrophies();paintTable();
if(led.k>0)say("Welcome back. "+fmt(led.k)+" addresses drawn, no match yet, exactly as the arithmetic promised.");

/* iOS long-press hardening: user-select:none alone is not honored
   reliably on Safari, so selection is refused at the event layer and any
   range that sneaks through is swept on touchend */
(function(){
  var st=document.querySelector(".is-stage");
  if(!st)return;
    /* the decisive layer: cancel the NATIVE touch before Safari's selection
     recognizer runs. Scoped to the canvas and overlay prose only, so
     buttons keep their taps and the page keeps its scroll. */
  st.addEventListener("touchstart",function(e){
    var t=e.target;
    if(!t||!t.closest)return;
    if(t.closest("button,a,input,select,textarea"))return;
    if(t.closest("canvas")||t.closest(".is-overlay"))e.preventDefault();
  },{passive:false});
  ["selectstart","contextmenu"].forEach(function(ev){
    st.addEventListener(ev,function(e){e.preventDefault();});
  });
  document.addEventListener("touchend",function(){
    try{
      var sel=window.getSelection&&window.getSelection();
      if(!sel||!sel.rangeCount||!sel.anchorNode)return;
      var n=sel.anchorNode.nodeType===1?sel.anchorNode:sel.anchorNode.parentNode;
      if(n&&st.contains(n))sel.removeAllRanges();
    }catch(e){}
  },{passive:true});
})();
})();
</script>
