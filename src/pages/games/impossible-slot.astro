---
import Base from '../../layouts/Base.astro';
import '../../styles/doc.css';
import HeroEmblem from '../../components/HeroEmblem.astro';
---
<Base title="The Impossible Slot Machine: Match a Bitcoin Address - OpenBitcoin" description="A slot machine where every spin draws real bitcoin private keys in your browser and compares your fresh address against the machine's own fresh draw. A full match wins, at odds of exactly 1 in 2^160. No balance checks, nobody's coins involved, nothing leaves your browser. Free, no wagering, no prizes." analytics={false}>
<main class="wrap doc-wrap">
  <div class="doc-head">
    <div class="doc-kicker"><a href="/games">Games</a></div>
    <h1>The Impossible Slot Machine</h1>
    <HeroEmblem name="slotmachine" />
    <p class="doc-lede">Real keys, drawn in your browser: one for the machine, one per reel. Match its address in full and you win, at 1 in 2<sup>160</sup> odds. Nobody ever has.</p>
  </div>
  <div class="doc-grid">
  <div>

    <!-- ============ THE MACHINE ============ -->
    <div class="is-stage" id="is-stage">
      <div class="is-cab" id="is-cab">
        <div class="is-marquee">
          <div class="is-title">IMPOSSIBLE SLOT MACHINE</div>
          <div class="is-sub">every key real &middot; only for fun</div>
        </div>

        <div class="is-window">
          <div class="is-rows" id="is-rows"></div>
          <canvas class="is-fx" id="is-fx"></canvas>
        </div>

        <div class="is-console">
          <div class="is-led">
            <i>Addresses drawn</i>
            <b id="is-c-keys">0</b>
          </div>
          <div class="is-led">
            <i>Best match &middot; chars</i>
            <b id="is-c-won">0</b>
          </div>
          <div class="is-led">
            <i>Trophies</i>
            <b id="is-c-tr">0</b>
          </div>
        </div>
        <div class="is-console is-console2">
          <div class="is-draws" role="group" aria-label="Address family">
            <span class="is-dlab">Family</span>
            <button class="is-dbtn is-fbtn" id="is-f-p2pkh" type="button" aria-pressed="false" title="Legacy addresses">1&hellip;</button>
            <button class="is-dbtn is-fbtn" id="is-f-p2sh" type="button" aria-pressed="true" title="Script addresses">3&hellip;</button>
            <button class="is-dbtn is-fbtn" id="is-f-p2wpkh" type="button" aria-pressed="false" title="SegWit addresses">bc1q</button>
            <button class="is-dbtn is-fbtn" id="is-f-p2tr" type="button" aria-pressed="false" title="Taproot addresses">bc1p</button>
          </div>
          <div class="is-draws" role="group" aria-label="Reels per spin">
            <span class="is-dlab">Reels</span>
            <button class="is-dbtn" id="is-d1" type="button" aria-pressed="true">&times;1</button>
            <button class="is-dbtn" id="is-d2" type="button" aria-pressed="false">&times;2</button>
            <button class="is-dbtn" id="is-d3" type="button" aria-pressed="false">&times;3</button>
          </div>
          <div class="is-spinrow">
          <button class="is-spin" id="is-spin" type="button">Spin</button>
          <div class="is-small">
            <button class="is-mini" id="is-auto" type="button" aria-label="Auto spin" aria-pressed="false" title="Auto spin">
              <svg viewBox="0 0 24 24" id="is-auto-ic"><path d="M4 12a8 8 0 0 1 13.6-5.7M20 12a8 8 0 0 1-13.6 5.7" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><path d="M17.6 2.5v4h-4M6.4 21.5v-4h4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span class="is-autoN" id="is-autoN" hidden></span>
            </button>
            <button class="is-mini" id="is-fast" type="button" aria-label="Fast mode" aria-pressed="false" title="Fast mode">
              <svg viewBox="0 0 24 24"><path d="M13 2 5 14h5l-1 8 8-12h-5z" fill="currentColor"/></svg>
            </button>
            <button class="is-mini" id="is-mute" type="button" aria-label="Mute" aria-pressed="false" title="Mute">
              <svg viewBox="0 0 24 24" id="is-mute-on"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16 9c1.2.8 1.2 5.2 0 6M18.5 7c2.2 2 2.2 8 0 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              <svg viewBox="0 0 24 24" id="is-mute-off" hidden><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16 9.5l6 5M22 9.5l-6 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
            <button class="is-mini" id="is-fs" type="button" aria-label="Fullscreen" aria-pressed="false" title="Fullscreen">
              <svg viewBox="0 0 24 24" id="is-fs-open"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <svg viewBox="0 0 24 24" id="is-fs-close" hidden><path d="M9 4v5H4M20 9h-5V4M15 20v-5h5M4 15h5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
          </div>
        </div>
        <div class="is-autopick" id="is-autopick" hidden>
          <span class="is-dlab">Auto spins</span>
          <button class="is-dbtn" id="is-a50" type="button">50</button>
          <button class="is-dbtn" id="is-a100" type="button">100</button>
          <button class="is-dbtn" id="is-a500" type="button">500</button>
          <button class="is-dbtn" id="is-a1000" type="button">1000</button>
          <button class="is-dbtn" id="is-ainf" type="button" aria-label="Unlimited">&infin;</button>
          <button class="is-dbtn is-acancel" id="is-a0" type="button" aria-label="Cancel">&times;</button>
        </div>
        <div class="is-msg" id="is-msg">The machine deals itself a fresh address; your reels try to match it. Every key is real, nobody's coins are involved, and nothing leaves this page. Good luck anyway.</div>
        <div class="is-plate">
          <span class="is-plab">ODDS OF A FULL MATCH: 1 IN</span>
          <span class="is-pnum">1,461,501,637,330,902,918,203,684,832,716,283,019,655,932,542,976</span>
        </div>
        <div class="is-lever" id="is-lever" aria-hidden="true">
          <div class="is-track"></div>
          <div class="is-arm" id="is-arm"><div class="is-knob"></div></div>
        </div>
      </div>
      
      <div class="is-sr" id="is-live" aria-live="polite"></div>
    </div>
    <noscript><p class="is-nojs">The machine needs JavaScript to draw keys. The odds and arithmetic below are true either way.</p></noscript>

    <!-- the match panel, revealed ONLY on a full match (which will never
         occur; the honest contingency, not a promise) -->
    <div class="is-card is-mircard" id="is-mir" hidden>
      <h2 class="is-tlab is-mlab">You appear to have won</h2>
      <p class="is-p">A reel matched the machine's address in full: odds of 1 in 2<sup>160</sup>, an event with no precedent anywhere. Before celebrating, know the honest ranking of explanations: your browser's random number generator failing catastrophically is overwhelmingly more likely than the universe delivering a genuine collision, and either way we would love to hear about it via the <a href="/contact">contact page</a>. No coins are involved and nobody is at risk: both keys are yours, the address is empty, and the only thing you have won is the best story on earth. Screenshot it; the <a href="/terms">terms</a> apply.</p>
    </div>

    <!-- ============ THE LEDGER ============ -->
    <div class="is-card">
      <h2 class="is-tlab">The ledger: this browser, all time</h2>
      <div class="is-stats">
        <div class="is-stat"><b id="is-l-spins">0</b><i>spins</i></div>
        <div class="is-stat"><b id="is-l-keys">0</b><i>addresses drawn</i></div>
        <div class="is-stat"><b id="is-l-bm">0</b><i>best match, characters</i></div>
        <div class="is-stat"><b id="is-l-tr">0</b><i>trophies</i></div>
      </div>
      <p class="is-ledaddr"><i>The machine's address this spin, the one your reels were chasing:</i>
      <b id="is-haddr">none yet; spin to deal one</b></p>
      <p class="is-share" id="is-share">Share of the key space you have explored: none yet.</p>
      <p class="is-brow"><span>The ledger lives in this browser's storage and never leaves the page. The best-match column is the machine's honest tease: every extra character is 32 times rarer than the last, and there are 38 of them.</span> <button class="is-reset" id="is-reset" type="button">Reset everything</button></p>
    </div>

    <!-- ============ THE TROPHY CASE ============ -->
    <div class="is-card">
      <h2 class="is-tlab">The trophy case</h2>
      <p class="is-p">Coins never come out of this machine, but pretty addresses do. Every draw is a real address nobody has ever seen and nobody will ever own, and once in a while one arrives wearing a pattern, or brushes unusually close to the machine's. Each trophy is earned once: the table below lights up as you collect them. The machine keeps the plates, keys and all, in this browser; each pattern plate can show you its private key, which is genuinely yours and genuinely worthless. A webpage is still not a wallet.</p>
      <div class="is-trophies" id="is-trophies"><p class="is-trempty" id="is-trempty">Nothing yet. The common ones turn up about once in 900 draws.</p></div>
      <div class="is-ptwrap">
        <table class="is-pt" id="is-ptable">
          <thead><tr><th>Trophy</th><th>Example</th><th>True odds</th></tr></thead>
          <tbody>
            <tr data-kind="openbitcoin"><td>"openbitcoin" in a legacy draw</td><td class="is-mono">&hellip;opEnbitcoin&hellip;</td><td>about 1 in 8 quadrillion</td></tr>
            <tr data-kind="d10"><td>Match depth 10: ten leading characters shared</td><td class="is-mono">bc1q<u>w508d6qejx</u>&hellip;</td><td>about 1 in 1.1 quadrillion</td></tr>
            <tr data-kind="d9"><td>Match depth 9</td><td class="is-mono">bc1q<u>w508d6qej</u>&hellip;</td><td>about 1 in 35 trillion</td></tr>
            <tr data-kind="d8"><td>Match depth 8</td><td class="is-mono">bc1q<u>w508d6qe</u>&hellip;</td><td>about 1 in 1.1 trillion</td></tr>
            <tr data-kind="d7"><td>Match depth 7</td><td class="is-mono">bc1q<u>w508d6q</u>&hellip;</td><td>about 1 in 34 billion</td></tr>
            <tr data-kind="bitcoin"><td>"bitcoin" in a legacy draw</td><td class="is-mono">&hellip;bItcoin&hellip;</td><td>about 1 in 5 billion</td></tr>
            <tr data-kind="satoshi"><td>"satoshi" in a legacy draw</td><td class="is-mono">&hellip;sAtoshi&hellip;</td><td>about 1 in 2.6 billion</td></tr>
            <tr data-kind="d6"><td>Match depth 6</td><td class="is-mono">bc1q<u>w508d6</u>&hellip;</td><td>about 1 in 1.1 billion</td></tr>
            <tr data-kind="d5"><td>Match depth 5</td><td class="is-mono">bc1q<u>w508d</u>&hellip;</td><td>about 1 in 34 million</td></tr>
            <tr data-kind="d4"><td>Match depth 4</td><td class="is-mono">bc1q<u>w508</u>&hellip;</td><td>about 1 in a million</td></tr>
            <tr data-kind="stutter"><td>The stutter: address starts bc1qqqq</td><td class="is-mono">bc1qqqq&hellip;</td><td>exactly 1 in 32,768</td></tr>
            <tr data-kind="run5"><td>Five identical characters in a row</td><td class="is-mono">&hellip;kkkkk&hellip;</td><td>about 1 in 31,000</td></tr>
            <tr data-kind="sats"><td>"sats" anywhere in it</td><td class="is-mono">&hellip;w2sats7&hellip;</td><td>about 1 in 30,000</td></tr>
            <tr data-kind="run4"><td>Four identical characters in a row</td><td class="is-mono">&hellip;7777&hellip;</td><td>about 1 in 900</td></tr>
            <tr data-kind="sat"><td>"sat" anywhere in it</td><td class="is-mono">&hellip;9sat0&hellip;</td><td>about 1 in 900</td></tr>
            <tr data-kind="btc"><td>"btc" in a legacy draw</td><td class="is-mono">&hellip;1BtC&hellip;</td><td>about 1 in 800</td></tr>
          </tbody>
        </table>
      </div>
      <p class="is-note">Pattern odds are quoted for bc1q draws over the 38 characters after the prefix; other families' alphabets shift them a little. Match-depth odds are per reel against the machine's draw. Bech32 has no b, i, o or 1, so "btc", "bitcoin", "satoshi" and "openbitcoin" only ever turn up wearing a 1 or a 3. Milestone plates arrive at 1,000, 10,000, 100,000 and 1,000,000 addresses drawn.</p>
    </div>

    <!-- ============ WHAT A SPIN IS ============ -->
    <div class="is-card">
      <h2 class="is-tlab">What a spin actually is</h2>
      <div class="is-pipe">
        <div class="is-step"><span>01</span><b>The machine's key</b><i>256 random bits from <code class="is-code">crypto.getRandomValues</code>, drawn on this page, derived to a real address in the family you chose.</i></div>
        <div class="is-step"><span>02</span><b>Your keys</b><i>Each reel draws its own, exactly the same way. Legacy 1, script 3, segwit bc1q or taproot bc1p, all real derivations.</i></div>
        <div class="is-step"><span>03</span><b>The comparison</b><i>Reel address against machine address. Every shared leading character is a 1-in-32 event; all 38 shared is the win.</i></div>
      </div>
      <p class="is-note">One footnote for the purists: the three hash-based families compare 160-bit hashes, so a full match is exactly 1 in 2<sup>160</sup>. Taproot compares 256-bit output keys, which is rarer still, at 1 in 2<sup>256</sup>. Both round to never.</p>
    </div>

    <!-- ============ THE MATHEMATICS ============ -->
    <div class="is-card">
      <h2 class="is-tlab">The mathematics of never</h2>
      <div class="doc-sec doc-prose">
        <h3>The space</h3>
        <p>An address is a 160-bit number, so there are about <strong>1.46 &times; 10<sup>48</sup></strong> of them. Matching the machine's fresh draw is the same arithmetic as guessing any one specific address: the exact event bitcoin's security rests on never happening. For scale, the Earth contains about 1.3 &times; 10<sup>50</sup> atoms; picking one named atom out of the planet at random is only about a hundred times harder than what this machine asks of you.</p>
      </div>
      <div class="doc-sec doc-prose">
        <h3>The hardware fantasy</h3>
        <p>Bitcoin's entire mining network performs on the order of 10<sup>20</sup> hash computations a second, the largest purpose-built computation on earth. Repurposed to pulling this lever (it cannot be; a draw costs far more than one hash), an even chance of one full match would still take on the order of <strong>10<sup>20</sup> years</strong>: billions of times the age of the universe. Your browser checks a few reels per spin.</p>
      </div>
      <div class="doc-sec doc-prose">
        <h3>Why no-match is the product</h3>
        <p>Every spin that ends in NO MATCH is bitcoin's security model, demonstrated live. The reason you cannot land on the machine's address is the same reason nobody lands on yours. The real risks live elsewhere, in <a href="/learn/self-custody">backups and custody</a>, in <a href="/learn/scams">scams</a>, and for exposed public keys someday perhaps in <a href="/quantum">quantum computers</a>; never in someone's browser drawing your number.</p>
      </div>
    </div>

    <!-- ============ IF YOU BEAT THE ODDS ============ -->
    <div class="is-card">
      <h2 class="is-tlab">If you beat the odds</h2>
      <p class="is-p">Suppose a reel actually matches: 1 in 1,461,501,637,330,902,918,203,684,832,716,283,019,655,932,542,976, which nobody has ever beaten at anything. The machine halts, stops any auto run, and says:</p>
      <ol class="is-drill">
        <li><b>Nothing needs protecting.</b> Both keys are yours, the address is empty, and nobody's coins were ever involved.</li>
        <li><b>Suspect your browser before the universe.</b> A broken random number generator is trillions of times likelier than a genuine collision; either way, tell us via the <a href="/contact">contact page</a>.</li>
        <li><b>Screenshot it, tell everyone, prove nothing.</b> Buy a real lottery ticket while you are at it: 1 in 300 million is now beneath you. This machine will deny everything.</li>
      </ol>
    </div>

    <!-- ============ A TOY, NOT A CASINO ============ -->
    <div class="is-card is-warncard">
      <h2 class="is-tlab is-wlab">A toy, not a casino</h2>
      <p class="is-p">Nothing on this site takes wagers or pays prizes, and nothing here ever will. There is no jackpot and nothing to win except the event itself; the machine checks no balances, touches nobody's coins, and sends nothing anywhere. The arithmetic on the plate is the house edge: 2<sup>160</sup> to 1, in favour of everyone who owns bitcoin. A real slot machine hides a much smaller number and charges admission. The <a href="/terms">terms</a> cover the rest.</p>
    </div>

    <div class="is-about doc-prose">
      <p>The Impossible Slot Machine is what a fair game over the whole address space actually looks like: real keys, real derivations, and a comparison that will read NO MATCH for the lifetime of the universe. It sits in the <a href="/games">games section</a>, where play is free forever. The unit its families encode is explained on <a href="/sats">the sats page</a>, and the game about the only strategy that has historically worked is the <a href="/dca">DCA backtester</a>.</p>
    </div>
  </div>
  <aside class="doc-rail">
    <div class="doc-tile">
      <div class="doc-tlab">House rules</div>
      <ul class="is-rl">
        <li>One to three reels per spin; four families on the dial</li>
        <li>The machine draws its own fresh address every spin</li>
        <li>Match it in full and you win; odds 1 in 2<sup>160</sup></li>
        <li>No balance checks; nothing leaves your browser</li>
        <li>Trophies and milestones at printed odds; free forever</li>
      </ul>
    </div>
    <div class="doc-tile">
      <div class="doc-tlab">Related</div>
      <nav>
        <a href="/games">All games</a>
        <a href="/quantum">Quantum and bitcoin</a>
        <a href="/learn/self-custody">Self-custody basics</a>
      </nav>
    </div>
  </aside>
  </div>
</main>

<style is:global>
  .doc-kicker a{color:inherit;text-decoration:none}
  .doc-kicker a:hover{text-decoration:underline}
  
  
  .is-stage,.is-stage *{-webkit-user-select:none !important;user-select:none !important;
    -webkit-touch-callout:none !important}
  .is-stage ::selection{background:transparent}
  .is-stage{position:relative}
  @media(min-width:741px){.is-stage{padding-right:74px}}
  .is-stage.is-fake{position:fixed;inset:0;z-index:80;background:#0A0806;display:flex;justify-content:center;padding:12px;overflow:auto}
  .is-stage:fullscreen{background:#0A0806;display:flex;justify-content:center;padding:12px;overflow:auto}
  .is-stage.is-fake .is-cab,.is-stage:fullscreen .is-cab{margin:auto;max-width:640px}
  html.is-lock{overflow:hidden}

  .is-cab{position:relative;max-width:600px;margin:0 auto;
    background:linear-gradient(180deg,#241D14,#120E09 70%,#0C0906);
    border:1px solid #3E3322;border-radius:20px;
    padding:16px 20px 12px;
    box-shadow:0 18px 44px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,220,160,.10),inset 0 -14px 30px rgba(0,0,0,.45)}
  .is-cab button:focus-visible{outline:3px solid #FFD9A0;outline-offset:2px}

  
  .is-marquee{text-align:center;padding:0 0 10px;position:relative;z-index:1}
  .is-marquee::before{content:"";position:absolute;left:8%;right:8%;top:-6px;height:52px;
    background:radial-gradient(closest-side,rgba(247,147,26,.18),transparent);pointer-events:none}
  .is-title{font:700 clamp(14px,3.6vw,19px) var(--mono);letter-spacing:.18em;color:#FFD9A0;
    text-shadow:0 0 16px rgba(247,147,26,.55),0 1px 0 rgba(0,0,0,.6)}
  .is-sub{font:600 8.5px var(--mono);letter-spacing:.24em;text-transform:uppercase;color:#A98F65;margin-top:5px}

  
  .is-window{position:relative;background:#060504;border:1px solid #3E3322;border-radius:14px;
    padding:8px;box-shadow:inset 0 4px 18px rgba(0,0,0,.85)}
  .is-row{position:relative;isolation:isolate;background:linear-gradient(180deg,#171310,#1E1913 50%,#171310);
    border-radius:9px;box-shadow:inset 0 0 0 1px #2C241A;padding:8px 12px 9px;margin-top:6px;overflow:hidden}
  .is-row:first-child{margin-top:0}
  
