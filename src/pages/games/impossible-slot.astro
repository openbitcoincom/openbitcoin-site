/* ---------------- trophies: real patterns at printed odds ---------------- */
function scanTrophy(addr,famKey){
  /* each kind is collectible ONCE: already-earned kinds scan as nothing */
  var bech=(famKey==="p2wpkh"||famKey==="p2tr");
  var body=bech?addr.slice(4):addr.slice(1);
  var lower=body.toLowerCase();
  var got=function(k){return led.tk.indexOf(k)>=0;};
  /* the house words live in base58 only: bech32 has no o, i or b */
  if(!bech&&lower.indexOf("openbitcoin")>=0&&!got("openbitcoin"))return {k:"openbitcoin",l:'"openbitcoin" · about 1 in 8 quadrillion'};
  if(!bech&&lower.indexOf("bitcoin")>=0&&!got("bitcoin"))return {k:"bitcoin",l:'"bitcoin" · about 1 in 5 billion'};
  if(!bech&&lower.indexOf("satoshi")>=0&&!got("satoshi"))return {k:"satoshi",l:'"satoshi" · about 1 in 2.6 billion'};
  /* checked rarest first, so a multi-pattern draw awards its rarest plate */
  if(famKey==="p2wpkh"&&body.slice(0,3)==="qqq"&&!got("stutter"))return {k:"stutter",l:"the stutter · 1 in 32,768"};
  if(/(.)\1{4}/.test(body)&&!got("run5"))return {k:"run5",l:"five in a row · about 1 in 31,000"};
  if(lower.indexOf("sats")>=0&&!got("sats"))return {k:"sats",l:'"sats" · about 1 in 30,000'};
  if(/(.)\1{3}/.test(body)&&!got("run4"))return {k:"run4",l:"four in a row · about 1 in 900"};
  if(lower.indexOf("sat")>=0&&!got("sat"))return {k:"sat",l:'"sat" · about 1 in 900'};
  if(!bech&&lower.indexOf("btc")>=0&&!got("btc"))return {k:"btc",l:'"btc" · about 1 in 800'};
  return null;
}
