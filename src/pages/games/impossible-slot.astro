        tr.map(function(t){
          if(t.l.indexOf('"openbitcoin"')>=0)return "openbitcoin";
          if(t.l.indexOf('"bitcoin"')>=0)return "bitcoin";
          if(t.l.indexOf('"satoshi"')>=0)return "satoshi";
          if(t.l.indexOf("stutter")>=0)return "stutter";
          if(t.l.indexOf('"sats"')>=0)return "sats";
          if(t.l.indexOf("five in a row")>=0)return "run5";
          if(t.l.indexOf('"btc"')>=0)return "btc";
          if(t.l.indexOf('"sat"')>=0)return "sat";
          if(t.l.indexOf("four in a row")>=0)return "run4";
          var m=t.l.match(/match depth (\d+)/);
          if(m)return "d"+Math.min(10,parseInt(m[1],10));
          return null;
        }).filter(function(x,i,a){return x&&a.indexOf(x)===i;});
      /* a depth kind implies every depth beneath it; backfill ledgers written
         before the cascade so the lower checkmarks light too */
      var maxd=0;
      tk.forEach(function(x){var dm=/^d(\d+)$/.exec(x);if(dm)maxd=Math.max(maxd,parseInt(dm[1],10));});
      for(var dd=4;dd<=Math.min(10,maxd);dd++)if(tk.indexOf("d"+dd)<0)tk.push("d"+dd);
      return {s:l.s|0,k:l.k|0,bm:l.bm|0,tn:l.tn|0,tr:tr,tk:tk,
              ms:Array.isArray(l.ms)?l.ms.filter(function(x){return isFinite(x);}).map(Math.floor):[]};
    }
  }catch(e){}
  return {s:0,k:0,bm:0,tn:0,tr:[],tk:[],ms:[]};
}
