/* ---------------- pause ---------------- */
function paintPause(){
  var pb=el("bk-pause");
  hideIc(el("bk-ic-pause"),paused);hideIc(el("bk-ic-play"),!paused);
  if(pb)pb.setAttribute("aria-pressed",paused?"true":"false");
}
function shiftClocks(delta){
  stateUntil+=delta;lastBreakAt+=delta;
  if(sayHoldUntil)sayHoldUntil+=delta;
  if(widenUntil)widenUntil+=delta;
  if(shrinkUntil)shrinkUntil+=delta;
  if(slowUntil)slowUntil+=delta;
  if(pierceUntil)pierceUntil+=delta;
  if(holdUntil)holdUntil+=delta;
  if(spikeUntil)spikeUntil+=delta;
  balls.forEach(function(b){if(b.stuck)b.stickAt+=delta;});
  flashes.forEach(function(fl){fl.t0+=delta;});
}
function setPause(on){
  if(on&&state!=="run"&&state!=="serve")return;
  if(paused===on)return;
  paused=on;paintPause();
  if(on){
    pausedAt=performance.now();pausedFrom=state;state="pause";
    stopMusic();
    say("Paused. The real backlog is not.",null,600);
  }else{
    shiftClocks(performance.now()-pausedAt);
    state=pausedFrom;lastT=performance.now();
    startMusic();
    say("Back to the wall.",null,600);
  }
}
el("bk-pause").addEventListener("click",function(e){
  if(e.detail>0)this.blur();
  if(state==="run"||state==="serve")setPause(true);
  else if(state==="pause")setPause(false);
  else say("Nothing running to pause yet.",null,700);
});
document.addEventListener("visibilitychange",function(){
  if(!document.hidden)return;
  keysDown={}; /* keys can release unseen while the tab is hidden */
  stopMusic(); /* a hidden tab falls silent NOW: rAF freezes, deferred paths cannot */
  if(state==="run"||state==="serve")setPause(true);
  /* dead and found need no deferral: both resolve into the serve state,
     which holds still until the player is back anyway */
});

/* ---------------- input ---------------- */
ovBtn.addEventListener("click",function(){ac();startRun();});
var bwrap=cv.parentNode;
bwrap.addEventListener("pointermove",function(e){
  if(!e.isPrimary)return;
  if(state==="idle"||state==="over")return;
  var rect=cv.getBoundingClientRect();
  paddleTarget=Math.max(0,Math.min(W,(e.clientX-rect.left)*(W/Math.max(1,rect.width))));
});
cv.addEventListener("pointerdown",function(e){
  if(state==="pause"){setPause(false);return;} /* a click on the board resumes */
  if(state==="idle"||state==="over")return;
  if(!e.isPrimary){
    /* a second finger can serve or release without stealing the steering */
    if(state==="serve"){ac();launch();}
    else if(state==="run")launch();
    return;
  }
  var rect=cv.getBoundingClientRect();
  paddleTarget=Math.max(0,Math.min(W,(e.clientX-rect.left)*(W/Math.max(1,rect.width))));
  if(state==="serve"){ac();launch();}
  else if(state==="run")launch(); /* releases held balls */
});
document.addEventListener("keydown",function(e){
  if(e.altKey||e.ctrlKey||e.metaKey)return;
  var k=e.key;
  if(["ArrowUp","ArrowDown","ArrowLeft","ArrowRight","a","A","d","D","p","P","m","M"," ","Enter"].indexOf(k)<0)return;
  var tg=e.target;
  if(tg&&tg.closest){
    if(tg.closest("input,select,textarea,a"))return;
    /* a focused button keeps its native Space/Enter activation */
    if(tg.closest("button")&&(k===" "||k==="Enter"))return;
  }
  var r=stage.getBoundingClientRect();
  if(r.bottom<0||r.top>window.innerHeight)return;
  if(state==="run"||state==="serve"||state==="dead"||state==="found"){
    if(k==="ArrowLeft"||k==="a"||k==="A"){e.preventDefault();keysDown.left=true;}
    else if(k==="ArrowRight"||k==="d"||k==="D"){e.preventDefault();keysDown.right=true;}
    else if(k===" "||k==="ArrowUp"){e.preventDefault();if(state==="serve"){ac();launch();}else if(state==="run")launch();}
    else if(k==="m"||k==="M"){e.preventDefault();if(!e.repeat)toggleMusic();}
    else if(k==="p"||k==="P"){e.preventDefault();setPause(true);}
    else if(k==="ArrowDown"||k==="Enter"){e.preventDefault();}
  }else if(k==="m"||k==="M"){e.preventDefault();if(!e.repeat)toggleMusic();}
  else if(state==="pause"&&(k==="p"||k==="P"||k===" ")){e.preventDefault();setPause(false);}
  else if((k===" "||k==="Enter")&&!overlay.hidden){e.preventDefault();ac();startRun();}
});
document.addEventListener("keyup",function(e){
  var k=e.key;
  if(k==="ArrowLeft"||k==="a"||k==="A")keysDown.left=false;
  else if(k==="ArrowRight"||k==="d"||k==="D")keysDown.right=false;
});
window.addEventListener("blur",function(){keysDown={};});

/* two-step reset, sibling idiom */
var resetArmed=false,resetTimer=null;
el("bk-reset").addEventListener("click",function(){
  var b=el("bk-reset");
  if(!resetArmed){
    resetArmed=true;b.classList.add("bk-armed");b.textContent="Click again to wipe";
    resetTimer=setTimeout(function(){resetArmed=false;b.classList.remove("bk-armed");b.textContent="Reset everything";},4000);
    return;
  }
  clearTimeout(resetTimer);resetArmed=false;
  b.classList.remove("bk-armed");b.textContent="Reset everything";
  led={g:0,best:0,blk:0,lv:0,ep:1,dr:0,wh:0,fees:0,tr:[]};
  saveLed();paintLedger();paintShelf();
