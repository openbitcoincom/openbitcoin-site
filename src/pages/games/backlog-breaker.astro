});

/* ---------------- fullscreen (shared idiom) ---------------- */
var fsBtn=el("bk-fs");
function fsActive(){return document.fullscreenElement===stage||stage.classList.contains("bk-fake");}
function setInertOutside(on){
  var node=stage;
  while(node&&node!==document.body){
    var p=node.parentElement;
    if(!p)break;
    for(var i=0;i<p.children.length;i++){
      var sib=p.children[i];
      if(sib===node)continue;
      if(on)sib.setAttribute("inert","");else sib.removeAttribute("inert");
    }
    node=p;
  }
}
function paintFs(){
  var on=fsActive();
  hideIc(el("bk-fs-open"),on);hideIc(el("bk-fs-close"),!on);
  fsBtn.setAttribute("aria-pressed",on?"true":"false");
  sizeBoard();
}
function exitFake(){
  stage.classList.remove("bk-fake");document.documentElement.classList.remove("bk-lock");
  setInertOutside(false);paintFs();
}
function fsToggle(){
  if(document.fullscreenElement){document.exitFullscreen();return;}
  if(stage.classList.contains("bk-fake")){exitFake();return;}
  if(stage.requestFullscreen){
    stage.requestFullscreen().then(paintFs).catch(function(){
      stage.classList.add("bk-fake");document.documentElement.classList.add("bk-lock");
      setInertOutside(true);paintFs();
    });
  }else{
    stage.classList.add("bk-fake");document.documentElement.classList.add("bk-lock");
    setInertOutside(true);paintFs();
  }
}
