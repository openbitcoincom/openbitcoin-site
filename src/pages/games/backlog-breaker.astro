function computeCuts(){
  var total=0,i;
  for(i=0;i<feed.vsizes.length;i++)total+=feed.vsizes[i];
  if(!(total>0))return;
  var cuts=[],qi=1,acc=0;
  for(i=0;i<feed.edges.length&&qi<=5;i++){
    acc+=feed.vsizes[i];
    while(qi<=5&&acc>=total*qi/6){
      var lo=feed.edges[i],hi=(i+1<feed.edges.length)?feed.edges[i+1]:Math.max(lo+1,lo*3);
      cuts.push(Math.max(1,Math.round((lo+hi)/2)));
      qi++;
    }
  }
  while(cuts.length<5)cuts.push((cuts.length?cuts[cuts.length-1]:40)*2);
  for(i=1;i<5;i++)if(cuts[i]<=cuts[i-1])cuts[i]=cuts[i-1]+1;
  tierCuts=cuts;
}
function fetchFeed(){
  return fetch(apiBase()+"/mempool").then(function(r){if(!r.ok)throw 0;return r.json();}).then(function(j){
    var got=false;
    if(j&&j.bands&&Array.isArray(j.bands.edges)&&Array.isArray(j.bands.vsizes)&&
       j.bands.edges.length===j.bands.vsizes.length&&j.bands.edges.length>3&&
       j.bands.vsizes.every(function(v){return typeof v==="number"&&isFinite(v)&&v>=0;})&&
       j.bands.vsizes.some(function(v){return v>0;})){
      feed={edges:j.bands.edges,vsizes:j.bands.vsizes,live:true,
            count:(j.count|0),mb:Math.round((j.vsize||0)/1e6)};
      got=true;
    }else if(j&&Array.isArray(j.histogram)&&j.histogram.length){
      var e=[],v=[];
      j.histogram.slice().reverse().forEach(function(row){
        if(Array.isArray(row)&&isFinite(row[0])&&isFinite(row[1])&&row[1]>0){e.push(Math.max(1,row[0]));v.push(row[1]);}
      });
      if(e.length>3){feed={edges:e,vsizes:v,live:true,count:(j.count|0),mb:Math.round((j.vsize||0)/1e6)};got=true;}
    }
    /* a 200 with unusable bands is still not a live feed: never claim it is */
    if(!got)feed.live=false;
    computeCuts();
    /* nothing at stake on the attract wall: re-deal it so the demo shows
       real prices and the chip can honestly say so */
    if(state==="idle"&&got){dealWall();paintHud();}
    paintChip();
  }).catch(function(){feed.live=false;paintChip();});
}
function sampleRate(){
  var total=0,i;
  for(i=0;i<feed.vsizes.length;i++)total+=feed.vsizes[i];
  var x=Math.random()*total;
  for(i=0;i<feed.vsizes.length;i++){x-=feed.vsizes[i];if(x<=0)break;}
  if(i>=feed.edges.length)i=feed.edges.length-1;
  var lo=feed.edges[i],hi=(i+1<feed.edges.length)?feed.edges[i+1]:Math.max(lo+1,lo*3);
  return Math.max(1,Math.round(lo+Math.random()*(hi-lo)));
}
