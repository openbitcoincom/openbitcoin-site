function sLost(){tone(500,0.5,"sawtooth",0.1,0,90);}
function sBlock(){var seq=[523,659,784,1047,1319],i;
  for(i=0;i<seq.length;i++){tone(seq[i],0.18,"triangle",0.13,i*0.09);tone(seq[i]*2,0.16,"sine",0.05,i*0.09);}}
function sRetarget(){tone(392,0.14,"triangle",0.1);tone(494,0.14,"triangle",0.1,0.11);tone(622,0.2,"triangle",0.11,0.22);}
function sTrophy(){tone(1319,0.1,"triangle",0.08);tone(1760,0.12,"triangle",0.06,0.06);}
function sOver(){var seq=[392,330,262,196],i;for(i=0;i<seq.length;i++)tone(seq[i],0.2,"triangle",0.1,i*0.12);}
/* ---------------- ambient music: generative, ported from Block Builder so
   the cabinets hum the same tune. No audio assets, never repeats. */
var musicOn=readInt("ob-bkb-music",1)===1;
var mus={on:false,next:0,timer:null,gain:null,chord:0};
var MUS_SCALE=[220,261.63,293.66,329.63,392,440,523.25,587.33];
var MUS_CHORDS=[[110,164.81,220],[87.31,130.81,174.61],[98,146.83,196],[73.42,110,146.83]];
function musNote(freq,t,dur,vol,type){
  var o=actx.createOscillator(),g2=actx.createGain();
  o.type=type||"triangle";o.frequency.setValueAtTime(freq,t);
  g2.gain.setValueAtTime(0,t);
  g2.gain.linearRampToValueAtTime(vol,t+dur*0.4);
  g2.gain.exponentialRampToValueAtTime(0.0001,t+dur);
  o.connect(g2);g2.connect(mus.gain);
  o.start(t);o.stop(t+dur+0.1);
}
function musBar(){
  var a=ac();if(!a||!mus.on)return;
  var bar=3.2,t=Math.max(a.currentTime+0.05,mus.next);
  mus.next=t+bar;
  var chd=MUS_CHORDS[mus.chord%MUS_CHORDS.length];
  mus.chord+=(Math.random()<0.2)?2:1;
  for(var i=0;i<chd.length;i++)musNote(chd[i]*2,t,bar*1.15,0.014,"triangle");
  musNote(chd[0],t,bar*1.1,0.02,"sine");
  for(var k=0;k<8;k++){
    if(Math.random()<0.62)continue;
    var f2=MUS_SCALE[(Math.random()*MUS_SCALE.length)|0];
    musNote(f2*(Math.random()<0.15?2:1),t+k*bar/8,0.9,0.011+Math.random()*0.008,"sine");
  }
  mus.timer=setTimeout(musBar,Math.max(200,(mus.next-a.currentTime-0.25)*1000));
}
function startMusic(){
  if(!musicOn||muted||mus.on)return;
  var a=ac();if(!a)return;
  if(!mus.gain){mus.gain=a.createGain();mus.gain.gain.value=0.5;mus.gain.connect(a.destination);}
  mus.gain.gain.cancelScheduledValues(a.currentTime);
  mus.gain.gain.setValueAtTime(0.0001,a.currentTime);
  mus.gain.gain.linearRampToValueAtTime(0.5,a.currentTime+0.6);
  mus.on=true;mus.next=0;
  musBar();
}
function stopMusic(){
  mus.on=false;
  if(mus.timer){clearTimeout(mus.timer);mus.timer=null;}
  if(mus.gain&&actx){
    mus.gain.gain.cancelScheduledValues(actx.currentTime);
    mus.gain.gain.setValueAtTime(mus.gain.gain.value,actx.currentTime);
    mus.gain.gain.linearRampToValueAtTime(0.0001,actx.currentTime+0.3);
  }
}
function paintMusicBtn(){
  var btn=el("bk-music");
  hideIc(el("bk-music-on"),!musicOn);hideIc(el("bk-music-off"),musicOn);
  if(btn)btn.setAttribute("aria-pressed",musicOn?"true":"false");
}
function toggleMusic(){
  musicOn=!musicOn;store("ob-bkb-music",musicOn?"1":"0");
  paintMusicBtn();
  if(musicOn&&(state==="run"||state==="serve"||state==="found"||state==="dead"))startMusic();
  else stopMusic();
  say(musicOn?(muted?"Music on, once the mute lifts.":"Music on."):"Music off. The backlog hums to itself anyway.",null,900);
}
function paintMute(){
  var btn=el("bk-mute");
  hideIc(el("bk-mute-on"),muted);hideIc(el("bk-mute-off"),!muted);
  /* the ring means "audible", matching the music toggle */
  if(btn)btn.setAttribute("aria-pressed",muted?"false":"true");
}
el("bk-mute").addEventListener("click",function(e){
  if(e.detail>0)this.blur();
  muted=!muted;store("ob-bkb-mute",muted?"1":"0");paintMute();
  if(muted)stopMusic();
  else{tone(880,0.08,"sine",0.08);if(state==="run"||state==="serve"||state==="found"||state==="dead")startMusic();}
});
paintMute();
el("bk-music").addEventListener("click",function(e){
  if(e.detail>0)this.blur();
  toggleMusic();
});
paintMusicBtn();
var optTab=el("bk-opttab"),optRow=el("bk-topbtns"),optOpen=false;
function setOpts(open){
  optOpen=open;
  if(optRow)optRow.hidden=!open;
  if(optTab)optTab.setAttribute("aria-expanded",open?"true":"false");
}
if(optTab)optTab.addEventListener("click",function(e){if(e.detail>0)this.blur();setOpts(!optOpen);});

/* ---------------- game state ---------------- */
var state="idle",wl=null,balls=[],drops=[],parts=[],flashes=[],
    paddleX=0,paddleTarget=0,
    score=0,rigs=3,feesRun=0,feesBlk=0,level=1,blocksTotal=0,nextHeight=null,
    hitRamp=0,flight=0,lastBreakAt=0,wallStartAt=0,diedThisWall=false,fudThisWall=false,
    widenUntil=0,shrinkUntil=0,slowUntil=0,pierceUntil=0,holdUntil=0,spikeUntil=0,
    stateUntil=0,pendingRetarget=false,
    raf=null,lastT=0,paused=false,pausedAt=0,pausedFrom="run",
    keysDown={};

function epoch(){return Math.floor(blocksTotal/RETARGET_EVERY)+1;}
function diffPct(){
  /* quoted percent tracks the CAPPED multiplier: the HUD never claims speed
     the code stopped delivering */
  return ((Math.min(1.6,Math.pow(DIFF_STEP,epoch()-1))-1)*100).toFixed(1);
}
function speedNow(now){
  var s=cell*8.2*Math.min(1.6,Math.pow(DIFF_STEP,epoch()-1))*Math.min(1.45,Math.pow(1.015,hitRamp));
  if(slowUntil>now)s*=0.72;
  return s;
}
function paddleW(now){
  /* once the ball speed caps (epoch 9), difficulty keeps a lever: the rig
     narrows 3% per further epoch, floored at three quarters width */
  var w=cell*2.6*Math.max(0.75,1-0.03*Math.max(0,epoch()-9));
  if(widenUntil>now)w*=1.5;
  if(shrinkUntil>now)w*=0.65;
  return w;
}
function paddleY(){return H-cell*1.1;}

/* ---------------- the wall ---------------- */
function dealWall(){
  var spec=WALLS[(level-1)%WALLS.length];
  var wallCycle=Math.floor((level-1)/WALLS.length);
  var wcols=spec.cols||COLS;
  wl={name:spec.name,line:spec.line,rows:spec.rows.length,bricks:[],left:0,dealt:0,
      whalesTotal:0,whalesBroken:0,cols:wcols,bhf:spec.bhf||0.5,
      live:feed.live,count:feed.count,mb:feed.mb}; /* latch provenance */
  for(var r=0;r<spec.rows.length;r++){
    var line=[];
    for(var c=0;c<wcols;c++){
      var ch=spec.rows[r].charAt(c);
      if(ch==="."){line.push(null);continue;}
      /* the ladder: armor arrives at level 3, whales at level 5, and every
         full cycle through the walls hardens what the pattern dealt */
      if(ch==="W"&&level<5)ch="2";
      if(ch==="2"&&level<3)ch="x";
      if(ch==="x"&&wallCycle>0&&Math.random()<Math.min(0.5,0.15*wallCycle))ch="2";
      else if(ch==="2"&&wallCycle>1&&Math.random()<Math.min(0.2,0.06*wallCycle))ch="W";
      var b;
      if(ch==="W"){
        var wr=topRate();
        b={hp:3,max:3,rate:wr,val:wr*WHALE_VB,whale:true};
        wl.whalesTotal++;
      }else if(ch==="2"){
        var r2=sampleRate();
        b={hp:2,max:2,rate:r2,val:r2*DOUBLE_VB,whale:false};
      }else{
        var r1=sampleRate();
        b={hp:1,max:1,rate:r1,val:r1*COIN_VB,whale:false};
      }
      line.push(b);
      wl.left++;wl.dealt+=b.val;
    }
    wl.bricks.push(line);
  }
}

/* ---------------- runs, walls, serves ---------------- */
function fetchHeight(){
  fetch(apiBase()+"/height").then(function(r){if(!r.ok)throw 0;return r.json();}).then(function(j){
    if(j&&typeof j.height==="number"&&isFinite(j.height)&&j.height>0){
      nextHeight=Math.floor(j.height)+1;
      paintOvHeight();paintHud();
    }
  }).catch(function(){});
}
function startRun(){
  score=0;rigs=3;feesRun=0;level=1;blocksTotal=0;pendingRetarget=false;
  overlay.hidden=true;
  if(cv.parentNode&&cv.parentNode.classList)cv.parentNode.classList.remove("bk-deadframe");
  startMusic();
  fetchFeed();
  fetchHeight(); /* re-sync so the shown height never drifts across runs */
  startWall();
}
function startWall(){
  dealWall();
  feesBlk=0;diedThisWall=false;fudThisWall=false;hitRamp=0;flight=0;lastBreakAt=performance.now();wallStartAt=lastBreakAt;
  drops=[];parts=[];flashes=[];
  clearEffects();
  serve();
  /* floor-arrival trophies first: the wall line below must land last */
  if(epoch()>=5)trophy("epoch5");
  if(epoch()>=10)trophy("epoch10");
  var h=nextHeight?("#"+fmt(nextHeight)):"next";
  var lap=Math.floor((level-1)/WALLS.length)+1;
  if(lap>1&&(level-1)%WALLS.length===0){
    /* the wrap. Every lap boundary is also a retarget (15 walls, retarget
       every 3), so this line owns the slot and carries the speed news */
    pendingRetarget=false;
    sRetarget();
    say("LAP "+lap+": the backlog rebuilt itself, and it learned from last time. Same fifteen shapes, meaner bricks, ball "+diffPct()+"% faster than block one.","bk-good",4000);
  }else if(pendingRetarget){
    pendingRetarget=false;
    sRetarget();
    if(epoch()>=10)say("DIFFICULTY ADJUSTMENT: the ball tops out at +60%, so the wall leans on the rig instead. It narrows from here.","bk-good",3500);
    else say("DIFFICULTY ADJUSTMENT: the ball is "+diffPct()+"% faster than block one. The chain noticed you.","bk-good",3500);
  }else{
    say("Block "+h+", level "+level+": "+wl.name+". "+wl.line,null,700);
  }
  paintHud();
}
function nextWall(){
  level++;
  if(level>WALLS.length)trophy("lap1"); /* all fifteen shapes cleared this run */
  if(nextHeight)nextHeight++;
  if(blocksTotal%RETARGET_EVERY===0)pendingRetarget=true;
  fetchFeed(); /* ripens for the NEXT deal: the chip describes each wall's own deal */
  startWall();
}
function serve(){
  if(cv.parentNode&&cv.parentNode.classList)cv.parentNode.classList.remove("bk-deadframe");
  startMusic(); /* idempotent: heals the hidden-tab stop during dead/found */
  balls=[{x:paddleX,y:paddleY()-cell*0.2,dx:0,dy:-1,stuck:true,stickDx:0,stickAt:performance.now()}];
  state="serve";
}
function launch(){
  if(state==="serve")state="run";
  var now=performance.now(),released=0;
  balls.forEach(function(b){
    if(!b.stuck)return;
    b.stuck=false;released++;
    var ang=(Math.random()*0.5-0.25)+(b.stickDx/Math.max(1,paddleW(now)))*0.9;
    b.dx=Math.sin(ang);b.dy=-Math.cos(ang);
  });
  if(released)sLaunch(); /* a no-op press stays silent */
}
function clearEffects(){
  widenUntil=0;shrinkUntil=0;slowUntil=0;pierceUntil=0;holdUntil=0;spikeUntil=0;
}
function gameOver(){
  state="over";
  stopMusic();
  led.g++;
  if(score>led.best)led.best=score;
  led.blk+=blocksTotal;
  if(level>led.lv)led.lv=level;
  if(epoch()>led.ep)led.ep=epoch();
  led.fees+=feesRun;
  saveLed();paintLedger();
  sOver();
  var line=blocksTotal===0?
    "No blocks found. The backlog does not clear itself, but it did outlast you.":
    (blocksTotal<3?
     blocksTotal+" block"+(blocksTotal===1?"":"s")+" found. The wall always gets another row somewhere.":
     blocksTotal+" blocks found and difficulty epoch "+epoch()+" reached. The chain would have retargeted around you eventually.");
  ovTitle.textContent="OUT OF BITCOINS";
  ovText.innerHTML="<b>"+fmtScore(score)+"</b> · "+blocksTotal+" block"+(blocksTotal===1?"":"s")+" found · level "+level+" · epoch "+epoch()+".<br><br>"+line;
  ovBtn.textContent="Break again";
  overlay.hidden=false;
  say("Run over: "+fmtScore(score)+", "+blocksTotal+" blocks found, level "+level+". "+line,null,5000);
}

/* ---------------- scoring ---------------- */
function checkCoiner(){
  if(led.fees+feesRun>=1e8)trophy("coiner");
  if(feesBlk>=1e8)trophy("feeblock");
  if(score>=21e8)trophy("cap21");
}
function breakBrick(r,c,now,src){
  var b=wl.bricks[r][c];
  if(!b)return;
  b.hp--;
  if(b.hp>0){sClink();return;}
  wl.bricks[r][c]=null;
  wl.left--;lastBreakAt=now;
  /* flights belong to the ball that flew them: a shared counter would let
     any paddle touch during multiball kill every chain */
  var f=src?(src.flight=(src.flight||0)+1):++flight;
  var mult=(f>=4?2:1)*(spikeUntil>now?1.5:1);
  var sats=Math.round(b.val*mult);
  score+=sats;feesRun+=sats;feesBlk+=sats;
  if(b.whale){
    wl.whalesBroken++;led.wh++;
    if(led.wh>=25)trophy("whale25");
    sClink();sPop(0);
    say("Whale broken: +"+fmt(sats)+" sats"+(sats===b.val?"":" with multipliers")+", a "+fmt(b.rate)+" sat/vB scoop of "+fmt(WHALE_VB)+" vb.","bk-good",1600);
    spawnDrop(r,c,true);
  }else{
    sPop(tierIdx(b.rate));
    spawnDrop(r,c,false);
  }
  if(f===4)say("Chain of four: fees doubled while the flight lasts.","bk-good",1500);
  if(f>=8)trophy("flight8");
  if(!reduce){
    var ti=TIERS[tierIdx(b.rate)];
    for(var k=0;k<6;k++)parts.push({
      x:c*brickW()+brickW()/2,y:topOff()+r*brickH()+brickH()/2,
      vx:(Math.random()-.5)*180,vy:-(30+Math.random()*140),
      r:1.5+Math.random()*2.5,color:ti.bg,life:0.8});
  }
  checkCoiner();
  paintHud();
  if(wl.left<=0)wallFound(now);
}
function wallFound(now){
  state="found";stateUntil=performance.now()+(reduce?500:1500);
  blocksTotal++;
  clearEffects();
  var h=nextHeight?("#"+fmt(nextHeight)):"";
  /* plaques first: the block line below must land last and stick */
  trophy("first");
  var wname=WALLS[(level-1)%WALLS.length].name;
  if(wname==="The big B")trophy("bigb");
  if(wname==="The vault")trophy("vault");
  if(!diedThisWall)trophy("cleanpass");
  if(fudThisWall)trophy("fudproof");
  if(wl.whalesTotal>=2&&wl.whalesBroken>=wl.whalesTotal)trophy("whales");
  if(led.blk+blocksTotal>=21)trophy("b21");
  if(rigs===1)trophy("lastcoin");
  /* the warmup shapes are too small to count as a fast clear */
  if(wl.cols===COLS&&now-wallStartAt<30000)trophy("fast30");
  score+=SUBSIDY;
  checkCoiner(); /* the subsidy can tip the 21 BTC cap */
  sBlock();
  if(!reduce)for(var k=0;k<50;k++)parts.push({
    x:Math.random()*W,y:Math.random()*H*0.5,
    vx:(Math.random()-.5)*220,vy:-(80+Math.random()*220),
    r:2+Math.random()*3,color:TIERS[(Math.random()*TIERS.length)|0].bg,life:1.2});
  say("BLOCK "+h+" FOUND: wall cleared. The "+fmtBtc(SUBSIDY)+" subsidy is scored, exactly what a real miner collects today, plus "+fmt(feesBlk)+" sats of fees.","bk-good",3000);
  paintHud();
}

/* ---------------- drops ---------------- */
/* drops arrive gradually: the first walls deal only the simple boons, the
   trickier ones and the FUD wait until the player has their feet */
function dropUnlocked(k){
  if(level<=2)return k==="WIDE"||k==="SLOW"||k==="+COIN";
  if(level<=4)return k!=="RBF"&&k!=="SPIKE"&&k!=="FUD";
  return true;
}
function pickDrop(){
  var pool=DROPS.filter(function(dd){return dropUnlocked(dd.k);});
  var tot=0,i;
  for(i=0;i<pool.length;i++)tot+=pool[i].w;
  var x=Math.random()*tot;
  for(i=0;i<pool.length;i++){x-=pool[i].w;if(x<=0)return pool[i];}
  return pool[0];
}
function spawnDrop(r,c,always){
  if(!always&&Math.random()>=0.06)return;
  drops.push({x:c*brickW()+brickW()/2,y:topOff()+r*brickH()+brickH()/2,spec:pickDrop()});
}
var DROP_BLURBS={BATCH:"THE HASH SPLITS",WIDE:"PADDLE GROWS",SLOW:"TRAFFIC CALMS",
  HOLD:"CATCH AND AIM",RBF:"PIERCES THE WALL",SPIKE:"FEES ×1.5","+COIN":"SPARE BITCOIN",FUD:"RIG SHRINKS"};
function applyDrop(spec,now){
  led.dr++;
  if(led.dr>=50)trophy("drops50");
  /* every catch says its name where the player is looking */
  flashes.push({text:spec.k+" · "+(DROP_BLURBS[spec.k]||""),color:spec.good?"#FFD9A0":"#E0503C",t0:now});
  if(spec.k==="FUD"){
    fudThisWall=true;
    shrinkUntil=now+9000;
    sBad();
    say("FUD caught. The rig shrinks while the doubt lasts. Should have dodged that one.","bk-bad",1800);
    return;
  }
  sCatch();
  if(spec.k==="BATCH"){
    var live0=balls.filter(function(b){return !b.stuck;});
    var src=live0[0]||balls[0];
    if(src){
      var added=0;
      for(var i=0;i<2&&balls.length<MAX_BALLS;i++){
        var ang=(i===0?-0.45:0.45);
        var ndx=src.dx*Math.cos(ang)-src.dy*Math.sin(ang),
            ndy=src.dx*Math.sin(ang)+src.dy*Math.cos(ang);
        if(src.stuck){ndx=Math.sin(ang);ndy=-Math.cos(ang);}
        balls.push({x:src.x,y:src.y,dx:ndx,dy:ndy,stuck:false,stickDx:0,stickAt:0});
        added++;
      }
      if(added){
        sSplit();
        if(balls.length>=5)trophy("multi5");
        say("BATCH: one hash becomes "+(added+1)+". The wall disagrees with this development.","bk-good",1500);
      }else{
        say("BATCH caught, but five hashes is all the rack can run.","bk-good",1200);
      }
    }
  }else if(spec.k==="WIDE"){
    widenUntil=now+12000;
    say("Rig upgrade: wider paddle while it lasts.","bk-good",1200);
  }else if(spec.k==="SLOW"){
    slowUntil=now+9000;
    say("Traffic calms: the ball eases off for a while.","bk-good",1200);
  }else if(spec.k==="HOLD"){
    holdUntil=now+10000;
    say("Cold storage: the ball will stick to the rig. Aim your shot.","bk-good",1500);
  }else if(spec.k==="RBF"){
    pierceUntil=now+7000;
    say("RBF: the ball shoves straight through the queue for a while.","bk-good",1500);
  }else if(spec.k==="SPIKE"){
    spikeUntil=now+9000;
    say("FEE SPIKE: every brick is worth half again more, briefly. Break fast.","bk-good",1800);
  }else if(spec.k==="+COIN"){
    if(rigs<5){rigs++;if(rigs===5)trophy("rack5");paintHud();say("A spare bitcoin joins the rack. Bitcoins: "+rigs+".","bk-good",1500);}
    else say("A spare bitcoin arrives, but the rack is full.","bk-good",1200);
  }
}

/* ---------------- geometry ---------------- */
var cell=36,W=0,H=0;
function topOff(){return cell*0.9;}
function brickH(){return cell*(wl&&wl.bhf?wl.bhf:0.5);}
function brickW(){return wl&&wl.cols?W/wl.cols:cell;}
function sizeBoard(){
  var avail=rig.clientWidth-40-16;
  var old=cell;
  /* the playfield fills its frame to the pixel: cell is fractional on
     purpose, physics and drawing are float-safe */
  cell=Math.max(22,avail/COLS);
  var maxH=(window.innerHeight-240)/12;
  if(maxH>=18)cell=Math.min(cell,maxH);
  W=avail;H=cell*12;
  var dpr=window.devicePixelRatio||1;
  cv.width=W*dpr;cv.height=H*dpr;
  cv.style.width=W+"px";cv.style.height=H+"px";
  ctx.setTransform(dpr,0,0,dpr,0,0);
  if(old>0&&old!==cell){
    var k=cell/old;
    paddleX*=k;paddleTarget*=k;
    balls.forEach(function(b){b.x*=k;b.y*=k;b.stickDx*=k;});
    drops.forEach(function(d){d.x*=k;d.y*=k;});
  }
  paddleX=Math.max(0,Math.min(W,paddleX));
  paddleTarget=Math.max(0,Math.min(W,paddleTarget));
  draw(performance.now());
}

/* ---------------- physics ---------------- */
function ballR(){return cell*0.21;}
function loseBall(i){
  balls.splice(i,1);
  if(balls.length===0){
    state="dead";stateUntil=performance.now()+(reduce?400:1000);
    if(cv.parentNode&&cv.parentNode.classList)cv.parentNode.classList.add("bk-deadframe");
    diedThisWall=true;
    hitRamp=0; /* the mercy rule: a fresh serve never resumes at the speed that killed you */
    rigs--;
    sLost();
    clearEffects();
    drops=[];
    paintHud();
    if(rigs>0)say("A bitcoin slipped past the rig. Bitcoins left: "+rigs+".","bk-bad",2000);
    else say("The last bitcoin slipped away.","bk-bad",2000);
  }
}
function stepBalls(dt,now){
  var r=ballR(),spd=speedNow(now),pw=paddleW(now),py=paddleY();
  for(var i=balls.length-1;i>=0;i--){
    var b=balls[i];
    if(b.stuck){
      b.x=paddleX+b.stickDx;b.y=py-r-1;
      /* held balls relaunch themselves before the stall gets boring */
      if(now-b.stickAt>2500&&state==="run")launch();
      continue;
    }
    var total=spd*dt,stepMax=Math.max(2,r),n=Math.ceil(total/stepMax),step=total/n;
    for(var s=0;s<n;s++){
      b.x+=b.dx*step;b.y+=b.dy*step;
      /* side + top walls */
      if(b.x<r){b.x=r;b.dx=Math.abs(b.dx);sWallB();}
      else if(b.x>W-r){b.x=W-r;b.dx=-Math.abs(b.dx);sWallB();}
      if(b.y<r){b.y=r;b.dy=Math.abs(b.dy);sWallB();}
      /* paddle */
      if(b.dy>0&&b.y+r>=py&&b.y+r<=py+cell*0.6&&Math.abs(b.x-paddleX)<=pw/2+r){
        if(holdUntil>now){
          b.stuck=true;b.stickDx=Math.max(-pw/2,Math.min(pw/2,b.x-paddleX));b.stickAt=now;
          b.flight=0;flight=0;sPaddle();
          break; /* the caught ball is done integrating this frame */
        }
        var rel=Math.max(-1,Math.min(1,(b.x-paddleX)/(pw/2)));
        var ang=rel*1.05; /* up to ~60 degrees off vertical */
        b.dx=Math.sin(ang);b.dy=-Math.cos(ang);
        b.y=py-r;
        hitRamp++;b.flight=0;flight=0;
        sPaddle();
        continue;
      }
      /* the wall of bricks */
      if(b.y-r<topOff()+wl.rows*brickH()&&b.y+r>topOff()){
        var hit=collideBricks(b,r,now);
        if(hit&&state!=="run")return; /* wallFound mid-flight ends the frame */
        if(hit&&pierceUntil<=now)continue;
      }
      /* the floor */
      if(b.y>H+r*2){loseBall(i);break;}
    }
    /* never let a ball grind fully horizontal */
    if(!b.stuck&&Math.abs(b.dy)<0.18){
      b.dy=(b.dy<0?-0.18:0.18);
      var norm=Math.sqrt(b.dx*b.dx+b.dy*b.dy);
      b.dx/=norm;b.dy/=norm;
    }
    if(state!=="run")return;
  }
}
function collideBricks(b,r,now){
  var bh=brickH(),bw=brickW(),to=topOff();
  var c0=Math.max(0,Math.floor((b.x-r)/bw)),c1=Math.min(wl.cols-1,Math.floor((b.x+r)/bw)),
      r0=Math.max(0,Math.floor((b.y-r-to)/bh)),r1=Math.min(wl.rows-1,Math.floor((b.y+r-to)/bh));
  for(var rr=r0;rr<=r1;rr++)for(var cc=c0;cc<=c1;cc++){
    var brick=wl.bricks[rr]&&wl.bricks[rr][cc];
    if(!brick)continue;
    var bx=cc*bw+bw/2,by=to+rr*bh+bh/2,
        hw=bw/2-1,hh=bh/2-1;
    var dx=b.x-bx,dy=b.y-by;
    if(Math.abs(dx)>hw+r||Math.abs(dy)>hh+r)continue;
    if(pierceUntil<=now){
      /* reflect off the axis with the shallower overlap, and push the ball
         flush so the next sub-step cannot double-hit the same brick */
      var penX=hw+r-Math.abs(dx),penY=hh+r-Math.abs(dy);
      if(penX<penY){
        b.dx=dx<0?-Math.abs(b.dx):Math.abs(b.dx);
        b.x=bx+(dx<0?-1:1)*(hw+r+0.5);
      }else{
        b.dy=dy<0?-Math.abs(b.dy):Math.abs(b.dy);
        b.y=by+(dy<0?-1:1)*(hh+r+0.5);
      }
    }
    breakBrick(rr,cc,now,b);
    return true;
  }
  return false;
}
function stepDrops(dt,now){
  var py=paddleY(),pw=paddleW(now);
  for(var i=drops.length-1;i>=0;i--){
    var d=drops[i];
    d.y+=cell*3.2*dt;
    if(d.y>H+20){drops.splice(i,1);continue;}
    if(d.y>=py-6&&d.y<=py+cell*0.6&&Math.abs(d.x-paddleX)<=pw/2+cell*0.35){
      drops.splice(i,1);
      applyDrop(d.spec,now);
      paintHud();
    }
  }
}

/* ---------------- main loop ---------------- */
function loop(t){
  raf=requestAnimationFrame(loop);
  var dt=Math.min(50,t-lastT)/1000;lastT=t;
  var now=t;
  if(state==="pause"){draw(pausedAt);return;}
  /* keyboard steering applies in every live state */
  if(state==="run"||state==="serve"||state==="found"||state==="idle"){
    var kv=(keysDown.left?-1:0)+(keysDown.right?1:0);
    if(kv)paddleTarget=Math.max(0,Math.min(W,paddleTarget+kv*cell*11*dt));
  }
  if(state==="idle"){
    /* attract: an endless demo rally behind the overlay, nothing scored */
    if(!balls.length||balls[0].stuck)balls=[{x:W/2,y:H*0.6,dx:0.5,dy:-0.86,stuck:false,stickDx:0,stickAt:0}];
    var b0=balls[0],sp=cell*5.5*dt;
    b0.x+=b0.dx*sp;b0.y+=b0.dy*sp;
    var r0=ballR();
    if(b0.x<r0){b0.x=r0;b0.dx=Math.abs(b0.dx);}
    if(b0.x>W-r0){b0.x=W-r0;b0.dx=-Math.abs(b0.dx);}
    if(b0.y<topOff()+wl.rows*brickH()+r0){b0.y=topOff()+wl.rows*brickH()+r0;b0.dy=Math.abs(b0.dy);}
    if(b0.y>paddleY()-r0){b0.y=paddleY()-r0;b0.dy=-Math.abs(b0.dy);}
    paddleTarget=b0.x;
    paddleX+=(paddleTarget-paddleX)*Math.min(1,dt*8);
    draw(t);return;
  }
  paddleX+=(paddleTarget-paddleX)*Math.min(1,dt*18);
  if(state==="dead"){
    if(now>=stateUntil){
      if(rigs<=0)gameOver();
      else serve();
    }
    draw(t);return;
  }
  if(state==="found"){
    stepDrops(dt,now); /* a whale broken last still drops something catchable */
    if(now>=stateUntil)nextWall();
    draw(t);return;
  }
  if(state==="serve"){
    stepBalls(dt,now);
    draw(t);return;
  }
  if(state!=="run"){draw(t);return;}
  /* last-brick mercy: when a handful of stragglers dodge the ball for 18
     seconds, the bench sends in an RBF drop rather than let the hunt drag */
  if(wl.left>0&&wl.left<=4&&now-lastBreakAt>18000){
    lastBreakAt=now;
    drops.push({x:W/2,y:topOff()+wl.rows*brickH()+10,spec:DROPS[4]});
    say("The stragglers dug in. An RBF drop comes off the bench.",null,1500);
  }
  stepBalls(dt,now);
  if(state==="run")stepDrops(dt,now);
  draw(t);
}

/* ---------------- painting ---------------- */
function rr2(x,y,w,h,rad){
  if(w<2*rad)rad=w/2;if(h<2*rad)rad=h/2;
  ctx.beginPath();
  ctx.moveTo(x+rad,y);
  ctx.arcTo(x+w,y,x+w,y+h,rad);ctx.arcTo(x+w,y+h,x,y+h,rad);
  ctx.arcTo(x,y+h,x,y,rad);ctx.arcTo(x,y,x+w,y,rad);
  ctx.closePath();
}
function draw(t){
  if(!wl)return;
  var now=t;
  ctx.fillStyle="#0B0908";ctx.fillRect(0,0,W,H);
  var bh=brickH(),bw=brickW(),to=topOff();
  /* bricks */
  for(var r=0;r<wl.rows;r++)for(var c=0;c<wl.cols;c++){
    var b=wl.bricks[r][c];
    if(!b)continue;
    var x=c*bw+1.5,y=to+r*bh+1.5,w=bw-3,h=bh-3;
    if(b.whale){
      ctx.shadowColor="rgba(255,233,184,.7)";ctx.shadowBlur=8;
      ctx.fillStyle="#FFE9B8";
      rr2(x,y,w,h,4);ctx.fill();
      ctx.shadowBlur=0;
      if(bw>=26){
        ctx.fillStyle="#3A2600";
        ctx.font="700 "+Math.floor(bh*0.62)+"px Cascadia Mono,Consolas,monospace";
        ctx.textAlign="center";ctx.textBaseline="middle";
        ctx.fillText("₿",x+w/2,y+h/2+0.5);
        ctx.textAlign="left";ctx.textBaseline="alphabetic";
      }
    }else{
      var ti=TIERS[tierIdx(b.rate)];
      ctx.fillStyle=ti.bg;
      rr2(x,y,w,h,3);ctx.fill();
      if(b.max===2){
        ctx.strokeStyle="rgba(0,0,0,.4)";ctx.lineWidth=1.6;
        rr2(x+1.5,y+1.5,w-3,h-3,2);ctx.stroke();
      }
    }
    /* straggler beacon: the last few bricks glow so the hunt has a target */
    if(wl.left<=4&&(state==="run"||state==="serve")){
      var bg=reduce?0.5:(0.35+0.3*Math.sin(t/200));
      ctx.strokeStyle="rgba(255,217,160,"+bg.toFixed(2)+")";
      ctx.lineWidth=2;
      rr2(x-1,y-1,w+2,h+2,4);ctx.stroke();
    }
    /* damage cracks */
    if(b.hp<b.max){
      ctx.strokeStyle="rgba(0,0,0,.55)";ctx.lineWidth=1;
      ctx.beginPath();
      ctx.moveTo(x+w*0.25,y+1);ctx.lineTo(x+w*0.45,y+h*0.55);ctx.lineTo(x+w*0.3,y+h-1);
      if(b.hp<b.max-1){ctx.moveTo(x+w*0.7,y+1);ctx.lineTo(x+w*0.6,y+h*0.5);ctx.lineTo(x+w*0.78,y+h-1);}
      ctx.stroke();
    }
  }
  /* drops */
  drops.forEach(function(d){
    var dw=Math.max(32,cell*0.95),dh=Math.max(14,cell*0.38);
    /* FUD is the one SOLID chip; boons are outlined. A shape cue, so the
       tell survives color blindness and 7px labels */
    if(d.spec.good){
      ctx.fillStyle="#14100B";
      rr2(d.x-dw/2,d.y-dh/2,dw,dh,4);ctx.fill();
      ctx.strokeStyle=d.spec.color;ctx.lineWidth=1.5;
      rr2(d.x-dw/2+0.75,d.y-dh/2+0.75,dw-1.5,dh-1.5,4);ctx.stroke();
      ctx.fillStyle=d.spec.color;
    }else{
      ctx.fillStyle=d.spec.color;
      rr2(d.x-dw/2,d.y-dh/2,dw,dh,4);ctx.fill();
      ctx.fillStyle="#14100B";
    }
    ctx.font="700 "+Math.max(8,Math.floor(dh*0.58))+"px Cascadia Mono,Consolas,monospace";
    ctx.textAlign="center";ctx.textBaseline="middle";
    ctx.fillText(d.spec.k,d.x,d.y+0.5);
    ctx.textAlign="left";ctx.textBaseline="alphabetic";
  });
  /* particles */
  if(!reduce){
    for(var i=parts.length-1;i>=0;i--){
      var p=parts[i];
      p.life-=0.016;
      if(p.life<=0){parts.splice(i,1);continue;}
      p.x+=p.vx*0.016;p.y+=p.vy*0.016;p.vy+=340*0.016;
      ctx.globalAlpha=Math.max(0,p.life);
      ctx.fillStyle=p.color;
      ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,7);ctx.fill();
      ctx.globalAlpha=1;
    }
  }else parts=[];
  /* the rig (paddle) */
  var pw=paddleW(now),py=paddleY();
  var shrunk=shrinkUntil>now,wide=widenUntil>now;
  ctx.shadowColor="rgba(247,147,26,.6)";ctx.shadowBlur=8;
  ctx.fillStyle=shrunk?"#C46A00":"#F7931A";
  rr2(paddleX-pw/2,py,pw,cell*0.42,cell*0.21);ctx.fill();
  ctx.shadowBlur=0;
  ctx.strokeStyle=wide?"#FFE9B8":"#FFD9A0";ctx.lineWidth=1.4;
  rr2(paddleX-pw/2+0.7,py+0.7,pw-1.4,cell*0.42-1.4,cell*0.21);ctx.stroke();
  if(holdUntil>now){
    ctx.fillStyle="#5E81B5";
    ctx.fillRect(paddleX-pw/2+3,py+cell*0.42-3,pw-6,2);
  }
  /* balls */
  var brd=ballR();
  balls.forEach(function(b){
    var pierce=pierceUntil>now;
    ctx.shadowColor=pierce?"rgba(255,212,59,.9)":"rgba(247,147,26,.8)";ctx.shadowBlur=8;
    ctx.fillStyle=pierce?"#FFD43B":"#F7931A";
    ctx.save();
    var bs=(brd*2)/63.6;
    ctx.translate(b.x-brd,b.y-brd);
    ctx.scale(bs,bs);
    ctx.fill(BCOIN);
    ctx.shadowBlur=0;
    ctx.fillStyle="#FFFFFF";
    ctx.fill(BGLYPH);
    ctx.restore();
  });
  /* dead flood */
  if(state==="dead"){
    /* steady under reduced motion, a rising flood otherwise */
    var frac=reduce?0.7:1-Math.max(0,(stateUntil-now)/1000);
    ctx.fillStyle="rgba(224,80,60,"+(0.18*frac).toFixed(2)+")";
    ctx.fillRect(0,0,W,H);
  }
  /* serve hint */
  if(state==="serve"){
    ctx.fillStyle="#A98F65";
    ctx.font="700 "+Math.max(9,Math.floor(cell*0.32))+"px Cascadia Mono,Consolas,monospace";
    ctx.textAlign="center";
    ctx.fillText("SPACE OR TAP TO SERVE THE HASH",W/2,H-cell*2.1);
    ctx.textAlign="left";
  }
  /* catch flashes: the drop announces itself where the player is looking */
  for(var fi=flashes.length-1;fi>=0;fi--){
    var fl=flashes[fi],age=(now-fl.t0)/1400;
    if(age>=1){flashes.splice(fi,1);continue;}
    ctx.globalAlpha=reduce?0.9:(1-age);
    ctx.fillStyle=fl.color;
    ctx.font="700 "+Math.max(10,Math.floor(cell*0.34))+"px Cascadia Mono,Consolas,monospace";
    ctx.textAlign="center";
    ctx.fillText(fl.text,W/2,paddleY()-cell*(reduce?1.2:(1.2+age*1.6)));
    ctx.textAlign="left";
    ctx.globalAlpha=1;
  }
  /* active effects: labeled chips with a draining time bar, bottom right */
  var fx=[];
  if(pierceUntil>now)fx.push(["RBF",pierceUntil,7000,"#FFD43B"]);
  if(widenUntil>now)fx.push(["WIDE",widenUntil,12000,"#63C36C"]);
  if(shrinkUntil>now)fx.push(["FUD",shrinkUntil,9000,"#E0503C"]);
  if(slowUntil>now)fx.push(["SLOW",slowUntil,9000,"#3BB9B0"]);
  if(spikeUntil>now)fx.push(["SPIKE",spikeUntil,9000,"#FFE9B8"]);
  if(holdUntil>now)fx.push(["HOLD",holdUntil,10000,"#5E81B5"]);
  if(fx.length&&state!=="idle"){
    var chw=Math.max(38,cell*1.15),chh=Math.max(15,cell*0.42),chx=W-6;
    ctx.font="700 "+Math.max(8,Math.floor(chh*0.55))+"px Cascadia Mono,Consolas,monospace";
    ctx.textAlign="center";ctx.textBaseline="middle";
    for(var xf=0;xf<fx.length;xf++){
      var eff=fx[xf];chx-=chw+5;
      ctx.fillStyle="rgba(20,16,11,.85)";
      rr2(chx,H-chh-6,chw,chh,4);ctx.fill();
      ctx.strokeStyle=eff[3];ctx.lineWidth=1.2;
      rr2(chx+0.6,H-chh-5.4,chw-1.2,chh-1.2,4);ctx.stroke();
      ctx.fillStyle=eff[3];
      ctx.fillText(eff[0],chx+chw/2,H-chh/2-5.6);
      var remain=Math.max(0,Math.min(1,(eff[1]-now)/eff[2]));
      ctx.fillRect(chx+2,H-8.5,(chw-4)*remain,2);
    }
    ctx.textAlign="left";ctx.textBaseline="alphabetic";
  }
}
function paintHud(){
  txt("bk-score",fmtScore(score));
  txt("bk-rigs",String(Math.max(0,rigs)));
  txt("bk-block",nextHeight?"#"+fmt(nextHeight):"–");
  txt("bk-level",String(level));
  txt("bk-diff","+"+diffPct()+"%");
  txt("bk-left",wl?String(wl.left):"0");
}
function paintLedger(){
  txt("bk-l-games",fmt(led.g));txt("bk-l-best",fmtScore(led.best));
  txt("bk-l-blk",fmt(led.blk));txt("bk-l-lv",fmt(led.lv));
  txt("bk-l-ep",fmt(led.ep));txt("bk-l-dr",fmt(led.dr));
  txt("bk-l-wh",fmt(led.wh));txt("bk-l-fees",fmt(led.fees));
