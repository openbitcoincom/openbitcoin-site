---
import Base from '../../layouts/Base.astro';
import HeroEmblem from '../../components/HeroEmblem.astro';
import '../../styles/doc.css';
---
<Base title="Backlog Breaker: Break the Mempool Wall - OpenBitcoin" description="A paddle arcade game about clearing the mempool. The wall is the backlog: every brick is a transaction priced from this site's own mempool feed, live when our node answers and honestly labelled when it is not. Break bricks to score their fees, clear the wall to find the block, and survive the difficulty adjustments. Fifteen wall patterns from gentle to fortress, splitting balls, random drops. All score, no money. Free, no wagering, no prizes.">
<main class="wrap doc-wrap">
  <div class="doc-head">
    <div class="doc-kicker"><a href="/games">Games</a></div>
    <h1>Backlog Breaker</h1>
    <HeroEmblem name="wallbreak" />
    <p class="doc-lede">Every brick is a transaction priced from our own node's fee feed. Bounce your bitcoin, smash the backlog, find the block; the chain notices and the difficulty adjusts.</p>
  </div>
  <div class="doc-grid">
  <div>

    <!-- ============ THE RIG ============ -->
    <div class="bk-stage" id="bk-stage">
      <div class="bk-rig" id="bk-rig">
        <div class="bk-marquee">
          <div class="bk-title" role="img" aria-label="Backlog Breaker"><span class="bk-word"><span style="background:#5E81B5;color:#0A1526;--d:0.35s">B</span><span style="background:#3BB9B0;color:#032120;--d:0.1s">A</span><span style="background:#63C36C;color:#06230C;--d:0.5s">C</span><span style="background:#FFD43B;color:#332600;--d:0.2s">K</span><span style="background:#F7931A;color:#2A1600;--d:0s">L</span><span style="background:#FFE9B8;color:#3A2600;--d:0.55s">O</span><span style="background:#5E81B5;color:#0A1526;--d:0.15s">G</span></span><i></i><span class="bk-word"><span style="background:#3BB9B0;color:#032120;--tilt:-7.5deg;--d:0.4s">B</span><span style="background:#63C36C;color:#06230C;--tilt:7.5deg;--d:0.05s">R</span><span style="background:#FFD43B;color:#332600;--tilt:-7.5deg;--d:0.45s">E</span><span style="background:#F7931A;color:#2A1600;--tilt:7.5deg;--d:0.25s">A</span><span style="background:#FFE9B8;color:#3A2600;--tilt:-7.5deg;--d:0.3s">K</span><span style="background:#5E81B5;color:#0A1526;--tilt:-7.5deg;--d:0.6s">E</span><span style="background:#3BB9B0;color:#032120;--tilt:7.5deg;--d:0.12s">R</span></span></div>
        </div>
        <div class="bk-leds">
          <div class="bk-led"><i>Level</i><b id="bk-level">1</b></div>
          <div class="bk-led"><i>Score</i><b id="bk-score">0</b></div>
          <div class="bk-led"><i>Bitcoins</i><b id="bk-rigs">3</b></div>
          <div class="bk-led"><i>Block</i><b id="bk-block">&ndash;</b></div>
          <div class="bk-led"><i>Difficulty</i><b id="bk-diff">e1</b></div>
          <div class="bk-led"><i>Backlog</i><b id="bk-left">0</b></div>
        </div>
        <div class="bk-boardwrap">
          <canvas id="bk-board" role="img" aria-label="A wall of transaction bricks at the top, your paddle rig at the bottom, and a ball bouncing between them. Breaking a brick scores its fee, drops sometimes fall for the paddle to catch, and clearing the wall finds the block. The readouts above the board mirror score, rigs, block height, level, difficulty and bricks remaining."></canvas>
          <button class="bk-opttab" id="bk-opttab" type="button" aria-label="Options" aria-expanded="false"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
          <div class="bk-topbtns" id="bk-topbtns" hidden>
            <button class="bk-mini" id="bk-pause" type="button" aria-label="Pause" aria-pressed="false" title="Pause">
              <svg viewBox="0 0 24 24" id="bk-ic-pause"><path d="M8 5v14M16 5v14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
              <svg viewBox="0 0 24 24" id="bk-ic-play" hidden><path d="M8 5l11 7-11 7z" fill="currentColor"/></svg>
            </button>
            <button class="bk-mini" id="bk-music" type="button" aria-label="Music" aria-pressed="true" title="Music">
              <svg viewBox="0 0 24 24" id="bk-music-on"><path d="M9 18V6l8-2v12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="7" cy="18" r="2.4" fill="currentColor"/><circle cx="15" cy="16" r="2.4" fill="currentColor"/></svg>
              <svg viewBox="0 0 24 24" id="bk-music-off" hidden><path d="M9 18V6l8-2v12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="7" cy="18" r="2.4" fill="currentColor"/><circle cx="15" cy="16" r="2.4" fill="currentColor"/><path d="M4 21L20 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
            <button class="bk-mini" id="bk-mute" type="button" aria-label="Sound" aria-pressed="true" title="Sound">
              <svg viewBox="0 0 24 24" id="bk-mute-on"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16 9c1.2.8 1.2 5.2 0 6M18.5 7c2.2 2 2.2 8 0 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              <svg viewBox="0 0 24 24" id="bk-mute-off" hidden><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16 9.5l6 5M22 9.5l-6 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
            <button class="bk-mini" id="bk-fs" type="button" aria-label="Fullscreen" aria-pressed="false" title="Fullscreen">
              <svg viewBox="0 0 24 24" id="bk-fs-open"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <svg viewBox="0 0 24 24" id="bk-fs-close" hidden><path d="M9 4v5H4M20 9h-5V4M15 20v-5h5M4 15h5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
          <div class="bk-overlay" id="bk-overlay">
            <div class="bk-ovinner">
              <b id="bk-ovtitle">MINE BLOCK <span id="bk-ovheight">#&hellip;</span></b>
              <p id="bk-ovtext">Steer the rig with your mouse, finger or arrow keys. Break bricks to score their fees, catch the drops (mind the FUD), clear the wall to find the block. Space or tap launches.</p>
              <button class="bk-go" id="bk-go" type="button">Start breaking</button>
            </div>
          </div>
        </div>
        <div class="bk-help">
          <span class="bk-hslide" id="bk-helpsteer">Mouse or &#8592; &#8594; steer &middot; Space launches &middot; M music &middot; P pauses</span>
          <span class="bk-hslide bk-hout" id="bk-datachip">BACKLOG FEED: &hellip;</span>
        </div>
        <div class="bk-msg" id="bk-msg">Fifteen walls, easy first, then they come back harder. The backlog never really clears; that is the point.</div>
      </div>
      <div class="bk-sr" id="bk-live" aria-live="polite"></div>
    </div>
    <noscript><p class="bk-nojs">The wall needs JavaScript to fall. The difficulty arithmetic below is true either way.</p></noscript>

    <!-- ============ HOW IT PLAYS ============ -->
    <div class="bk-card">
      <h2 class="bk-tlab">How it plays</h2>
      <p class="bk-p">Every brick is a scoop of the real fee queue, colored cold blue dust to white-hot gold by its feerate (the chip says if the feed is live). Break one and its fee is scored; string bricks together in a single flight and the chain doubles them. Gold whale bricks take three hits and always drop something. Clear the whole wall and the block is found: the score grabs the 3.125 BTC subsidy a real miner collects today, the next wall deals in a new pattern, and every third block the difficulty adjusts upward; the real chain retargets too, though it is honest enough to go both ways. Drop a bitcoin and a spare steps in; drop all three and the run is over.</p>
    </div>

    <!-- ============ THE DROPS ============ -->
    <div class="bk-card">
      <h2 class="bk-tlab">The drops</h2>
      <p class="bk-p" style="margin-bottom:10px">They arrive gradually: the first walls deal only the simple ones, the trickier tools and the FUD wait until level five.</p>
      <ul class="bk-drops">
        <li><b class="bk-dg">BATCH</b> one hash becomes three: the ball splits</li>
        <li><b class="bk-dg">RBF</b> the ball shoves straight through bricks for a while</li>
        <li><b class="bk-dg">HOLD</b> cold storage: the ball sticks to the rig, aim your shot</li>
        <li><b class="bk-dg">WIDE</b> a rig upgrade: the paddle grows</li>
        <li><b class="bk-dg">SLOW</b> traffic calms: the ball eases off</li>
        <li><b class="bk-dg">SPIKE</b> a fee spike: every brick is worth half again more, briefly</li>
        <li><b class="bk-dg">+COIN</b> a spare bitcoin joins the rack</li>
        <li><b class="bk-db">FUD</b> the one to dodge: your rig shrinks</li>
      </ul>
    </div>

    <!-- ============ THE LEDGER ============ -->
    <div class="bk-card">
      <h2 class="bk-tlab">The ledger: this browser, all time</h2>
      <div class="bk-stats">
        <div class="bk-stat"><b id="bk-l-games">0</b><i>runs</i></div>
        <div class="bk-stat"><b id="bk-l-best">0</b><i>best run</i></div>
        <div class="bk-stat"><b id="bk-l-blk">0</b><i>blocks found</i></div>
        <div class="bk-stat"><b id="bk-l-lv">0</b><i>deepest level</i></div>
        <div class="bk-stat"><b id="bk-l-ep">1</b><i>deepest difficulty epoch</i></div>
        <div class="bk-stat"><b id="bk-l-dr">0</b><i>drops caught</i></div>
        <div class="bk-stat"><b id="bk-l-wh">0</b><i>whales broken</i></div>
        <div class="bk-stat"><b id="bk-l-fees">0</b><i>career fee sats</i></div>
      </div>
      <p class="bk-brow"><span>Lives in this browser and never leaves. The sats are score; the difficulty in here only goes up, which is more than the real chain promises.</span> <button class="bk-reset" id="bk-reset" type="button">Reset everything</button></p>
    </div>

    <!-- ============ THE TROPHY SHELF ============ -->
    <div class="bk-card">
      <h2 class="bk-tlab">The trophy shelf</h2>
      <div class="bk-shelf" id="bk-shelf"></div>
    </div>

    <!-- ============ THE BITCOIN BIT ============ -->
    <div class="bk-card">
      <h2 class="bk-tlab">The bitcoin bit</h2>
      <p class="bk-p">The real backlog is a fee auction, and miners clear it exactly this way: highest feerates first, block by block, subsidy plus fees to whoever finds each one. The difficulty really does adjust, every 2,016 blocks rather than every three, so that blocks keep arriving about every ten minutes no matter how much hashrate shows up. The machinery lives on the <a href="/fees">fees</a>, <a href="/mempool">mempool</a> and <a href="/pools">pools</a> pages.</p>
    </div>

    <div class="bk-about doc-prose">
      <p>Free forever: no wagers, no prizes, and the score is pretend sats, never money (the <a href="/terms">terms</a> agree). More machines in the <a href="/games">games section</a>: <a href="/games/block-builder">Block Builder</a> packs these transactions into blocks, <a href="/games/last-sat">The Last Sat</a> races rival miners across the same mempool floor, and <a href="/games/impossible-slot">The Impossible Slot Machine</a> spins real keys against the whole chain.</p>
    </div>
  </div>
  <aside class="doc-rail">
    <div class="doc-tile">
      <div class="doc-tlab">House rules</div>
      <ul class="bk-rl">
        <li>Every brick is a fee from our mempool feed; the plate says live or snapshot</li>
        <li>Breaking a brick scores its fee; chains of four double them</li>
        <li>Clear the wall to find the block and score the subsidy</li>
        <li>Every third block the difficulty adjusts up</li>
        <li>Catch the drops, dodge the FUD</li>
        <li>All score, no money, free forever</li>
      </ul>
    </div>
    <div class="doc-tile">
      <div class="doc-tlab">Related</div>
      <nav>
        <a href="/games">All games</a>
        <a href="/games/block-builder">Block Builder</a>
        <a href="/games/last-sat">The Last Sat</a>
        <a href="/mempool">The live mempool</a>
        <a href="/fees">Fees right now</a>
      </nav>
    </div>
  </aside>
  </div>
</main>

<style is:global>
  .doc-kicker a{color:inherit;text-decoration:none}
  .doc-kicker a:hover{text-decoration:underline}
  
  
  .bk-stage,.bk-stage *{-webkit-user-select:none !important;user-select:none !important;
    -webkit-touch-callout:none !important}
  .bk-stage ::selection{background:transparent}
  .bk-stage{position:relative}
  .bk-stage.bk-fake{position:fixed;inset:0;z-index:80;background:#0A0806;display:flex;justify-content:center;padding:12px;overflow:auto}
  .bk-stage:fullscreen{background:#0A0806;display:flex;justify-content:center;padding:12px;overflow:auto}
  .bk-stage.bk-fake .bk-rig,.bk-stage:fullscreen .bk-rig{margin:auto}
  html.bk-lock{overflow:hidden}

  .bk-rig{position:relative;max-width:600px;margin:0 auto;
    -webkit-tap-highlight-color:transparent;-webkit-touch-callout:none;
    -webkit-user-select:none;user-select:none;
    background:linear-gradient(180deg,#241D14,#120E09 70%,#0C0906);
    border:1px solid #3E3322;border-radius:20px;padding:16px 20px 12px;
    box-shadow:0 18px 44px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,220,160,.10),inset 0 -14px 30px rgba(0,0,0,.45)}
  .bk-rig button:focus-visible{outline:3px solid #FFD9A0;outline-offset:2px}

  .bk-marquee{text-align:center;padding:4px 0 18px;position:relative}
  .bk-marquee::before{content:"";position:absolute;left:12%;right:12%;top:-6px;height:44px;
    background:radial-gradient(closest-side,rgba(247,147,26,.16),transparent);pointer-events:none}
  .bk-title{display:flex;gap:3px;justify-content:center;align-items:center;flex-wrap:wrap;
    font:700 clamp(11px,2.9vw,16px) var(--mono);
    animation:bk-tgap 1.75s ease both}
  
  .bk-word{display:inline-flex;gap:3px}
  .bk-word>span{--tilt:0deg;display:inline-flex;align-items:center;justify-content:center;position:relative;
    min-width:1.5em;padding:.22em 0;border-radius:5px;
    box-shadow:inset 0 1.5px 0 rgba(255,255,255,.28),inset 0 -2px 0 rgba(0,0,0,.25),0 2px 8px rgba(0,0,0,.45);
    transform:rotate(var(--tilt));
    animation:bk-tin 1.5s cubic-bezier(.3,.6,.3,1.1) var(--d) both}
  .bk-word>span::before{content:"";position:absolute;inset:24% 20%;z-index:-1;
    background:rgba(255,255,255,.30);border-radius:40%;filter:blur(2px)}
  .bk-title i{width:7px;animation:bk-tigap 1.75s ease both}
  
  @keyframes bk-tin{
    0%{transform:translateY(-72px) rotate(0deg);opacity:0}
    12%{opacity:1}
    27%{transform:translateY(0) rotate(0deg)}
    63%{transform:translateY(0) rotate(0deg)}
    88%{transform:translateY(0) rotate(var(--tilt))}
    100%{transform:translateY(0) rotate(var(--tilt))}
  }
  @keyframes bk-tgap{0%,57%{gap:3px}74%{gap:0px}100%{gap:3px}}
  @keyframes bk-tigap{0%,57%{width:7px}74%{width:0px}100%{width:7px}}
  @media(prefers-reduced-motion:reduce){
    
    .bk-title,.bk-word>span,.bk-title i{animation:none}
  }

  .bk-leds{display:flex;gap:8px;margin-bottom:10px}
  .bk-led{box-sizing:border-box;flex:1;min-width:0;background:#0A0705;border:1px solid #35291A;border-radius:9px;padding:6px 8px 7px;
    box-shadow:inset 0 2px 8px rgba(0,0,0,.7)}
  .bk-led i{display:block;font:700 7.5px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:#A98F65;font-style:normal;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .bk-led b{display:block;font:700 clamp(12px,3vw,15px) var(--mono);color:#FFD9A0;margin-top:2px;
    font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-shadow:0 0 9px rgba(255,166,60,.35)}

  .bk-boardwrap{position:relative;background:#060504;border:1px solid #3E3322;border-radius:12px;
    padding:8px;box-shadow:inset 0 4px 18px rgba(0,0,0,.85)}
  .bk-boardwrap{transition:box-shadow .5s ease,border-color .5s ease}
  .bk-boardwrap.bk-deadframe{border-color:#8B2A1E;
    box-shadow:inset 0 0 56px rgba(224,80,60,.34),0 0 26px rgba(224,80,60,.20)}
  .bk-boardwrap canvas{display:block;margin:0 auto;border-radius:6px;touch-action:none;max-width:100%;
    
    cursor:url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%2212%22%20r%3D%225.5%22%20fill%3D%22none%22%20stroke%3D%22%23000%22%20stroke-opacity%3D%22.25%22%2F%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%2212%22%20r%3D%225%22%20fill%3D%22%23fff%22%20fill-opacity%3D%22.22%22%2F%3E%3C%2Fsvg%3E') 12 12,none}
  .bk-overlay{position:absolute;inset:8px;display:flex;align-items:center;justify-content:center;
    background:rgba(6,5,4,.84);border-radius:6px;overflow:auto}
  .bk-overlay[hidden]{display:none}
  .bk-ovinner{text-align:center;padding:14px 16px;max-width:92%;max-height:100%;margin:auto}
  .bk-ovinner b{display:block;font:700 14px var(--mono);letter-spacing:.12em;color:#FFD9A0}
  .bk-ovinner p{font:600 11px/1.65 var(--mono);color:#B99B6B;margin:10px 0 0}
  .bk-ovinner p b{display:inline;font-size:11px;color:#FFB84D;letter-spacing:.02em}
  .bk-go{margin-top:14px;background:#F7931A;color:#241200;border:1.5px solid rgba(255,166,60,.65);
    border-radius:10px;cursor:pointer;min-height:48px;padding:0 26px;
    font:700 14px var(--mono);letter-spacing:.13em;text-transform:uppercase;
    box-shadow:0 5px 16px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.14),0 0 22px rgba(247,147,26,.22)}
  .bk-go:hover{background:#FFA733}

  .bk-help{margin-top:12px;position:relative;min-height:14px;
    font:600 8.5px var(--mono);letter-spacing:.08em;color:#97815A;text-align:center}
  .bk-hslide{position:absolute;left:0;right:0;top:0;opacity:1;transition:opacity .9s ease}
  .bk-hslide.bk-hout{opacity:0}
  @media(prefers-reduced-motion:reduce){.bk-hslide{transition:none}}
  .bk-hslide.bk-livefeed{color:#C98A2E}
  .bk-topbtns{position:absolute;top:8px;right:42px;
    display:flex;gap:6px;z-index:3;opacity:.7;transition:opacity .15s ease}
  .bk-topbtns:hover{opacity:1}
  .bk-opttab{position:absolute;top:8px;right:8px;z-index:3;
    display:flex;align-items:center;justify-content:center;background:rgba(18,14,10,.45);
    border:1px solid rgba(62,51,34,.55);border-radius:7px;color:#B99B6B;cursor:pointer;
    width:28px;height:28px;opacity:.7;transition:opacity .15s ease}
  .bk-opttab:hover{opacity:1}
  .bk-opttab svg{width:14px;height:14px}
  .bk-opttab[aria-expanded="true"]{border-color:rgba(247,147,26,.55);color:#FFB84D;opacity:1}
  .bk-opttab[hidden],.bk-topbtns[hidden]{display:none}
  .bk-topbtns .bk-mini{width:28px;height:28px;min-height:0;border-radius:7px;
    background:rgba(18,14,10,.45);border:1px solid rgba(62,51,34,.55)}
  .bk-topbtns .bk-mini svg{width:13px;height:13px}
  @media(pointer:coarse){
    .bk-opttab,.bk-topbtns .bk-mini{width:38px;height:38px}
  }
  .bk-topbtns .bk-mini[aria-pressed="true"]{border-color:rgba(247,147,26,.55);color:#FFB84D}
  .bk-mini{width:40px;height:40px;display:flex;align-items:center;justify-content:center;flex:none;
    background:#191410;border:1px solid #35291A;border-radius:8px;color:#B99B6B;cursor:pointer}
  .bk-mini:hover{color:#FFD9A0;border-color:#5A452A}
  .bk-mini[aria-pressed="true"]{border-color:rgba(247,147,26,.55);color:#FFB84D}
  .bk-mini svg{width:17px;height:17px}
  
  .bk-mini svg[hidden]{display:none}
  .bk-msg{min-height:34px;margin-top:10px;text-align:center;font:600 11.5px/1.5 var(--mono);letter-spacing:.02em;color:#B99B6B}
  .bk-msg.bk-good{color:#FFB84D}
  .bk-msg.bk-bad{color:#E06A55}

  
  .bk-card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:20px 24px 22px;margin-top:14px}
  .bk-tlab{font:700 9.5px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);margin:0 0 12px}
  .bk-drops{margin:0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px}
  .bk-drops li{font:500 12.5px/1.55 var(--sans);color:var(--ink-2);min-width:0;
    background:var(--field);border:1px dashed rgba(255,166,60,.28);border-radius:10px;padding:10px 12px}
  .bk-drops li:last-child{border-color:rgba(224,80,60,.45)}
  .bk-drops b{display:inline-block;min-width:52px;font:700 10px var(--mono);letter-spacing:.08em;
    border:1px solid rgba(247,147,26,.45);border-radius:6px;padding:2px 6px;margin:0 0 6px;text-align:center;display:block;width:fit-content}
  .bk-dg{color:var(--acc)}
  .bk-db{color:var(--down);border-color:currentColor !important}
  .bk-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(118px,1fr));gap:10px}
  .bk-stat{background:rgba(124,140,168,.13);border:1px dashed rgba(255,166,60,.32);border-radius:10px;padding:10px 12px;min-width:0}
  .bk-stat b{display:block;font:700 16px var(--mono);color:var(--ink);font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
