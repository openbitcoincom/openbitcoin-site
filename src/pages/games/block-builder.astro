/* ---------------- pause ---------------- */
var paused=false;
function paintPause(){
  var pb=el("bb-pause");
  hideIc(el("bb-ic-pause"),paused);hideIc(el("bb-ic-play"),!paused);
  if(pb)pb.setAttribute("aria-pressed",paused?"true":"false");
}
function setPause(on){
  if(state!=="run"&&on)return;
  if(paused===on)return;
  paused=on;paintPause();
  fastDrop=false; /* a keyup lost to the tab switch must not stick */
  if(on){state="pause";stopMusic();say("Paused. The real network never does this.");}
  else{
    state="run";lastT=performance.now();
    /* the slide window must not age while paused: hand back a fresh beat */
    if(groundedSince!==null)groundedSince=lastT;
    startMusic();
    say("Back to work.");
  }
}
window.addEventListener("blur",function(){fastDrop=false;});
el("bb-pause").addEventListener("click",function(){
  if(state==="run")setPause(true);
  else if(state==="pause")setPause(false);
});
document.addEventListener("visibilitychange",function(){
  if(!document.hidden)return;
  stopMusic(); /* a hidden tab must fall silent NOW: rAF is frozen, so a
     settle/found state cannot resolve into the deferred pause */
  if(state==="run")setPause(true);
  /* hiding during a flash cannot pause mid-animation; remember to pause the
     moment the settle or fanfare resolves instead of resuming unwatched */
  else if(state==="settle"||state==="found")hidMid=true;
});

/* ---------------- input ---------------- */
ovBtn.addEventListener("click",function(){ac();startRound();});
document.addEventListener("keydown",function(e){
  if(e.altKey||e.ctrlKey||e.metaKey)return;
  var k=e.key;
  if(["ArrowLeft","ArrowRight","ArrowUp","ArrowDown"," ","Enter","z","Z","p","P","c","C","h","H","g","G","m","M"].indexOf(k)<0)return;
  var tg=e.target;
  if(tg&&tg.closest){
    if(tg.closest("input,select,textarea,a"))return;
    /* a focused button keeps its native Space/Enter activation, but the
       game keys still play so focusing Pause does not kill the arrows */
    if(tg.closest("button")&&(k===" "||k==="Enter"))return;
  }
  var r=stage.getBoundingClientRect();
  if(r.bottom<0||r.top>window.innerHeight)return;
  if(state==="run"){
    if(k==="ArrowLeft"){e.preventDefault();tryMove(-1);}
    else if(k==="ArrowRight"){e.preventDefault();tryMove(1);}
    else if(k==="ArrowUp"||k==="z"||k==="Z"){e.preventDefault();tryRotate();}
    else if(k==="ArrowDown"){e.preventDefault();if(!fastDrop){fastDrop=true;dropAcc=Math.min(dropAcc,45);}}
    else if(k===" "){e.preventDefault();hardDrop();}
    else if(k==="c"||k==="C"||k==="h"||k==="H"){e.preventDefault();if(!e.repeat)tryHold();}
    else if(k==="g"||k==="G"){e.preventDefault();if(!e.repeat)toggleGhost();}
    else if(k==="m"||k==="M"){e.preventDefault();if(!e.repeat)toggleMusic();}
    else if(k==="p"||k==="P"){e.preventDefault();setPause(true);}
  }else if(state==="settle"||state==="found"||state==="dead"){
    /* the seal/burn flash, the found fanfare and the death flood are still
       mid-game: swallow every game key so a held arrow never scrolls the
       page, and keep a held soft-drop armed for the next piece */
    e.preventDefault();
    if(k==="ArrowDown")fastDrop=true;
    else if((k==="m"||k==="M")&&!e.repeat)toggleMusic();
  }
  else if(state==="pause"&&(k==="m"||k==="M")){e.preventDefault();if(!e.repeat)toggleMusic();}
  else if(state==="pause"&&(k==="p"||k==="P"||k===" ")){e.preventDefault();setPause(false);}
  else if(state!=="pause"&&(k===" "||k==="Enter")){
    if(!overlay.hidden){e.preventDefault();ac();startRound();}
  }
});
document.addEventListener("keyup",function(e){
  if(e.key==="ArrowDown")fastDrop=false;
});
function bindPad(id,fn,repeat){
  var b=el(id),timer=null,pid=null;
  if(!b)return;
  b.addEventListener("pointerdown",function(e){
    if(e.button!==0||!e.isPrimary)return;
    e.preventDefault();
    if(timer)return; /* a second finger must not orphan the repeat timer */
    pid=e.pointerId;
    fn();
    if(repeat)timer=setInterval(fn,140);
  });
  ["pointerup","pointercancel","pointerleave"].forEach(function(ev){
    /* only the pointer that pressed may release: a second finger's up or a
       mouse merely passing over must not kill a held repeat or soft drop */
    b.addEventListener(ev,function(e){
      if(e.pointerId!==pid)return;
      pid=null;
      if(timer){clearInterval(timer);timer=null;}
      if(id==="bb-pdrop")fastDrop=false;
    });
  });
  /* keyboard and assistive-tech activation arrives as a detail-0 click,
     never as pointerdown; the soft-drop pad gets a timed pulse since a
     keyboard click has no release to clear it */
  b.addEventListener("click",function(e){
    if(e.detail!==0)return;
    fn();
    if(id==="bb-pdrop")setTimeout(function(){fastDrop=false;},200);
  });
}

/* the wipe wants a second press: the ledger is not reborn (slot idiom) */
var resetTimer=null;
function disarmReset(){
  if(resetTimer){clearTimeout(resetTimer);resetTimer=null;}
  var rb=el("bb-reset");
  rb.textContent="Reset everything";
  rb.classList.remove("bb-armed");
}
el("bb-reset").addEventListener("click",function(){
  var rb=this;
  if(!resetTimer){
    rb.textContent="Sure?";
    rb.classList.add("bb-armed");
    resetTimer=setTimeout(disarmReset,4000);
    return;
  }
  disarmReset();
  led={g:0,best:0,sum:0,blk:0,rows:0,br:0,bu:0,lv:0,tr:[]};
  saveLed();paintLedger();paintShelf();
  say("Wiped. The mempool keeps no score either.");
});

/* ---------------- touch on the board itself: drag to steer, tap to rotate,
   flick down to drop. The pads stay for anyone who prefers buttons. */
(function(){
  var tId=null,sx=0,sy=0,lx=0,startAt=0,movedCols=0,softening=false;
  cv.addEventListener("pointerdown",function(e){
    if(state==="pause"){setPause(false);return;} /* a tap on the board resumes */
    /* settle and found are still mid-game: a finger that lands during the
       flash must own the next piece the moment run resumes */
    if(e.pointerType==="mouse"||(state!=="run"&&state!=="settle"&&state!=="found"))return;
    /* a second finger while one is down = HOLD (the pads are gone) */
    if(tId!==null&&e.pointerId!==tId){tryHold();e.preventDefault();return;}
    tId=e.pointerId;sx=lx=e.clientX;sy=e.clientY;startAt=performance.now();
    movedCols=0;softening=false;
    cv.setPointerCapture(tId);
    e.preventDefault();
  });
  cv.addEventListener("pointermove",function(e){
    if(e.pointerId!==tId||state!=="run")return;
    var step=cell*0.8;
    while(e.clientX-lx>=step){tryMove(1);lx+=step;movedCols++;}
    while(lx-e.clientX>=step){tryMove(-1);lx-=step;movedCols++;}
    var dy=e.clientY-sy;
    if(dy>cell*1.3&&movedCols===0){
      if(!softening){softening=true;fastDrop=true;dropAcc=Math.min(dropAcc,45);}
    }else if(softening&&dy<cell*0.8){softening=false;fastDrop=false;}
  });
  function endTouch(e){
    if(e.pointerId!==tId)return;
    tId=null;
    if(softening)fastDrop=false;
    var dt2=performance.now()-startAt,dy=e.clientY-sy,dx=Math.abs(e.clientX-sx);
    if(state!=="run")return;
    if(dy>cell*2&&dt2<240){hardDrop();return;}          /* fast flick down */
    if(movedCols===0&&!softening&&dt2<260&&dx<cell*0.6&&Math.abs(dy)<cell*0.6)tryRotate(); /* tap */
  }
  cv.addEventListener("pointerup",endTouch);
  cv.addEventListener("pointercancel",function(e){if(e.pointerId===tId){tId=null;fastDrop=false;}});
})();

/* ---------------- fullscreen (shared idiom) ---------------- */
var fsBtn=el("bb-fs");
function fsActive(){return document.fullscreenElement===stage||stage.classList.contains("bb-fake");}
function setInertOutside(on){
  var node=stage;
  while(node&&node!==document.body){
    var p=node.parentElement;
    if(!p)break;
    for(var i=0;i<p.children.length;i++){
      var sib=p.children[i];
      if(sib===node)continue;
      if(on)sib.setAttribute("inert","");else sib.removeAttribute("inert");
    }
    node=p;
  }
}
function paintFs(){
  var on=fsActive();
  hideIc(el("bb-fs-open"),on);hideIc(el("bb-fs-close"),!on);
  fsBtn.setAttribute("aria-pressed",on?"true":"false");
  sizeBoard();
}
function exitFake(){
  stage.classList.remove("bb-fake");document.documentElement.classList.remove("bb-lock");
  setInertOutside(false);paintFs();
}
function fsToggle(){
  if(document.fullscreenElement){document.exitFullscreen();return;}
  if(stage.classList.contains("bb-fake")){exitFake();return;}
  if(stage.requestFullscreen){
    stage.requestFullscreen().then(paintFs).catch(function(){
      stage.classList.add("bb-fake");document.documentElement.classList.add("bb-lock");
      setInertOutside(true);paintFs();
    });
  }else{
    stage.classList.add("bb-fake");document.documentElement.classList.add("bb-lock");
    setInertOutside(true);paintFs();
  }
}
fsBtn.addEventListener("click",fsToggle);
document.addEventListener("fullscreenchange",paintFs);
document.addEventListener("keydown",function(e){
  if(e.key==="Escape"&&stage.classList.contains("bb-fake"))exitFake();
});
var lastSizeW=window.innerWidth;
window.addEventListener("resize",function(){
  /* mobile browsers fire resize while scrolling as the URL bar collapses;
     the board must not breathe with it. Only a real width change (rotation,
     window resize, fullscreen) re-racks the board. */
  var w=window.innerWidth;
  if(w===lastSizeW&&!fsActive())return;
  lastSizeW=w;
  sizeBoard();
});

/* ---------------- boot ---------------- */
newGrid();
sizeBoard();
paintLedger();
paintShelf();
paintHold();
/* the chip keeps its honest "..." until the first feed answer: never claim
   the feed is unavailable while it is merely still being asked */
fetchFeed();
fetch(apiBase()+"/height").then(function(r){if(!r.ok)throw 0;return r.json();}).then(function(j){
  if(j&&typeof j.height==="number"&&isFinite(j.height)&&j.height>0){nextHeight=Math.floor(j.height)+1;paintOvHeight();}
}).catch(function(){});
lastT=performance.now();
if(!raf)raf=requestAnimationFrame(loop); /* the attract demo runs behind the overlay */
if(led.g>0)say("Welcome back. Best fee score in this browser: "+fmt(led.best)+" sats. The block wants filling.");

/* iOS long-press hardening: user-select:none alone is not honored
   reliably on Safari, so selection is refused at the event layer and any
   range that sneaks through is swept on touchend */
(function(){
  var st=document.querySelector(".bb-stage");
  if(!st)return;
    /* the decisive layer: cancel the NATIVE touch before Safari's selection
     recognizer runs. Scoped to the canvas and overlay prose only, so
     buttons keep their taps and the page keeps its scroll. */
  st.addEventListener("touchstart",function(e){
    var t=e.target;
    if(!t||!t.closest)return;
    if(t.closest("button,a,input,select,textarea"))return;
    if(t.closest("canvas")||t.closest(".bb-overlay"))e.preventDefault();
  },{passive:false});
  ["selectstart","contextmenu"].forEach(function(ev){
    st.addEventListener(ev,function(e){e.preventDefault();});
  });
  document.addEventListener("touchend",function(){
    try{
      var sel=window.getSelection&&window.getSelection();
      if(!sel||!sel.rangeCount||!sel.anchorNode)return;
      var n=sel.anchorNode.nodeType===1?sel.anchorNode:sel.anchorNode.parentNode;
      if(n&&st.contains(n))sel.removeAllRanges();
    }catch(e){}
  },{passive:true});
})();
})();
</script>
