---
import Base from '../../layouts/Base.astro';
import HeroEmblem from '../../components/HeroEmblem.astro';
import '../../styles/doc.css';
---
<Base title="Block Builder: Stack the Mempool - OpenBitcoin" description="Build a bitcoin block from the bottom up. Bricks fall in a fee mix sampled from this site's own mempool feed; rows seal bottom-first and score their fees, a full row above a gap burns to nothing, and sealing all ten rows finds the block and scores the 3.125 BTC subsidy a real miner would collect. All score, no money. Free, no wagering, no prizes.">
<main class="wrap doc-wrap">
  <div class="doc-head">
    <div class="doc-kicker"><a href="/games">Games</a></div>
    <h1>Block Builder</h1>
    <HeroEmblem name="brickfall" />
    <p class="doc-lede">You already know the controls: steer the bricks, complete rows. The goal is the bitcoin part: fill the block solid from the bottom, and ten sealed rows find it.</p>
  </div>
  <div class="doc-grid">
  <div>

    <!-- ============ THE RIG ============ -->
    <div class="bb-stage" id="bb-stage">
      <div class="bb-rig" id="bb-rig">
        <div class="bb-bgblocks" aria-hidden="true">
          <svg class="bb-bgfloor"><defs><pattern id="bbrow1" width="216" height="32" patternUnits="userSpaceOnUse"><rect x="0" y="0" width="32" height="32" rx="5" fill="#F7931A"/><rect x="36" y="0" width="32" height="32" rx="5" fill="#5E81B5"/><rect x="72" y="0" width="32" height="32" rx="5" fill="#FFD43B"/><rect x="108" y="0" width="32" height="32" rx="5" fill="#63C36C"/><rect x="144" y="0" width="32" height="32" rx="5" fill="#3BB9B0"/><rect x="180" y="0" width="32" height="32" rx="5" fill="#FFE9B8"/></pattern><pattern id="bbrow2" width="216" height="32" patternUnits="userSpaceOnUse"><rect x="0" y="0" width="32" height="32" rx="5" fill="#63C36C"/><rect x="36" y="0" width="32" height="32" rx="5" fill="#3BB9B0"/><rect x="72" y="0" width="32" height="32" rx="5" fill="#FFE9B8"/><rect x="108" y="0" width="32" height="32" rx="5" fill="#F7931A"/><rect x="144" y="0" width="32" height="32" rx="5" fill="#5E81B5"/><rect x="180" y="0" width="32" height="32" rx="5" fill="#FFD43B"/></pattern></defs><rect x="0" y="0" width="100%" height="32" fill="url(#bbrow2)"/><rect x="0" y="36" width="100%" height="32" fill="url(#bbrow1)"/></svg>
          <svg class="bb-bgcol bb-bgcol-l" aria-hidden="true"><rect x="0" y="112" width="32" height="32" rx="5" fill="#F7931A"/><rect x="0" y="148" width="32" height="32" rx="5" fill="#5E81B5"/><rect x="0" y="184" width="32" height="32" rx="5" fill="#FFD43B"/><rect x="0" y="220" width="32" height="32" rx="5" fill="#63C36C"/><rect x="0" y="256" width="32" height="32" rx="5" fill="#3BB9B0"/><rect x="0" y="292" width="32" height="32" rx="5" fill="#FFE9B8"/><rect x="0" y="328" width="32" height="32" rx="5" fill="#F7931A"/><rect x="0" y="364" width="32" height="32" rx="5" fill="#5E81B5"/><rect x="36" y="292" width="32" height="32" rx="5" fill="#63C36C"/><rect x="36" y="328" width="32" height="32" rx="5" fill="#3BB9B0"/><rect x="36" y="364" width="32" height="32" rx="5" fill="#FFE9B8"/></svg>
          <svg class="bb-bgcol bb-bgcol-r" aria-hidden="true"><rect x="36" y="112" width="32" height="32" rx="5" fill="#FFD43B"/><rect x="36" y="148" width="32" height="32" rx="5" fill="#63C36C"/><rect x="36" y="184" width="32" height="32" rx="5" fill="#3BB9B0"/><rect x="36" y="220" width="32" height="32" rx="5" fill="#FFE9B8"/><rect x="36" y="256" width="32" height="32" rx="5" fill="#F7931A"/><rect x="36" y="292" width="32" height="32" rx="5" fill="#5E81B5"/><rect x="36" y="328" width="32" height="32" rx="5" fill="#FFD43B"/><rect x="36" y="364" width="32" height="32" rx="5" fill="#63C36C"/><rect x="0" y="292" width="32" height="32" rx="5" fill="#FFE9B8"/><rect x="0" y="328" width="32" height="32" rx="5" fill="#F7931A"/><rect x="0" y="364" width="32" height="32" rx="5" fill="#5E81B5"/></svg>
        </div>
        <div class="bb-wmark" aria-hidden="true"></div>
        <div class="bb-marquee">
          <div class="bb-title" role="img" aria-label="Block Builder"><span style="background:#5E81B5;color:#0A1526;--tilt:-7.5deg;--d:.35s">B</span><span style="background:#3BB9B0;color:#032120;--tilt:7.5deg;--d:.10s">L</span><span style="background:#63C36C;color:#06230C;--tilt:-7.5deg;--d:.50s">O</span><span style="background:#FFD43B;color:#332600;--tilt:7.5deg;--d:.20s">C</span><span style="background:#F7931A;color:#2A1600;--tilt:7.5deg;--d:0s">K</span><i></i><span style="background:#FFE9B8;color:#3A2600;--tilt:-7.5deg;--d:.55s">B</span><span style="background:#5E81B5;color:#0A1526;--tilt:7.5deg;--d:.15s">U</span><span style="background:#3BB9B0;color:#032120;--tilt:-7.5deg;--d:.40s">I</span><span style="background:#63C36C;color:#06230C;--tilt:7.5deg;--d:.05s">L</span><span style="background:#FFD43B;color:#332600;--tilt:-7.5deg;--d:.45s">D</span><span style="background:#F7931A;color:#2A1600;--tilt:-7.5deg;--d:.25s">E</span><span style="background:#FFE9B8;color:#3A2600;--tilt:7.5deg;--d:.30s">R</span></div>
        </div>
        <div class="bb-deck">
          <div class="bb-boardwrap">
            <canvas id="bb-board" role="img" aria-label="A ten by sixteen well filling with falling transaction bricks. The bottom ten rows are the block: rows seal from the bottom up and score their fees, a complete row above a gap burns away, and sealing all ten rows finds the block. The readouts beside the board mirror the fee score, blocks found and rows sealed."></canvas>
            <div class="bb-overlay" id="bb-overlay">
              <div class="bb-ovinner" id="bb-ovinner">
                <b id="bb-ovtitle">MINE BLOCK <span id="bb-ovheight">#&hellip;</span></b>
                <p id="bb-ovtext">Fill the block from the bottom up: rows on solid rows seal and score, rows over a gap burn, ten sealed rows finds the block. Phone: drag to steer, tap to rotate, flick to drop, two-finger tap to hold.</p>
                <button class="bb-go" id="bb-go" type="button">Start mining</button>
              </div>
            </div>
            <button class="bb-opttab" id="bb-opttab" type="button" aria-label="Options" aria-expanded="false"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
            <div class="bb-topbtns" id="bb-topbtns" hidden>
            <button class="bb-mini" id="bb-pause" type="button" aria-label="Pause" aria-pressed="false" title="Pause">
              <svg viewBox="0 0 24 24" id="bb-ic-pause"><path d="M8 5v14M16 5v14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
              <svg viewBox="0 0 24 24" id="bb-ic-play" hidden><path d="M8 5l11 7-11 7z" fill="currentColor"/></svg>
            </button>
            <button class="bb-mini" id="bb-music" type="button" aria-label="Music" aria-pressed="true" title="Music">
              <svg viewBox="0 0 24 24" id="bb-music-on"><path d="M9 18V6l8-2v12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="7" cy="18" r="2.4" fill="currentColor"/><circle cx="15" cy="16" r="2.4" fill="currentColor"/></svg>
              <svg viewBox="0 0 24 24" id="bb-music-off" hidden><path d="M9 18V6l8-2v12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="7" cy="18" r="2.4" fill="currentColor"/><circle cx="15" cy="16" r="2.4" fill="currentColor"/><path d="M4 21L20 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
            <button class="bb-mini" id="bb-ghost" type="button" aria-label="Landing guide" aria-pressed="true" title="Landing guide">
              <svg viewBox="0 0 24 24" id="bb-ghost-on"><path d="M5 5h4M15 5h4M5 5v4M19 5v4M5 15v4M5 19h4M19 15v4M15 19h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="12" r="2.2" fill="currentColor"/></svg>
              <svg viewBox="0 0 24 24" id="bb-ghost-off" hidden><path d="M5 5h4M15 5h4M5 5v4M19 5v4M5 15v4M5 19h4M19 15v4M15 19h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M5 19L19 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
            <button class="bb-mini" id="bb-mute" type="button" aria-label="Sound" aria-pressed="true" title="Sound">
              <svg viewBox="0 0 24 24" id="bb-mute-on"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16 9c1.2.8 1.2 5.2 0 6M18.5 7c2.2 2 2.2 8 0 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              <svg viewBox="0 0 24 24" id="bb-mute-off" hidden><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16 9.5l6 5M22 9.5l-6 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
            <button class="bb-mini" id="bb-fs" type="button" aria-label="Fullscreen" aria-pressed="false" title="Fullscreen">
              <svg viewBox="0 0 24 24" id="bb-fs-open"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <svg viewBox="0 0 24 24" id="bb-fs-close" hidden><path d="M9 4v5H4M20 9h-5V4M15 20v-5h5M4 15h5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            </div>
          </div>
          <div class="bb-side">
            <div class="bb-led"><i>Level</i><b id="bb-level">1</b></div>
            <div class="bb-led"><i>Fee score</i><b id="bb-fees">0</b></div>
            <div class="bb-led"><i>Blocks found</i><b id="bb-blocks">0</b></div>
            <div class="bb-led"><i>Block fill</i><b id="bb-rows">0/10</b><span class="bb-tbar"><span id="bb-tfill"></span></span></div>
            <div class="bb-next">
              <i>Next</i>
              <div id="bb-queue" class="bb-queue" aria-hidden="true"></div>
            </div>
            <div class="bb-hold">
              <i>Hold &middot; C</i>
              <div id="bb-holdbox" class="bb-queue" aria-hidden="true"></div>
            </div>
            <div class="bb-chip" id="bb-datachip">PIECE FEED: &hellip;</div>
          </div>
        </div>
        <div class="bb-console">
          <div class="bb-help">&#8592; &#8594; steer &middot; &#8593; rotate &middot; &#8595; fast &middot; Space drops &middot; C holds &middot; G guide &middot; M music &middot; P pauses</div>
        </div>
        <div class="bb-msg" id="bb-msg">The bricks are transactions, colored cold to hot by feerate, dealt from this site's mempool feed (the chip says which). Seal the block from the bottom.</div>
      </div>
      <div class="bb-sr" id="bb-live" aria-live="polite"></div>
    </div>
    <noscript><p class="bb-nojs">The rig needs JavaScript to run. The block-space arithmetic below is true either way.</p></noscript>

    <!-- ============ HOW IT PLAYS ============ -->
    <div class="bb-card">
      <h2 class="bb-tlab">How it plays</h2>
      <p class="bb-p">You are packing a block, bottom row first. The bricks are transactions, colored cold blue dust to white-hot gold, dealt in the fee mix of our own mempool (the chip says if the feed is live). A row resting on solid rows seals and scores its fees. A full row floating over a gap burns to nothing, so mind your holes; burning the cover off a buried gap on purpose is a legal move and feels great. Fill all ten rows and the block is found: the score grabs the 3.125 BTC subsidy a real miner would collect, and the next block deals faster. All score, no money.</p>
    </div>

    <!-- ============ THE LEDGER ============ -->
    <div class="bb-card">
      <h2 class="bb-tlab">The ledger: this browser, all time</h2>
      <div class="bb-stats">
        <div class="bb-stat"><b id="bb-l-games">0</b><i>runs</i></div>
        <div class="bb-stat"><b id="bb-l-best">0</b><i>best fees, sats</i></div>
        <div class="bb-stat"><b id="bb-l-career">0</b><i>career fee sats</i></div>
        <div class="bb-stat"><b id="bb-l-blocks">0</b><i>blocks found</i></div>
        <div class="bb-stat"><b id="bb-l-rows">0</b><i>rows sealed</i></div>
        <div class="bb-stat"><b id="bb-l-burn">0</b><i>rows burned</i></div>
        <div class="bb-stat"><b id="bb-l-brow">0</b><i>best row, sats</i></div>
        <div class="bb-stat"><b id="bb-l-lv">1</b><i>best level</i></div>
      </div>
      <p class="bb-brow"><span>Lives in this browser and never leaves. The sats are score; the blocks are pride, which is worse.</span> <button class="bb-reset" id="bb-reset" type="button">Reset everything</button></p>
    </div>

    <!-- ============ THE TROPHY SHELF ============ -->
    <div class="bb-card">
      <h2 class="bb-tlab">The trophy shelf</h2>
      <div class="bb-shelf" id="bb-shelf"></div>
    </div>

    <!-- ============ THE BITCOIN BIT ============ -->
    <div class="bb-card">
      <h2 class="bb-tlab">The bitcoin bit</h2>
      <p class="bb-p">Real blocks are packed exactly like this: 4 million weight units, filled solid, because empty space in a found block is wasted forever. Real miners do it in milliseconds by sorting the queue; your thumbs are the artisanal version. Want the actual machinery? It lives on the <a href="/fees">fees</a>, <a href="/mempool">mempool</a> and <a href="/pools">pools</a> pages.</p>
    </div>

    <div class="bb-about doc-prose">
      <p>Free forever: no wagers, no prizes, and the score is pretend sats, never money (the <a href="/terms">terms</a> agree). More machines in the <a href="/games">games section</a>: <a href="/games/mempool-crossing">Mempool Crossing</a> drops you into the fee traffic as a transaction, and <a href="/games/impossible-slot">The Impossible Slot Machine</a> spins real keys against the whole chain.</p>
    </div>
  </div>
  <aside class="doc-rail">
    <div class="doc-tile">
      <div class="doc-tlab">House rules</div>
      <ul class="bb-rl">
        <li>Fill the block from the bottom row up</li>
        <li>Rows on solid rows seal and score their fees</li>
        <li>A full row above a gap burns to nothing</li>
        <li>Ten sealed rows finds the block; then it deals faster</li>
        <li>Top out and the mempool buries you</li>
        <li>All score, no money, free forever</li>
      </ul>
    </div>
    <div class="doc-tile">
      <div class="doc-tlab">Related</div>
      <nav>
        <a href="/games">All games</a>
        <a href="/games/mempool-crossing">Mempool Crossing</a>
        <a href="/mempool">The live mempool</a>
        <a href="/fees">Fees right now</a>
        <a href="/pools">Mining pools</a>
      </nav>
    </div>
  </aside>
  </div>
</main>

<style is:global>
  .doc-kicker a{color:inherit;text-decoration:none}
  .doc-kicker a:hover{text-decoration:underline}
  
  
  .bb-stage,.bb-stage *{-webkit-user-select:none !important;user-select:none !important;
    -webkit-touch-callout:none !important}
  .bb-stage ::selection{background:transparent}
  .bb-stage{position:relative}
  .bb-stage.bb-fake{position:fixed;inset:0;z-index:80;background:#0A0806;display:flex;justify-content:center;padding:12px;overflow:auto}
  .bb-stage:fullscreen{background:#0A0806;display:flex;justify-content:center;padding:12px;overflow:auto}
  .bb-stage.bb-fake .bb-rig,.bb-stage:fullscreen .bb-rig{margin:auto;max-width:940px}
  html.bb-lock{overflow:hidden}

  
  .bb-bgblocks{position:absolute;left:0;right:0;bottom:0;height:80%;z-index:-1;
    opacity:.07;pointer-events:none;border-radius:0 0 19px 19px;overflow:hidden;
    -webkit-mask-image:linear-gradient(to top,#000 40%,transparent 97%);
    mask-image:linear-gradient(to top,#000 40%,transparent 97%)}
  .bb-bgblocks svg{position:absolute;display:block}
  .bb-bgfloor{left:12px;bottom:10px;width:calc(100% - 24px);height:32px}
  .bb-bgcol{bottom:48px;width:68px;height:396px}
  .bb-bgcol-l{left:6px}
  .bb-bgcol-r{right:6px}
  .bb-rig{position:relative;isolation:isolate;max-width:600px;margin:0 auto;
    -webkit-tap-highlight-color:transparent;-webkit-touch-callout:none;
    -webkit-user-select:none;user-select:none;
    background:linear-gradient(180deg,#171310,#100D09 70%,#0C0906);
    border:1px solid #3E3322;border-radius:20px;padding:16px 20px 12px;
    box-shadow:0 18px 44px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,220,160,.10),inset 0 -14px 30px rgba(0,0,0,.45)}
  .bb-rig button:focus-visible{outline:3px solid #FFD9A0;outline-offset:2px}

  .bb-marquee{text-align:center;padding:6px 0 22px;position:relative}
  .bb-marquee::before{content:"";position:absolute;left:12%;right:12%;top:-6px;height:44px;
    background:radial-gradient(closest-side,rgba(247,147,26,.10),transparent);pointer-events:none}
  .bb-title{display:flex;gap:3px;justify-content:center;align-items:center;flex-wrap:wrap;
    font:700 clamp(13px,3.4vw,18px) var(--mono);
    animation:bb-tgap 1.75s ease both}
  .bb-title span{display:inline-flex;align-items:center;justify-content:center;position:relative;
    min-width:1.5em;padding:.22em 0;border-radius:5px;
    box-shadow:inset 0 1.5px 0 rgba(255,255,255,.28),inset 0 -2px 0 rgba(0,0,0,.25),0 2px 8px rgba(0,0,0,.45);
    transform:rotate(var(--tilt));
    animation:bb-tin 1.5s cubic-bezier(.3,.6,.3,1.1) var(--d) both}
  
  .bb-title span::before{content:"";position:absolute;inset:24% 20%;z-index:-1;
    background:rgba(255,255,255,.30);border-radius:40%;filter:blur(2px)}
  .bb-title i{width:7px;animation:bb-tigap 1.75s ease both}
  
  @keyframes bb-tin{
    0%{transform:translateY(-72px) rotate(0deg);opacity:0}
    12%{opacity:1}
    27%{transform:translateY(0) rotate(0deg)}
    63%{transform:translateY(0) rotate(0deg)}
    88%{transform:translateY(0) rotate(var(--tilt))}
    100%{transform:translateY(0) rotate(var(--tilt))}
  }
  @keyframes bb-tgap{0%,57%{gap:3px}74%{gap:0px}100%{gap:3px}}
  @keyframes bb-tigap{0%,57%{width:7px}74%{width:0px}100%{width:7px}}
  @media(prefers-reduced-motion:reduce){
    .bb-title,.bb-title span,.bb-title i{animation:none}
  }

  .bb-deck{display:flex;gap:12px;align-items:flex-start;justify-content:center}
  .bb-boardwrap{position:relative;flex:0 0 auto;background:#060504;border:1px solid #3E3322;border-radius:12px;
    padding:8px;box-shadow:inset 0 4px 18px rgba(0,0,0,.85)}
  .bb-boardwrap{transition:box-shadow .5s ease,border-color .5s ease}
  
  .bb-boardwrap.bb-deadframe{border-color:#8B2A1E;
    box-shadow:inset 0 0 56px rgba(224,80,60,.34),0 0 26px rgba(224,80,60,.20)}
  .bb-boardwrap canvas{display:block;border-radius:6px;touch-action:none}
  
