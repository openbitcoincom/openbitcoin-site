/* ---------------- board sizing ---------------- */
var cell=26,W=0,H=0;
var bigH=0;
function sizeBoard(){
  var fs=fsActive();
  var avail=rig.clientWidth-40-140-24;
  if(window.innerWidth<=740)avail=rig.clientWidth-40;
  /* fullscreen on a big display earns bigger cells and a wider rig */
  cell=Math.max(16,Math.min(fs?46:34,Math.floor(avail/COLS)));
  /* the height clamp uses the most generous height ever seen, so a mobile
     URL bar collapsing mid-scroll can never shrink the board */
  if(!fs&&window.innerHeight>bigH)bigH=window.innerHeight;
  var maxH=Math.floor(((fs?window.innerHeight:bigH)-280)/ROWS);
  if(maxH>=12)cell=Math.min(cell,maxH);
  W=COLS*cell;H=ROWS*cell;
  var dpr=window.devicePixelRatio||1;
  cv.width=W*dpr;cv.height=H*dpr;
  cv.style.width=W+"px";cv.style.height=H+"px";
  ctx.setTransform(dpr,0,0,dpr,0,0);
  draw();
}

/* ---------------- game state ---------------- */
var grid=[],cur=null,queue=[],state="idle",
    fees=0,feesBlk=0,blocks=0,rowsSealed=0,rowsBurned=0,burnsBlk=0,rowBest=0,
    sealed=0,holdP=null,canHold=true,
    lastT=0,dropAcc=0,fastDrop=false,raf=null,
    sealRows=[],burnRows=[],settleUntil=0,foundUntil=0,nextHeight=null,
    groundedSince=null,lockResets=0,danger=false,hidMid=false,
    deadStart=0,deadUntil=0,
    parts=[],lastPartT=0;

/* the ramp: honest 60ms steps to level 10, then a long gentle tail so the
   good runs get to breathe (owner died at 14 and wanted a longer window) */
function gravityMs(){
  if(blocks<=9)return 850-blocks*60;
  /* the wall: level 21 and beyond holds at 180ms, so past the wall a
     skilled run ends on mistakes, never on raw impossibility */
  return Math.max(180,310-(blocks-9)*12);
}
function newGrid(){
  grid=[];
  for(var r=0;r<ROWS;r++){var row=[];for(var c=0;c<COLS;c++)row.push(0);grid.push(row);}
}
function pieceDims(p){return dims(p.cells);}
function collides(p,x,y){
  for(var i=0;i<p.cells.length;i++){
    var r=y+p.cells[i][0],c=x+p.cells[i][1];
    if(c<0||c>=COLS||r>=ROWS)return true;
    if(r>=0&&grid[r][c])return true;
  }
  return false;
}
function ghostY(){
  var y=cur.y;
  while(!collides(cur,cur.x,y+1))y++;
  return y;
}
function spawn(){
  while(queue.length<4)queue.push(dealPiece());
  var d=queue.shift();
  var dm=dims(d.cells);
  cur={cells:d.cells,rate:d.rate,x:Math.floor((COLS-dm.w)/2),y:-dm.h};
  groundedSince=null;lockResets=0;
  paintQueue();
  /* nowhere to land fully on the board = the stack reached the sky */
  if(ghostY()<0){jamPiece();gameOver();return false;}
  /* a genuinely fat feerate from the feed deserves an announcement, but
     never at the cost of stepping on a fresh clear message */
  if(cur.rate===RB){
    sWhale();
    say("A RAINBOW BRICK is falling: six rows seal on the spot.",true);
  }else if(cur.rate===RB2){
    sWhale();
    say("A PURGE BRICK is falling: it blasts a four by four hole.",true);
  }else if(cur.rate>=80&&Date.now()-lastSayAt>1600){
    sWhale();
    say("A "+cur.rate+" sat/vB whale is falling. Do not waste it.",true);
  }
  return true;
}
function frontRow(){return ROWS-1-sealed;}
/* sealed is derivable state: the contiguous full rows up from the floor.
   Recounting from the board at every settle exit means NO code path can
   leave the counter claiming a sealed row the grid does not have (owner
   screenshot: bricks resting one row above an empty floor). */
/* the fatal piece stays visible: jam whatever fits into the top rows so
   the player sees exactly where the mempool buried them */
function jamPiece(){
  if(!cur)return;
  var gy=ghostY();if(gy>cur.y)cur.y=gy;
  for(var i=0;i<cur.cells.length;i++){
    var r=cur.y+cur.cells[i][0],c=cur.x+cur.cells[i][1];
    if(r>=0&&r<ROWS&&c>=0&&c<COLS)grid[r][c]=cur.rate;
  }
  cur=null;
}
function recountSealed(){
  if(grid.length!==ROWS){
    /* should be impossible; if you ever see this warn, tell the console
       story to the workshop */
    console.warn("bb invariant: grid has "+grid.length+" rows");
    while(grid.length>ROWS)grid.shift();
    while(grid.length<ROWS){var fr9=[];for(var c9=0;c9<COLS;c9++)fr9.push(0);grid.unshift(fr9);}
  }
  var k=0;
  for(var r=ROWS-1;r>=BLOCK_TOP;r--){
    var fullR=true;
    for(var c=0;c<COLS;c++)if(!grid[r][c]){fullR=false;break;}
    if(!fullR)break;
    k++;
  }
  sealed=k;
}
/* per-column gravity over the unsealed rows: a burn must never leave a
   brick hanging in the air (owner hit exactly that near the top line) */
function dropLoose(){
  var front=frontRow(),r,c;
  for(c=0;c<COLS;c++){
    var stack=[];
    for(r=front;r>=0;r--)if(grid[r][c]){stack.push(grid[r][c]);grid[r][c]=0;}
    for(var i=0;i<stack.length;i++)grid[front-i][c]=stack[i];
  }
}
function lock(){
  /* a landing above the top row also ends the run (belt to spawn's braces) */
  var top=cur.y;
  if(top<0){jamPiece();gameOver();return false;}
  var isRB=cur.rate===RB,isBomb=cur.rate===RB2;
  if(!isBomb)for(var i=0;i<cur.cells.length;i++)
    grid[cur.y+cur.cells[i][0]][cur.x+cur.cells[i][1]]=cur.rate;
  if(isBomb){
    /* the purge: a 4x4 blast around the landing cell, sealed rows very
       much included (owner: the block takes the hit and gets rebuilt);
       recount derives the new seal line from whatever survived */
    var bx=cur.x,by=cur.y,bc=0,sealedBefore=sealed;
    for(var br=Math.max(0,by-1);br<=Math.min(ROWS-1,by+2);br++)
      for(var bcc=Math.max(0,bx-1);bcc<=Math.min(COLS-1,bx+2);bcc++)
        if(grid[br][bcc]&&grid[br][bcc]!==RB2){grid[br][bcc]=0;bc++;}
    recountSealed();
    var breached=Math.max(0,sealedBefore-sealed);
    trophy("purge");
    sBurn();shakeRig();
    say("THE PURGE: "+bc+" bricks blasted"+(breached?", "+breached+" sealed row"+(breached===1?"":"s")+" breached. Rebuild.":"."),true);
    paintHud();
  }
  cur=null;canHold=true;
  if(isBomb)dropLoose(); /* what survived the blast tumbles down */
  if(isRB){
    /* the rainbow brick lands: the next SIX rows flood solid upward from
       the seal front (bricks already in them still score their fees);
       reach the top of the block and the level is beaten */
    var rbFront=frontRow(),rbTop=Math.max(BLOCK_TOP,rbFront-5);
    for(var rr2=rbTop;rr2<=rbFront;rr2++)for(var rc2=0;rc2<COLS;rc2++)
      if(!grid[rr2][rc2])grid[rr2][rc2]=RB;
    trophy("rainbow");
    sWhale();
  }
  /* scan only the unsealed rows: the sealed ones are full by construction */
  var front=frontRow(),full=[];
  for(var r=0;r<=front;r++){
    var ok=true;
    for(var c=0;c<COLS;c++)if(!grid[r][c]){ok=false;break;}
    if(ok)full.push(r);
  }
  /* the seal front climbs through contiguous complete rows, bottom first... */
  sealRows=[];burnRows=[];
  while(front>=BLOCK_TOP&&full.indexOf(front)>=0){sealRows.push(front);front--;}
  /* ...and any other complete row is floating above a gap: it burns (the
     house rule). Unless this piece just finished the block, in which case
     whatever sits in the sky is overflow and the wipe handles it. */
  if(sealed+sealRows.length<BLOCK_ROWS)
    burnRows=full.filter(function(r){return r<=front;});
  if(sealRows.length||burnRows.length){
    settleUntil=performance.now()+(reduce?60:(burnRows.length?430:350));
    state="settle";
    if(sealRows.length)sClear(sealRows.length);
    if(burnRows.length)sBurn();
    return true;
  }
  sLand();
  return spawn();
}
function settleApply(){
  /* seal: score the fees of every cell in the sealed rows, with a combo bonus */
  var sats=0,topRow=ROWS,n=sealRows.length;
  sealRows.forEach(function(r){
    if(r<topRow)topRow=r;
    for(var c=0;c<COLS;c++){
      var v=grid[r][c];
      if(v>0)sats+=v*CELL_VB; /* rainbow flood cells score nothing */
      /* coin burst from every sealed cell, colored like its brick */
      if(!reduce&&Math.random()<0.6)parts.push({
        x:c*cell+cell/2,y:r*cell+cell/2,
        vx:(Math.random()-.5)*140,vy:-(60+Math.random()*170),
        r:2+Math.random()*2.5,color:v===RB?"#FFD43B":tierOf(v).bg,life:1});
    }
  });
  var mult=n>=4?3:(n===3?2:(n===2?1.5:1));
  sats=Math.round(sats*mult);
  if(n){
    fees+=sats;feesBlk+=sats;
    rowsSealed+=n;
    if(sats>rowBest)rowBest=sats;
  }
  /* burn: the floating row goes to nothing and everything above falls one,
     which re-exposes whatever the row was covering */
  var nb=burnRows.length,burnTop=ROWS;
  burnRows.sort(function(a,b){return a-b;}).forEach(function(r){
    if(r<burnTop)burnTop=r;
    if(!reduce)for(var c=0;c<COLS;c++)if(Math.random()<0.5)parts.push({
      x:c*cell+cell/2,y:r*cell+cell/2,
      vx:(Math.random()-.5)*90,vy:-(20+Math.random()*70),
      r:1.5+Math.random()*2,color:"#E0503C",life:0.8});
    grid.splice(r,1);
    var fresh=[];for(var c2=0;c2<COLS;c2++)fresh.push(0);
    grid.unshift(fresh);
  });
  rowsBurned+=nb;burnsBlk+=nb;
  recountSealed(); /* derive, never accumulate: the board is the truth */
  if(n){
    var cr=led.rows+rowsSealed;
    if(cr>=100)trophy("rows100");
    if(cr>=1000)trophy("stacker");
    if(cr>=5000)trophy("rows5k");
    if(cr>=21000)trophy("rows21k");
  }
  sealRows=[];burnRows=[];
  if(n){
    floatText("+"+fmt(sats)+(mult>1?" ×"+mult:""),topRow,n>=2);
    if(n>=2)shakeRig();
    if(nb)say(n+" row"+(n===1?"":"s")+" sealed (+"+fmt(sats)+" sats), and a full row above a gap burned to nothing.",true);
    else say(n>=2?
      (n+" rows sealed at once: +"+fmt(sats)+" sats ("+mult+"x combo)."):
      ("Row sealed: +"+fmt(sats)+" sats. The block grows from the bottom."),true);
  }else{
    floatText("BURNED · 0 SATS",Math.max(1,burnTop),false);
    say(nb===1?
      "A full row burned above a gap: packed space over a hole is wasted. Seal from the bottom up.":
      (nb+" full rows burned above the gaps. Seal from the bottom up."));
  }
  paintHud();
  if(sealed>=BLOCK_ROWS){blockFound();return;}
  if(nb){
    /* the burn pulled the floor out: let loose bricks tumble, and if the
       fallen debris completes the front row it seals like anything else
       (contiguous from the front by construction, so never a new burn) */
    dropLoose();
    var front2=frontRow(),full2=[],r2,c2,ok2;
    for(r2=front2;r2>=BLOCK_TOP;r2--){
      ok2=true;
      for(c2=0;c2<COLS;c2++)if(!grid[r2][c2]){ok2=false;break;}
      if(!ok2)break;
      full2.push(r2);
    }
    if(full2.length){
      sealRows=full2;burnRows=[];
      settleUntil=performance.now()+(reduce?60:350);
      sClear(full2.length);
      return; /* stay in settle; the next apply banks these */
    }
  }
  state="run";
  spawn();
  if(hidMid){hidMid=false;setPause(true);}
}
function blockFound(){
  state="found";
  foundUntil=performance.now()+(reduce?300:1050);
  blocks++;
  /* whatever got parked above the line never made this block */
  var over=0;
  for(var r=0;r<BLOCK_TOP;r++)for(var c=0;c<COLS;c++)if(grid[r][c])over++;
  sBlock();shakeRig();
  if(!reduce)for(var k=0;k<70;k++)parts.push({
    x:Math.random()*W,y:(BLOCK_TOP+Math.random()*BLOCK_ROWS)*cell,
    vx:(Math.random()-.5)*220,vy:-(120+Math.random()*260),
    r:2+Math.random()*3,
    color:TIERS[(Math.random()*TIERS.length)|0].bg,life:1.3});
  floatText("BLOCK"+(nextHeight?" #"+fmt(nextHeight):"")+" FOUND",BLOCK_TOP+2,true);
  say("BLOCK"+(nextHeight?" #"+fmt(nextHeight):"")+" FOUND: scored the "+(SUBSIDY/1e8)+" BTC subsidy a real miner would collect, plus "+fmt(feesBlk)+" sats in fees."+
    (over?" The "+over+" cells above the line fall to the floor of the next one.":"")+" Level "+(blocks+1)+": it deals faster.",true);
  /* what is inside this one? printed odds, one roll per found block,
     rarest checked first */
  var roll=Math.random();
  if(roll<1/52500){trophy("satoshi");floatText("SATOSHI'S BLOCK",BLOCK_TOP+4,true);}
  else if(roll<1/2009)trophy("headline");
  else if(roll<1/100)trophy("pizza");
  else if(roll<1/21){trophy("btc");floatText("₿",BLOCK_TOP+4,true);}
  if(burnsBlk===0)trophy("clean");
  if(over===0)trophy("airtight");
  if(blocks+1>=10)trophy("lvl10");
  if(blocks+1>=21)trophy("lvl21");
  var cb=led.blk+blocks;
  if(cb>=1)trophy("blk1");
  if(cb>=10)trophy("blk10");
  if(cb>=21)trophy("epoch");
  if(cb>=100)trophy("blk100");
  if(cb>=500)trophy("blk500");
  if(cb>=2016)trophy("blk2016");
  paintHud();
}
function foundApply(){
  /* what did not fit above the line falls to the floor and starts the next
     template: the mempool never empties */
  var stacks=[],r,c;
  for(c=0;c<COLS;c++){
    var s=[];
    for(r=0;r<BLOCK_TOP;r++)if(grid[r][c])s.push(grid[r][c]);
    stacks.push(s);
  }
  newGrid();
  for(c=0;c<COLS;c++){
    var s2=stacks[c];
    for(var i=0;i<s2.length;i++)grid[ROWS-1-i][c]=s2[s2.length-1-i];
  }
  sealed=0;feesBlk=0;burnsBlk=0;
  if(nextHeight){nextHeight++;paintOvHeight();}
  fetchFeed(); /* a found block drains the pool: deal the next from a fresh feed */
  state="run";
  paintHud();
  /* fallen debris can already complete bottom rows; they seal like anything
     else resting on the floor (never above a gap: gravity leaves no holes) */
  var front=frontRow(),full=[];
  for(r=0;r<=front;r++){
    var ok=true;
    for(c=0;c<COLS;c++)if(!grid[r][c]){ok=false;break;}
    if(ok)full.push(r);
  }
  sealRows=[];burnRows=[];
  while(front>=BLOCK_TOP&&full.indexOf(front)>=0){sealRows.push(front);front--;}
  if(sealRows.length){
    settleUntil=performance.now()+(reduce?60:350);
    state="settle";
    sClear(sealRows.length);
  }else{
    spawn();
    if(hidMid){hidMid=false;setPause(true);}
  }
}
/* a successful move while resting on the stack earns a short lock-delay
   reset (capped, so a piece cannot dance forever) */
function touchGround(){
  if(!cur)return;
  if(!collides(cur,cur.x,cur.y+1)){groundedSince=null;return;}
  if(groundedSince!==null&&lockResets<5){groundedSince=performance.now();lockResets++;}
}
function tryMove(dx){
  if(!cur||state!=="run")return;
  if(!collides(cur,cur.x+dx,cur.y)){cur.x+=dx;sMove();touchGround();draw();}
}
function tryRotate(){
  if(!cur||state!=="run")return;
  var rc=rotateCells(cur.cells);
  var old=cur.cells,oldX=cur.x;
  cur.cells=rc;
  /* wall kicks: try in place, then one and two cells to either side */
  var kicks=[0,-1,1,-2,2],ok=false;
  for(var i=0;i<kicks.length;i++){
    if(!collides(cur,oldX+kicks[i],cur.y)){cur.x=oldX+kicks[i];ok=true;break;}
  }
  if(!ok){cur.cells=old;cur.x=oldX;return;}
  sRot();touchGround();draw();
}
function hardDrop(){
  if(!cur||state!=="run")return;
  var gy=ghostY();
  if(gy<0){jamPiece();gameOver();draw();return;}
  cur.y=gy;
  groundedSince=null;
  lock();draw();
}
/* the classic pressure valve: set one transaction aside, once per drop */
function tryHold(){
  if(!cur||state!=="run")return;
  if(!canHold){say("Hold is spent until this brick lands.");return;}
  var swap=holdP;
  holdP={cells:cur.cells,rate:cur.rate};
  canHold=false;
  paintHold();sHold();
  if(swap){
    var dm=dims(swap.cells);
    cur={cells:swap.cells,rate:swap.rate,x:Math.floor((COLS-dm.w)/2),y:-dm.h};
    groundedSince=null;lockResets=0;
    say("Swapped: the held "+swap.rate+" sat/vB brick is falling, "+holdP.rate+" sat/vB set aside.");
    if(ghostY()<0){jamPiece();gameOver();draw();return;}
  }else{
    cur=null;
    say("Held the "+holdP.rate+" sat/vB brick. Next one is falling.");
    spawn();
  }
  draw();
}

/* ---------------- runs ---------------- */
function startRound(){
  if(cv.parentNode&&cv.parentNode.classList)cv.parentNode.classList.remove("bb-deadframe");
  newGrid();queue=[];sealRows=[];burnRows=[];parts=[];
  fees=0;feesBlk=0;blocks=0;rowsSealed=0;rowsBurned=0;burnsBlk=0;rowBest=0;sealed=0;
  holdP=null;canHold=true;paintHold();
  dropAcc=0;fastDrop=false;
  groundedSince=null;lockResets=0;danger=false;hidMid=false;
  state="run";
  overlay.hidden=true;
  paintPause();
  startMusic();
  fetchFeed();
  spawn();
  say("Mining"+(nextHeight?" toward block #"+fmt(nextHeight):"")+". Seal the bottom row first; a full row above a gap burns.");
  lastT=performance.now();
  if(!raf)raf=requestAnimationFrame(loop);
  paintHud();draw();
}
/* death comes in two beats: the stack floods red from the top down (the
   "dead" state, drawn in draw()), then the overlay reads the will */
function gameOver(){
  if(state==="over"||state==="dead")return;
  cur=null;
  state="dead";
  if(cv.parentNode&&cv.parentNode.classList)cv.parentNode.classList.add("bb-deadframe");
  deadStart=performance.now();
  deadUntil=deadStart+(reduce?200:900)+250;
  stopMusic();
  sOver();
}
function finishOver(){
  state="over";
  led.g++;led.sum+=fees;led.blk+=blocks;led.rows+=rowsSealed;led.bu+=rowsBurned;
  if(fees>led.best)led.best=fees;
  if(rowBest>led.br)led.br=rowBest;
  if(blocks+1>led.lv)led.lv=blocks+1;
  saveLed();paintLedger();
  var score=(blocks*SUBSIDY+fees)/1e8;
  var math=blocks>0?
    ("what a real miner would collect: "+blocks+" × "+(SUBSIDY/1e8)+" BTC subsidy + "+fmt(fees)+" sats in fees"):
    ("fees only, "+fmt(fees)+" sats: no block, no subsidy");
  var line;
  if(blocks===0)line="No block found. The subsidy scores nothing for almost; that is the entire business.";
  else if(blocks<3)line="The stack always wins eventually; the question is how many blocks you pull out of it first.";
  else line="Blocks "+blocks+" deep at that speed is genuinely respectable. The difficulty adjustment sends its regards.";
  ovTitle.textContent="THE MEMPOOL BURIED YOU";
  ovText.innerHTML="<b>Score "+score.toFixed(3)+" BTC</b> ("+math+") · "+blocks+" block"+(blocks===1?"":"s")+" found · "+rowsSealed+" rows sealed · "+rowsBurned+" burned"+
    (rowBest>0?" · best row "+fmt(rowBest)+" sats":"")+".<br><br>"+line;
  ovBtn.textContent="Mine again";
  overlay.hidden=false;
  say("Run over: score "+score.toFixed(3)+" BTC, "+blocks+" blocks found, "+rowsSealed+" rows sealed, "+rowsBurned+" burned. "+line);
}

/* ---------------- the attract demo: a silent self-player behind the start
   overlay, sibling idiom. It uses the real grid, pieces and seal/burn rules
   but never touches fees, trophies, sounds or the HUD. */
var demoNext=0;
function demoStep(t){
  if(t<demoNext)return;
  demoNext=t+70;
  if(!cur){
    var d=dealPiece();
    if(d.rate<0)d={cells:[[0,0]],rate:sampleRate()}; /* no legends in the lobby */
    if(Math.random()<0.5)d={cells:rotateCells(d.cells),rate:d.rate};
    var dm=dims(d.cells);
    /* aim for an open slot in the front row most of the time */
    var fr=frontRow(),opts=[],c0;
    for(c0=0;c0<=COLS-dm.w;c0++)if(!grid[fr][c0])opts.push(c0);
    var x=(opts.length&&Math.random()<0.75)?
      opts[(Math.random()*opts.length)|0]:
      ((Math.random()*(COLS-dm.w+1))|0);
    cur={cells:d.cells,rate:d.rate,x:x,y:-dm.h};
    return;
  }
  if(!collides(cur,cur.x,cur.y+1)){cur.y++;return;}
  if(cur.y<0){newGrid();sealed=0;cur=null;return;} /* demo topped out: reset */
  for(var i=0;i<cur.cells.length;i++){
    var r=cur.y+cur.cells[i][0],c=cur.x+cur.cells[i][1];
    if(r>=0&&r<ROWS)grid[r][c]=cur.rate;
  }
  cur=null;
  /* silent seal/burn, same rules as play */
  var front=frontRow(),full=[],r2,c2,ok2;
  for(r2=0;r2<=front;r2++){
    ok2=true;
    for(c2=0;c2<COLS;c2++)if(!grid[r2][c2]){ok2=false;break;}
    if(ok2)full.push(r2);
  }
  var f2=front;
  while(f2>=BLOCK_TOP&&full.indexOf(f2)>=0)f2--;
  full.filter(function(rr){return rr<=f2;}).sort(function(x2,y2){return x2-y2;}).forEach(function(rr){
    grid.splice(rr,1);
    var fresh=[];for(var cc=0;cc<COLS;cc++)fresh.push(0);
    grid.unshift(fresh);
  });
  recountSealed();
  if(sealed>=BLOCK_ROWS){newGrid();sealed=0;} /* demo block found: go again */
}

/* ---------------- main loop ---------------- */
function loop(t){
  raf=requestAnimationFrame(loop);
  var dt=Math.min(100,t-lastT);lastT=t;
  if(state==="idle"){
    demoStep(t);
    draw();
    return;
  }
  if(state==="settle"){
    if(t>=settleUntil)settleApply();
    draw();
    return;
  }
  if(state==="found"){
    if(t>=foundUntil)foundApply();
    draw();
    return;
  }
  if(state==="dead"){
    if(t>=deadUntil)finishOver();
    draw();
    return;
  }
  if(state!=="run"){
    if(parts.length)draw(); /* let clear particles finish falling */
    return;
  }
  dropAcc+=dt;
  var interval=fastDrop?45:gravityMs();
  while(dropAcc>=interval){
    dropAcc-=interval;
    if(cur){
      if(!collides(cur,cur.x,cur.y+1)){cur.y++;groundedSince=null;}
      else if(cur.y<0){jamPiece();gameOver();break;}
      else{
        /* grounded: the lock delay below gives a beat to slide, the way
           every falling-brick game since the 90s has been kind */
        if(groundedSince===null)groundedSince=t;
        dropAcc=0;break;
      }
    }
  }
  if(cur&&state==="run"&&groundedSince!==null){
    if(!collides(cur,cur.x,cur.y+1))groundedSince=null; /* slid off a ledge */
    else if(t-groundedSince>=(fastDrop?70:380)){
      groundedSince=null;
      lock();
    }
  }
  /* danger heat: the stack is inside the top four rows */
  var hot=false;
  for(var r=0;r<4&&!hot;r++)for(var c=0;c<COLS;c++)if(grid[r][c]){hot=true;break;}
  if(hot&&!danger)sDanger();
  danger=hot;
  draw();
}

/* ---------------- painters ---------------- */
function draw(){
  ctx.fillStyle="#0B0908";ctx.fillRect(0,0,W,H);
  /* the sky above the block line is overflow parking: darker, never paid */
  ctx.fillStyle="rgba(0,0,0,.30)";
  ctx.fillRect(0,0,W,BLOCK_TOP*cell);
  ctx.strokeStyle="rgba(255,220,160,.05)";ctx.lineWidth=1;
  for(var c=1;c<COLS;c++){ctx.beginPath();ctx.moveTo(c*cell+.5,0);ctx.lineTo(c*cell+.5,H);ctx.stroke();}
  for(var r=1;r<ROWS;r++){ctx.beginPath();ctx.moveTo(0,r*cell+.5);ctx.lineTo(W,r*cell+.5);ctx.stroke();}
  /* the 4M WU line: everything below it is the block being built */
  ctx.strokeStyle="rgba(255,217,160,.30)";ctx.lineWidth=1;
  ctx.setLineDash([5,4]);
  ctx.beginPath();ctx.moveTo(0,BLOCK_TOP*cell+.5);ctx.lineTo(W,BLOCK_TOP*cell+.5);ctx.stroke();
  ctx.setLineDash([]);
  if(cell>=18){
    ctx.fillStyle="rgba(255,217,160,.34)";
    ctx.font="700 "+Math.max(7,Math.floor(cell*0.26))+"px Cascadia Mono,Consolas,monospace";
    ctx.textAlign="right";ctx.textBaseline="bottom";
    ctx.fillText("THE 4M WU LINE",W-4,BLOCK_TOP*cell-3);
  }
  /* settled cells */
  for(r=0;r<ROWS;r++)for(c=0;c<COLS;c++)if(grid[r][c])drawCell(c,r,grid[r][c]);
  /* the sealed part of the block: welded, with a bright seam on top */
  if(sealed>0){
    var sy=(ROWS-sealed)*cell;
    ctx.fillStyle="rgba(247,147,26,.08)";
    ctx.fillRect(0,sy,W,sealed*cell);
    ctx.strokeStyle="rgba(255,217,160,.55)";ctx.lineWidth=2;
    ctx.beginPath();ctx.moveTo(0,sy+1);ctx.lineTo(W,sy+1);ctx.stroke();
  }
  /* the open cells of the row the block wants next: soft glowing sockets,
     a FILL on purpose so they can never be mistaken for the dashed ghost */
  if((state==="run"||state==="pause"||state==="idle")&&sealed<BLOCK_ROWS){
    var fr=frontRow();
    var ga=reduce?0.04:(0.03+0.02*(0.5+0.5*Math.sin(performance.now()/950)));
    ctx.fillStyle="rgba(255,217,160,"+ga.toFixed(3)+")";
    for(var gc=0;gc<COLS;gc++)if(!grid[fr][gc])
      ctx.fillRect(gc*cell+1,fr*cell+1,cell-2,cell-2);
  }
  /* sealing rows flash gold, burning rows flash ember red */
  if(state==="settle"){
    var u=reduce?0.5:Math.abs(Math.sin(performance.now()/60));
    if(sealRows.length){
      ctx.fillStyle="rgba(255,217,160,"+(0.25+0.45*u).toFixed(2)+")";
      sealRows.forEach(function(rr2){ctx.fillRect(0,rr2*cell,W,cell);});
    }
    if(burnRows.length){
      ctx.fillStyle="rgba(224,80,60,"+(0.30+0.40*u).toFixed(2)+")";
      burnRows.forEach(function(rr3){ctx.fillRect(0,rr3*cell,W,cell);});
    }
  }
  /* a found block glows whole while the fanfare plays */
  if(state==="found"){
    var fu=reduce?0.4:Math.abs(Math.sin(performance.now()/90));
    ctx.fillStyle="rgba(255,217,160,"+(0.16+0.30*fu).toFixed(2)+")";
    ctx.fillRect(0,BLOCK_TOP*cell,W,BLOCK_ROWS*cell);
  }
  /* the death flood: red rolls from the sky down to the floor, then the
     overlay reads the will */
  if(state==="dead"||state==="over"){
    var df=state==="over"?1:Math.min(1,(performance.now()-deadStart)/(reduce?200:900));
    var covered=Math.ceil(df*ROWS);
    if(covered>0){
      ctx.fillStyle="rgba(224,80,60,.62)";
      ctx.fillRect(0,0,W,covered*cell);
    }
  }
  if(cur&&(state==="run"||state==="pause"||state==="idle")){
    if(ghostOn){
      var gy=ghostY();
      ctx.strokeStyle="rgba(255,220,160,.19)";ctx.lineWidth=1.5;
      ctx.setLineDash([4,3]);
      cur.cells.forEach(function(cc){
        ctx.strokeRect(( cur.x+cc[1])*cell+1.5,(gy+cc[0])*cell+1.5,cell-3,cell-3);
      });
      ctx.setLineDash([]);
    }
    cur.cells.forEach(function(cc){
      if(cur.y+cc[0]>=0)drawCell(cur.x+cc[1],cur.y+cc[0],cur.rate);
    });
  }
  /* coin particles from cleared rows */
  if(parts.length){
    var now=performance.now(),pdt=Math.min(0.05,(now-(lastPartT||now))/1000);
    lastPartT=now;
    for(var k=parts.length-1;k>=0;k--){
      var pp=parts[k];
      pp.vy+=560*pdt;pp.x+=pp.vx*pdt;pp.y+=pp.vy*pdt;pp.life-=pdt*1.4;
      if(pp.life<=0||pp.y>H+10){parts.splice(k,1);continue;}
      ctx.globalAlpha=Math.min(1,pp.life*2);
      ctx.fillStyle=pp.color;
      ctx.beginPath();ctx.arc(pp.x,pp.y,pp.r,0,6.3);ctx.fill();
    }
    ctx.globalAlpha=1;
  }else lastPartT=0;
  /* danger heat when the stack is inside the top four rows */
  if(danger&&(state==="run"||state==="pause")){
    var da=reduce?0.16:(0.10+0.08*Math.abs(Math.sin(performance.now()/280)));
    var grad=ctx.createLinearGradient(0,0,0,cell*5);
    grad.addColorStop(0,"rgba(224,80,60,"+da.toFixed(2)+")");
    grad.addColorStop(1,"rgba(224,80,60,0)");
    ctx.fillStyle=grad;
    ctx.fillRect(0,0,W,cell*5);
  }
}
function drawCell(cx,cyR,rate){
  var px=cx*cell+1,py=cyR*cell+1,ps=cell-2;
  if(rate===RB2){
    /* the purge brick: charcoal shell, pulsing red core */
    ctx.fillStyle="#2A1214";
    rr(px,py,ps,ps,3);ctx.fill();
    var ra=reduce?0.7:(0.45+0.45*Math.abs(Math.sin(performance.now()/160)));
    ctx.strokeStyle="rgba(224,80,60,"+ra.toFixed(2)+")";ctx.lineWidth=1.5;
    rr(px+1,py+1,ps-2,ps-2,3);ctx.stroke();
    ctx.fillStyle="rgba(224,80,60,"+ra.toFixed(2)+")";
    ctx.beginPath();ctx.arc(px+ps/2,py+ps/2,Math.max(2,ps*0.16),0,6.3);ctx.fill();
    return;
  }
  if(rate===RB){
    /* the rainbow brick: hue slides along the diagonal, road style */
    var hue=reduce?45:Math.floor((performance.now()/6+(cx+cyR)*36)%360);
    ctx.fillStyle=reduce?"#FFD43B":"hsl("+hue+",85%,62%)";
    rr(px,py,ps,ps,3);ctx.fill();
    ctx.strokeStyle="rgba(255,255,255,.4)";ctx.lineWidth=1;
    rr(px+.5,py+.5,ps-1,ps-1,3);ctx.stroke();
    return;
  }
  var t=tierOf(rate);
  if(t.glow){ctx.shadowColor="rgba(255,217,160,.7)";ctx.shadowBlur=8;}
  ctx.fillStyle=t.bg;
  rr(px,py,ps,ps,3);ctx.fill();
  ctx.shadowBlur=0;
  ctx.strokeStyle="rgba(0,0,0,.35)";ctx.lineWidth=1;
  rr(px+.5,py+.5,ps-1,ps-1,3);ctx.stroke();
  ctx.strokeStyle="rgba(255,255,255,.16)";
  ctx.beginPath();ctx.moveTo(px+2.5,py+2);ctx.lineTo(px+ps-2.5,py+2);ctx.stroke();
  if(cell>=20){
    ctx.fillStyle=t.ink;
    ctx.font="700 "+Math.max(8,Math.floor(cell*0.38))+"px Cascadia Mono,Consolas,monospace";
    ctx.textAlign="center";ctx.textBaseline="middle";
    ctx.fillText(String(rate),px+ps/2,py+ps/2+1);
  }
}
function rr(x,y,w,h,r){
  if(w<2*r)r=w/2;if(h<2*r)r=h/2;
  ctx.beginPath();
  ctx.moveTo(x+r,y);
  ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);
  ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);
  ctx.closePath();
}
function paintHud(){
  var fe=el("bb-fees");if(fe){fe.textContent=fmt(fees);fe.className=fees>0?"bb-hot":"";}
  txt("bb-level",String(blocks+1));
  txt("bb-blocks",String(blocks));
  txt("bb-rows",sealed+"/"+BLOCK_ROWS);
  var tf=el("bb-tfill");
  if(tf)tf.style.width=(sealed/BLOCK_ROWS*100)+"%";
}
function pieceEl(p,px){
  px=px||11;
  /* the preview boxes are fixed-height: tall pieces shrink to fit instead
     of growing the box and shoving the layout below (owner report) */
  var dmH=dims(p.cells).h;
  if(dmH*px+dmH-1>56)px=Math.floor((56-(dmH-1))/dmH);
  var t=(p.rate===RB||p.rate===RB2)?null:tierOf(p.rate),dm=dims(p.cells);
  var d=document.createElement("div");
  d.className="bb-qpiece";
  d.style.gridTemplateColumns="repeat("+dm.w+","+px+"px)";
  var occ={};
  p.cells.forEach(function(cc){occ[cc[0]+"_"+cc[1]]=1;});
  for(var rI=0;rI<dm.h;rI++)for(var cI=0;cI<dm.w;cI++){
    var cellEl=document.createElement("div");
    cellEl.className="bb-qcell"+(occ[rI+"_"+cI]?(t?"":(p.rate===RB2?" bb-qbomb":" bb-qrb")):" bb-qempty");
    cellEl.style.width=px+"px";cellEl.style.height=px+"px";
    if(occ[rI+"_"+cI]&&t)cellEl.style.background=t.bg;
    d.appendChild(cellEl);
  }
  d.title=t?p.rate+" sat/vB":(p.rate===RB2?"the purge brick":"the rainbow brick");
  return d;
}
/* one piece, big and centered: the only brick worth planning around */
