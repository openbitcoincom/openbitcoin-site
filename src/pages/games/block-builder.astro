  .bb-float{position:absolute;pointer-events:none;transform:translateX(-50%);
    font:700 13px var(--mono);letter-spacing:.06em;color:#FFD9A0;white-space:nowrap;
    text-shadow:0 0 10px rgba(255,166,60,.8),0 1px 2px rgba(0,0,0,.8);
    animation:bb-floatup .95s ease-out forwards}
  .bb-float.bb-bigfloat{font-size:16px;letter-spacing:.14em;color:#FFB84D}
  @keyframes bb-floatup{from{opacity:1;margin-top:0}to{opacity:0;margin-top:-44px}}
  .bb-rig.bb-shake{animation:bb-shakes .45s ease}
  @keyframes bb-shakes{0%,100%{transform:translate(0,0)}20%{transform:translate(-3px,1px)}40%{transform:translate(3px,-1px)}60%{transform:translate(-2px,-1px)}80%{transform:translate(2px,1px)}}
  @media(prefers-reduced-motion:reduce){
    .bb-float{animation-duration:.01s;animation-delay:.9s;opacity:1}
    .bb-rig.bb-shake{animation:none}
  }
  .bb-overlay{position:absolute;inset:8px;display:flex;align-items:center;justify-content:center;
    background:rgba(6,5,4,.82);border-radius:6px;overflow:auto}
  .bb-overlay[hidden]{display:none}
  .bb-ovinner{text-align:center;padding:14px 16px;max-width:92%;max-height:100%;margin:auto}
  .bb-ovinner b{display:block;font:700 15px var(--mono);letter-spacing:.12em;color:#FFD9A0}
  .bb-ovinner p{font:600 11px/1.65 var(--mono);color:#B99B6B;margin:10px 0 0}
  .bb-ovinner p b{display:inline;font-size:11px;color:#FFB84D;letter-spacing:.02em}
  .bb-go{margin-top:14px;background:#F7931A;color:#241200;border:1.5px solid rgba(255,166,60,.65);
    border-radius:10px;cursor:pointer;min-height:48px;padding:0 26px;
    font:700 14px var(--mono);letter-spacing:.13em;text-transform:uppercase;
    box-shadow:0 5px 16px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.14),0 0 22px rgba(247,147,26,.22)}
  .bb-go:hover{background:#FFA733}

  .bb-side{display:flex;flex-direction:column;gap:8px;min-width:128px;flex:0 1 150px}
  .bb-led{background:#0A0705;border:1px solid #35291A;border-radius:9px;padding:7px 10px 8px;
    box-shadow:inset 0 2px 8px rgba(0,0,0,.7)}
  .bb-led i{display:block;font:700 7.5px var(--mono);letter-spacing:.16em;text-transform:uppercase;color:#A98F65;font-style:normal;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .bb-led b{display:block;font:700 17px var(--mono);color:#FFD9A0;margin-top:3px;
    font-variant-numeric:tabular-nums;white-space:nowrap;text-shadow:0 0 9px rgba(255,166,60,.35)}
  .bb-led b.bb-hot{color:#FFB84D}
  .bb-tbar{display:block;height:4px;background:#241C12;border-radius:2px;margin-top:6px;overflow:hidden}
  .bb-tbar span{display:block;height:100%;width:0%;background:#F7931A;border-radius:2px;
    transition:width .3s ease}
  .bb-next{box-sizing:border-box;background:#0A0705;border:1px solid #35291A;border-radius:9px;padding:7px 10px 9px;
    box-shadow:inset 0 2px 8px rgba(0,0,0,.7);display:flex;flex-direction:column}
  .bb-next i{display:block;font:700 7.5px var(--mono);letter-spacing:.16em;text-transform:uppercase;color:#A98F65;font-style:normal}
  .bb-hold{box-sizing:border-box;background:#0A0705;border:1px solid #35291A;border-radius:9px;padding:7px 10px 9px;
    box-shadow:inset 0 2px 8px rgba(0,0,0,.7);min-height:56px;display:flex;flex-direction:column}
  .bb-hold i{display:block;font:700 7.5px var(--mono);letter-spacing:.16em;text-transform:uppercase;color:#A98F65;font-style:normal}
  .bb-queue{flex:0 0 58px;display:flex;gap:8px;margin-top:8px;align-items:center;justify-content:center}
  
  .bb-topbtns{position:absolute;top:8px;right:42px;
    display:flex;gap:6px;z-index:3;opacity:.7;transition:opacity .15s ease}
  .bb-topbtns:hover{opacity:1}
  .bb-opttab{position:absolute;top:8px;right:8px;z-index:3;
    display:flex;align-items:center;justify-content:center;background:rgba(18,14,10,.45);
    border:1px solid rgba(62,51,34,.55);border-radius:7px;color:#B99B6B;cursor:pointer;
    width:28px;height:28px;opacity:.7;transition:opacity .15s ease}
  .bb-opttab:hover{opacity:1}
  .bb-opttab svg{width:14px;height:14px}
  .bb-opttab[aria-expanded="true"]{border-color:rgba(247,147,26,.55);color:#FFB84D;opacity:1}
  .bb-opttab:hover{color:#FFD9A0;border-color:#5A452A}
  
  .bb-opttab[hidden],.bb-topbtns[hidden]{display:none}
  .bb-topbtns .bb-mini{width:28px;height:28px;min-height:0;border-radius:7px;
    background:rgba(18,14,10,.45);border:1px solid rgba(62,51,34,.55)}
  .bb-topbtns .bb-mini svg{width:13px;height:13px}
  .bb-topbtns .bb-mini[aria-pressed="true"]{border-color:rgba(247,147,26,.55);color:#FFB84D}
  .bb-holdhint{font:600 7.5px var(--mono);letter-spacing:.09em;text-transform:uppercase;color:#8A7452;
    text-align:center;line-height:1.9;padding:2px}
  .bb-qpiece{display:grid;gap:1px}
  .bb-qcell{width:11px;height:11px;border-radius:2px}
  .bb-qcell.bb-qempty{background:transparent}
  .bb-qcell.bb-qrb{animation:bb-rb 1s linear infinite}
  @keyframes bb-rb{0%,100%{background:#FF5A5A}20%{background:#FFD43B}40%{background:#63C36C}60%{background:#3BB9B0}80%{background:#5E81B5}}
  @media(prefers-reduced-motion:reduce){.bb-qcell.bb-qrb{animation:none;background:#FFD43B}}
  .bb-qcell.bb-qbomb{background:#2A1214;border:1px solid #E0503C;animation:bb-bomb 1s ease infinite}
  @keyframes bb-bomb{0%,100%{box-shadow:0 0 2px rgba(224,80,60,.4)}50%{box-shadow:0 0 7px rgba(224,80,60,.9)}}
  @media(prefers-reduced-motion:reduce){.bb-qcell.bb-qbomb{animation:none}}
  .bb-chip{font:700 7.5px var(--mono);letter-spacing:.14em;color:#97815A;text-align:center;
    border:1px dashed #4A3B24;border-radius:7px;padding:6px 8px;line-height:1.5}
  .bb-chip.bb-livefeed{color:#C98A2E;border-color:#6B5A3E}


  .bb-console{display:flex;align-items:center;gap:10px;margin-top:12px}
  .bb-help{flex:1;font:600 8.5px var(--mono);letter-spacing:.08em;color:#97815A;text-align:center}
  .bb-mini{min-height:40px;display:flex;align-items:center;justify-content:center;
