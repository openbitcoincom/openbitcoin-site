var muted=readInt("ob-mc-mute",0)===1,actx=null;
function ac(){
  if(!actx){try{actx=new (window.AudioContext||window.webkitAudioContext)();}catch(e){}}
  if(actx&&actx.state==="suspended")actx.resume();
  return actx;
}
function tone(freq,dur,type,vol,when,slide){
  var a=ac();if(!a||muted)return;
  var t=a.currentTime+(when||0),o=a.createOscillator(),g=a.createGain();
  o.type=type||"sine";o.frequency.setValueAtTime(freq,t);
  if(slide)o.frequency.exponentialRampToValueAtTime(slide,t+dur);
  g.gain.setValueAtTime(0,t);
  g.gain.linearRampToValueAtTime(vol,t+0.008);
  g.gain.exponentialRampToValueAtTime(0.0001,t+dur);
  o.connect(g);g.connect(a.destination);
  o.start(t);o.stop(t+dur+0.05);
}
function sHop(){tone(660,0.035,"square",0.03);}
function sHit(){tone(220,0.16,"sawtooth",0.1,0,60);tone(140,0.2,"sine",0.12,0.04,50);}
function sPurge(){tone(160,0.14,"square",0.08,0,80);tone(120,0.18,"square",0.08,0.12,60);}
function sBump(){tone(700,0.08,"triangle",0.1,0,1400);}
function sConfirm(){var seq=[659,784,1047,1319],i;for(i=0;i<seq.length;i++)tone(seq[i],0.15,"triangle",0.11,i*0.08);}
function sMineTick(){tone(1200,0.03,"square",0.02);}
function sMined(){tone(196,0.18,"sine",0.14,0,110);}
function sLevel(){tone(523,0.1,"triangle",0.09);tone(659,0.12,"triangle",0.09,0.08);}
function sOver(){var seq=[392,330,262,196],i;for(i=0;i<seq.length;i++)tone(seq[i],0.2,"triangle",0.1,i*0.12);}
function paintMute(){
  var on=el("mc-mute-on"),off=el("mc-mute-off"),btn=el("mc-mute");
  if(on)on.hidden=muted;if(off)off.hidden=!muted;
