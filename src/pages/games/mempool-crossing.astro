el("mc-mute").addEventListener("click",function(){
  muted=!muted;store("ob-mc-mute",muted?"1":"0");paintMute();if(!muted)tone(880,0.08,"sine",0.08);
});
paintMute();

/* ---------------- sizing ---------------- */
var cell=34,W=0,H=0;
function sizeBoard(){
  var old=cell;
  var avail=rig.clientWidth-40-16;
  cell=Math.max(16,Math.min(38,Math.floor(avail/COLS)));
  var maxH=Math.floor((window.innerHeight-300)/ROWS);
  if(maxH>=16)cell=Math.min(cell,maxH);
  W=COLS*cell;H=ROWS*cell;
  var dpr=window.devicePixelRatio||1;
  cv.width=W*dpr;cv.height=H*dpr;
  cv.style.width=W+"px";cv.style.height=H+"px";
  ctx.setTransform(dpr,0,0,dpr,0,0);
  /* traffic lives in pixels: rescale chips and lane physics with the board */
  if(lanes.length&&old!==cell&&old>0){
    var k=cell/old;
    lanes.forEach(function(l,li){
      l.spec=laneSpec(li);
      l.chips.forEach(function(ch){ch.x*=k;ch.w*=k;});
    });
  }
  draw(performance.now());
}

/* ---------------- game state ---------------- */
var state="idle",lanes=[],player=null,lives=3,bumps=2,score=0,confirms=0,level=1,
    blockT=10000,blockCycle=10000,purgeT=0,raf=null,lastT=0,hopLock=0,
    inTemplate=false,flash=0,nextHeight=null;

var LEVEL_LINES=[
  "Congestion rising: an inscription mint just dropped.",
  "Congestion rising: someone is consolidating dust at the worst possible time.",
  "Congestion rising: an exchange just batched a thousand withdrawals.",
  "Congestion rising: weekend calm is over and the arbitrage bots are awake.",
  "Congestion rising: a whale moved and everyone is front-running the panic."
];

function laneSpec(li){
  /* li 0..5 = BANDS index; density from live share, clamped playable */
  var d=Math.max(0.06,Math.min(0.6,share[li]));
  var lvMul=1+(level-1)*0.07;
  return {
    speed:BANDS[li].speed*lvMul*(cell/34),
    gapPx:Math.max(cell*1.15,cell*(4.6-d*6)/lvMul),
    color:BANDS[li].color,ink:BANDS[li].ink,label:BANDS[li].label,
    dir:(li%2===0)?1:-1
  };
}
function initLanes(){
  lanes=LANE_ROWS.map(function(row,li){
    var spec=laneSpec(li);
    var chips=[],x=-cell*2;
    /* pre-fill the lane so traffic exists from frame one */
    while(x<W+cell*2){
      var wCells=1+((Math.random()<0.3)?1:0)+((Math.random()<0.12)?1:0);
      chips.push({x:x,w:wCells*cell*0.92,rate:rateFor(li)});
      x+=wCells*cell*0.92+spec.gapPx*(0.7+Math.random()*0.9);
    }
    return {row:row,li:li,spec:spec,chips:chips};
  });
}
function rateFor(li){
  var b=BANDS[li];
  var hi=isFinite(b.hi)?b.hi:b.lo*3;
  return Math.max(1,Math.round(b.lo+Math.random()*(hi-b.lo)));
}
var graceUntil=0,purgeWarned=false;
function resetPlayer(){
  player={c:Math.floor(COLS/2),r:START,hopAt:0};
  inTemplate=false;purgeT=0;purgeWarned=false;
  /* a fresh broadcast gets a moment to breathe before traffic counts;
     hop() ends the grace the moment you leave the bank */
  graceUntil=performance.now()+1000;
}

/* ---------------- runs ---------------- */
function startRun(){
  lives=3;bumps=2;score=0;confirms=0;level=1;
  blockCycle=10000;blockT=blockCycle;
  initLanes();resetPlayer();
  state="run";overlay.hidden=true;paintPause();
  fetchFeed();
  paintHud();
  say("Broadcast. The block is "+(nextHeight?"#"+fmt(nextHeight)+" and it is ":"")+"coming whether you are ready or not.");
  lastT=performance.now();
  if(!raf)raf=requestAnimationFrame(loop);
}
function gameOver(cause){
  state="over";
  led.g++;led.cf+=confirms;
  if(score>led.best)led.best=score;
  if(level>led.lv)led.lv=level;
  saveLed();paintLedger();
  sOver();
  var causeLine=cause==="hit"?"Outbid on the last broadcast. ":(cause==="purge"?"Purged on the last broadcast. ":"");
  var line=confirms===0?
    "Zero confirmations. The mempool forgets you the moment you stop paying attention; so did it.":
    confirms<3?
    "Confirmed "+confirms+" time"+(confirms>1?"s":"")+". The queue is undefeated in the long run.":
    "Confirmed "+confirms+" times and reached congestion level "+level+". Somewhere a fee estimator just felt obsolete.";
  ovTitle.textContent="WALLET GAVE UP";
  ovText.innerHTML="<b>"+fmt(score)+" sats</b> · "+confirms+" confirmation"+(confirms===1?"":"s")+" · congestion level "+level+".<br><br>"+causeLine+line;
  ovBtn.textContent="Broadcast again";
  overlay.hidden=false;
  say("Run over: "+fmt(score)+" sats, "+confirms+" confirmations. "+causeLine+line);
}
function die(reason){
  lives--;
  paintHud();
  if(lives<=0){flash=performance.now()+350;gameOver(reason);return;}
  if(reason==="hit"){sHit();say("Outbid. A fatter fee shoved past and you slid back down the queue. Broadcasts left: "+lives+".","mc-bad");}
  else{sPurge();say("Purged. Sit at the bottom of the mempool long enough and the mempool stops holding your coat. Broadcasts left: "+lives+".","mc-bad");}
  flash=performance.now()+350;
  resetPlayer();
}
function confirmPlayer(){
  var bonus=3000*bumps,pay=10000+500*(level-1)+bonus;
  score+=pay;confirms++;
  sConfirm();
  say("CONFIRMED in block "+(nextHeight?"#"+fmt(nextHeight):"")+": +"+fmt(pay)+" sats"+(bonus?" ("+fmt(bonus)+" of that is fees you never had to bump)":"")+".","mc-good");
  if(nextHeight)nextHeight++;
  level++;bumps=2;
  if(level%1===0&&level>1){
    setTimeout(function(){if(state==="run"){say(LEVEL_LINES[level%LEVEL_LINES.length]);sLevel();}},1600);
  }
  initLanes();resetPlayer();
  blockCycle=Math.max(6500,10000-level*250);blockT=blockCycle;
  paintHud();
}

/* ---------------- input ---------------- */
function hop(dc,dr){
  if(state!=="run"||inTemplate)return;
  var now=performance.now();
  if(now-player.hopAt<90)return;
  var nc=player.c+dc,nr=player.r+dr;
  if(nc<0||nc>=COLS||nr<0||nr>START)return;
  player.c=nc;player.r=nr;player.hopAt=now;
  if(nr!==START){
    purgeT=0;purgeWarned=false;
    /* the respawn grace protects the bank, never the crossing: stepping
       into traffic ends it, or holding Up would confirm invulnerably */
    graceUntil=0;
  }
  sHop();
  if(nr===BLOCKROW)enterTemplate();
}
function enterTemplate(){
  inTemplate=true;
  say("In the template. Nothing can outbid you now; wait for the block.","mc-good");
}
function bump(){
  if(state!=="run"||inTemplate)return;
  if(bumps<=0){say("No bumps left. The wallet refuses to chase the market any further.","mc-bad");return;}
  var nr=Math.max(BLOCKROW,player.r-2);
  bumps--;player.r=nr;player.hopAt=performance.now();purgeT=0;purgeWarned=false;graceUntil=0;
  sBump();
  paintHud();
  say("Fee bumped: same payment, bigger fee, two lanes closer. Your future self paid for that.");
  if(nr===BLOCKROW)enterTemplate();
}

/* ---------------- main loop ---------------- */
function loop(t){
  raf=requestAnimationFrame(loop);
  var dt=Math.min(80,t-lastT);lastT=t;
  if(state==="pause")return;
  if(state!=="run"){
    /* idle and game-over: traffic keeps flowing behind the overlay, because
       the mempool does not care whether you are playing */
    lanes.forEach(function(l){
      var sp=l.spec;
      l.chips.forEach(function(ch){ch.x+=sp.dir*sp.speed*dt/1000;});
      l.chips=l.chips.filter(function(ch){return ch.x>-cell*4-ch.w&&ch.x<W+cell*4;});
      if(l.chips.length<3){
        var wc=1+((Math.random()<0.3)?1:0);
        l.chips.push({x:sp.dir>0?-wc*cell-cell:W+cell,w:wc*cell*0.92,rate:rateFor(l.li)});
      }
    });
    draw(t);
    return;
  }
  /* traffic */
  lanes.forEach(function(l){
    var sp=l.spec;
    l.chips.forEach(function(ch){ch.x+=sp.dir*sp.speed*dt/1000;});
    /* recycle: keep the lane populated with its gap rhythm */
    if(sp.dir>0){
      l.chips=l.chips.filter(function(ch){return ch.x<W+cell*3;});
      var minX=Infinity;
      l.chips.forEach(function(ch){if(ch.x<minX)minX=ch.x;});
      if(minX>sp.gapPx*(0.7+Math.random()*0.6)-cell*2){
        var wc=1+((Math.random()<0.3)?1:0)+((Math.random()<0.12)?1:0);
        l.chips.push({x:-wc*cell-cell,w:wc*cell*0.92,rate:rateFor(l.li)});
      }
    }else{
      l.chips=l.chips.filter(function(ch){return ch.x>-cell*3-ch.w;});
      var maxX=-Infinity;
      l.chips.forEach(function(ch){if(ch.x+ch.w>maxX)maxX=ch.x+ch.w;});
      if(maxX<W-(sp.gapPx*(0.7+Math.random()*0.6))+cell*2){
        var wc2=1+((Math.random()<0.3)?1:0)+((Math.random()<0.12)?1:0);
        l.chips.push({x:W+cell,w:wc2*cell*0.92,rate:rateFor(l.li)});
      }
    }
  });
  /* the block clock */
  blockT-=dt;
  if(blockT<=2000&&blockT+dt>2000)sMineTick();
  if(blockT<=0){
    if(inTemplate){confirmPlayer();}
    else{sMined();flash=t+220;if(nextHeight)nextHeight++;blockCycle=Math.max(6500,blockCycle);blockT=blockCycle;
      say("Block found without you. It happens to most of the mempool, most of the time.");}
    if(state==="run"&&blockT<=0)blockT=blockCycle;
  }
  /* purge pressure on the bottom bank */
  if(player.r===START){
    purgeT+=dt;
    if(purgeT>18000){die("purge");}
    else if(purgeT>12000){
      if(!purgeWarned){purgeWarned=true;say("Purge warning: the mempool is about to drop you. Move up.","mc-bad");}
      if(Math.floor((purgeT-12000)/900)!==Math.floor((purgeT-12000-dt)/900))sPurge();
    }
  }
  /* collision */
  if(!inTemplate&&t>graceUntil){
    var lane=null;
    for(var i=0;i<lanes.length;i++)if(lanes[i].row===player.r){lane=lanes[i];break;}
    if(lane){
      var px=player.c*cell+cell*0.18,pw=cell*0.64;
      for(var k=0;k<lane.chips.length;k++){
        var ch=lane.chips[k];
        if(px<ch.x+ch.w&&px+pw>ch.x){die("hit");break;}
      }
    }
  }
  paintClock();
  draw(t);
}

/* ---------------- painters ---------------- */
function rr(x,y,w,h,r){
  if(w<2*r)r=w/2;if(h<2*r)r=h/2;
  ctx.beginPath();
  ctx.moveTo(x+r,y);
  ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);
  ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);
  ctx.closePath();
}
function draw(t){
  ctx.fillStyle="#0B0908";ctx.fillRect(0,0,W,H);
  /* the block bank */
  ctx.fillStyle=inTemplate?"#2A2113":"#1B150E";
  ctx.fillRect(0,0,W,cell);
  ctx.strokeStyle="#3E3322";ctx.strokeRect(.5,.5,W-1,cell-1);
  ctx.fillStyle="#A98F65";
  ctx.font="700 "+Math.max(8,Math.floor(cell*0.28))+"px Cascadia Mono,Consolas,monospace";
  ctx.textAlign="left";ctx.textBaseline="middle";
  var secs=state==="run"?Math.max(0,Math.ceil(blockT/1000)):Math.ceil(blockCycle/1000);
  ctx.fillText((nextHeight?"BLOCK #"+fmt(nextHeight):"NEXT BLOCK")+" IN 0:"+String(secs).padStart(2,"0"),6,cell/2);
  /* countdown fuse along the top */
  if(state==="run"){
    ctx.fillStyle="#F7931A";
    ctx.fillRect(0,0,W*(blockT/blockCycle),3);
  }
  /* the bench */
  ctx.fillStyle="#141009";
  ctx.fillRect(0,BENCH*cell,W,cell);
  ctx.fillStyle="#97815A";
  ctx.font="700 "+Math.max(7,Math.floor(cell*0.22))+"px Cascadia Mono,Consolas,monospace";
  ctx.fillText("THE BACKLOG BENCH · SAFE, GOING NOWHERE",6,BENCH*cell+cell/2);
  /* the broadcast bank */
  var purgeFrac=Math.min(1,purgeT/18000);
  ctx.fillStyle=purgeFrac>0.66?"#2A130E":"#1B150E";
  ctx.fillRect(0,START*cell,W,cell);
  ctx.fillStyle=purgeFrac>0.66?"#E06A55":"#A98F65";
  ctx.fillText(purgeFrac>0.66?"PURGE IMMINENT · MOVE":"YOUR WALLET · BROADCAST BANK",6,START*cell+cell/2);
  if(state==="run"&&player.r===START&&purgeT>0){
    ctx.fillStyle="rgba(224,106,85,.8)";
    ctx.fillRect(0,(START+1)*cell-3,W*purgeFrac,3);
  }
  /* lanes */
  lanes.forEach(function(l){
    var y=l.row*cell;
    ctx.fillStyle=l.li%2?"#0E0B08":"#100D09";
    ctx.fillRect(0,y,W,cell);
    /* band tag */
    ctx.fillStyle="#A98F65";
    ctx.font="700 "+Math.max(7,Math.floor(cell*0.22))+"px Cascadia Mono,Consolas,monospace";
    ctx.fillText(l.spec.label,4,y+cell/2);
    l.chips.forEach(function(ch){
      ctx.fillStyle=l.spec.color;
      rr(ch.x,y+cell*0.16,ch.w,cell*0.68,4);ctx.fill();
      ctx.strokeStyle="rgba(0,0,0,.35)";ctx.lineWidth=1;
      rr(ch.x+.5,y+cell*0.16+.5,ch.w-1,cell*0.68-1,4);ctx.stroke();
      if(ch.w>cell*1.2&&cell>=26){
        ctx.fillStyle=l.spec.ink;
        ctx.font="700 "+Math.floor(cell*0.3)+"px Cascadia Mono,Consolas,monospace";
        ctx.textAlign="center";
        ctx.fillText(String(ch.rate),ch.x+ch.w/2,y+cell/2);
        ctx.textAlign="left";
      }
    });
  });
  /* the player */
  if(state==="run"||state==="pause"){
    var px=player.c*cell+cell*0.14,py=player.r*cell+cell*0.14,ps=cell*0.72;
    if(t<graceUntil)ctx.globalAlpha=reduce?0.6:(0.45+0.45*Math.abs(Math.sin(t/150))); /* respawn blink, steady under reduced motion */
    ctx.shadowColor="rgba(247,147,26,.8)";ctx.shadowBlur=10;
    ctx.fillStyle="#F7931A";
    rr(px,py,ps,ps,6);ctx.fill();
    ctx.shadowBlur=0;
    ctx.strokeStyle="#FFD9A0";ctx.lineWidth=1.6;
    rr(px+.8,py+.8,ps-1.6,ps-1.6,6);ctx.stroke();
    ctx.fillStyle="#241200";
    ctx.font="700 "+Math.floor(cell*0.4)+"px Cascadia Mono,Consolas,monospace";
    ctx.textAlign="center";ctx.textBaseline="middle";
    ctx.fillText("₿",px+ps/2,py+ps/2+1);
    ctx.textAlign="left";
    ctx.globalAlpha=1;
  }
  /* hit/mine flash: skipped under reduced motion */
  if(flash>t&&!reduce){
    ctx.fillStyle="rgba(255,217,160,"+(0.25*(flash-t)/350).toFixed(2)+")";
    ctx.fillRect(0,0,W,H);
  }
}
function paintHud(){
  txt("mc-score",fmt(score));
  txt("mc-lives",String(Math.max(0,lives)));
  txt("mc-bumps",String(bumps));
  txt("mc-conf",String(confirms));
}
var lastClockS=-1;
function paintClock(){
  /* mirror the canvas countdown into a real DOM LED for assistive tech */
  var s=state==="run"?Math.max(0,Math.ceil(blockT/1000)):Math.ceil(blockCycle/1000);
  if(s!==lastClockS){lastClockS=s;txt("mc-block","0:"+String(s).padStart(2,"0"));}
}
function paintLedger(){
  txt("mc-l-games",fmt(led.g));txt("mc-l-best",fmt(led.best));
  txt("mc-l-conf",fmt(led.cf));txt("mc-l-level",fmt(led.lv));
}

/* ---------------- pause ---------------- */
var paused=false;
function paintPause(){
  var ip=el("mc-ic-pause"),ipl=el("mc-ic-play"),pb=el("mc-pause");
  if(ip)ip.hidden=paused;if(ipl)ipl.hidden=!paused;
  if(pb)pb.setAttribute("aria-pressed",paused?"true":"false");
}
function setPause(on){
  if(state!=="run"&&on)return;
  if(paused===on)return;
  paused=on;paintPause();
  if(on){state="pause";say("Paused. The real mempool is not.");}
  else{state="run";lastT=performance.now();say("Back into traffic.");}
}
el("mc-pause").addEventListener("click",function(){
  if(state==="run")setPause(true);
  else if(state==="pause")setPause(false);
});
document.addEventListener("visibilitychange",function(){
  if(document.hidden&&state==="run")setPause(true);
});

/* ---------------- wiring ---------------- */
ovBtn.addEventListener("click",function(){ac();startRun();});
document.addEventListener("keydown",function(e){
  if(e.altKey||e.ctrlKey||e.metaKey)return;
  var k=e.key;
  /* cheap key filter before any layout read */
  if(["ArrowUp","ArrowDown","ArrowLeft","ArrowRight","w","W","a","A","s","S","d","D","b","B","p","P"," ","Enter"].indexOf(k)<0)return;
  var tg=e.target;
  if(tg&&tg.closest){
    if(tg.closest("input,select,textarea,a"))return;
    /* a focused button keeps its native Space/Enter activation, but the
       game keys still play so focusing Pause does not kill the arrows */
    if(tg.closest("button")&&(k===" "||k==="Enter"))return;
  }
  var r=stage.getBoundingClientRect();
  if(r.bottom<0||r.top>window.innerHeight)return;
  if(state==="run"){
    if(k==="ArrowUp"||k==="w"||k==="W"){e.preventDefault();hop(0,-1);}
    else if(k==="ArrowDown"||k==="s"||k==="S"){e.preventDefault();hop(0,1);}
    else if(k==="ArrowLeft"||k==="a"||k==="A"){e.preventDefault();hop(-1,0);}
    else if(k==="ArrowRight"||k==="d"||k==="D"){e.preventDefault();hop(1,0);}
    else if(k==="b"||k==="B"){e.preventDefault();bump();}
    else if(k==="p"||k==="P"){e.preventDefault();setPause(true);}
    else if(k===" "){e.preventDefault();} /* mid-game Space never scrolls the page */
  }else if(state==="pause"&&(k==="p"||k==="P"||k===" ")){e.preventDefault();setPause(false);}
  else if(state!=="pause"&&(k===" "||k==="Enter")){
    if(!overlay.hidden){e.preventDefault();ac();startRun();}
  }
});
function bindPad(id,fn){
  var b=el(id);
  if(!b)return;
  b.addEventListener("pointerdown",function(e){
    if(e.button!==0||!e.isPrimary)return;
    e.preventDefault();fn();
  });
}
bindPad("mc-pu",function(){hop(0,-1);});
bindPad("mc-pd",function(){hop(0,1);});
bindPad("mc-plft",function(){hop(-1,0);});
bindPad("mc-prgt",function(){hop(1,0);});
bindPad("mc-pbump",function(){bump();});

el("mc-reset").addEventListener("click",function(){
  led={g:0,best:0,cf:0,lv:0};
  saveLed();paintLedger();
  say("Wiped. The mempool keeps no score either.");
});

/* ---------------- fullscreen (shared idiom) ---------------- */
var fsBtn=el("mc-fs");
function fsActive(){return document.fullscreenElement===stage||stage.classList.contains("mc-fake");}
function setInertOutside(on){
  var node=stage;
  while(node&&node!==document.body){
    var p=node.parentElement;
    if(!p)break;
    for(var i=0;i<p.children.length;i++){
      var sib=p.children[i];
      if(sib===node)continue;
      if(on)sib.setAttribute("inert","");else sib.removeAttribute("inert");
    }
    node=p;
  }
}
function paintFs(){
  var open=el("mc-fs-open"),close=el("mc-fs-close"),on=fsActive();
  if(open)open.hidden=on;if(close)close.hidden=!on;
  fsBtn.setAttribute("aria-pressed",on?"true":"false");
  sizeBoard();
}
function exitFake(){
  stage.classList.remove("mc-fake");document.documentElement.classList.remove("mc-lock");
  setInertOutside(false);paintFs();
}
function fsToggle(){
  if(document.fullscreenElement){document.exitFullscreen();return;}
  if(stage.classList.contains("mc-fake")){exitFake();return;}
  if(stage.requestFullscreen){
    stage.requestFullscreen().then(paintFs).catch(function(){
      stage.classList.add("mc-fake");document.documentElement.classList.add("mc-lock");
      setInertOutside(true);paintFs();
    });
  }else{
    stage.classList.add("mc-fake");document.documentElement.classList.add("mc-lock");
    setInertOutside(true);paintFs();
  }
}
fsBtn.addEventListener("click",fsToggle);
document.addEventListener("fullscreenchange",paintFs);
document.addEventListener("keydown",function(e){
  if(e.key==="Escape"&&stage.classList.contains("mc-fake"))exitFake();
});
window.addEventListener("resize",sizeBoard);

/* ---------------- boot ---------------- */
initLanes();
resetPlayer();
sizeBoard();
paintHud();paintLedger();paintChip();
fetchFeed();
fetch(apiBase()+"/height").then(function(r){if(!r.ok)throw 0;return r.json();}).then(function(j){
  if(j&&typeof j.height==="number"&&isFinite(j.height)&&j.height>0)nextHeight=Math.floor(j.height)+1;
}).catch(function(){});
if(!raf)raf=requestAnimationFrame(loop); /* idle traffic keeps flowing behind the overlay */
if(led.g>0)say("Welcome back. Best run so far: "+fmt(led.best)+" sats. The traffic has not thinned.");

/* iOS long-press hardening: user-select:none alone is not honored
   reliably on Safari, so selection is refused at the event layer and any
   range that sneaks through is swept on touchend */
(function(){
  var st=document.querySelector(".mc-stage");
  if(!st)return;
    /* the decisive layer: cancel the NATIVE touch before Safari's selection
     recognizer runs. Scoped to the canvas and overlay prose only, so
     buttons keep their taps and the page keeps its scroll. */
  st.addEventListener("touchstart",function(e){
    var t=e.target;
    if(!t||!t.closest)return;
    if(t.closest("button,a,input,select,textarea"))return;
    if(t.closest("canvas")||t.closest(".mc-overlay"))e.preventDefault();
  },{passive:false});
  ["selectstart","contextmenu"].forEach(function(ev){
    st.addEventListener(ev,function(e){e.preventDefault();});
  });
  document.addEventListener("touchend",function(){
    try{
      var sel=window.getSelection&&window.getSelection();
      if(!sel||!sel.rangeCount||!sel.anchorNode)return;
      var n=sel.anchorNode.nodeType===1?sel.anchorNode:sel.anchorNode.parentNode;
      if(n&&st.contains(n))sel.removeAllRanges();
    }catch(e){}
  },{passive:true});
})();
})();
</script>
