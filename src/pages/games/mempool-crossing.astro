/* ---------------- dom + sound ---------------- */
function el(id){return document.getElementById(id);}
function txt(id,v){var e=el(id);if(e)e.textContent=v;}
function fmt(n){return n.toLocaleString("en-US");}
var cv=el("mc-board"),ctx=cv.getContext("2d"),
    overlay=el("mc-overlay"),ovTitle=el("mc-ovtitle"),ovText=el("mc-ovtext"),ovBtn=el("mc-go"),
    msgEl=el("mc-msg"),live=el("mc-live");
function say(m,cls){
