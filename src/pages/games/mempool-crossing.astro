---
import Base from '../../layouts/Base.astro';
import '../../styles/doc.css';
---
<Base title="Mempool Crossing: Dodge the Fee Traffic - OpenBitcoin" description="An arcade crossing game about the bitcoin fee market. You are a transaction: six lanes of fee traffic seeded from this site's own mempool, live when our node answers and honestly labelled when it is not, stand between your broadcast and the next block. Dodge what outbids you, mind the purge, and spend Replace-By-Fee bumps wisely. Free, no wagering, no prizes." indexable={false}>
<main class="wrap doc-wrap">
  <div class="doc-head">
    <div class="doc-kicker">Games</div>
    <h1>Mempool Crossing</h1>
    <p class="doc-lede">Every transaction ever confirmed made the same trip: broadcast at the bottom, block at the top, and between them a queue of everybody else's money, sorted by impatience. Here the queue is six lanes of traffic seeded from this site's own mempool, live when our node answers (the plate under the board says which), the blocks arrive whether you are ready or not, and the fee-bump button does exactly what it does in your wallet: jumps the line, for a price.</p>
  </div>
  <div class="doc-grid">
  <div>

    <!-- ============ THE CROSSING ============ -->
    <div class="mc-stage" id="mc-stage">
      <div class="mc-rig" id="mc-rig">
        <div class="mc-marquee">
          <div class="mc-title">MEMPOOL CROSSING</div>
          <div class="mc-sub">six lanes of fee traffic &middot; one confirmation</div>
        </div>
        <div class="mc-leds">
          <div class="mc-led"><i>Score &middot; sats</i><b id="mc-score">0</b></div>
          <div class="mc-led"><i>Broadcasts</i><b id="mc-lives">3</b></div>
          <div class="mc-led"><i>Bumps left</i><b id="mc-bumps">2</b></div>
          <div class="mc-led"><i>Confirmed</i><b id="mc-conf">0</b></div>
          <div class="mc-led"><i>Next block</i><b id="mc-block">&ndash;</b></div>
        </div>
        <div class="mc-boardwrap">
          <canvas id="mc-board" role="img" aria-label="A top-down crossing: your transaction hops from the broadcast bank at the bottom, across six lanes of moving fee traffic, to the block at the top. The readouts above the board mirror score, broadcasts, bumps, confirmations and the block countdown."></canvas>
          <div class="mc-overlay" id="mc-overlay">
            <div class="mc-ovinner">
              <b id="mc-ovtitle">BROADCAST YOUR TRANSACTION</b>
              <p id="mc-ovtext">Hop lane to lane. Traffic that touches you outbids you back to the start. Camp at the bottom and the purge takes you. BUMP jumps two lanes; unused bumps score when you confirm.</p>
              <button class="mc-go" id="mc-go" type="button">Broadcast</button>
            </div>
          </div>
        </div>
        <div class="mc-pads" id="mc-pads">
          <button class="mc-pad" id="mc-pu" type="button" aria-label="Hop up">&#9650;</button>
          <div class="mc-padrow">
            <button class="mc-pad" id="mc-plft" type="button" aria-label="Hop left">&#9664;</button>
            <button class="mc-pad mc-bump" id="mc-pbump" type="button" aria-label="Bump the fee">BUMP</button>
            <button class="mc-pad" id="mc-prgt" type="button" aria-label="Hop right">&#9654;</button>
          </div>
          <button class="mc-pad" id="mc-pd" type="button" aria-label="Hop down">&#9660;</button>
        </div>
        <div class="mc-console">
          <button class="mc-mini" id="mc-pause" type="button" aria-label="Pause" aria-pressed="false" title="Pause">
            <svg viewBox="0 0 24 24" id="mc-ic-pause"><path d="M8 5v14M16 5v14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
            <svg viewBox="0 0 24 24" id="mc-ic-play" hidden><path d="M8 5l11 7-11 7z" fill="currentColor"/></svg>
          </button>
          <div class="mc-help">Arrows hop &middot; B bumps the fee &middot; P pauses</div>
          <div class="mc-small">
            <button class="mc-mini" id="mc-mute" type="button" aria-label="Mute" aria-pressed="false" title="Mute">
              <svg viewBox="0 0 24 24" id="mc-mute-on"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16 9c1.2.8 1.2 5.2 0 6M18.5 7c2.2 2 2.2 8 0 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              <svg viewBox="0 0 24 24" id="mc-mute-off" hidden><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16 9.5l6 5M22 9.5l-6 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
            <button class="mc-mini" id="mc-fs" type="button" aria-label="Fullscreen" aria-pressed="false" title="Fullscreen">
              <svg viewBox="0 0 24 24" id="mc-fs-open"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <svg viewBox="0 0 24 24" id="mc-fs-close" hidden><path d="M9 4v5H4M20 9h-5V4M15 20v-5h5M4 15h5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>
        <div class="mc-msg" id="mc-msg">The low lanes crawl bumper to bumper; the high lanes are empty and fast. That is not game design, that is the fee market.</div>
        <div class="mc-plate"><span id="mc-datachip">TRAFFIC FEED: &hellip;</span></div>
      </div>
      <div class="mc-sr" id="mc-live" aria-live="polite"></div>
    </div>
    <noscript><p class="mc-nojs">The crossing needs JavaScript to run. The fee-market mapping below is true either way.</p></noscript>

    <!-- ============ THE LEDGER ============ -->
    <div class="mc-card">
      <h2 class="mc-tlab">The ledger: this browser, all time</h2>
      <div class="mc-stats">
        <div class="mc-stat"><b id="mc-l-games">0</b><i>runs</i></div>
        <div class="mc-stat"><b id="mc-l-best">0</b><i>best score, sats</i></div>
        <div class="mc-stat"><b id="mc-l-conf">0</b><i>confirmations</i></div>
        <div class="mc-stat"><b id="mc-l-level">0</b><i>deepest congestion level</i></div>
      </div>
      <p class="mc-brow"><span>The ledger lives in this browser's storage and never leaves the page. The score is in sats because everything in the mempool is; none of them are real here.</span> <button class="mc-reset" id="mc-reset" type="button">Reset everything</button></p>
    </div>

    <!-- ============ THE TOY AGAINST THE TRUTH ============ -->
    <div class="mc-card">
      <h2 class="mc-tlab">The toy against the truth</h2>
      <div class="mc-ptwrap">
        <table class="mc-pt">
          <thead><tr><th>In the game</th><th>On the network</th></tr></thead>
          <tbody>
            <tr><td>Six lanes, dense and slow at the bottom</td><td>Fee bands: most days, most stuck volume sits at 1-5 sat/vB, and it barely moves</td></tr>
            <tr><td>Traffic that knocks you back</td><td>Being outbid: blocks fill from the top of the fee ladder, and you slide down the queue</td></tr>
            <tr><td>The purge tide at the bottom bank</td><td>Mempool eviction: when memory fills, nodes drop the cheapest transactions entirely</td></tr>
            <tr><td>The BUMP button</td><td>Replace-By-Fee (BIP 125): re-broadcast the same payment with a higher fee and jump the queue</td></tr>
            <tr><td>Blocks arriving on their own clock</td><td>Poisson block times: roughly every ten minutes on average, and never when you want one</td></tr>
            <tr><td>Points for unused bumps</td><td>Fees you did not pay: the whole game of fee estimation</td></tr>
          </tbody>
        </table>
      </div>
      <p class="mc-note">One knowing simplification: real queues do not knock you unconscious, they just make you wait. The collision is the wait, compressed into something your reflexes can feel.</p>
    </div>

    <!-- ============ RBF ============ -->
    <div class="mc-card">
      <h2 class="mc-tlab">The bump button is real</h2>
      <p class="mc-p">Replace-By-Fee is the polite name for shoving to the front: you re-sign the same payment with a bigger fee, and nodes replace the old version because the new one pays more. Most wallets hide it behind a button called "speed up", and the rule of the game is the rule of the network: every bump costs real money, so the cheapest transaction is the one that guessed its fee right the first time. The <a href="/fees/calculator">fee calculator</a> does the guessing with live data, and the <a href="/fees">fees page</a> shows what the lanes look like right now.</p>
    </div>

    <!-- ============ A TOY ============ -->
    <div class="mc-card mc-warncard">
      <h2 class="mc-tlab mc-wlab">A toy, not fee advice</h2>
      <p class="mc-p">Nothing here takes wagers or pays prizes; the score is a number in your browser. The traffic is seeded from the real mempool but the physics are arcade physics, and surviving level nine says nothing about your fee estimation. When real sats are on the line, read the <a href="/fees">live rates</a> and let arithmetic do the hopping; the <a href="/terms">terms</a> cover the rest.</p>
    </div>

    <div class="mc-about doc-prose">
      <p>Mempool Crossing sits in the <a href="/games">games section</a>, where play is free forever. Its sibling machines: <a href="/games/block-builder">Block Builder</a> puts you on the other side of the same queue, choosing which of these transactions make the block, and <a href="/games/impossible-slot">The Impossible Slot Machine</a> spins real keys against the whole chain. The traffic report this game is drawn from lives on the <a href="/mempool">mempool page</a>.</p>
    </div>
  </div>
  <aside class="doc-rail">
    <div class="doc-tile">
      <div class="doc-tlab">House rules</div>
      <ul class="mc-rl">
        <li>Three broadcasts, then the wallet gives up</li>
        <li>Two fee bumps per crossing; unused bumps score</li>
        <li>Touching traffic sends you back to the start</li>
        <li>Camping at the bottom invites the purge</li>
        <li>Traffic seeded from our mempool feed; the plate says live or snapshot</li>
      </ul>
    </div>
    <div class="doc-tile">
      <div class="doc-tlab">Related</div>
      <nav>
        <a href="/games">All games</a>
        <a href="/games/block-builder">Block Builder</a>
        <a href="/mempool">The live mempool</a>
        <a href="/fees/calculator">Fee calculator</a>
      </nav>
    </div>
  </aside>
  </div>
</main>

<style is:global>
  
  
  .mc-stage,.mc-stage *{-webkit-user-select:none !important;user-select:none !important;
    -webkit-touch-callout:none !important}
  .mc-stage ::selection{background:transparent}
  .mc-stage{position:relative}
  .mc-stage.mc-fake{position:fixed;inset:0;z-index:80;background:#0A0806;display:flex;justify-content:center;padding:12px;overflow:auto}
  .mc-stage:fullscreen{background:#0A0806;display:flex;justify-content:center;padding:12px;overflow:auto}
  .mc-stage.mc-fake .mc-rig,.mc-stage:fullscreen .mc-rig{margin:auto}
  html.mc-lock{overflow:hidden}

  .mc-rig{position:relative;max-width:560px;margin:0 auto;
    background:linear-gradient(180deg,#241D14,#120E09 70%,#0C0906);
    border:1px solid #3E3322;border-radius:20px;padding:16px 20px 12px;
    box-shadow:0 18px 44px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,220,160,.10),inset 0 -14px 30px rgba(0,0,0,.45)}
  .mc-rig button:focus-visible{outline:3px solid #FFD9A0;outline-offset:2px}

  .mc-marquee{text-align:center;padding:2px 0 10px;position:relative}
  .mc-marquee::before{content:"";position:absolute;left:12%;right:12%;top:-6px;height:44px;
    background:radial-gradient(closest-side,rgba(247,147,26,.16),transparent);pointer-events:none}
  .mc-title{font:700 clamp(15px,3.8vw,20px) var(--mono);letter-spacing:.22em;color:#FFD9A0;
    text-shadow:0 0 16px rgba(247,147,26,.55),0 1px 0 rgba(0,0,0,.6)}
  .mc-sub{font:600 8.5px var(--mono);letter-spacing:.24em;text-transform:uppercase;color:#A98F65;margin-top:4px}

  .mc-leds{display:flex;gap:8px;margin-bottom:10px}
  .mc-led{flex:1;min-width:0;background:#0A0705;border:1px solid #35291A;border-radius:9px;padding:6px 10px 7px;
    box-shadow:inset 0 2px 8px rgba(0,0,0,.7)}
  .mc-led i{display:block;font:700 7.5px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:#A98F65;font-style:normal;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .mc-led b{display:block;font:700 clamp(14px,3.4vw,17px) var(--mono);color:#FFD9A0;margin-top:2px;
    font-variant-numeric:tabular-nums;white-space:nowrap;text-shadow:0 0 9px rgba(255,166,60,.35)}

  .mc-boardwrap{position:relative;background:#060504;border:1px solid #3E3322;border-radius:12px;
    padding:8px;box-shadow:inset 0 4px 18px rgba(0,0,0,.85)}
  .mc-boardwrap canvas{display:block;margin:0 auto;border-radius:6px}
  .mc-overlay{position:absolute;inset:8px;display:flex;align-items:center;justify-content:center;
    background:rgba(6,5,4,.84);border-radius:6px;overflow:auto}
  .mc-overlay[hidden]{display:none}
  .mc-ovinner{text-align:center;padding:14px 16px;max-width:92%;max-height:100%;margin:auto}
  .mc-ovinner b{display:block;font:700 14px var(--mono);letter-spacing:.12em;color:#FFD9A0}
  .mc-ovinner p{font:600 11px/1.65 var(--mono);color:#B99B6B;margin:10px 0 0}
  .mc-ovinner p b{display:inline;font-size:11px;color:#FFB84D;letter-spacing:.02em}
  .mc-go{margin-top:14px;background:var(--cta);color:var(--cta-ink);border:1.5px solid rgba(255,166,60,.65);
    border-radius:10px;cursor:pointer;min-height:48px;padding:0 26px;
    font:700 14px var(--mono);letter-spacing:.13em;text-transform:uppercase;
    box-shadow:0 5px 16px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.14),0 0 22px rgba(247,147,26,.22)}
  .mc-go:hover{background:var(--cta-hov)}

  .mc-pads{display:none;flex-direction:column;align-items:center;gap:6px;margin-top:12px}
  .mc-padrow{display:flex;gap:6px}
  .mc-pad{min-width:56px;min-height:44px;background:#191410;border:1px solid #35291A;border-radius:9px;
    color:#FFD9A0;cursor:pointer;font:700 14px var(--mono)}
  .mc-pad:active{background:#2A2118}
  .mc-bump{font-size:10px;letter-spacing:.14em;border-color:rgba(247,147,26,.5);color:#FFB84D}
  @media(pointer:coarse){.mc-pads{display:flex}}

  .mc-console{display:flex;align-items:center;gap:10px;margin-top:12px}
  .mc-help{flex:1;font:600 8.5px var(--mono);letter-spacing:.08em;color:#97815A;text-align:center}
  .mc-small{display:flex;gap:6px}
  .mc-mini{width:40px;height:40px;display:flex;align-items:center;justify-content:center;flex:none;
    background:#191410;border:1px solid #35291A;border-radius:8px;color:#B99B6B;cursor:pointer}
  .mc-mini:hover{color:#FFD9A0;border-color:#5A452A}
  .mc-mini[aria-pressed="true"]{border-color:rgba(247,147,26,.55);color:#FFB84D}
  .mc-mini svg{width:17px;height:17px}
  .mc-msg{min-height:34px;margin-top:10px;text-align:center;font:600 11.5px/1.5 var(--mono);letter-spacing:.02em;color:#B99B6B}
  .mc-msg.mc-good{color:#FFB84D}
  .mc-msg.mc-bad{color:#E06A55}
  .mc-plate{margin-top:8px;text-align:center;font:600 7.5px var(--mono);letter-spacing:.2em;color:#97815A;
    border-top:1px solid #241C12;padding-top:8px}
  .mc-plate .mc-livefeed{color:#C98A2E}

  
  .mc-card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:20px 24px 22px;margin-top:14px}
  .mc-tlab{font:700 9.5px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);margin:0 0 12px}
  .mc-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(118px,1fr));gap:10px}
  .mc-stat{background:rgba(124,140,168,.13);border:1px dashed rgba(255,166,60,.32);border-radius:10px;padding:10px 12px;min-width:0}
  .mc-stat b{display:block;font:700 16px var(--mono);color:var(--ink);font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .mc-stat i{display:block;font:600 9px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3);font-style:normal;margin-top:3px}
  .mc-brow{font:500 11.5px/1.6 var(--sans);color:var(--ink-3);margin:12px 0 0;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
  .mc-brow span{flex:1;min-width:220px}
  .mc-reset{background:transparent;border:1px dashed var(--line-2);border-radius:7px;color:var(--ink-3);
    font:700 9.5px var(--mono);letter-spacing:.1em;text-transform:uppercase;padding:6px 10px;min-height:40px;cursor:pointer}
  .mc-reset:hover{color:var(--down);border-color:var(--down)}
  .mc-p{font:500 13.5px/1.65 var(--sans);color:var(--ink-2);margin:0}
  .mc-p a,.mc-about a{color:var(--acc);text-decoration:none;border-bottom:1px dashed rgba(247,147,26,.35);padding-bottom:1px}
  .mc-p a:hover,.mc-about a:hover{border-bottom-style:solid}
  .mc-ptwrap{overflow-x:auto}
  .mc-pt{width:100%;border-collapse:collapse}
  .mc-pt th{font:700 9.5px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3);
    text-align:left;padding:0 10px 8px 0;border-bottom:1px solid var(--line-2)}
  .mc-pt td{font:500 13px/1.5 var(--sans);color:var(--ink-2);padding:9px 10px 9px 0;border-bottom:1px dotted var(--line-2);vertical-align:top}
  .mc-pt td:first-child{color:var(--ink);font-weight:600;min-width:150px}
  .mc-pt tr:last-child td{border-bottom:0}
  .mc-note{font:500 12.5px/1.6 var(--sans);color:var(--ink-3);margin:12px 0 0}
  .mc-warncard{border-color:rgba(255,166,60,.32)}
  .mc-wlab{color:var(--acc)}
  .mc-about{margin-top:14px}
  .mc-about p{font:500 13.5px/1.65 var(--sans);color:var(--ink-3)}
  .mc-rl{margin:0;padding-left:16px}
  .mc-rl li{font:600 11.5px/1.5 var(--sans);color:var(--ink-2);margin-top:6px}
  .mc-rl li:first-child{margin-top:0}
  .mc-rl li::marker{color:var(--acc)}
  .mc-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap}
  .mc-nojs{font:600 12.5px/1.6 var(--sans);color:var(--ink-3);text-align:center;margin:12px 0 0}

  @media(max-width:740px){
    .mc-rig{padding:12px 10px 10px}
    .mc-leds{flex-wrap:wrap}
    .mc-led{flex:1 1 40%}
    .mc-help{display:none}
    .mc-msg{min-height:50px}
  }
  @media(max-width:700px){
    .mc-card{padding:18px 16px}
  }
</style>

<script is:inline>
(function(){
"use strict";
var stage=document.getElementById("mc-stage"),rig=document.getElementById("mc-rig");
if(!stage||!rig)return;

/* ---------------- board geometry ----------------
   row 0 = the block bank, rows 1-3 fast high-fee lanes, row 4 = the bench,
   rows 5-7 slow low-fee lanes, row 8 = the broadcast bank */
var COLS=11,ROWS=9,LANE_ROWS=[1,2,3,5,6,7],BENCH=4,START=8,BLOCKROW=0;
/* read lazily: Base publishes OB_DATA_API after this inline script parses */
function apiBase(){return (typeof window.OB_DATA_API==="string"&&window.OB_DATA_API)||"/api/v1";}
var reduce=window.matchMedia&&window.matchMedia("(prefers-reduced-motion: reduce)").matches;

/* six game bands, high fee first (row 1) down to dust (row 7).
   label, edge range [lo,hi), base speed px/s at cell=34, chip color */
var BANDS=[
  {lo:50,hi:Infinity,label:"50+", speed:82,color:"#FFD9A0",ink:"#241200"},
  {lo:20,hi:50,      label:"20-49",speed:68,color:"#FFB454",ink:"#241200"},
  {lo:10,hi:20,      label:"10-19",speed:54,color:"#F7931A",ink:"#241200"},
  {lo:6, hi:10,      label:"6-9",  speed:42,color:"#C46A00",ink:"#FFF3E0"},
  {lo:3, hi:6,       label:"3-5",  speed:31,color:"#8F6B36",ink:"#F0E9DE"},
  {lo:1, hi:3,       label:"1-2",  speed:22,color:"#5F5140",ink:"#D8CDBB"}
];
/* density share per band, replaced by the live feed when it answers;
   the snapshot mirrors a quiet chain: nearly everything cheap and stuck */
var share=[0.02,0.04,0.06,0.10,0.26,0.52],feedLive=false,feedCount=0,feedMb=0;

function paintChip(){
  var c=document.getElementById("mc-datachip");
  if(!c)return;
  if(feedLive){
    c.className="mc-livefeed";
    c.textContent="TRAFFIC FEED: LIVE MEMPOOL · "+feedCount.toLocaleString("en-US")+" TX · "+feedMb+" MvB";
  }else{
    c.className="";
    c.textContent="TRAFFIC FEED: STORED SNAPSHOT (feed unavailable)";
  }
}
function fetchFeed(){
  return fetch(apiBase()+"/mempool").then(function(r){if(!r.ok)throw 0;return r.json();}).then(function(j){
    if(j&&j.bands&&Array.isArray(j.bands.edges)&&Array.isArray(j.bands.vsizes)&&
       j.bands.edges.length===j.bands.vsizes.length&&
       j.bands.vsizes.every(function(v){return typeof v==="number"&&isFinite(v)&&v>=0;})&&
       j.bands.vsizes.some(function(v){return v>0;})){
      var sums=[0,0,0,0,0,0],total=0,i,b;
      for(i=0;i<j.bands.edges.length;i++){
        var rate=j.bands.edges[i],vs=j.bands.vsizes[i];
        for(b=0;b<BANDS.length;b++)if(rate>=BANDS[b].lo&&rate<BANDS[b].hi){sums[b]+=vs;break;}
        total+=vs;
      }
      if(total>0){
        share=sums.map(function(s){return s/total;});
        feedLive=true;feedCount=j.count|0;feedMb=Math.round((j.vsize||0)/1e6);
        paintChip();return;
      }
    }
    /* a 200 with unusable bands is still not a live feed: never claim it is */
    feedLive=false;
    paintChip();
  }).catch(function(){feedLive=false;paintChip();});
}

/* ---------------- storage ---------------- */
function store(k,v){try{localStorage.setItem(k,v);}catch(e){}}
function readInt(k,d){try{var v=parseInt(localStorage.getItem(k),10);return isFinite(v)?v:d;}catch(e){return d;}}
function readLed(){
  try{var l=JSON.parse(localStorage.getItem("ob-mc-led"));
    if(l&&isFinite(l.g)&&isFinite(l.best)&&isFinite(l.cf)&&isFinite(l.lv))
      return {g:l.g|0,best:l.best|0,cf:l.cf|0,lv:l.lv|0};
  }catch(e){}
