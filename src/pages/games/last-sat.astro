/* ---------------- maze parsing ---------------- */
var mz=null; /* {rows, coins[][], P, house[], door, plaza, wrapRows{}, dealt, nCoins} */
function parseMaze(idx){
  var rows=LAYOUTS[idx],r,c;
  var m={rows:rows,coins:[],P:null,house:[],door:null,plaza:null,wrapRows:{},nCoins:0,dealt:0,whales:[]};
  for(r=0;r<ROWS;r++){
    var line=[],ch;
    for(c=0;c<COLS;c++){
      ch=rows[r].charAt(c);
      line.push(0);
      if(ch==="P")m.P={r:r,c:c};
      if(ch==="H")m.house.push({r:r,c:c});
      if(ch==="-")m.door={r:r,c:c};
    }
    m.coins.push(line);
    if(rows[r].charAt(0)!=="#")m.wrapRows[r]=true;
  }
  if(m.door)m.plaza={r:m.door.r-1,c:m.door.c};
  return m;
}
function charAt(r,c){
  c=((c%COLS)+COLS)%COLS;
  if(r<0||r>=ROWS)return "#";
  return mz.rows[r].charAt(c);
}
function walkable(r,c,ghostly){
  var ch=charAt(r,c);
  if(ch==="#")return false;
  if(ch==="-"||ch==="H")return !!ghostly;
  return true;
}
function wrapC(c){return ((c%COLS)+COLS)%COLS;}
function inTunnel(r,c){return mz.wrapRows[r]&&(c<=1||c>=COLS-2);}

/* seed the floor with priced coins; four become whales */
function dealCoins(){
  var r,c,cells=[];
  mz.nCoins=0;mz.dealt=0;mz.whales=[];
  for(r=0;r<ROWS;r++)for(c=0;c<COLS;c++){
    var ch=mz.rows[r].charAt(c);
    if(ch==="."||ch==="o"){
      var v=sampleRate()*COIN_VB;
      mz.coins[r][c]=v;
      mz.nCoins++;mz.dealt+=v;
      if(ch===".")cells.push({r:r,c:c});
    }else mz.coins[r][c]=0;
  }
  /* whales: far from the start, spread out */
  mz.live=feed.live;mz.count=feed.count;mz.mb=feed.mb; /* latch provenance */
  var picks=0,guard=0;
  while(picks<4&&guard++<400&&cells.length){
    var i=(Math.random()*cells.length)|0,cell=cells[i];
    var dd=Math.abs(cell.r-mz.P.r)+Math.abs(cell.c-mz.P.c);
    var ok=dd>=5;
    if(ok)for(var w=0;w<mz.whales.length;w++){
      var o=mz.whales[w];
      if(Math.abs(o.r-cell.r)+Math.abs(o.c-cell.c)<4){ok=false;break;}
    }
    if(ok){
      var wv=topRate()*WHALE_VB;
      mz.dealt+=wv-mz.coins[cell.r][cell.c];
      mz.coins[cell.r][cell.c]=wv;
      mz.whales.push({r:cell.r,c:cell.c});
      cells.splice(i,1);picks++;
    }
  }
}
function isWhale(r,c){
  for(var i=0;i<mz.whales.length;i++)if(mz.whales[i].r===r&&mz.whales[i].c===c)return true;
  return false;
}
function isSurgeCell(r,c){return charAt(r,c)==="o"&&mz.coins[r][c]>0;}

/* ---------------- BFS: first step + distance ---------------- */
var DIRS=[{dr:-1,dc:0},{dr:0,dc:-1},{dr:1,dc:0},{dr:0,dc:1}];
function bfs(sr,sc,goal,ghostly){
  /* goal(r,c) -> true; returns {dr,dc,dist} of the first step, or null */
  var prev={},q=[{r:sr,c:sc}],seen={};
  seen[sr+","+sc]=true;
  var head=0,found=null;
  if(goal(sr,sc))return {dr:0,dc:0,dist:0};
  while(head<q.length){
    var n=q[head++];
    for(var i=0;i<4;i++){
      var nr=n.r+DIRS[i].dr,nc=wrapC(n.c+DIRS[i].dc);
      if(nr<0||nr>=ROWS)continue;
      var k=nr+","+nc;
      if(seen[k]||!walkable(nr,nc,ghostly))continue;
      seen[k]=true;prev[k]={r:n.r,c:n.c};
      if(goal(nr,nc)){found={r:nr,c:nc};head=q.length;break;}
      q.push({r:nr,c:nc});
    }
  }
  if(!found)return null;
  var cur=found,dist=0;
  while(true){
    var p=prev[cur.r+","+cur.c];
    dist++;
    if(p.r===sr&&p.c===sc)break;
    cur=p;
  }
  var dc=cur.c-sc;
  if(dc>1)dc=-1;if(dc<-1)dc=1; /* wrap step */
  return {dr:cur.r-sr,dc:dc,dist:dist};
}
function manDist(r1,c1,r2,c2){
  var dc=Math.abs(c1-c2);
  return Math.abs(r1-r2)+Math.min(dc,COLS-dc);
}

/* ---------------- game state ---------------- */
var state="idle",player=null,rivals=[],score=0,rigs=3,
    feesRun=0,feesBlk=0,whalesBlk=0,foundRun=0,lostRun=0,orphRun=0,whRun=0,
    blocksTotal=0,layoutIdx=0,nextHeight=null,
    surgeUntil=0,orphChain=0,waveChase=true,waveNext=0,
    graceUntil=0,stateUntil=0,frenzySaid=false,lastSatSaid=false,
    raf=null,lastT=0,pausedAt=0,hidMid=false,hidAt=0,coinsLeft=0,pendingHalving=false;

function epoch(){return Math.floor(blocksTotal/HALVE_EVERY)+1;}
function subsidy(){return Math.max(0,Math.floor(SUB0/Math.pow(2,epoch()-1)));}
function ramp(){return Math.min(1.4,1+blocksTotal*0.035);}
function surgeMs(){return Math.max(1500,8000-700*(epoch()-1));}
/* the deep-run screw: each epoch the rivals start racing the floor earlier,
   so the last-sat endgame stretches even after raw speed tops out */
function frenzyAt(){return Math.min(36,12+3*(epoch()-1));}

function mkPlayer(){
  return {from:{r:mz.P.r,c:mz.P.c},to:{r:mz.P.r,c:mz.P.c},t:0,
          dir:null,want:null,moving:false};
}
function mkRivals(delays){
  return RIVALS.map(function(spec,i){
    var h=mz.house[Math.min(i,mz.house.length-1)]||mz.house[0];
    return {key:spec.key,color:spec.color,corner:spec.corner,
            from:{r:h.r,c:h.c},to:{r:h.r,c:h.c},t:0,dir:{dr:0,dc:0},
            state:"house",releaseAt:performance.now()+delays[i],
            cand:0,said:false};
  });
}
function releaseDelays(){
  var k=Math.min(6,blocksTotal*0.4)*1000;
  return [0,Math.max(2000,4000-k),Math.max(4000,8000-k),Math.max(7000,13000-k)];
}

/* ---------------- runs and mazes ---------------- */
function startRun(){
  score=0;rigs=3;feesRun=0;foundRun=0;lostRun=0;orphRun=0;whRun=0;
  blocksTotal=0;layoutIdx=0;pendingHalving=false;
  hidMid=false; /* a hide during the final death animation must not pause the NEXT run */
  overlay.hidden=true;
  fetchFeed();
  startMaze();
}
function startMaze(){
  mz=parseMaze(layoutIdx);
  dealCoins();
  coinsLeft=mz.nCoins;
  feesBlk=0;whalesBlk=0;frenzySaid=false;lastSatSaid=false;
  player=mkPlayer();
  rivals=mkRivals(releaseDelays());
  surgeUntil=0;orphChain=0;graceUntil=0;
  waveChase=true;waveNext=performance.now()+20000;
  state="ready";stateUntil=performance.now()+1300;
  sReady();
  /* floor-arrival trophies first: the block or halving line below has a
     hold of its own and must land last, not get stomped by a plaque */
  if(blocksTotal>=4&&rigs===3)trophy("tidy");
  if(epoch()>=5)trophy("present");
  var h=nextHeight?("#"+fmt(nextHeight)):"next";
  if(pendingHalving){
    pendingHalving=false;
    sHalve();
    say("HALVING: the subsidy drops to "+fmtBtc(subsidy())+". The fees just became more interesting.","ls-good",3500);
  }else{
    say("Block "+h+", epoch "+epoch()+": the last sat scores the "+fmtBtc(subsidy())+" subsidy. Sweep.",null,700);
  }
  paintHud();
}
function nextMaze(){
  blocksTotal++;
  if(nextHeight)nextHeight++;
  if(blocksTotal%HALVE_EVERY===0)pendingHalving=true;
  layoutIdx=blocksTotal%LAYOUTS.length;
  fetchFeed(); /* ripens for the NEXT deal: the chip describes each floor's own deal */
  startMaze();
}
function gameOver(){
  state="over";
  led.g++;
  if(score>led.best)led.best=score;
  led.blk+=foundRun;led.lost+=lostRun;led.orph+=orphRun;led.wh+=whRun;
  led.fees+=feesRun;
  if(epoch()>led.ep)led.ep=epoch();
  saveLed();paintLedger();
  sOver();
  var line=foundRun===0?
    "No blocks found. The rivals mined right past you, which is what hashrate does.":
    (foundRun===1?
     "One block found. Somewhere an orphaned rival is telling the story differently.":
     foundRun+" blocks found, and you saw epoch "+epoch()+". The fees were carrying you by the end.");
  ovTitle.textContent="OUT OF RIGS";
  ovText.innerHTML="<b>"+fmtScore(score)+"</b> · "+foundRun+" block"+(foundRun===1?"":"s")+" found · "+
    lostRun+" lost to rivals · epoch "+epoch()+".<br><br>"+line;
  ovBtn.textContent="Mine again";
  overlay.hidden=false;
  say("Run over: "+fmtScore(score)+", "+foundRun+" blocks found, epoch "+epoch()+". "+line,null,5000);
}

/* ---------------- sweeping ---------------- */
function checkCoiner(){
  if(led.fees+feesRun>=1e8)trophy("coiner");
}
function playerSweep(r,c){
  var v=mz.coins[r][c];
  if(!v)return;
  var whale=isWhale(r,c),surge=isSurgeCell(r,c);
  mz.coins[r][c]=0;coinsLeft--;
  score+=v;feesRun+=v;feesBlk+=v;
  if(whale){
    whalesBlk++;whRun++;
    sWhaleC();
    say("Whale swept: +"+fmt(v)+" sats, a "+fmt(Math.round(v/WHALE_VB))+" sat/vB scoop.","ls-good",1600);
    if(whalesBlk>=4)trophy("whales");
  }else sCoin();
  if(surge)startSurge();
  checkCoiner();
  if(coinsLeft<=0){blockFound(true,null,r,c);paintHud();return;}
  maybeFrenzySay();
  paintHud();
}
function rivalSweep(g,r,c){
  var v=mz.coins[r][c];
  if(!v)return;
  if(isSurgeCell(r,c)){
    /* rivals cannot use a surge: they roll it into the candidate like any coin */
  }
  mz.coins[r][c]=0;coinsLeft--;
  g.cand+=v;
  if(coinsLeft<=0){blockFound(false,g,r,c);paintHud();return;}
  maybeFrenzySay();
  paintHud();
}
function maybeFrenzySay(){
  if(coinsLeft<=frenzyAt()&&!frenzySaid&&state==="run"){
    frenzySaid=true;
    say("LAST SATS: everyone can count. The race is on.","ls-good",2000);
  }
  if(coinsLeft===1&&!lastSatSaid&&state==="run"){
    lastSatSaid=true;
    say("THE LAST SAT is on the floor. Take it and the block is yours.","ls-good",2500);
  }
}
function startSurge(){
  surgeUntil=performance.now()+surgeMs();
  orphChain=0;
  sSurge();
  rivals.forEach(function(g){
    if(g.state==="normal"){g.state="fright";reverseRival(g);}
  });
  say("SURGE: your hashrate spikes. The rivals are reeling; catch one and orphan it.","ls-good",1500);
}
function endSurge(){
  surgeUntil=0;
  rivals.forEach(function(g){if(g.state==="fright")g.state="normal";});
}
function reverseRival(g){
  var f=g.from;g.from=g.to;g.to=f;g.t=Math.max(0,1-g.t);
  g.dir={dr:g.to.r-g.from.r,dc:(g.to.c-g.from.c>1)?-1:((g.to.c-g.from.c<-1)?1:g.to.c-g.from.c)};
}
function orphanRival(g){
  orphChain++;orphRun++;
  var spilled=g.cand;
  g.cand=0;g.state="eyes";
  sOrphan(orphChain);
  if(spilled>0){
    /* the orphaned candidate goes back to the mempool: coins return to the floor */
    var avg=Math.max(1,Math.round(mz.dealt/Math.max(1,mz.nCoins)));
    var k=Math.max(1,Math.min(10,Math.round(spilled/avg)));
    var spots=[],r,c;
    for(r=0;r<ROWS;r++)for(c=0;c<COLS;c++){
      var ch=mz.rows[r].charAt(c);
      /* never on an 'o' cell or a whale cell: a spilled coin there would
         redraw (and re-trigger) as a surge or whale it is not */
      if((ch==="."||ch===" "||ch==="P")&&!mz.coins[r][c]&&!isWhale(r,c)&&
         manDist(r,c,player.to.r,player.to.c)>2)spots.push({r:r,c:c});
    }
    var each=Math.max(1,Math.floor(spilled/k)),placed=0;
    while(placed<k&&spots.length){
      var i=(Math.random()*spots.length)|0,s=spots.splice(i,1)[0];
      mz.coins[s.r][s.c]=each;coinsLeft++;placed++;
    }
    sSpill();
    say(g.key+" orphaned: its candidate spills "+fmt(spilled)+" sats back onto the floor.","ls-good",2000);
  }else{
    say(g.key+" orphaned before it swept a thing. The chain will not remember it.","ls-good",2000);
  }
  if(orphChain>=4)trophy("reorg4");
  paintHud();
}

/* ---------------- the block ---------------- */
/* the compressed epochs map onto bitcoin's real eras, so the anchor phrase
   stays honest in every one of them */
function eraLine(){
  var ep=epoch();
  if(ep===1)return "what a real miner collected in the 2009 era";
  if(ep===2)return "what a real miner collected in the 2012 era";
  if(ep===3)return "what a real miner collected in the 2016 era";
  if(ep===4)return "what a real miner collected in the 2020 era";
  if(ep===5)return "exactly what a real miner collects today";
  return "what miners will be down to in an era still to come";
}
function blockFound(byPlayer,rival,lr,lc){
  state="found";stateUntil=performance.now()+(reduce?500:1400);
  endSurge();
  var sub=subsidy(),h=nextHeight?("#"+fmt(nextHeight)):"";
  /* plaques first: the block line below must land last and stick */
  if(feesBlk>=0.8*mz.dealt&&mz.dealt>0)trophy("greedy");
  if(feesBlk>sub)trophy("feeera");
  if(byPlayer){
    /* was it a snatch? any hunting rival close to the last coin counts */
    var near=false;
    rivals.forEach(function(g){
      if(g.state==="normal"&&manDist(g.to.r,g.to.c,lr,lc)<=3)near=true;
    });
    score+=sub;foundRun++;
    trophy("first");
    if(near)trophy("snipe");
    if(led.blk+foundRun>=21)trophy("b21");
    sBlock();
    say("BLOCK "+h+" FOUND: you took the last sat and scored the "+fmtBtc(sub)+" subsidy, "+eraLine()+", plus "+fmt(feesBlk)+" sats of fees.","ls-good",3000);
  }else{
    lostRun++;
    sLost();
    say(rival.key+" took the last sat: block "+h+" is theirs, subsidy and all. Your "+fmt(feesBlk)+" sats of fees stay scored; the chain moves on.","ls-bad",3000);
  }
  paintHud();
}

/* ---------------- death ---------------- */
function playerCaught(g){
  state="dead";stateUntil=performance.now()+(reduce?400:1100);
  endSurge();
  rigs--;
  sDeath();
  paintHud();
  if(rigs>0)say("Outmined. "+g.key+" caught you and a rig goes dark. Rigs left: "+rigs+".","ls-bad",2000);
  else say("Outmined by "+g.key+", and that was the last rig.","ls-bad",2000);
}
function afterDeath(){
  if(rigs<=0){gameOver();return;}
  player=mkPlayer();
  /* the rivals do NOT reset: they keep their floor positions and their
     candidates, so feeding a rig near the endgame buys nothing. Only the
     player pays for a death. */
  graceUntil=performance.now()+1500;
  state="run";
  if(hidMid){hidMid=false;shiftClocks(performance.now()-hidAt);setPause(true);}
}

/* ---------------- movement ---------------- */
function entPx(e){
  var dc=e.to.c-e.from.c;
  if(dc>1)dc=-1;if(dc<-1)dc=1;
  return {x:(e.from.c+dc*e.t+0.5)*cell,y:(e.from.r+(e.to.r-e.from.r)*e.t+0.5)*cell};
}
function tryDir(fromCell,d,ghostly){
  if(!d)return null;
  var nr=fromCell.r+d.dr,nc=wrapC(fromCell.c+d.dc);
  if(nr<0||nr>=ROWS)return null;
  if(!walkable(nr,nc,ghostly))return null;
  return {r:nr,c:nc};
}
function stepPlayer(dt){
  var spd=PSPD;
  var moved=(player.moving?spd*dt:0);
  player.t+=moved;
  while(player.t>=1){
    player.t-=1;
    player.from=player.to;
    playerSweep(player.from.r,player.from.c);
    if(state!=="run")return; /* the sweep may have ended the maze */
    var next=null;
    if(player.want){
      next=tryDir(player.from,player.want,false);
      if(next){player.dir=player.want;player.want=null;}
    }
    if(!next&&player.dir)next=tryDir(player.from,player.dir,false);
    if(next){player.to=next;player.moving=true;}
    else{player.to=player.from;player.t=0;player.moving=false;}
  }
  /* a standing player can start moving the moment a key lands */
  if(!player.moving){
    var d=player.want||player.dir,go=d?tryDir(player.from,d,false):null;
    if(go){
      if(player.want){player.dir=player.want;player.want=null;go=tryDir(player.from,player.dir,false);}
      if(go){player.to=go;player.moving=true;}
    }
  }
}
function rivalTarget(g){
  var ep=epoch();
  if(g.state==="eyes")return null; /* BFS home instead */
  if(coinsLeft<=4)               /* everyone races the floor, SOLO excepted */
    if(g.key!=="SOLO")return "coin";
  if(coinsLeft<=frenzyAt()&&(g.key==="FARM"||g.key==="SNIPE"))return "coin";
  if(g.key==="FARM")return "coin";
  if(g.key==="SOLO")return "wander";
  if(!waveChase)return g.corner;
  if(g.key==="POOL")return {r:player.to.r,c:player.to.c};
  /* SNIPE: four tiles ahead of where you are going */
  var d=player.dir||{dr:0,dc:0};
  return {r:Math.max(0,Math.min(ROWS-1,player.to.r+d.dr*4)),c:wrapC(player.to.c+d.dc*4)};
}
function chooseRival(g){
  /* called at cell arrival: pick g.to */
  var ghostly=(g.state==="eyes"||g.state==="exit");
  var opts=[],i;
  for(i=0;i<4;i++){
    var d=DIRS[i],nr=g.from.r+d.dr,nc=wrapC(g.from.c+d.dc);
    if(nr<0||nr>=ROWS)continue;
    if(!walkable(nr,nc,ghostly))continue;
    /* hunters never walk back in the door */
    if(!ghostly&&(charAt(nr,nc)==="-"||charAt(nr,nc)==="H"))continue;
    if(g.dir&&d.dr===-g.dir.dr&&d.dc===-g.dir.dc)opts.push({d:d,r:nr,c:nc,rev:true});
    else opts.push({d:d,r:nr,c:nc,rev:false});
  }
  var fwd=opts.filter(function(o){return !o.rev;});
  if(fwd.length)opts=fwd;
  if(!opts.length)return;
  var pick=null;
  if(g.state==="fright"){
    pick=opts[(Math.random()*opts.length)|0];
  }else if(g.state==="eyes"){
    var step=bfs(g.from.r,g.from.c,function(r,c){return charAt(r,c)==="H";},true);
    if(step&&(step.dr||step.dc)){
      for(i=0;i<opts.length;i++)if(opts[i].d.dr===step.dr&&opts[i].d.dc===step.dc)pick=opts[i];
    }
    if(!pick)pick=opts[0];
  }else if(g.state==="exit"){
    var step2=bfs(g.from.r,g.from.c,function(r,c){return r===mz.plaza.r&&c===mz.plaza.c;},true);
    if(step2&&(step2.dr||step2.dc)){
      for(i=0;i<opts.length;i++)if(opts[i].d.dr===step2.dr&&opts[i].d.dc===step2.dc)pick=opts[i];
    }
    if(!pick)pick=opts[0];
  }else{
    var tgt=rivalTarget(g);
    if(tgt==="coin"){
      var step3=bfs(g.from.r,g.from.c,function(r,c){return mz.coins[r][c]>0;},false);
      if(step3&&(step3.dr||step3.dc)){
        for(i=0;i<opts.length;i++)if(opts[i].d.dr===step3.dr&&opts[i].d.dc===step3.dc)pick=opts[i];
      }
      if(!pick)pick=opts[(Math.random()*opts.length)|0];
    }else if(tgt==="wander"){
      pick=opts[(Math.random()*opts.length)|0];
    }else{
      var bd=Infinity;
      for(i=0;i<opts.length;i++){
        var dd=manDist(opts[i].r,opts[i].c,tgt.r,tgt.c);
        if(dd<bd){bd=dd;pick=opts[i];}
      }
    }
  }
  if(!pick)pick=opts[0];
  g.dir=pick.d;g.to={r:pick.r,c:pick.c};
}
function stepRival(g,dt,now){
  if(g.state==="house"){
    if(now>=g.releaseAt){
      g.state="exit";
      if(!g.said&&state==="run"){g.said=true;say(OUT_LINES[g.key]);}
    }
    return;
  }
  var spd=RSPD*ramp();
  if(g.state==="fright")spd=FRIGHT_SPD;
  else if(g.state==="eyes")spd=EYES_SPD;
  else if(g.state==="exit")spd=3;
  if(inTunnel(g.from.r,g.from.c))spd*=0.55;
  g.t+=spd*dt;
  while(g.t>=1){
    g.t-=1;
    g.from=g.to;
    if(g.state==="exit"&&g.from.r===mz.plaza.r&&g.from.c===mz.plaza.c){
      g.state=(surgeUntil>0)?"fright":"normal";
    }
    if(g.state==="eyes"&&charAt(g.from.r,g.from.c)==="H"){
      g.state="house";g.releaseAt=now+2500;g.to=g.from;g.t=0;
      return;
    }
    if(g.state==="normal"&&state==="run")rivalSweep(g,g.from.r,g.from.c);
    if(state!=="run"&&state!=="idle")return;
    chooseRival(g);
  }
}
function collide(now){
  if(now<graceUntil)return;
  var pp=entPx(player);
  for(var i=0;i<rivals.length;i++){
    var g=rivals[i];
    if(g.state==="house"||g.state==="exit"||g.state==="eyes")continue;
    var gp=entPx(g);
    var dx=Math.abs(pp.x-gp.x);
    dx=Math.min(dx,W-dx); /* the tunnel wraps for collisions too */
    var dy=pp.y-gp.y;
    if(dx*dx+dy*dy<(cell*0.55)*(cell*0.55)){
      if(g.state==="fright")orphanRival(g);
      else{playerCaught(g);return;}
    }
  }
}

/* ---------------- main loop ---------------- */
function loop(t){
  raf=requestAnimationFrame(loop);
  var dt=Math.min(50,t-lastT)/1000;lastT=t;
  var now=t;
  if(state==="pause"){draw(t);return;}
  if(state==="idle"){
    /* attract: the rivals wander the full floor behind the overlay */
    rivals.forEach(function(g){
      if(g.state==="house"&&now>=g.releaseAt)g.state="exit";
      if(g.state!=="house"){
        var spd=2.6;
        g.t+=spd*dt;
        while(g.t>=1){
          g.t-=1;g.from=g.to;
          if(g.state==="exit"&&g.from.r===mz.plaza.r&&g.from.c===mz.plaza.c)g.state="fright";
          chooseRival(g);
        }
      }
    });
    draw(t);return;
  }
  if(state==="ready"){
    if(now>=stateUntil){
      state="run";
      /* rAF slept while hidden, so shift every deadline by the hidden span
         before pausing: the release stagger must survive a tab switch */
      if(hidMid){hidMid=false;shiftClocks(performance.now()-hidAt);setPause(true);}
    }
    draw(t);return;
  }
  if(state==="dead"){
    if(now>=stateUntil)afterDeath();
    draw(t);return;
  }
  if(state==="found"){
    if(now>=stateUntil)nextMaze();
    draw(t);return;
  }
  if(state!=="run"){draw(t);return;}
  /* the surge clock */
  if(surgeUntil&&now>=surgeUntil)endSurge();
  /* chase and breathe waves */
  if(now>=waveNext){
    waveChase=!waveChase;
    waveNext=now+(waveChase?20000:Math.max(2000,5000-300*(epoch()-1)));
    rivals.forEach(function(g){if(g.state==="normal")reverseRival(g);});
  }
  stepPlayer(dt);
  if(state==="run"){
    rivals.forEach(function(g){stepRival(g,dt,now);});
    if(state==="run")collide(now);
  }
  draw(t);
}

/* ---------------- painting ---------------- */
var cell=26,W=0,H=0;
function sizeBoard(){
  var avail=rig.clientWidth-40-16;
  cell=Math.max(14,Math.min(30,Math.floor(avail/COLS)));
  var maxH=Math.floor((window.innerHeight-330)/ROWS);
  if(maxH>=14)cell=Math.min(cell,maxH);
  W=COLS*cell;H=ROWS*cell;
  var dpr=window.devicePixelRatio||1;
  cv.width=W*dpr;cv.height=H*dpr;
  cv.style.width=W+"px";cv.style.height=H+"px";
  ctx.setTransform(dpr,0,0,dpr,0,0);
  draw(performance.now());
}
function rr(x,y,w,h,r){
  if(w<2*r)r=w/2;if(h<2*r)r=h/2;
  ctx.beginPath();
  ctx.moveTo(x+r,y);
  ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);
  ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);
  ctx.closePath();
}
function drawEntity(px,fn){
  fn(px);
  if(px.x<cell)fn({x:px.x+W,y:px.y});
  if(px.x>W-cell)fn({x:px.x-W,y:px.y});
}
function draw(t){
  if(!mz)return;
  ctx.fillStyle="#0B0908";ctx.fillRect(0,0,W,H);
  var r,c;
  /* walls */
  for(r=0;r<ROWS;r++)for(c=0;c<COLS;c++){
    var ch=mz.rows[r].charAt(c);
    if(ch==="#"){
      ctx.fillStyle="#221A10";
      rr(c*cell+1,r*cell+1,cell-2,cell-2,3);ctx.fill();
      ctx.strokeStyle="#3A2E1C";ctx.lineWidth=1;
      rr(c*cell+1.5,r*cell+1.5,cell-3,cell-3,3);ctx.stroke();
    }else if(ch==="-"){
      ctx.fillStyle="#A98F65";
      ctx.fillRect(c*cell+2,r*cell+cell*0.42,cell-4,Math.max(2,cell*0.14));
    }
  }
  /* coins */
  for(r=0;r<ROWS;r++)for(c=0;c<COLS;c++){
    var v=mz.coins[r][c];
    if(!v)continue;
    var cx=c*cell+cell/2,cy=r*cell+cell/2;
    if(isSurgeCell(r,c)){
      var pul=reduce?1:(0.85+0.15*Math.sin(t/220));
      ctx.strokeStyle="#F7931A";ctx.lineWidth=2;
      ctx.beginPath();ctx.arc(cx,cy,cell*0.24*pul,0,7);ctx.stroke();
      ctx.fillStyle="#FFD9A0";
      ctx.beginPath();ctx.arc(cx,cy,cell*0.09,0,7);ctx.fill();
    }else if(isWhale(r,c)){
      ctx.shadowColor="rgba(255,233,184,.8)";ctx.shadowBlur=8;
      ctx.fillStyle="#FFE9B8";
      ctx.beginPath();ctx.arc(cx,cy,cell*0.2,0,7);ctx.fill();
      ctx.shadowBlur=0;
      if(cell>=20){
        ctx.fillStyle="#3A2600";
        ctx.font="700 "+Math.floor(cell*0.26)+"px Cascadia Mono,Consolas,monospace";
        ctx.textAlign="center";ctx.textBaseline="middle";
        ctx.fillText("₿",cx,cy+0.5);
        ctx.textAlign="left";ctx.textBaseline="alphabetic";
      }
    }else if(coinsLeft===1){
      /* the title mechanic gets a face: the final coin glows and rings */
      var lp=reduce?1:(0.8+0.2*Math.sin(t/180));
      ctx.shadowColor="rgba(255,217,160,.9)";ctx.shadowBlur=10;
      ctx.fillStyle="#FFD9A0";
      ctx.beginPath();ctx.arc(cx,cy,cell*0.16,0,7);ctx.fill();
      ctx.shadowBlur=0;
      ctx.strokeStyle="#F7931A";ctx.lineWidth=1.6;
      ctx.beginPath();ctx.arc(cx,cy,cell*0.28*lp,0,7);ctx.stroke();
    }else{
      ctx.fillStyle="#D8A959";
      ctx.beginPath();ctx.arc(cx,cy,cell*0.1,0,7);ctx.fill();
    }
  }
  var now=t;
  /* rivals */
  rivals.forEach(function(g){
    var px=entPx(g);
    drawEntity(px,function(p){
      var fright=g.state==="fright";
      var ending=fright&&surgeUntil-now<2000;
      var flash=ending&&!reduce&&Math.floor(now/180)%2===0;
      if(g.state==="eyes"){
        ctx.fillStyle="#E8E2D6";
        ctx.beginPath();ctx.arc(p.x-cell*0.13,p.y,cell*0.1,0,7);ctx.fill();
        ctx.beginPath();ctx.arc(p.x+cell*0.13,p.y,cell*0.1,0,7);ctx.fill();
        ctx.fillStyle="#241200";
        ctx.beginPath();ctx.arc(p.x-cell*0.13+g.dir.dc*2,p.y+g.dir.dr*2,cell*0.045,0,7);ctx.fill();
        ctx.beginPath();ctx.arc(p.x+cell*0.13+g.dir.dc*2,p.y+g.dir.dr*2,cell*0.045,0,7);ctx.fill();
        return;
      }
      /* under reduced motion the about-to-recover warning is a steady lighter body */
      ctx.fillStyle=fright?(flash?"#E8E2D6":(ending&&reduce?"#7E96BC":"#3D5A8A")):g.color;
      var rad=cell*0.36;
      ctx.beginPath();
      ctx.arc(p.x,p.y-rad*0.15,rad,Math.PI,0);
      ctx.lineTo(p.x+rad,p.y+rad*0.7);
      var k;
      for(k=2;k>=-2;k--)ctx.lineTo(p.x+rad*k/2.5,p.y+rad*(k%2===0?0.7:0.5));
      ctx.closePath();ctx.fill();
      if(fright){
        ctx.fillStyle=flash?"#3D5A8A":"#E8E2D6";
        ctx.beginPath();ctx.arc(p.x-cell*0.11,p.y-cell*0.08,cell*0.05,0,7);ctx.fill();
        ctx.beginPath();ctx.arc(p.x+cell*0.11,p.y-cell*0.08,cell*0.05,0,7);ctx.fill();
      }else{
        ctx.fillStyle="#FFFFFF";
        ctx.beginPath();ctx.arc(p.x-cell*0.12,p.y-cell*0.1,cell*0.09,0,7);ctx.fill();
        ctx.beginPath();ctx.arc(p.x+cell*0.12,p.y-cell*0.1,cell*0.09,0,7);ctx.fill();
        ctx.fillStyle="#241200";
        ctx.beginPath();ctx.arc(p.x-cell*0.12+g.dir.dc*cell*0.04,p.y-cell*0.1+g.dir.dr*cell*0.04,cell*0.045,0,7);ctx.fill();
        ctx.beginPath();ctx.arc(p.x+cell*0.12+g.dir.dc*cell*0.04,p.y-cell*0.1+g.dir.dr*cell*0.04,cell*0.045,0,7);ctx.fill();
      }
    });
  });
  /* the player */
  if(state!=="idle"&&state!=="over"&&player){
    var pp=entPx(player);
    drawEntity(pp,function(p){
      var inGrace=now<graceUntil;
      if(inGrace&&!reduce&&Math.floor(now/150)%2===0)return;
      var dying=state==="dead";
      var sc=dying?Math.max(0.15,1-(now-(stateUntil-(reduce?400:1100)))/(reduce?400:1100)):1;
      /* reduced motion: the blink becomes a steady half-fade so the grace still shows */
      ctx.globalAlpha=dying?Math.max(0.25,sc):(inGrace&&reduce?0.55:1);
      ctx.shadowColor="rgba(247,147,26,.8)";ctx.shadowBlur=10;
      ctx.fillStyle="#F7931A";
      ctx.beginPath();ctx.arc(p.x,p.y,cell*0.36*sc,0,7);ctx.fill();
      ctx.shadowBlur=0;
      ctx.strokeStyle="#FFD9A0";ctx.lineWidth=1.4;
      ctx.beginPath();ctx.arc(p.x,p.y,cell*0.36*sc-0.7,0,7);ctx.stroke();
      ctx.fillStyle="#241200";
      ctx.font="700 "+Math.floor(cell*0.4*sc)+"px Cascadia Mono,Consolas,monospace";
      ctx.textAlign="center";ctx.textBaseline="middle";
      ctx.fillText("₿",p.x,p.y+0.5);
      ctx.textAlign="left";ctx.textBaseline="alphabetic";
      ctx.globalAlpha=1;
    });
  }
  /* ready banner */
  if(state==="ready"){
    ctx.fillStyle="rgba(6,5,4,.55)";
    ctx.fillRect(0,H/2-cell,W,cell*2);
    ctx.fillStyle="#FFD9A0";
    ctx.font="700 "+Math.floor(cell*0.75)+"px Cascadia Mono,Consolas,monospace";
    ctx.textAlign="center";ctx.textBaseline="middle";
    ctx.fillText("SWEEP",W/2,H/2);
    ctx.textAlign="left";ctx.textBaseline="alphabetic";
  }
  /* surge vignette: steady under reduced motion, breathing otherwise */
  if(surgeUntil>now){
    ctx.strokeStyle=reduce?"rgba(247,147,26,.3)":"rgba(247,147,26,"+(0.25+0.15*Math.sin(now/120)).toFixed(2)+")";
    ctx.lineWidth=3;
    ctx.strokeRect(1.5,1.5,W-3,H-3);
  }
}
function paintHud(){
  txt("ls-score",fmtScore(score));
  txt("ls-rigs",String(Math.max(0,rigs)));
  txt("ls-block",nextHeight?"#"+fmt(nextHeight):"–");
  txt("ls-sub",fmtBtc(subsidy())+" · e"+epoch());
  txt("ls-coins",String(coinsLeft));
}
function paintLedger(){
  txt("ls-l-games",fmt(led.g));txt("ls-l-best",fmtScore(led.best));
  txt("ls-l-blk",fmt(led.blk));txt("ls-l-lost",fmt(led.lost));
  txt("ls-l-ep",fmt(led.ep));txt("ls-l-orph",fmt(led.orph));
  txt("ls-l-wh",fmt(led.wh));txt("ls-l-fees",fmt(led.fees));
}
function paintOvHeight(){
  var e=el("ls-ovheight");
  if(e)e.textContent=nextHeight?"#"+fmt(nextHeight):"#…";
}

/* ---------------- pause ---------------- */
var paused=false;
function paintPause(){
  var pb=el("ls-pause");
  hideIc(el("ls-ic-pause"),paused);hideIc(el("ls-ic-play"),!paused);
  if(pb)pb.setAttribute("aria-pressed",paused?"true":"false");
}
function shiftClocks(delta){
  if(surgeUntil)surgeUntil+=delta;
  stateUntil+=delta;waveNext+=delta;
  if(sayHoldUntil)sayHoldUntil+=delta;
  if(graceUntil)graceUntil+=delta;
  rivals.forEach(function(g){if(g.state==="house")g.releaseAt+=delta;});
}
function setPause(on){
  if(on&&state!=="run")return;
  if(paused===on)return;
  paused=on;paintPause();
  if(on){pausedAt=performance.now();state="pause";say("Paused. The rivals wait; real miners would not.",null,600);}
  else{
    shiftClocks(performance.now()-pausedAt);
    state="run";lastT=performance.now();
    say("Back to the floor.",null,600);
  }
}
el("ls-pause").addEventListener("click",function(e){
  if(e.detail>0)this.blur();
  if(state==="run")setPause(true);
  else if(state==="pause")setPause(false);
});
document.addEventListener("visibilitychange",function(){
  if(!document.hidden)return;
  if(state==="run")setPause(true);
  else if(state==="ready"||state==="dead"||state==="found"){hidMid=true;hidAt=performance.now();}
});

/* ---------------- input ---------------- */
function steer(dr,dc){
  if(!player)return;
  player.want={dr:dr,dc:dc};
}
ovBtn.addEventListener("click",function(){ac();startRun();});
document.addEventListener("keydown",function(e){
  if(e.altKey||e.ctrlKey||e.metaKey)return;
  var k=e.key;
  if(["ArrowUp","ArrowDown","ArrowLeft","ArrowRight","w","W","a","A","s","S","d","D","p","P"," ","Enter"].indexOf(k)<0)return;
  var tg=e.target;
  if(tg&&tg.closest){
    if(tg.closest("input,select,textarea,a"))return;
    /* a focused button keeps its native Space/Enter activation */
    if(tg.closest("button")&&(k===" "||k==="Enter"))return;
  }
  var r=stage.getBoundingClientRect();
  if(r.bottom<0||r.top>window.innerHeight)return;
  if(state==="run"||state==="ready"||state==="dead"||state==="found"){
    if(k==="ArrowUp"||k==="w"||k==="W"){e.preventDefault();steer(-1,0);}
    else if(k==="ArrowDown"||k==="s"||k==="S"){e.preventDefault();steer(1,0);}
    else if(k==="ArrowLeft"||k==="a"||k==="A"){e.preventDefault();steer(0,-1);}
    else if(k==="ArrowRight"||k==="d"||k==="D"){e.preventDefault();steer(0,1);}
    else if(k==="p"||k==="P"){e.preventDefault();setPause(true);}
    else if(k===" "){e.preventDefault();} /* mid-game Space never scrolls the page */
  }else if(state==="pause"&&(k==="p"||k==="P"||k===" ")){e.preventDefault();setPause(false);}
  else if((k===" "||k==="Enter")&&!overlay.hidden){e.preventDefault();ac();startRun();}
});
function bindPad(id,dr,dc){
  var b=el(id);
  if(!b)return;
  b.addEventListener("pointerdown",function(e){
    if(e.button!==0||!e.isPrimary)return;
    e.preventDefault();steer(dr,dc);
  });
  /* keyboard/AT activation arrives as a detail-0 click (the BB pattern) */
  b.addEventListener("click",function(e){if(e.detail===0)steer(dr,dc);});
}
bindPad("ls-pu",-1,0);bindPad("ls-pd",1,0);bindPad("ls-plft",0,-1);bindPad("ls-prgt",0,1);
/* swipe on the board: each clear direction re-steers */
var swipeOrigin=null;
cv.addEventListener("pointerdown",function(e){
  if(!e.isPrimary)return;
  swipeOrigin={x:e.clientX,y:e.clientY};
});
cv.addEventListener("pointermove",function(e){
  if(!swipeOrigin||!e.isPrimary)return;
  var dx=e.clientX-swipeOrigin.x,dy=e.clientY-swipeOrigin.y,
      ax=Math.abs(dx),ay=Math.abs(dy);
  if(ax<24&&ay<24)return;
  /* one axis must clearly win, or a diagonal drag flip-flops the steering */
  if(ax>ay*1.5)steer(0,dx>0?1:-1);
  else if(ay>ax*1.5)steer(dy>0?1:-1,0);
  else return;
  swipeOrigin={x:e.clientX,y:e.clientY};
});
cv.addEventListener("pointerup",function(){swipeOrigin=null;});
cv.addEventListener("pointercancel",function(){swipeOrigin=null;});

/* two-step reset, sibling idiom */
var resetArmed=false,resetTimer=null;
el("ls-reset").addEventListener("click",function(){
  var b=el("ls-reset");
  if(!resetArmed){
    resetArmed=true;b.classList.add("ls-armed");b.textContent="Click again to wipe";
    resetTimer=setTimeout(function(){resetArmed=false;b.classList.remove("ls-armed");b.textContent="Reset everything";},4000);
    return;
  }
  clearTimeout(resetTimer);resetArmed=false;
  b.classList.remove("ls-armed");b.textContent="Reset everything";
  led={g:0,best:0,blk:0,lost:0,ep:1,orph:0,wh:0,fees:0,tr:[]};
  saveLed();paintLedger();paintShelf();
  say("Wiped. The chain remembers nothing either.",null,600);
});

/* ---------------- fullscreen (shared idiom) ---------------- */
var fsBtn=el("ls-fs");
function fsActive(){return document.fullscreenElement===stage||stage.classList.contains("ls-fake");}
function setInertOutside(on){
  var node=stage;
  while(node&&node!==document.body){
    var p=node.parentElement;
    if(!p)break;
    for(var i=0;i<p.children.length;i++){
      var sib=p.children[i];
      if(sib===node)continue;
      if(on)sib.setAttribute("inert","");else sib.removeAttribute("inert");
    }
    node=p;
  }
}
function paintFs(){
  var on=fsActive();
  hideIc(el("ls-fs-open"),on);hideIc(el("ls-fs-close"),!on);
  fsBtn.setAttribute("aria-pressed",on?"true":"false");
  sizeBoard();
}
function exitFake(){
  stage.classList.remove("ls-fake");document.documentElement.classList.remove("ls-lock");
  setInertOutside(false);paintFs();
}
function fsToggle(){
  if(document.fullscreenElement){document.exitFullscreen();return;}
  if(stage.classList.contains("ls-fake")){exitFake();return;}
  if(stage.requestFullscreen){
    stage.requestFullscreen().then(paintFs).catch(function(){
      stage.classList.add("ls-fake");document.documentElement.classList.add("ls-lock");
      setInertOutside(true);paintFs();
    });
  }else{
    stage.classList.add("ls-fake");document.documentElement.classList.add("ls-lock");
    setInertOutside(true);paintFs();
  }
}
fsBtn.addEventListener("click",function(e){
  if(e.detail>0)this.blur();
  fsToggle();
});
document.addEventListener("fullscreenchange",paintFs);
document.addEventListener("keydown",function(e){
  if(e.key==="Escape"&&stage.classList.contains("ls-fake"))exitFake();
});
window.addEventListener("resize",sizeBoard);

/* ---------------- boot ---------------- */
mz=parseMaze(0);
dealCoins();
coinsLeft=mz.nCoins;
player=mkPlayer();
rivals=mkRivals([600,1800,3200,4600]); /* attract mode wander */
sizeBoard();
paintHud();paintLedger();paintShelf();paintChip();paintOvHeight();
fetchFeed();
fetch(apiBase()+"/height").then(function(r){if(!r.ok)throw 0;return r.json();}).then(function(j){
  if(j&&typeof j.height==="number"&&isFinite(j.height)&&j.height>0){
    nextHeight=Math.floor(j.height)+1;
    paintOvHeight();paintHud();
  }
}).catch(function(){});
lastT=performance.now();
if(!raf)raf=requestAnimationFrame(loop); /* the attract floor runs behind the overlay */
if(led.g>0)say("Welcome back. Best run: "+fmtScore(led.best)+". The floor is freshly swept and the rivals slept badly.");

/* test hook: inert unless the drive suite predefined the global before load;
   lets the headless harness reach the closure to drive deep scenarios
   (halvings, last-sat races) that would take hours of simulated play */
if(typeof window.__LS_TEST_HOOK__==="function")window.__LS_TEST_HOOK__({
  LAYOUTS:LAYOUTS,
  led:function(){return led;},
  refs:function(){return {player:player,rivals:rivals,mz:mz};},
  g:{
    state:function(v){if(v!==undefined)state=v;return state;},
    score:function(v){if(v!==undefined)score=v;return score;},
    coinsLeft:function(v){if(v!==undefined)coinsLeft=v;return coinsLeft;},
    rigs:function(v){if(v!==undefined)rigs=v;return rigs;},
    blocksTotal:function(v){if(v!==undefined)blocksTotal=v;return blocksTotal;},
    surgeUntil:function(){return surgeUntil;},
    graceUntil:function(v){if(v!==undefined)graceUntil=v;return graceUntil;},
    foundRun:function(){return foundRun;},
    lostRun:function(){return lostRun;},
    orphRun:function(){return orphRun;},
    feesRun:function(v){if(v!==undefined)feesRun=v;return feesRun;},
    feesBlk:function(){return feesBlk;},
    nextHeight:function(v){if(v!==undefined)nextHeight=v;return nextHeight;}
  },
  fns:{startRun:startRun,startMaze:startMaze,nextMaze:nextMaze,
       playerSweep:playerSweep,rivalSweep:rivalSweep,orphanRival:orphanRival,
       startSurge:startSurge,endSurge:endSurge,subsidy:subsidy,epoch:epoch,
       fmtBtc:fmtBtc,fmtScore:fmtScore,readLed:readLed,checkCoiner:checkCoiner,
       setPause:setPause,steer:steer,walkable:walkable}
});

/* iOS long-press hardening: user-select:none alone is not honored
   reliably on Safari, so selection is refused at the event layer and any
   range that sneaks through is swept on touchend */
(function(){
  var st=document.querySelector(".ls-stage");
  if(!st)return;
    /* the decisive layer: cancel the NATIVE touch before Safari's selection
     recognizer runs. Scoped to the canvas and overlay prose only, so
     buttons keep their taps and the page keeps its scroll. */
  st.addEventListener("touchstart",function(e){
    var t=e.target;
    if(!t||!t.closest)return;
    if(t.closest("button,a,input,select,textarea"))return;
    if(t.closest("canvas")||t.closest(".ls-overlay"))e.preventDefault();
  },{passive:false});
  ["selectstart","contextmenu"].forEach(function(ev){
    st.addEventListener(ev,function(e){e.preventDefault();});
  });
  document.addEventListener("touchend",function(){
    try{
      var sel=window.getSelection&&window.getSelection();
      if(!sel||!sel.rangeCount||!sel.anchorNode)return;
      var n=sel.anchorNode.nodeType===1?sel.anchorNode:sel.anchorNode.parentNode;
      if(n&&st.contains(n))sel.removeAllRanges();
    }catch(e){}
  },{passive:true});
})();
})();
</script>
