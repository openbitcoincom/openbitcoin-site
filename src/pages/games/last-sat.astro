    if(l&&isFinite(l.g)&&isFinite(l.best)&&isFinite(l.blk)&&isFinite(l.ep))
      /* sat totals can pass 2^31: floor, never |0 (which wraps negative) */
      return {g:l.g|0,best:Math.max(0,Math.floor(l.best)),blk:l.blk|0,
              lost:isFinite(l.lost)?l.lost|0:0,
              ep:Math.max(1,l.ep|0),
              orph:isFinite(l.orph)?l.orph|0:0,
              wh:isFinite(l.wh)?l.wh|0:0,
              fees:isFinite(l.fees)?Math.max(0,Math.floor(l.fees)):0,
              /* kind strings capped at 12 chars: the slot's readLed once
                 silently dropped a long kind on reload, never again */
              tr:Array.isArray(l.tr)?l.tr.filter(function(x){return typeof x==="string"&&x.length<=12;}).slice(0,32):[]};
