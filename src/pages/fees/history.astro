---
import Base from '../../layouts/Base.astro';
import '../../styles/doc.css';

const FH_START = 2009;
const FH_VALS = [
  0, 0, 0, 0,          // 2009: free transactions, mostly empty blocks
  0, 0, 0, 0,          // 2010
  0, 0, 0, 0,          // 2011
  0, 52.5, 72, 113,    // 2012: flat default fee rules start to bind
  125, 114, 80, 38,    // 2013: high sat/vB from fixed BTC-denominated fees
  25.5, 21, 22, 16,    // 2014
  15, 17, 23, 20,      // 2015
  25, 30, 50, 59.5,    // 2016: blocks fill, a real fee market forms
  96, 190, 121, 155.5, // 2017: the backlog year
  18, 10, 6, 5,        // 2018: the unwind
  6, 47, 21, 8.5,      // 2019
  10.5, 20, 38, 50,    // 2020
  66.5, 54, 4, 5,      // 2021: spring spike, second-half collapse
  4, 6, 10, 8,         // 2022
  9, 26.5, 11, 59,     // 2023: inscriptions, May and December
  28, 20, 4, 5,        // 2024: halving quarter, then calm
  2, 2, 1, 1,          // 2025
  1, 1, 1,             // 2026 through Q3
];
const FH_N = FH_VALS.length;
const FH_END_YEAR = FH_START + Math.floor((FH_N - 1) / 4);

const FW = 640, FH = 212, FPT = 26, FPB = 32, FPL = 12, FPR = 12;
const fhHi = Math.max(...FH_VALS);
const fx = (i) => FPL + (i / (FH_N - 1)) * (FW - FPL - FPR);
const fy = (v) => FPT + (1 - v / fhHi) * (FH - FPT - FPB);
const fhLine = 'M' + FH_VALS.map((v, i) => fx(i).toFixed(1) + ',' + fy(v).toFixed(1)).join('L');
const fhArea = fhLine + 'L' + fx(FH_N - 1).toFixed(1) + ',' + (FH - FPB) + 'L' + fx(0).toFixed(1) + ',' + (FH - FPB) + 'Z';
const fhGrid = [0.25, 0.5, 0.75].map((q) => (FPT + q * (FH - FPT - FPB)).toFixed(1));
const fhTicks = [2010, 2014, 2018, 2022, 2026].map((y) => ({ x: fx((y - FH_START) * 4).toFixed(1), t: String(y) }));
const fhEras = [2017, 2021, 2023].map((yy) => {
  const a = (yy - FH_START) * 4;
  let b = a;
  for (let k = a; k < Math.min(a + 4, FH_N); k++) if (FH_VALS[k] > FH_VALS[b]) b = k;
  return { x: fx(b).toFixed(1), y: Math.max(fy(FH_VALS[b]) - 9, 15).toFixed(1), t: String(yy) };
});
const fhEnd = { x: fx(FH_N - 1).toFixed(1), y: fy(FH_VALS[FH_N - 1]).toFixed(1) };
let fhPk = 0;
for (let i = 1; i < FH_N; i++) if (FH_VALS[i] > FH_VALS[fhPk]) fhPk = i;
const fhAria = 'Median bitcoin transaction feerate in satoshis per virtual byte, quarterly from ' + FH_START + ' through ' + FH_END_YEAR + ': free or near free into early 2012, elevated through 2012 and 2013 when flat default fees set the price, peaking near ' + FH_VALS[fhPk] + ' sat per virtual byte in ' + (FH_START + Math.floor(fhPk / 4)) + ', spiking again in 2021 and 2023, and near ' + FH_VALS[FH_N - 1] + ' in the latest quarter.';
import { FX, SYM } from '../../lib/fx.js';
---
<Base title="Bitcoin Fee History: What Sending Bitcoin Has Cost - OpenBitcoin" description="The history of bitcoin transaction fees: the 2017 backlog, the 2021 spike, the 2023 inscriptions wave, and why the fee auction spikes and reverts.">
<main class="wrap doc-wrap">
  <div class="doc-head">
    <div class="doc-kicker">Fee history</div>
    <h1>What sending bitcoin has cost</h1>
    <p class="doc-lede">For most of bitcoin's history a payment has cost pennies to send. Three times the fee market has spiked into real money, and each spike has unwound. Here is the record since 2009, and the mechanics behind it.</p>
  </div>
  <div class="doc-grid">
  <div>
    <div class="fh-chartcard">
      <div class="fh-clab">Median feerate paid, sat/vB, quarterly</div>
      <svg class="fh-chart" viewBox={'0 0 ' + FW + ' ' + FH} role="img" aria-label={fhAria}>
        <defs>
          <linearGradient id="fh-fill" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0" stop-color="rgba(247,147,26,.20)" />
            <stop offset="1" stop-color="rgba(247,147,26,0)" />
          </linearGradient>
        </defs>
        {fhGrid.map((y) => <line class="fh-grid" x1={FPL} x2={FW - FPR} y1={y} y2={y} />)}
        <line class="fh-axis" x1={FPL} x2={FW - FPR} y1={FH - FPB} y2={FH - FPB} />
        <path class="fh-area" d={fhArea} />
        <path class="fh-line" d={fhLine} />
        <circle class="fh-dot" cx={fhEnd.x} cy={fhEnd.y} r="3.5" />
        <g class="fh-eras-g">{fhEras.map((e) => <text class="fh-era-t" x={e.x} y={e.y} text-anchor="middle">{e.t}</text>)}</g>
        <g class="fh-ticks-g">{fhTicks.map((t) => <text x={t.x} y={FH - 10} text-anchor="middle">{t.t}</text>)}</g>
      </svg>
      <div class="fh-cfoot">
        <span class="fh-cap" id="fh-range">{FH_START + ' to ' + FH_END_YEAR + ', linear scale from zero'}</span>
        <span class="fh-cap">Quarterly medians, one chain sample per 144 blocks</span>
      </div>
    </div>

    <div class="fh-eras">
      <div class="fh-eracard">
        <div class="fh-eyear">Era: late 2017</div>
        <h2>The 2017 backlog</h2>
        <p>Through the autumn of 2017, transaction demand ran ahead of block space for months on end. The queue of waiting transactions grew into the hundreds of thousands, and by late December the median fee paid touched roughly $34, with daily averages above $50. For a few weeks, small payments were priced out of the chain entirely.</p>
        <p>The unwind taught as much as the spike did. Exchanges finally adopted batching, putting hundreds of withdrawals into one transaction; SegWit, activated that August, made typical payments smaller as wallets adopted it; and demand itself fell away through 2018. By spring the median fee was back under a dollar, where it stayed for most of two years.</p>
      </div>
      <div class="fh-eracard">
        <div class="fh-eyear">Era: 2023</div>
        <h2>The inscriptions wave</h2>
        <p>In early 2023 the Ordinals protocol began writing images and token mints directly into transaction data, and block space found a brand new bidder. The BRC-20 minting rush of May 2023 pushed the queue past 400,000 transactions, and a major exchange paused bitcoin withdrawals while it caught up. A second wave in December held fee rates elevated into the new year.</p>
        <p>The auction did not care what the bytes were for; it priced token mints exactly the way it prices payments. When minting activity faded through 2024, fee rates fell with it, and 2025 and 2026 have been calm by comparison.</p>
      </div>
    </div>

    <div class="doc-card fh-mt">
      <div class="doc-sec doc-prose">
        <h2>Why fee markets spike, and why they fall back</h2>
        <p>Block space is a fixed-supply auction. The network makes room for roughly the same amount of transaction data every ten minutes no matter how many people want in, so the fee is the only thing that can adjust. When demand surges, whether from a bull market, an exchange rush, or a brand new use for the bytes, the clearing price can move an order of magnitude in days.</p>
        <ul>
          <li><strong>High fees are their own medicine.</strong> Every spike pushes users to economize: exchanges batch withdrawals, wallets adopt smaller transaction formats, holders <a href="/fees/consolidate">consolidate coins</a> once rates fall, and casual transactions simply wait.</li>
          <li><strong>Demand shocks fade.</strong> Spring 2021 pushed the median daily fee to levels unseen since 2017, roughly $26 at the April peak. Within months the rush was over, mining had been disrupted, and fees sat near multi-year lows for the rest of the year.</li>
          <li><strong>Nothing is stuck forever.</strong> A transaction priced below the market waits in the <a href="/mempool">mempool</a> until its rate clears, and most wallets can bump the fee; the <a href="/tx/stuck">stuck transaction guide</a> covers how.</li>
        </ul>
        <p>None of this predicts where fees go next. It describes what has happened in every spike so far: the auction cleared, the incentive to economize did its work, and rates reverted. Around the April 2024 halving the pattern repeated in miniature, with record fees on the halving block itself and a fast fade afterward.</p>
      </div>
    </div>

    <div class="doc-card fh-mt fh-honest">
      <div class="doc-sec doc-prose">
        <h2>Cheap fees are also the security budget</h2>
        <p>Miners are paid twice for every block: newly issued coins, currently 3.125 BTC, and the fees of the transactions inside. The new-coin subsidy halves roughly every four years and rounds toward zero over the coming decades, so the share of security that fees must carry rises on a fixed schedule. Historically fees have been a small slice of miner revenue, with brief exceptions; around the April 2024 halving, some blocks earned more in fees than in subsidy. A calm fee chart is good news for anyone sending a payment and an open question for the long-run security budget, and both things are true at once. The schedule doing the work is on the <a href="/halving">halving page</a>.</p>
      </div>
    </div>

    <div class="fh-about doc-prose">
      <p>Fee history is the record of one auction repeating itself: demand arrives, the fixed supply of block space prices it, users adapt, and the market calms until the next surge. Today's rates are on the <a href="/fees">fees page</a>, the live queue is on the <a href="/mempool">mempool page</a>, and each block's fee total is on the <a href="/blocks">blocks page</a>. The chart is drawn from this site's own reading of the chain, one fee sample every 144 blocks; the dollar figures in the era stories reflect public fee datasets, and data provenance for everything this site measures is documented at <a href="/sources">/sources</a>.</p>
    </div>
  </div>
  <aside class="doc-rail">
    <div class="doc-tile">
      <div class="doc-tlab">Fees right now</div>
      <div class="fh-stat"><b id="fh-eco">2 sat/vB</b><i>economy &middot; <span class="fh-fiat" data-rate="2">$0.18</span> typical payment</i></div>
      <div class="fh-stat"><b id="fh-fast">5 sat/vB</b><i>fastest &middot; <span class="fh-fiat" data-rate="5">$0.45</span> typical payment</i></div>
    </div>
    <div class="doc-tile">
      <div class="doc-tlab">Related</div>
      <nav>
        <a href="/fees">Fees right now</a>
        <a href="/halving">Halving countdown</a>
        <a href="/mempool">Mempool live</a>
        <a href="/blocks">Latest blocks</a>
      </nav>
    </div>
  </aside>
  </div>
</main>
<style is:global>
  .fh-chartcard{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px 18px 14px}
  .fh-clab{font:700 9.5px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3)}
  .fh-chart{display:block;width:100%;height:auto;margin-top:8px}
  .fh-grid{stroke:var(--line-2);stroke-width:1;stroke-dasharray:2 5;vector-effect:non-scaling-stroke}
  .fh-axis{stroke:var(--line-2);stroke-width:1;vector-effect:non-scaling-stroke}
  .fh-area{fill:url(#fh-fill)}
  .fh-line{fill:none;stroke:var(--acc);stroke-width:2;stroke-linejoin:round;stroke-linecap:round;vector-effect:non-scaling-stroke}
  .fh-dot{fill:var(--acc);stroke:var(--panel);stroke-width:2}
  .fh-chart text{font:600 10.5px var(--mono);letter-spacing:.05em;fill:var(--ink-3);font-variant-numeric:tabular-nums}
  .fh-chart .fh-era-t{font-weight:700;fill:var(--ink-2)}
  .fh-cfoot{display:flex;justify-content:space-between;align-items:center;gap:6px 14px;flex-wrap:wrap;margin-top:8px}
  .fh-cap{font:600 9px var(--mono);letter-spacing:.11em;text-transform:uppercase;color:var(--ink-3)}
  .fh-mt{margin-top:14px}
  .fh-eras{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:14px}
  .fh-eracard{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:18px 22px 20px;min-width:0}
  .fh-eyear{font:700 9.5px var(--mono);letter-spacing:.13em;text-transform:uppercase;color:var(--acc)}
  .fh-eracard h2{font:700 16.5px/1.3 var(--sans);color:var(--ink);margin:6px 0 0}
  .fh-eracard p{font:500 13.5px/1.65 var(--sans);color:var(--ink-2);margin:9px 0 0}
  .fh-honest{border-color:rgba(255,166,60,.32)}
  .fh-about{margin-top:14px}
  .fh-about p{font:500 13.5px/1.65 var(--sans);color:var(--ink-3)}
  .fh-stat{padding:7px 0;border-bottom:1px dotted var(--line-2)}
  .fh-stat:last-child{border-bottom:0}
  .fh-stat b{display:block;font:700 16px var(--mono);color:var(--ink);font-variant-numeric:tabular-nums}
  .fh-stat i{display:block;font:600 9px var(--mono);letter-spacing:.11em;text-transform:uppercase;color:var(--ink-3);font-style:normal;margin-top:2px}
  .fh-fiat{color:var(--ink-2);font-variant-numeric:tabular-nums}
  @media(max-width:700px){
    .fh-eras{grid-template-columns:minmax(0,1fr)}
    .fh-eracard{padding:16px 18px 18px}
  }
  @media(max-width:520px){
    
    .fh-chart text{font-size:17px}
    .fh-dot{r:5}
  }
</style>
<script is:inline define:vars={{ FXSEED: FX, SYMSEED: SYM }}>
(function(){
  var fx=FXSEED,sym=SYMSEED; /* seeded from src/lib/fx.js via define:vars */
  var VB=141;
  /* fallback baseline; both rail rates repaint from the live feed */
  var P={price:64362.18,cur:"USD"};
  var costs=document.querySelectorAll(".fh-fiat");
  function fmt(n,d){return n.toLocaleString("en-US",{minimumFractionDigits:0,maximumFractionDigits:d});}
  function fiat(v){var s=sym[P.cur]||"",t=fmt(v,v>=100?0:2);return s?s+t:t+" "+P.cur;}
  function paint(){
    costs.forEach(function(el){
      el.textContent=fiat(parseFloat(el.dataset.rate)*VB*P.price*fx[P.cur]/1e8);
    });
  }
  /* the economy and fastest targets off a /summary payload, the same fields
     the /fees page reads; the typical-payment costs follow the same rates */
  var TIERS=[["fh-eco","economy"],["fh-fast","fastest"]];
  function applyFees(d){
    var f=d&&d.fees;if(!f)return false;
    TIERS.forEach(function(t){
      var r=f[t[1]],b=document.getElementById(t[0]);
      if(!b||typeof r!=="number"||!(r>0))return;
      b.textContent=(r%1?r.toFixed(1):String(r))+" sat/vB";
      var fi=b.parentNode.querySelector(".fh-fiat");
      if(fi)fi.dataset.rate=String(r);
    });
    return true;
  }
  /* live price and footer currency changes arrive via the chrome hooks;
     chrome.js refreshes window.OB_LIVE before each repaint call */
  window.obPaintFiat=function(S){
    P.price=S.price;if(S.cur)P.cur=S.cur;
    if(window.OB_LIVE)applyFees(window.OB_LIVE);
    paint();
  };
  window.obCurrencyChange=function(S){P.cur=S.cur;paint();};
  paint();
  /* initial fetch: OB_DATA_API is set by Base.astro after this script parses,
     so wait for DOMContentLoaded; on any failure the fallbacks stand */
  function boot(){
    try{
      if(window.OB_LIVE&&applyFees(window.OB_LIVE)){paint();return;}
      var api=window.OB_DATA_API;
      if(typeof api!=="string"||!api)return;
      fetch(api+"/summary").then(function(r){return r.json();}).then(function(d){
        if(applyFees(d))paint();
      }).catch(function(){});
    }catch(e){}
  }
  if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",boot);
  else boot();
})();
</script>
<script is:inline>
(function(){
  /* Live chart: one {OB_DATA_API}/fee-history?days=10000 fetch on load; with
     500+ chain samples the quarterly medians are recomputed with the same
     rule as the shipped snapshot and the built SVG is redrawn in place
     (line, area, end dot, era anchors, year ticks, caption range, aria).
     Any failure or a short response leaves the page exactly as served. */
  var FW=640,FHT=212,FPT=26,FPB=32,FPL=12,FPR=12,NS="http://www.w3.org/2000/svg";
  function draw(points){
    var card=document.querySelector(".fh-chartcard");if(!card)return;
    var svg=card.querySelector(".fh-chart"),line=card.querySelector(".fh-line"),
        area=card.querySelector(".fh-area"),dot=card.querySelector(".fh-dot"),
        eg=card.querySelector(".fh-eras-g"),tg=card.querySelector(".fh-ticks-g"),
        range=document.getElementById("fh-range");
    if(!svg||!line||!area||!dot||!eg||!tg||!range)return;
    /* quarterly medians of the per-sample median feerate; null samples are
       skipped, zero-fee quarters are real (the free-transaction era) and kept */
    var Q={},order=[],i;
    for(i=0;i<points.length;i++){
      var s=points[i];if(!s)continue;
      var v=s[2];
      if(v==null||!isFinite(v))continue;
      var d=new Date(s[0]*1000),k=d.getUTCFullYear()*4+Math.floor(d.getUTCMonth()/3);
      if(!Q[k]){Q[k]=[];order.push(k);}
      Q[k].push(+v);
    }
    order.sort(function(a,b){return a-b;});
    var vals=[],years=[];
    for(i=0;i<order.length;i++){
      var a=Q[order[i]].slice().sort(function(x,y){return x-y;}),m=a.length;
      vals.push(m%2?a[(m-1)/2]:(a[m/2-1]+a[m/2])/2);
      years.push(Math.floor(order[i]/4));
    }
    var n=vals.length;if(n<2)return;
    var pk=0;for(i=1;i<n;i++)if(vals[i]>vals[pk])pk=i;
    var hi=vals[pk];if(!(hi>0))return;
    function fx(j){return FPL+(j/(n-1))*(FW-FPL-FPR);}
    function fy(v){return FPT+(1-v/hi)*(FHT-FPT-FPB);}
    var dd="M"+vals.map(function(v,j){return fx(j).toFixed(1)+","+fy(v).toFixed(1);}).join("L");
    line.setAttribute("d",dd);
    area.setAttribute("d",dd+"L"+fx(n-1).toFixed(1)+","+(FHT-FPB)+"L"+fx(0).toFixed(1)+","+(FHT-FPB)+"Z");
    dot.setAttribute("cx",fx(n-1).toFixed(1));
    dot.setAttribute("cy",fy(vals[n-1]).toFixed(1));
    while(eg.firstChild)eg.removeChild(eg.firstChild);
    [2017,2021,2023].forEach(function(y){
      var b=-1,j;
      for(j=0;j<n;j++)if(years[j]===y&&(b<0||vals[j]>vals[b]))b=j;
      if(b<0)return;
      var t=document.createElementNS(NS,"text");
      t.setAttribute("class","fh-era-t");
      t.setAttribute("x",fx(b).toFixed(1));
      t.setAttribute("y",Math.max(fy(vals[b])-9,15).toFixed(1));
      t.setAttribute("text-anchor","middle");
      t.textContent=String(y);
      eg.appendChild(t);
    });
    while(tg.firstChild)tg.removeChild(tg.firstChild);
    var y0=years[0],y1=years[n-1],y;
    for(y=y0;y<=y1;y++){
      if(y%4!==2)continue; /* 2010, 2014, 2018, 2022, 2026, ... */
      var f=years.indexOf(y);if(f<0)continue;
      var tx=document.createElementNS(NS,"text");
      tx.setAttribute("x",fx(f).toFixed(1));
      tx.setAttribute("y",String(FHT-10));
      tx.setAttribute("text-anchor","middle");
      tx.textContent=String(y);
      tg.appendChild(tx);
    }
    range.textContent=y0+" to "+y1+", linear scale from zero";
    svg.setAttribute("aria-label","Median bitcoin transaction feerate in satoshis per virtual byte, quarterly from "+y0+" through "+y1+": free or near free into early 2012, elevated through 2012 and 2013 when flat default fees set the price, peaking near "+hi+" sat per virtual byte in "+years[pk]+", spiking again in 2021 and 2023, and near "+vals[n-1]+" in the latest quarter.");
  }
  /* OB_DATA_API is set by Base.astro after this script parses, so wait for
     DOMContentLoaded */
  function boot(){
    try{
      var api=(typeof window.OB_DATA_API==="string"&&window.OB_DATA_API)?window.OB_DATA_API:"/api/v1";
      fetch(api+"/fee-history?days=10000").then(function(r){
        if(!r.ok)throw new Error("fee-history "+r.status);
        return r.json();
      }).then(function(j){
        if(!j||!Array.isArray(j.points)||j.points.length<500)return;
        draw(j.points);
      }).catch(function(){});
    }catch(e){}
  }
  if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",boot);
  else boot();
})();
</script>
</Base>
