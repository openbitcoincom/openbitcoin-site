<script is:inline>
(function(){
  /* height ships as null, not as a baked figure: a block height is stale ten
     minutes after it is written, so the tile holds an ellipsis until the
     chrome hook paints the real one */
  var P={price:64362.18,height:null};
  function fmt(n){return n.toLocaleString("en-US");}
  var px=document.getElementById("ai-px"),h=document.getElementById("ai-h");
  function paint(){
    if(px)px.textContent="$"+fmt(Math.round(P.price));
    if(h)h.textContent=(P.height===null?"…":fmt(P.height));
  }
  /* live price and height arrive via the chrome hook (~1.5s and on new blocks) */
  window.obPaintFiat=function(S){if(S.price)P.price=S.price;if(S.height)P.height=S.height;paint();};
  paint();
})();
</script>
