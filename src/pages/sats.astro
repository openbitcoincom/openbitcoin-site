---
import Base from '../layouts/Base.astro';
import '../styles/doc.css';
---
<Base title="Sats to USD Converter: What 50,000 Sats Is Worth - OpenBitcoin" description="Convert satoshis to US dollars and 14 other currencies, live as you type. See what 50,000 sats is worth, the value of 1 sat, and sats per dollar.">
<main class="wrap doc-wrap">
  <div class="doc-head">
    <div class="doc-kicker">Sats</div>
    <h1>Sats converter</h1>
    <p class="doc-lede">Satoshis to dollars and 14 other currencies, live as you type. One bitcoin is 100,000,000 sats; the rate is a median of three exchanges, documented at /sources.</p>
  </div>
  <div class="doc-grid">
  <div>
    <div class="st-card">
      <div class="st-row">
        <div class="st-side">
          <div class="st-lab">Satoshis</div>
          <input id="st-s" inputmode="numeric" autocomplete="off" spellcheck="false" aria-label="Amount in satoshis">
          <div class="st-hint">1 BTC = 100,000,000 sats</div>
        </div>
        <div class="st-eq" aria-hidden="true">=</div>
        <div class="st-side">
          <div class="st-lab">Fiat</div>
          <input id="st-f" inputmode="decimal" autocomplete="off" spellcheck="false" aria-label="Amount in fiat">
          <div class="st-units" id="st-fiats" aria-label="Currency"></div>
        </div>
      </div>
    </div>
    <div class="st-card" style="margin-top:14px">
      <div class="st-tlab">Common amounts</div>
      <table class="st-table" id="st-table" aria-label="Common sat amounts and their fiat value">
        <thead><tr><th>Sats</th><th>Bitcoin</th><th id="st-percol">≈ USD</th></tr></thead>
        <tbody></tbody>
      </table>
      <div class="st-note">Click a row to load it into the converter.</div>
    </div>
    <div class="st-about doc-prose">
      <p>A satoshi, or sat, is the smallest unit of bitcoin: one hundred-millionth of a coin, so one bitcoin is exactly 100,000,000 sats. Lightning payments and most everyday amounts on the Bitcoin network are quoted in sats, which is why questions like "how much is 50,000 sats" come up daily. This page converts sats to 15 fiat currencies using a spot price computed as a median of three exchanges, described at <a href="/sources">/sources</a>. Rates are informational; see the <a href="/terms">terms</a>.</p>
    </div>
  </div>
  <aside class="doc-rail">
    <div class="doc-tile">
      <div class="doc-tlab">Right now</div>
      <div class="st-stat"><b id="st-r1">&hellip;</b><i>1 satoshi</i></div>
      <div class="st-stat"><b id="st-r2">&hellip;</b><i>per US dollar</i></div>
      <div class="st-stat"><b id="st-r3">&hellip;</b><i>1 BTC</i></div>
    </div>
    <div class="doc-tile">
      <div class="doc-tlab">Related</div>
      <nav>
        <a href="/convert">Full bitcoin converter</a>
        <a href="/sats-per-dollar">Sats per dollar</a>
      </nav>
    </div>
  </aside>
  </div>
</main>
<style is:global>
  .st-card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:22px 24px}
  .st-row{display:flex;align-items:stretch;gap:16px}
  .st-side{flex:1;min-width:0}
  .st-lab{font:700 9.5px var(--mono);letter-spacing:.13em;text-transform:uppercase;color:var(--ink-3);margin-bottom:8px}
  .st-side input{width:100%;box-sizing:border-box;background:rgba(124,140,168,.13);border:1px dashed rgba(255,166,60,.32);
    border-radius:10px;color:var(--price-ink);font:700 30px var(--mono);font-variant-numeric:tabular-nums;
    padding:12px 15px;outline:none;letter-spacing:-.5px}
  .st-side input:focus{border-style:solid;border-color:rgba(255,166,60,.55)}
  .st-eq{align-self:center;font:700 22px var(--mono);color:var(--ink-3);padding-top:18px}
  .st-hint{font:600 10px var(--mono);letter-spacing:.08em;color:var(--ink-3);margin-top:12px}
  .st-units{display:flex;width:100%;border:1px solid var(--line-2);border-radius:8px;overflow:hidden;margin-top:10px;flex-wrap:wrap}
  .st-units button{background:transparent;border:0;color:var(--ink-2);font:700 10.5px var(--mono);letter-spacing:.08em;
    padding:7px 12px;min-height:30px;cursor:pointer;border-right:1px solid var(--line);white-space:nowrap;
    flex:1 1 auto;text-align:center}
  .st-units button:last-child{border-right:0}
  .st-units button:hover{background:rgba(36,51,78,.55);color:var(--ink)}
  .st-units button.on{background:var(--cta);color:var(--cta-ink);box-shadow:inset 0 1px 0 rgba(255,255,255,.09),inset 0 -2px 0 var(--orange)}
  .st-tlab{font:700 9.5px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);margin-bottom:10px}
  .st-table{width:100%;border-collapse:collapse}
  .st-table th{font:700 9.5px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3);
    text-align:left;padding:0 10px 8px 0;border-bottom:1px solid var(--line-2)}
  .st-table td{font:600 14.5px var(--mono);color:var(--ink-2);padding:10px 10px 10px 0;border-bottom:1px dotted var(--line-2);
    font-variant-numeric:tabular-nums;white-space:nowrap}
  .st-table tr:last-child td{border-bottom:0}
  .st-table td:first-child{color:var(--ink);font-weight:700}
  .st-table td b{color:var(--price-ink);font-weight:700}
  .st-table tbody tr{cursor:pointer}
  .st-table tbody tr:hover td{background:rgba(36,51,78,.35)}
  .st-note{font:600 10px var(--mono);letter-spacing:.06em;color:var(--ink-3);margin-top:10px}
  .st-about{margin-top:14px}
  .st-about p{font:500 13.5px/1.65 var(--sans);color:var(--ink-3)}
  .st-stat{padding:7px 0;border-bottom:1px dotted var(--line-2)}
  .st-stat:last-child{border-bottom:0}
  .st-stat b{display:block;font:700 16px var(--mono);color:var(--ink);font-variant-numeric:tabular-nums}
  .st-stat i{display:block;font:600 9px var(--mono);letter-spacing:.11em;text-transform:uppercase;color:var(--ink-3);font-style:normal;margin-top:2px}
  @media(max-width:700px){
    .st-row{flex-direction:column;gap:12px}
    .st-eq{align-self:flex-start;padding:0}
    .st-side input{font-size:26px}
  }
</style>
<script is:inline>
(function(){
  var ELL="…";
  /* pre-fetch fallback only: window.OB_FX, the site's one rate table, replaces
     this on DOMContentLoaded and is then updated in place by chrome.js */
  var fx={USD:1,EUR:.8745,GBP:.7442,CAD:1.4023,AUD:1.4337,SEK:9.655,JPY:162.35,CNY:6.7775,RUB:78.1,BRL:5.1158,MXN:17.4837,INR:96.28,TRY:47.142,KRW:1485.32,CHF:.807},
      sym={USD:"$",EUR:"€",GBP:"£",CAD:"$",AUD:"$",SEK:"",JPY:"¥",CNY:"¥",RUB:"₽",BRL:"R$",MXN:"$",INR:"₹",TRY:"₺",KRW:"₩",CHF:""};
  var SATS=1e8,CAP=21e6*SATS,DEF=50000,AMTS=[100,1000,10000,100000,1000000];
  /* price null until the feed answers: no fiat figure is invented from a seed */
  var P={price:null,cur:"USD",sats:DEF};
  var elS=document.getElementById("st-s"),elF=document.getElementById("st-f"),
      tbl=document.querySelector("#st-table tbody"),percol=document.getElementById("st-percol"),
      fwrap=document.getElementById("st-fiats");
  function fmt(n,d){return n.toLocaleString("en-US",{minimumFractionDigits:0,maximumFractionDigits:d});}
  function parse(s){s=(""+s).replace(/[^0-9.]/g,"");var n=parseFloat(s);return isFinite(n)?n:null;}
  function fiatDec(v){return v>=100?0:v>=1?2:v>=.01?4:6;}

  /* fiat selector: same toggle idiom as /convert, wraps into rows */
  Object.keys(fx).forEach(function(c){
    var b=document.createElement("button");
    b.textContent=c;b.dataset.c=c;
    if(c===P.cur)b.className="on";
    b.addEventListener("click",function(){P.cur=c;
      fwrap.querySelectorAll("button").forEach(function(x){x.className=x.dataset.c===c?"on":"";});
      render("all");});
    fwrap.appendChild(b);
  });

  function rate(){var r=fx[P.cur];return typeof r==="number"?r:1;}
  function fiatVal(sats){return sats/SATS*P.price*rate();}
  function paintS(){elS.value=fmt(P.sats,0);}
  function paintF(){
    if(P.price===null){elF.value=ELL;return;}
    var v=fiatVal(P.sats);elF.value=fmt(v,fiatDec(v));
  }
  function paintTable(){
    percol.textContent="≈ "+P.cur;
    var s=sym[P.cur]||"";
    tbl.innerHTML=AMTS.map(function(a){
      /* sats and BTC are unit arithmetic and always real; the fiat cell waits
         for a price */
      var cell=ELL;
      if(P.price!==null){var v=fiatVal(a);cell=s+fmt(v,fiatDec(v));}
      return "<tr data-a="+a+"><td>"+fmt(a,0)+"</td><td>"+fmt(a/SATS,8)+" BTC</td><td><b>"+cell+"</b></td></tr>";
    }).join("");
    tbl.querySelectorAll("tr").forEach(function(r){
      r.addEventListener("click",function(){P.sats=parseInt(r.dataset.a,10);render("all");});
    });
  }
  function paintRail(){
    var s=sym[P.cur]||"",
        r1=document.getElementById("st-r1"),r2=document.getElementById("st-r2"),r3=document.getElementById("st-r3");
    if(P.price===null){r1.textContent=ELL;r2.textContent=ELL;r3.textContent=ELL;return;}
    var unit=P.price*rate();
    r1.textContent=s+fmt(unit/SATS,6);
    r2.textContent=fmt(SATS/P.price,0)+" sats";
    r3.textContent=s+fmt(unit,0)+(s?"":" "+P.cur);
  }
  function render(which){
    if(which!=="fromS")paintS();
    if(which!=="fromF")paintF();
    paintTable();paintRail();
  }

  elS.addEventListener("input",function(){var n=parse(elS.value);if(n===null)return;
    if(n>CAP)n=CAP;P.sats=n;render("fromS");});
  /* fiat to sats needs a rate: with no price yet the typing is left alone
     rather than converted against a made-up one */
  elF.addEventListener("input",function(){if(P.price===null)return;
    var n=parse(elF.value);if(n===null)return;
    var sats=n/(P.price*rate())*SATS;if(sats>CAP)sats=CAP;P.sats=sats;render("fromF");});
  [elS,elF].forEach(function(el){
    el.addEventListener("focus",function(){el.select();});
    el.addEventListener("blur",function(){
      /* while the fiat box is holding the placeholder it is not an emptied
         field, so leaving it must not reset the amount */
      if(el===elF&&P.price===null)return;
      if(parse(el.value)===null||parse(el.value)===0)P.sats=DEF;render("all");});
  });

  /* live tick + footer currency changes arrive via the chrome hooks */
  window.obPaintFiat=function(S){
    if(!S||typeof S.price!=="number"||!(S.price>0))return;
    P.price=S.price;render("all");};
  window.obCurrencyChange=function(S){P.cur=S.cur;
    fwrap.querySelectorAll("button").forEach(function(x){x.className=x.dataset.c===P.cur?"on":"";});
    render("all");};
  render("all");
  /* chrome.js parses after this script: on DOMContentLoaded take its live rate
     table (updated in place, so the reference stays current) and any summary it
     is already holding */
  function boot(){
    try{
      if(window.OB_FX&&typeof window.OB_FX.USD==="number")fx=window.OB_FX;
      var L=window.OB_LIVE;
      if(L&&L.price&&typeof L.price.usd==="number"&&L.price.usd>0)P.price=L.price.usd;
    }catch(e){}
    render("all");
  }
  if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",boot);
  else boot();
})();
</script>
</Base>
