---
import { createHash } from 'node:crypto';
import Base from '../../layouts/Base.astro';
import '../../styles/doc.css';
import us from '../../content/giftcards/us.json';
import ca from '../../content/giftcards/ca.json';
import au from '../../content/giftcards/au.json';
import intl from '../../content/giftcards/int-summary.json';
const localImg = (u) => {
  const m = new URL(u).pathname.match(/\.([a-zA-Z0-9]+)$/);
  const ext = m ? '.' + m[1].toLowerCase() : '.png';
  return '/img/giftcards/' + createHash('sha1').update(u).digest('hex').slice(0, 16) + ext;
};
const withLocal = (list) => list.map((p) => (p.img ? { ...p, limg: localImg(p.img) } : p));
const REGIONS = [
  { k: 'us', label: 'United States', n: us.length },
  { k: 'ca', label: 'Canada', n: ca.length },
  { k: 'au', label: 'Australia', n: au.length },
  { k: 'int', label: 'International', n: Object.keys(intl.countries).length + ' countries' },
];
const TAGS = ['all', 'restaurants', 'retail', 'travel', 'entertainment', 'sports', 'home improvement', 'gaming', 'gifts', 'grocery', 'electronics'];
const COUNTRIES = Object.entries(intl.countries)
  .map(([code, c]) => ({ code, ...c }))
  .sort((a, b) => b.n - a.n);
const GC = { us: withLocal(us), ca: withLocal(ca), au: withLocal(au) };
---
<Base title="Buy Gift Cards With Bitcoin: The Catalog - OpenBitcoin" description="Buy gift cards with bitcoin: hundreds of retailers across the US, Canada, Australia, and beyond, plus how the gift-card bridge actually works.">
<main class="wrap doc-wrap">
  <div class="doc-head">
    <div class="doc-kicker">Spend</div>
    <h1>Spend bitcoin on gift cards</h1>
    <p class="doc-lede">The catalog below is a snapshot of the providers' published listings, taken July 2026: retailers whose gift cards were selling for bitcoin as of that date, by country. Pick the market you are in, filter by category, and read how the bridge works underneath.</p>
  </div>
  <div class="doc-grid">
  <div>
    <div class="gc-card">
      <div class="gc-tlab">The catalog</div>
      <div class="gcx-tabs" role="tablist" aria-label="Catalog region">
        {REGIONS.map((r, i) => <button class={i === 0 ? 'on' : ''} data-r={r.k} role="tab" aria-selected={i === 0 ? 'true' : 'false'}>{r.label} <span>{r.n}</span></button>)}
      </div>
      <div class="gcx-tools" id="gcx-tools">
        <input id="gcx-q" type="search" placeholder="Search the catalog" autocomplete="off" spellcheck="false" aria-label="Search gift cards">
        <div class="gcx-chips" role="group" aria-label="Category filter">
          {TAGS.map((t, i) => <button class={i === 0 ? 'on' : ''} data-t={t}>{t}</button>)}
        </div>
      </div>
      <div class="gcx-count" id="gcx-count"></div>
      
      <div class="gcx-grid" id="gcx-grid"></div>
      <button class="gcx-more" id="gcx-more" type="button" hidden>Load 50 more</button>
      <div class="gcx-int" id="gcx-int" hidden>
        <p class="gc-p">Bitrefill covers gift cards, mobile refills, and esims across these markets; the catalog changes per country. Counts are cards per market in the snapshot. Each country below opens that region's catalog on Bitrefill in a new tab.</p>
        
        <div class="gcx-cgrid">
          {COUNTRIES.map((c) => <a class="gcx-country" href={`https://www.bitrefill.com/${c.code.toLowerCase()}/en/gift-cards/`} target="_blank" rel="noopener noreferrer"><b>{c.flag} {c.label}</b><i>{c.n}</i></a>)}
        </div>
        <p class="gc-fine">Browse the live international catalog at <a href="https://www.bitrefill.com" target="_blank" rel="noopener noreferrer">bitrefill.com &#8599;</a>. </p>
      </div>
      <p class="gc-fine">Catalog and prices come from the providers' published listings as of the July 2026 snapshot; the providers' live catalogs change constantly, and the checkout, delivery, and terms are theirs.</p>
    </div>

    <div class="gc-card gc-mt">
      <div class="gc-tlab">How it works</div>
      <p class="gc-p">Four steps, and only the second one involves bitcoin at all. The reseller sits between your wallet and a retailer that has no bitcoin integration of its own.</p>
      <ol class="gc-steps">
        <li><b>Pick the card and the amount.</b> Resellers list retailers by country, because a gift card is only valid in the market it was issued for. A card bought on a United States catalog does not reliably work in a European store.</li>
        <li><b>Pay the invoice in bitcoin.</b> The reseller quotes a bitcoin amount that holds for a short window, usually a few minutes, and gives you an on-chain address or a Lightning invoice. Lightning settles in seconds and sidesteps the <a href="/fees">fee market</a> entirely; on-chain payments wait for a confirmation, so the fee rate you attach decides how long you stand there.</li>
        <li><b>Receive the code.</b> Delivery is a code and a PIN, sent by email or shown in your account. This is the point of no return: once the code exists, the bitcoin is gone and the card is yours.</li>
        <li><b>Spend it like any gift card.</b> In-store at checkout, or as a payment method online. The cashier sees a normal gift card. Nothing about the purchase looks like a bitcoin transaction from the retailer's side.</li>
      </ol>
      <p class="gc-note">This is a bridge, not an upgrade. Direct bitcoin acceptance is better when it exists: no reseller margin, no code to lose, no card balance stranded at $3.17. Gift cards are what you reach for when direct acceptance is missing, which is most of the time.</p>
    </div>

    <div class="gc-card gc-mt">
      <div class="gc-tlab">Two resellers that take bitcoin</div>
      <p class="gc-affline">Some links on this page will be affiliate links once agreements are in place. Every affiliate link is labeled, per the <a href="/disclosure">disclosure policy</a>, and affiliate status never changes what a row says. Rows are ordered alphabetically; nothing here is a ranking.</p>
      <div class="gc-scroll">
      <table class="gc-table" aria-label="Gift card resellers that accept bitcoin, compared">
        <thead>
          <tr><th>Provider</th><th>Regions</th><th>Payment methods</th><th>Delivery</th><th>Notes</th><th></th></tr>
        </thead>
        <tbody>
          <tr>
            <td class="gc-prov"><b>Bitrefill</b><span class="gc-affchip">Affiliate</span></td>
            <td>International, many countries</td>
            <td>On-chain and Lightning</td>
            <td>Code in-account and by email, usually within minutes</td>
            <td class="gc-notes">Catalog also covers mobile refills and esims; country selector changes the whole catalog</td>
            
            <td class="gc-act"><a class="gc-visit" href="https://www.bitrefill.com" target="_blank" rel="noopener noreferrer">Visit &#8599;</a></td>
          </tr>
          <tr>
            <td class="gc-prov"><b>CoinCards</b><span class="gc-affchip">Affiliate</span></td>
            <td>United States and Canada</td>
            <td>On-chain and Lightning</td>
            <td>Code by email</td>
            <td class="gc-notes">Separate storefronts per country; catalog is built around North American retailers</td>
            
            <td class="gc-act"><a class="gc-visit" href="https://coincards.com" target="_blank" rel="noopener noreferrer">Visit &#8599;</a></td>
          </tr>
        </tbody>
      </table>
      </div>
      <p class="gc-fine">Regions, payment methods, delivery timing, and account requirements are as published by each service and change often; check the service's own site before you pay.</p>
    </div>

    <div class="gc-card gc-mt">
      <div class="gc-tlab">Trade-offs</div>
      <div class="gc-cols">
        <div class="gc-col">
          <div class="gc-clab gc-clab-yes">What it solves</div>
          <ul class="gc-clist">
            <li>Spends bitcoin at merchants that have no bitcoin integration and no interest in getting one.</li>
            <li>No card, no bank account, and no linked payment method in the checkout path.</li>
            <li>Lightning makes the payment itself close to instant, which matters when you are standing at a counter.</li>
          </ul>
        </div>
        <div class="gc-col">
          <div class="gc-clab gc-clab-no">What it costs</div>
          <ul class="gc-clist">
            <li>The reseller takes a margin, built into the quoted rate rather than shown as a fee.</li>
            <li>A card is locked to one retailer and usually one country. Buy the wrong market and the code is scrap.</li>
            <li>Leftover balances sit unspent. Small remainders are where gift card value quietly dies.</li>
          </ul>
        </div>
      </div>
      <div class="gc-rules">
        <div class="gc-tlab">Three habits</div>
        <ul class="gc-crit">
          <li><b>Treat every purchase as final.</b> A confirmed bitcoin payment cannot be reversed, and a delivered gift card code cannot be returned to the reseller. There is no chargeback anywhere in this chain. Read the amount and the retailer twice before you pay.</li>
          <li><b>Buy close to the moment you need it.</b> Holding a stack of gift cards converts bitcoin into a claim on one company, redeemable in one currency, at one retailer. Buy what you are about to spend, and keep the rest in a wallet you control.</li>
          <li><b>Check the balance promptly and keep the code.</b> Retailers set their own expiry and dormancy rules and those vary by jurisdiction. Verify the balance loaded correctly, note it somewhere, and spend it down rather than leaving a remainder to age.</li>
        </ul>
      </div>
    </div>

    <div class="gc-card gc-mt">
      <div class="gc-tlab">Timing and change</div>
      <div class="gc-two">
        <div class="gc-half">
          <h3 class="gc-h3">Paying on-chain</h3>
          <p class="gc-p">An on-chain invoice needs a confirmation before the code is released, so the fee rate you pick is the wait you accept. Check the current <a href="/fees">fee estimates</a> first and set the rate deliberately; a payment that gets stuck is a payment sitting between you and a checkout line. If one does stall, the <a href="/tx/stuck">stuck transaction guide</a> covers the ways out.</p>
        </div>
        <div class="gc-half">
          <h3 class="gc-h3">Change and your wallet</h3>
          <p class="gc-p">Paying from your own wallet sends the remainder of the coins you spent to a change address you also control. That is normal, and your wallet handles it, but it is worth understanding before you start making frequent small payments. The <a href="/learn/self-custody">self-custody guide</a> covers change, backups, and why the balance moves the way it does; <a href="/learn/privacy">privacy</a> covers what those payments reveal.</p>
        </div>
      </div>
      <p class="gc-note">A reseller account and an email address are part of most of these flows, and the retailer sees a gift card redemption rather than a bitcoin payment. That is a privacy trade in both directions, and it is worth being clear-eyed about it.</p>
    </div>

    <div class="gc-about doc-prose">
      <p>Gift cards are the practical way to spend bitcoin at merchants that do not accept it, which is still most merchants. You pay a reseller in bitcoin, on-chain or over Lightning, and receive a retailer code that spends like any other gift card. The cost is a reseller margin, a card locked to one retailer and one country, and a purchase that cannot be undone. Direct acceptance is better where it exists; where it does not, this is the bridge. Everything here is informational, not financial advice, under the site's <a href="/terms">terms</a>, and affiliate relationships are documented in the <a href="/disclosure">disclosure</a>.</p>
    </div>
  </div>
  <aside class="doc-rail">
    <div class="doc-tile">
      <div class="doc-tlab">In the catalog</div>
      <div class="gcx-rs"><b>{us.length}</b><i>United States cards</i></div>
      <div class="gcx-rs"><b>{ca.length}</b><i>Canada cards</i></div>
      <div class="gcx-rs"><b>{au.length}</b><i>Australia cards</i></div>
      <div class="gcx-rs"><b>{Object.keys(intl.countries).length}</b><i>countries internationally</i></div>
    </div>
    <div class="doc-tile">
      <div class="doc-tlab">Three habits</div>
      <ul class="gcx-rl">
        <li>Every purchase is final</li>
        <li>Buy close to the need</li>
        <li>Check the balance, keep the code</li>
      </ul>
    </div>
    <div class="doc-tile">
      <div class="doc-tlab">Related</div>
      <nav>
        <a href="/buy">Buying bitcoin</a>
        <a href="/fees">Fees before you pay</a>
        <a href="/learn/self-custody">Self-custody basics</a>
        <a href="/disclosure">How paid links work</a>
      </nav>
    </div>
  </aside>
  </div>
</main>
<style is:global>
  .gc-card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:22px 24px}
  .gc-mt{margin-top:14px}
  .gc-tlab{font:700 9.5px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);margin-bottom:10px}
  .gc-p{font:500 14px/1.65 var(--sans);color:var(--ink-2);margin:0 0 12px}
  .gc-p a{color:var(--acc);text-decoration:none;border-bottom:1px dashed rgba(247,147,26,.35);padding-bottom:1px}
  .gc-p a:hover{border-bottom-style:solid}
  .gcx-tabs{display:flex;flex-wrap:wrap;border:1px solid var(--line-2);border-radius:8px;overflow:hidden;margin-bottom:12px}
  .gcx-tabs button{background:transparent;border:0;color:var(--ink-2);font:700 11px var(--mono);letter-spacing:.06em;
    padding:9px 14px;cursor:pointer;border-right:1px solid var(--line);white-space:nowrap;flex:1 1 auto}
  .gcx-tabs button:last-child{border-right:0}
  .gcx-tabs button span{color:var(--ink-3);font-weight:600;margin-left:4px}
  .gcx-tabs button:hover{background:rgba(36,51,78,.55);color:var(--ink)}
  .gcx-tabs button.on{background:var(--cta);color:var(--cta-ink);box-shadow:inset 0 1px 0 rgba(255,255,255,.09),inset 0 -2px 0 var(--orange)}
  .gcx-tabs button.on span{color:var(--cta-ink);opacity:.75}
  .gcx-tools{display:flex;flex-direction:column;gap:10px;margin-bottom:10px}
  #gcx-q{width:100%;box-sizing:border-box;background:rgba(124,140,168,.13);border:1px dashed rgba(255,166,60,.32);
    border-radius:10px;color:var(--field-ink);font:600 13.5px var(--sans);padding:10px 13px;outline:none}
  #gcx-q:focus{border-style:solid;border-color:rgba(255,166,60,.55)}
  #gcx-q::placeholder{color:var(--ink-3);font-weight:500}
  .gcx-chips{display:flex;flex-wrap:wrap;gap:6px}
  .gcx-chips button{background:var(--field);border:1px solid var(--line-2);border-radius:99px;color:var(--ink-2);
    font:600 10.5px var(--mono);letter-spacing:.05em;padding:5px 11px;cursor:pointer;text-transform:capitalize}
  .gcx-chips button:hover{color:var(--ink);border-color:var(--line-2)}
  .gcx-chips button.on{background:rgba(247,147,26,.12);border-color:rgba(255,166,60,.5);color:var(--acc)}
  .gcx-count{font:600 10.5px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3);margin-bottom:10px}
  .gcx-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
  .gcx-more{display:block;margin:16px auto 0;font:700 12.5px var(--mono);letter-spacing:.08em;text-transform:uppercase;
    background:var(--cta);color:var(--cta-ink);border:1.5px solid rgba(255,166,60,.65);border-radius:9px;
    padding:11px 22px;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.18),inset 0 1px 0 rgba(255,255,255,.09)}
  .gcx-more:hover{background:var(--cta-hov);border-color:var(--orange)}
  .gcx-more[hidden]{display:none}
  .gcx-item{display:block;background:var(--field);border:1px solid var(--line-2);border-radius:10px;overflow:hidden;
    text-decoration:none;transition:border-color .15s}
  .gcx-item:hover{border-color:rgba(255,166,60,.5)}
  .gcx-item img{display:block;width:100%;height:auto;aspect-ratio:500/315;object-fit:cover;background:var(--panel-2)}
  .gcx-noimg{display:flex;width:100%;aspect-ratio:500/315;align-items:center;justify-content:center;
    background:var(--panel-2);color:var(--ink-3);font:700 26px var(--mono);padding:0 !important}
  .gcx-item span{display:block;padding:0 10px}
  .gcx-n{font:600 12px/1.4 var(--sans);color:var(--ink);padding-top:8px !important}
  .gcx-r{font:600 10.5px var(--mono);color:var(--ink-3);padding:3px 10px 9px !important}
  .gcx-cgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:8px;margin-top:4px}
  .gcx-country{background:var(--field);border:1px solid var(--line-2);border-radius:8px;padding:8px 11px;display:flex;
    justify-content:space-between;align-items:baseline;gap:8px;text-decoration:none;transition:border-color .15s}
  .gcx-country:hover{border-color:rgba(255,166,60,.5)}
  .gcx-country:hover b{color:var(--ink)}
  .gcx-country b{font:600 12px var(--sans);color:var(--ink-2);min-width:0}
  .gcx-country i{font:700 11px var(--mono);color:var(--ink-3);font-style:normal;flex:none}
  .gc-steps{margin:0;padding-left:22px}
  .gc-steps li{font:500 14px/1.65 var(--sans);color:var(--ink-2);margin-top:8px}
  .gc-steps li::marker{color:var(--acc);font-weight:700}
  .gc-steps b{color:var(--ink);font-weight:600}
  .gc-steps a{color:var(--acc);text-decoration:none;border-bottom:1px dashed rgba(247,147,26,.35)}
  .gc-note{font:500 13px/1.6 var(--sans);color:var(--ink-3);margin:12px 0 0;border-top:1px dotted var(--line-2);padding-top:12px}
  .gc-affline{font:500 12.5px/1.6 var(--sans);color:var(--ink-3);margin:0 0 12px}
  .gc-affline a{color:var(--acc);text-decoration:none;border-bottom:1px dashed rgba(247,147,26,.35)}
  .gc-affchip{display:inline-block;margin-left:8px;font:700 8.5px var(--mono);letter-spacing:.12em;text-transform:uppercase;
    color:var(--acc);border:1px dashed rgba(247,147,26,.45);border-radius:5px;padding:2px 6px;vertical-align:middle}
  .gc-scroll{overflow-x:auto}
  .gc-table{width:100%;border-collapse:collapse}
  .gc-table th{font:700 9.5px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3);
    text-align:left;padding:0 14px 8px 0;border-bottom:1px solid var(--line-2);white-space:nowrap}
  .gc-table td{font:500 13px/1.5 var(--sans);color:var(--ink-2);padding:11px 14px 11px 0;
    border-bottom:1px dotted var(--line-2);vertical-align:top}
  .gc-table tr:last-child td{border-bottom:0}
  .gc-prov{white-space:nowrap}
  .gc-prov b{font:700 14px var(--sans);color:var(--ink)}
  .gc-notes{min-width:190px}
  .gc-act{text-align:right}
  .gc-visit{display:inline-block;font:700 10.5px var(--mono);letter-spacing:.08em;text-transform:uppercase;
    background:var(--cta);color:var(--cta-ink);border-radius:8px;padding:8px 13px;text-decoration:none;white-space:nowrap;
    box-shadow:0 4px 14px rgba(0,0,0,.18),inset 0 1px 0 rgba(255,255,255,.09)}
  .gc-visit:hover{background:var(--cta-hov)}
  .gc-cols{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
  .gc-clab{font:700 10px var(--mono);letter-spacing:.12em;text-transform:uppercase;margin-bottom:8px}
  .gc-clab-yes{color:var(--up)}
  .gc-clab-no{color:var(--down)}
  .gc-clist{margin:0;padding-left:18px}
  .gc-clist li{font:500 13.5px/1.6 var(--sans);color:var(--ink-2);margin-top:6px}
  .gc-clist li::marker{color:var(--ink-3)}
  .gc-rules{margin-top:16px;padding-top:14px;border-top:1px dotted var(--line-2)}
  .gc-crit{margin:0;padding-left:20px}
  .gc-crit li{font:500 13.5px/1.65 var(--sans);color:var(--ink-2);margin-top:8px}
  .gc-crit li::marker{color:var(--acc)}
  .gc-crit b{color:var(--ink);font-weight:600}
  .gc-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
  .gc-h3{font:700 14px var(--sans);color:var(--ink);margin:0 0 6px}
  .gc-fine{font:500 11.5px/1.5 var(--sans);color:var(--ink-3);margin:12px 0 0}
  .gc-fine a{color:var(--acc);text-decoration:none;border-bottom:1px dashed rgba(247,147,26,.35)}
  .gc-about{margin-top:14px}
  .gc-about p{font:500 13.5px/1.65 var(--sans);color:var(--ink-3)}
  .gcx-rs{padding:7px 0;border-bottom:1px dotted var(--line-2)}
  .gcx-rs:last-child{border-bottom:0}
  .gcx-rs b{display:block;font:700 16px var(--mono);color:var(--ink);font-variant-numeric:tabular-nums}
  .gcx-rs i{display:block;font:600 9px var(--mono);letter-spacing:.11em;text-transform:uppercase;color:var(--ink-3);font-style:normal;margin-top:2px}
  .gcx-rl{margin:0;padding-left:16px}
  .gcx-rl li{font:600 11.5px/1.5 var(--sans);color:var(--ink-2);margin-top:6px}
  .gcx-rl li::marker{color:var(--acc)}
  @media(max-width:700px){
    .gc-card{padding:18px 16px}
    .gc-cols,.gc-two{grid-template-columns:minmax(0,1fr)}
    .gcx-grid{grid-template-columns:repeat(auto-fill,minmax(130px,1fr))}
    .gcx-item img{max-width:100%}
    .gcx-cgrid{grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}
    
    .gc-scroll{overflow:visible}
    .gc-table{min-width:0;table-layout:auto}
    .gc-table thead{display:none}
    .gc-table,.gc-table tbody,.gc-table tr,.gc-table td{display:block;width:auto}
    .gc-table tr{position:relative;padding:14px 0 13px;border-bottom:1px dotted var(--line-2)}
    .gc-table tr:last-child{border-bottom:0}
    .gc-table td{border-bottom:0;padding:0;font-size:13px}
    .gc-prov{white-space:normal;padding-right:88px}
    .gc-act{position:absolute;top:12px;right:0}
    .gc-visit{padding:7px 11px}
    .gc-table td:nth-child(2),.gc-table td:nth-child(3),.gc-table td:nth-child(4){display:inline-block;margin:7px 16px 0 0}
    .gc-table td:nth-child(2)::before,.gc-table td:nth-child(3)::before,.gc-table td:nth-child(4)::before{
      font:700 9.5px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3)}
    .gc-table td:nth-child(2)::before{content:"Regions: "}
    .gc-table td:nth-child(3)::before{content:"Payment: "}
    .gc-table td:nth-child(4)::before{content:"Delivery: "}
    .gc-notes{min-width:0;width:100%;margin-top:8px;color:var(--ink-3)}
  }
</style>
<script is:inline define:vars={{ GC }}>
(function(){
  var grid=document.getElementById("gcx-grid"),count=document.getElementById("gcx-count"),
      tools=document.getElementById("gcx-tools"),intv=document.getElementById("gcx-int"),
      q=document.getElementById("gcx-q"),more=document.getElementById("gcx-more");
  var PAGE=50;
  var st={r:"us",t:"all",q:"",lim:PAGE};
  function esc(s){return (""+(s==null?"":s)).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");}
  function money(v,cur){return "$"+v.toLocaleString("en-US")+(cur&&cur!=="USD"?" "+cur:"");}
  function render(){
    var isInt=st.r==="int";
    tools.style.display=isInt?"none":"";
    grid.style.display=isInt?"none":"";
    count.style.display=isInt?"none":"";
    intv.hidden=!isInt;
    if(isInt){more.hidden=true;return;}
    var data=GC[st.r]||[],ql=st.q.toLowerCase();
    var out=data.filter(function(p){
      if(st.t!=="all"){var tags=(p.tags||[]).map(function(x){return(""+x).toLowerCase();});if(tags.indexOf(st.t)===-1)return false;}
      if(ql&&p.n.toLowerCase().indexOf(ql)===-1)return false;
      return true;
    });
    var shown=out.slice(0,st.lim);
    count.textContent="Showing "+shown.length.toLocaleString("en-US")+" of "+out.length.toLocaleString("en-US")+" cards";
    more.hidden=out.length<=st.lim;
    if(!more.hidden)more.textContent="Load 50 more ("+(out.length-shown.length).toLocaleString("en-US")+" left)";
    grid.innerHTML=shown.map(function(p){
      var img=p.limg?'<img loading="lazy" src="'+esc(p.limg)+'" onerror="this.onerror=null;this.src=\''+esc(p.img)+'\'" alt="">':'<span class="gcx-noimg" aria-hidden="true">&#8383;</span>';
      return '<a class="gcx-item" href="'+esc(p.url)+'" target="_blank" rel="noopener noreferrer">'+img+
        '<span class="gcx-n">'+esc(p.n)+'</span>'+
        '<span class="gcx-r">'+money(p.lo,p.cur)+' to '+money(p.hi,p.cur)+'</span></a>';
    }).join("");
  }
  document.querySelectorAll(".gcx-tabs button").forEach(function(b){
    b.addEventListener("click",function(){
      st.r=b.dataset.r;st.lim=PAGE;
      b.parentNode.querySelectorAll("button").forEach(function(o){
        var on=o===b;o.classList.toggle("on",on);o.setAttribute("aria-selected",on?"true":"false");
      });
      render();
    });
  });
  document.querySelectorAll(".gcx-chips button").forEach(function(b){
    b.addEventListener("click",function(){
      st.t=b.dataset.t;st.lim=PAGE;
      b.parentNode.querySelectorAll("button").forEach(function(o){o.classList.toggle("on",o===b);});
      render();
    });
  });
  q.addEventListener("input",function(){st.q=q.value.trim();st.lim=PAGE;render();});
  more.addEventListener("click",function(){st.lim+=PAGE;render();});
  render();
})();
</script>
</Base>
