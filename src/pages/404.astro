---
import Base from '../layouts/Base.astro';
import '../styles/doc.css';
---
<Base title="Page not found - OpenBitcoin" description="There is no page at this URL." indexable={false}>
<main class="wrap doc-wrap">
  <div class="nf-wrap">
    <div class="nf-code" aria-label="404">
      <span>4</span>
      <svg class="nf-coin" viewBox="0 0 64 64" aria-hidden="true"><g transform="translate(0.006,-0.003)"><path fill="#F7931A" d="m63.033,39.744c-4.274,17.143-21.637,27.576-38.782,23.301-17.138-4.274-27.571-21.638-23.295-38.78,4.272-17.145,21.635-27.579,38.775-23.305,17.144,4.274,27.576,21.64,23.302,38.784z"/><path fill="#101A2C" d="m46.103,27.444c0.637-4.258-2.605-6.547-7.038-8.074l1.438-5.768-3.511-0.875-1.4,5.616c-0.923-0.23-1.871-0.447-2.813-0.662l1.41-5.653-3.509-0.875-1.439,5.766c-0.764-0.174-1.514-0.346-2.242-0.527l0.004-0.018-4.842-1.209-0.934,3.75s2.605,0.597,2.55,0.634c1.422,0.355,1.679,1.296,1.636,2.042l-1.638,6.571c0.098,0.025,0.225,0.061,0.365,0.117-0.117-0.029-0.242-0.061-0.371-0.092l-2.296,9.205c-0.174,0.432-0.615,1.08-1.609,0.834,0.035,0.051-2.552-0.637-2.552-0.637l-1.743,4.019,4.569,1.139c0.85,0.213,1.683,0.436,2.503,0.646l-1.453,5.834,3.507,0.875,1.439-5.772c0.958,0.26,1.888,0.5,2.798,0.726l-1.434,5.745,3.511,0.875,1.453-5.823c5.987,1.133,10.489,0.676,12.384-4.739,1.527-4.36-0.076-6.875-3.226-8.515,2.294-0.529,4.022-2.038,4.483-5.155zm-8.022,11.249c-1.085,4.36-8.426,2.003-10.806,1.412l1.928-7.729c2.38,0.594,10.012,1.77,8.878,6.317zm1.086-11.312c-0.99,3.966-7.1,1.951-9.082,1.457l1.748-7.01c1.982,0.494,8.365,1.416,7.334,5.553z"/></g></svg>
      <span>4</span>
    </div>
    <h1 class="nf-h1">Not in the chain</h1>
    <p class="nf-lede">There is no page at this URL. It may be mistyped, moved, or not built yet.</p>
    <p class="nf-hint">Looking for an address, transaction, or block height? Use the lookup at the top of the page; it takes all three.</p>
    <div class="nf-actions">
      <a class="nf-home" href="/">BACK TO THE TOOLS</a>
    </div>
    <nav class="nf-links" aria-label="Popular pages">
      <a href="/convert">Converter</a><span>·</span>
      <a href="/fees">Fees</a><span>·</span>
      <a href="/halving">Halving</a><span>·</span>
      <a href="/chart">Chart</a><span>·</span>
      <a href="/obituaries">Obituaries</a>
    </nav>
  </div>
</main>
<style is:global>
  .nf-wrap{max-width:640px;margin:34px auto 40px;text-align:center}
  .nf-code{display:flex;align-items:center;justify-content:center;gap:6px;
    font:800 120px/1 var(--mono);color:var(--price-ink);letter-spacing:-4px;user-select:none}
  .nf-coin{width:96px;height:96px;flex:none;margin:0 6px}
  .nf-h1{font:800 28px var(--sans);letter-spacing:-.5px;color:var(--ink);margin:18px 0 0}
  .nf-lede{font:500 15px/1.6 var(--sans);color:var(--ink-2);margin:10px 0 0}
  .nf-hint{font:500 13.5px/1.6 var(--sans);color:var(--ink-3);margin:8px 0 0}
  .nf-actions{margin-top:22px}
  .nf-home{display:inline-flex;align-items:center;justify-content:center;border-radius:8px;background:var(--cta);
    color:var(--cta-ink);font:700 14.5px var(--sans);letter-spacing:.04em;padding:0 24px;min-height:42px;
    text-decoration:none;box-shadow:0 4px 14px rgba(0,0,0,.18),inset 0 1px 0 rgba(255,255,255,.09)}
  .nf-home:hover{background:var(--cta-hov)}
  .nf-links{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:20px;
    font:600 12px var(--mono);letter-spacing:.04em}
  .nf-links a{color:var(--ink-2);text-decoration:none;border-bottom:1px dashed rgba(247,147,26,.35);padding-bottom:1px}
  .nf-links a:hover{color:var(--acc)}
  .nf-links span{color:var(--ink-3)}
  @media(max-width:520px){
    .nf-code{font-size:84px}
    .nf-coin{width:66px;height:66px}
  }
</style>
</Base>
