  lin: { t: 'Linux', svg: '<path d="M12 1.6c-2.1 0-3.6 1.6-3.6 3.7 0 .9-.2 1.8-.7 2.7-1 2-2.6 4.3-2.6 7.2 0 3.9 2.9 7 6.9 7s6.9-3.1 6.9-7c0-2.9-1.6-5.2-2.6-7.2-.5-.9-.7-1.8-.7-2.7 0-2.1-1.5-3.7-3.6-3.7z"/><ellipse class="neg" cx="12" cy="16" rx="3.5" ry="4.4"/><circle class="neg" cx="10.6" cy="5.2" r=".75"/><circle class="neg" cx="13.4" cy="5.2" r=".75"/><path d="M12 6.1l1.5 1.1-1.5 1-1.5-1z"/><ellipse cx="9.6" cy="22" rx="1.8" ry="1"/><ellipse cx="14.4" cy="22" rx="1.8" ry="1"/>' },
