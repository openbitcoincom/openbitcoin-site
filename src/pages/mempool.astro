      ctx.stroke();
    }
    /* crosshair */
    if(hover>=0&&hover<n){
      var hx=Math.round(X(t[hover]))+.5;
      ctx.strokeStyle=ink3;ctx.globalAlpha=.7;ctx.lineWidth=1;
      ctx.beginPath();ctx.moveTo(hx,padT);ctx.lineTo(hx,padT+ih);ctx.stroke();
      ctx.globalAlpha=1;
    }
    /* baseline */
    ctx.strokeStyle=line2;ctx.lineWidth=1;
    ctx.beginPath();ctx.moveTo(padL,Math.round(padT+ih)+.5);ctx.lineTo(W-padR,Math.round(padT+ih)+.5);ctx.stroke();
  }
  function showTip(px,py){
    if(!data||hover<0){tip.hidden=true;return;}
    var when=new Date(data.t[hover]*1000),tot=0,rows="",b;
    for(b=data.bands.length-1;b>=0;b--){
      var val=data.v[b][hover];tot+=val;
      rows+='<div class="r"><span class="c" style="background:'+data.bands[b].color+'"></span>'+
        data.bands[b].label+' sat/vB<b>'+fmtMvB(val)+' MvB</b></div>';
    }
    tip.innerHTML='<div class="h">'+when.toLocaleString("en-US",{month:"short",day:"numeric",hour:"2-digit",minute:"2-digit"})+
      '</div>'+rows+'<div class="r">total<b>'+fmtMvB(tot)+' MvB</b></div>';
    tip.hidden=false;
    var tw=tip.offsetWidth,ww=wrap.clientWidth;
    var lx=px+14;if(lx+tw>ww-4)lx=px-tw-14;if(lx<4)lx=4;
    var ly=py-10;var th=tip.offsetHeight;
    if(ly+th>wrap.clientHeight-2)ly=wrap.clientHeight-th-2;if(ly<2)ly=2;
    tip.style.left=lx+"px";tip.style.top=ly+"px";
  }
  function locate(ev){
    if(!data)return;
    var r=cv.getBoundingClientRect(),x=ev.clientX-r.left,y=ev.clientY-r.top;
    var W=wrap.clientWidth,padL=40,padR=8,iw=W-padL-padR;
    var t0=data.t[0],t1=data.t[data.t.length-1];
    var tt=t0+(x-padL)/iw*(t1-t0),best=0,bd=Infinity,i;
    for(i=0;i<data.t.length;i++){var dd=Math.abs(data.t[i]-tt);if(dd<bd){bd=dd;best=i;}}
    hover=best;draw();showTip(x,y);
  }
  function clearHover(){hover=-1;tip.hidden=true;draw();}
  cv.addEventListener("pointermove",locate);
  cv.addEventListener("pointerdown",locate);
  cv.addEventListener("pointerleave",clearHover);
  function applyNote(){
    if(!note)return;
    var base="Our node's mempool, snapshotted every 5 minutes and stacked by fee band; height is total virtual size waiting, in MvB.";
    if(recSince!==null&&Date.now()-recSince<31*86400000)
      base+=" Recording began "+new Date(recSince).toLocaleDateString("en-US",{month:"long",day:"numeric"})+"; longer ranges unlock as history accumulates.";
    note.textContent=base;
  }
  var api2=null;
  function refresh(){
    if(!api2)return;
    /* no in-flight guard: a range click mid-poll must still fetch, and the
       want!==sel check below already discards whichever response went stale */
    var want=sel;
    fetch(api2+"/mempool-history?days="+want.d).then(function(r){if(!r.ok)throw 0;return r.json();})
      .then(function(j){
        if(j&&j.recordingSince){var rs=Date.parse(j.recordingSince);if(isFinite(rs))recSince=rs;}
        /* first response: adopt the default range for the history we turn
           out to have, refetching finer buckets when it differs */
        if(!booted){
          booted=true;
          var def=defaultRange();
          if(def!==sel){sel=def;renderRng();applyNote();refresh();return;}
        }
        if(want!==sel)return; /* stale: the user switched while in flight */
        data=build(j);renderRng();renderLegend();applyNote();hover=-1;tip.hidden=true;draw();
      })
      .catch(function(){inflight=false;});
  }
  var rt=null;
  window.addEventListener("resize",function(){clearTimeout(rt);rt=setTimeout(draw,120);});
  function boot2(){
    api2=(typeof window.OB_DATA_API==="string"&&window.OB_DATA_API)?window.OB_DATA_API:null;
    /* the 1W default is a guess until the first response reports how much
       history exists; while recording is younger the default drops to fit */
    sel=RANGES[3];
    renderRng();draw();
    if(!api2)return;
    refresh();
    setInterval(refresh,300000);
  }
  if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",boot2);
  else boot2();
})();
</script>
