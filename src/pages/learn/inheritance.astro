<script is:inline>
(function(){
  /* This page runs no cryptography and holds no secret. It makes exactly one
     claim in code, and that claim is the reason the page exists:

       the printed worksheet cannot invite a secret onto paper.

     A worksheet with a line labelled "seed phrase" would be worse than no
     worksheet at all, so the claim is tested rather than trusted. Every field
     label on both sheets is read back out of the rendered page and run through
     a banned-term test. The test itself is checked first, against labels whose
     correct verdict is known.

     TEST VECTORS, 18 in total.
     MUST be rejected (a line a secret could be written on):
       "Seed phrase", "Recovery words 13 to 24", "Private key", "xprv",
       "Extra passphrase", "Hardware device PIN", "2FA secret",
       "Master password", "Mnemonic"
     MUST be accepted (a line that only records a place, a name or a date):
       "Wallet or software", "Where the device is kept", "Backup card location",
       "How to reach them",
       "Wallet descriptor or xpub file, where a copy is kept",
       "Date written", "Make and model", "Roughly how much is here",
       "Which cosigner"
     The xprv and xpub pair is deliberate: one is a spending key and must be
     rejected, the other is public and must be accepted, so a lazy substring
     test that treated them alike would fail here.

     STRUCTURAL CHECKS, on top of the vectors:
       both sheets exist, and each renders exactly the number of writing lines
       its own data model declared;  every writing line has a non-empty label
       and every label passes;  both sheets carry their printed warning;  and
       <main> contains no input, textarea, select, form or contenteditable
       element anywhere, because this page accepts nothing from anybody.

     Any failure hides the worksheet, disables printing, shows a visible
     failure state and logs the detail to the console. */

  var BAN = [" seed "," seeds "," mnemonic "," phrase "," phrases "," word "," words ",
             " key "," keys "," privkey "," xprv "," xpriv "," wif ",
             " passphrase "," password "," passwords "," pin "," pins ",
             " 2fa "," totp "," secret "," secrets "," code "," codes "," entropy "];

  /* pad and flatten so every term is matched on word boundaries: "pin" must
     not fire on "shipping", and "xpub" must not fire on the "xprv" term */
  function norm(s){return (" "+String(s).toLowerCase().replace(/[^a-z0-9]+/g," ")+" ").replace(/\s+/g," ");}
  function isSecretLabel(s){
    var t=norm(s);
    for(var i=0;i<BAN.length;i++){if(t.indexOf(BAN[i])>=0)return true;}
    return false;
  }

  var POS=["Seed phrase","Recovery words 13 to 24","Private key","xprv","Extra passphrase",
           "Hardware device PIN","2FA secret","Master password","Mnemonic"];
  var NEG=["Wallet or software","Where the device is kept","Backup card location",
           "How to reach them","Wallet descriptor or xpub file, where a copy is kept",
           "Date written","Make and model","Roughly how much is here","Which cosigner"];

  var pass=true,detail=[],i;
  for(i=0;i<POS.length;i++){if(!isSecretLabel(POS[i])){pass=false;detail.push('vector not rejected: "'+POS[i]+'"');}}
  for(i=0;i<NEG.length;i++){if(isSecretLabel(NEG[i])){pass=false;detail.push('vector not accepted: "'+NEG[i]+'"');}}

  var wrap=document.getElementById("ih-sheets"),
      fail=document.getElementById("ih-fail"),
      note=document.getElementById("ih-tplnote"),
      btn=document.getElementById("ih-print"),
      main=document.querySelector("main.doc-wrap"),
      sheets=document.querySelectorAll(".ih-sheet"),
      segs=document.querySelectorAll(".ih-s");
  if(!wrap||!main)return;

  var controls=main.querySelectorAll("input,textarea,select,form,[contenteditable]");
  if(controls.length!==0){pass=false;detail.push("page carries "+controls.length+" input element(s)");}

  if(sheets.length!==2){pass=false;detail.push("sheet count "+sheets.length);}
  var lines=0;
  Array.prototype.forEach.call(sheets,function(sh,si){
    var want=parseInt(sh.getAttribute("data-lines"),10),
        rules=sh.querySelectorAll(".ih-rule"),
        labs=sh.querySelectorAll(".ih-f > i"),
        warn=sh.querySelector(".ih-pwarn");
    if(!(want>0)||rules.length!==want){pass=false;detail.push("sheet "+(si+1)+" line count "+rules.length+" wanted "+want);}
    if(labs.length!==rules.length){pass=false;detail.push("sheet "+(si+1)+" has "+labs.length+" labels for "+rules.length+" lines");}
    if(!warn||warn.textContent.trim().length<60){pass=false;detail.push("sheet "+(si+1)+" printed warning missing");}
    Array.prototype.forEach.call(labs,function(l,li){
      var txt=l.textContent.trim();
      if(!txt){pass=false;detail.push("sheet "+(si+1)+" label "+(li+1)+" empty");return;}
      if(isSecretLabel(txt)){pass=false;detail.push('sheet '+(si+1)+' label '+(li+1)+' invites a secret: "'+txt+'"');}
    });
    lines+=rules.length;
  });

  if(!pass){
    console.error("[/learn/inheritance] self-test failed: "+detail.join("; ")+
      ". The worksheet is withheld rather than printed wrong.");
    wrap.className="ih-sheets is-off";
    fail.className="ih-fail ih-noprint is-on";
    note.style.display="none";
    btn.disabled=true;
    btn.textContent="Printing disabled";
    Array.prototype.forEach.call(segs,function(b){b.disabled=true;});
    return;
  }
  console.log("[/learn/inheritance] self-test passed: 18 label vectors, "+lines+
    " writing lines across "+sheets.length+" sheets, 0 input elements. No line invites a secret.");

  var NOTE={
    simple:"Set for a single-wallet plan: the cosigner and descriptor block is left off. Only the two sheets print; the guide, the menus and the rest of the page are left off the page.",
    multisig:"Set for a multisig plan: the cosigner and descriptor block prints with the rest. Only the two sheets print; the guide, the menus and the rest of the page are left off the page."
  };
  function setMode(m){
    if(m!=="simple"&&m!=="multisig")return;
    wrap.setAttribute("data-mode",m);
    Array.prototype.forEach.call(segs,function(b){b.classList.toggle("is-on",b.getAttribute("data-m")===m);});
    note.textContent=NOTE[m];
  }
  Array.prototype.forEach.call(segs,function(b){
    b.addEventListener("click",function(){setMode(b.getAttribute("data-m"));});
  });
  setMode("simple");

  btn.addEventListener("click",function(){window.print();});
})();
</script>
</Base>
