---
import Base from '../../layouts/Base.astro';
import '../../styles/doc.css';
import { TERMS, CATEGORIES, slug } from '../../lib/glossary.js';
import HeroEmblem from '../../components/HeroEmblem.astro';

const sorted = [...TERMS].sort((a, b) =>
  a.t.localeCompare(b.t, 'en', { numeric: true, sensitivity: 'base' }));

const groups = [];
for (const term of sorted) {
  const first = term.t[0].toUpperCase();
  const letter = /[A-Z]/.test(first) ? first : '#';
  if (!groups.length || groups[groups.length - 1].letter !== letter) groups.push({ letter, terms: [] });
  groups[groups.length - 1].terms.push(term);
}
const letters = groups.map((g) => g.letter);
const catLabel = Object.fromEntries(CATEGORIES.map((c) => [c.k, c.label]));

const ld = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Bitcoin glossary',
  url: 'https://openbitcoin.com/learn/glossary',
  hasDefinedTerm: sorted.map((t) => ({
    '@type': 'DefinedTerm',
    name: t.t,
    description: t.d,
    url: `https://openbitcoin.com/learn/glossary#${slug(t.t)}`,
  })),
};
---
<Base
  title="Bitcoin Glossary: Every Term Explained - OpenBitcoin"
  description={`A plain-language glossary of ${TERMS.length} bitcoin and crypto terms, from address and UTXO to halving, Lightning and rug pull. Searchable, with no jargon in the definitions.`}>
<main class="wrap doc-wrap">
  <div class="doc-head">
    <div class="doc-kicker">Learn</div>
    <h1>Bitcoin glossary</h1>
    <HeroEmblem name="glossary" />
    <p class="doc-lede">{TERMS.length} terms from bitcoin and the wider crypto world, each explained in plain language. Search, filter by topic, or jump to a letter. Every entry has its own link.</p>
  </div>

  <div class="gl-bar">
    <div class="gl-search">
      <svg class="gl-mag" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16.5 16.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <input id="gl-q" type="search" placeholder="Search terms" autocomplete="off" spellcheck="false" aria-label="Search the glossary" />
      <button id="gl-clear" type="button" aria-label="Clear search" hidden>&times;</button>
    </div>
    <div class="gl-chips" role="group" aria-label="Filter by topic">
      <button class="gl-chip on" data-k="all" type="button">All</button>
      {CATEGORIES.map((c) => <button class="gl-chip" data-k={c.k} type="button">{c.label}</button>)}
    </div>
  </div>

  <nav class="gl-az" aria-label="Jump to letter">
    {letters.map((l) => <a href={`#letter-${l === '#' ? 'num' : l}`} data-letter={l}>{l}</a>)}
  </nav>

  <p class="gl-count" id="gl-count" role="status" aria-live="polite"></p>

  <div class="gl-list">
    {groups.map((g) => (
      <section class="gl-sec" id={`letter-${g.letter === '#' ? 'num' : g.letter}`} data-letter={g.letter}>
        <h2 class="gl-letter">{g.letter}</h2>
        <div class="gl-terms">
          {g.terms.map((term) => (
            <article
              class="gl-term"
              id={slug(term.t)}
              data-k={term.k}
              data-s={`${term.t} ${term.alt || ''} ${term.d}`.toLowerCase()}>
              <h3 class="gl-t">
                {term.t}
                <a class="gl-link" href={`#${slug(term.t)}`} aria-label={`Link to ${term.t}`}>#</a>
                <span class="gl-cat">{catLabel[term.k]}</span>
              </h3>
              <p class="gl-d">{term.d}</p>
              {term.see && (
                <div class="gl-see">
                  {term.see.map(([label, href]) => <a href={href}>{label}</a>)}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>

  <p class="gl-empty" id="gl-empty" hidden>No terms match that search. Try a shorter word, or clear the topic filter.</p>

  <div class="gl-about doc-prose">
    <p>Definitions here describe how words are actually used, including the ones that get used loosely. Where a term belongs to the wider crypto world rather than to bitcoin, it says so rather than pretending the two are the same thing. Nothing on this page is advice about what to buy, as the <a href="/terms">terms</a> spell out.</p>
    <p>Missing a term, or think one of these is wrong? <a href="/contact">Tell us</a> and it gets fixed. If you are new, the <a href="/learn">Learn hub</a> has a numbered path that starts from zero, and <a href="/learn/what-is-bitcoin">What is Bitcoin</a> is the first stop.</p>
  </div>
</main>

<script type="application/ld+json" set:html={JSON.stringify(ld)} is:inline />

<style is:global>
  .gl-bar{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin:0 0 14px}
  .gl-search{position:relative;flex:1 1 260px;min-width:0}
  .gl-search input{width:100%;box-sizing:border-box;background:var(--field);color:var(--field-ink);
    border:1px solid var(--line-2);border-radius:10px;padding:11px 34px 11px 38px;
    font:600 14px var(--mono);outline:none;appearance:none}
  .gl-search input::placeholder{color:var(--ph);font-weight:500}
  .gl-search input:focus{border-color:rgba(247,147,26,.55);background:var(--field-hov)}
  .gl-search input::-webkit-search-cancel-button{display:none}
  .gl-mag{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--ink-3);pointer-events:none}
  #gl-clear{position:absolute;right:8px;top:50%;transform:translateY(-50%);width:24px;height:24px;
    background:none;border:0;color:var(--ink-3);font-size:19px;line-height:1;cursor:pointer;border-radius:6px}
  #gl-clear:hover{color:var(--ink);background:var(--nav-hov)}
  .gl-chips{display:flex;gap:6px;flex-wrap:wrap}
  .gl-chip{background:var(--panel);border:1px solid var(--line-2);color:var(--ink-2);border-radius:99px;
    padding:0 12px;height:32px;box-sizing:border-box;font:700 10px var(--mono);letter-spacing:.09em;
    text-transform:uppercase;cursor:pointer;white-space:nowrap}
  .gl-chip:hover{border-color:rgba(247,147,26,.45);color:var(--ink)}
  .gl-chip.on{background:var(--tab-on-bg);border-color:var(--tab-on-line);color:var(--tab-on-ink)}
  .gl-az{display:flex;flex-wrap:wrap;gap:4px;padding:10px 12px;background:var(--panel);
    border:1px solid var(--line);border-radius:12px}
  .gl-az a{min-width:26px;text-align:center;padding:4px 3px;border-radius:6px;
    font:700 12px var(--mono);color:var(--ink-2);text-decoration:none}
  .gl-az a:hover{background:var(--nav-hov);color:var(--acc)}
  .gl-az a.off{opacity:.28;pointer-events:none}
  .gl-count{font:600 11px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3);margin:12px 0 0}
  .gl-sec{margin-top:14px;scroll-margin-top:14px}
  .gl-letter{font:700 13px var(--mono);letter-spacing:.16em;color:var(--acc);margin:0 0 8px;
    padding-bottom:6px;border-bottom:1px solid var(--line)}
  .gl-terms{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:10px}
  .gl-term{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px 16px;scroll-margin-top:16px}
  .gl-term:target{border-color:rgba(247,147,26,.6);box-shadow:0 0 0 3px rgba(247,147,26,.12)}
  .gl-t{display:flex;align-items:baseline;gap:8px;margin:0;font:700 15px var(--sans);color:var(--ink)}
  .gl-link{font:700 12px var(--mono);color:var(--ink-3);text-decoration:none;opacity:0}
  .gl-term:hover .gl-link{opacity:1}
  .gl-link:hover{color:var(--acc)}
  .gl-cat{margin-left:auto;font:700 8.5px var(--mono);letter-spacing:.11em;text-transform:uppercase;
    color:var(--ink-3);border:1px solid var(--line-2);border-radius:99px;padding:2px 7px 3px;white-space:nowrap}
  .gl-d{font:500 13.5px/1.6 var(--sans);color:var(--ink-2);margin:7px 0 0}
  .gl-see{display:flex;flex-wrap:wrap;gap:5px;margin-top:9px}
  .gl-see a{font:600 10px var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--acc);
    text-decoration:none;border:1px solid rgba(255,166,60,.34);border-radius:7px;padding:4px 8px}
  .gl-see a:hover{background:rgba(247,147,26,.08)}
  .gl-empty{font:500 14px var(--sans);color:var(--ink-3);text-align:center;padding:30px 10px;margin:0}
  .gl-about{margin-top:18px}
  .gl-about p{font:500 13.5px/1.65 var(--sans);color:var(--ink-3)}
  @media(max-width:640px){
    .gl-terms{grid-template-columns:1fr}
    .gl-chips{gap:5px}
    .gl-chip{height:29px;padding:0 10px;font-size:9.5px}
    .gl-link{display:none}
  }
</style>

<script is:inline>
(function(){
  var q=document.getElementById("gl-q"),clear=document.getElementById("gl-clear"),
      count=document.getElementById("gl-count"),empty=document.getElementById("gl-empty"),
      terms=[].slice.call(document.querySelectorAll(".gl-term")),
      secs=[].slice.call(document.querySelectorAll(".gl-sec")),
      azs=[].slice.call(document.querySelectorAll(".gl-az a")),
      chips=[].slice.call(document.querySelectorAll(".gl-chip")),
      cat="all",total=terms.length;

  function apply(){
    var s=q.value.trim().toLowerCase(),shown=0;
    for(var i=0;i<terms.length;i++){
      var el=terms[i],
          ok=(cat==="all"||el.getAttribute("data-k")===cat)&&
             (!s||el.getAttribute("data-s").indexOf(s)>-1);
      el.hidden=!ok;
      if(ok)shown++;
    }
    /* a letter heading with nothing under it is noise, and so is a jump link
       that lands on an empty section */
    var live={};
    for(var j=0;j<secs.length;j++){
      var sec=secs[j],any=sec.querySelector(".gl-term:not([hidden])");
      sec.hidden=!any;
      live[sec.getAttribute("data-letter")]=!!any;
    }
    for(var k=0;k<azs.length;k++)azs[k].classList.toggle("off",!live[azs[k].getAttribute("data-letter")]);
    empty.hidden=shown>0;
    count.textContent=(s||cat!=="all")?shown+" of "+total+" terms":total+" terms";
    clear.hidden=!q.value;
  }

  q.addEventListener("input",apply);
  clear.addEventListener("click",function(){q.value="";q.focus();apply();});
  q.addEventListener("keydown",function(e){if(e.key==="Escape"){q.value="";apply();}});
  for(var c=0;c<chips.length;c++)chips[c].addEventListener("click",function(){
    for(var n=0;n<chips.length;n++)chips[n].classList.toggle("on",chips[n]===this);
    cat=this.getAttribute("data-k");apply();
  });

  /* ?q= makes a filtered view linkable, and a #anchor must survive the filter */
  var params=new URLSearchParams(location.search);
  if(params.get("q"))q.value=params.get("q");
  apply();
  if(location.hash){
    var target=document.getElementById(location.hash.slice(1));
    if(target&&target.hidden){q.value="";cat="all";
      for(var m=0;m<chips.length;m++)chips[m].classList.toggle("on",chips[m].getAttribute("data-k")==="all");
      apply();}
    if(target)target.scrollIntoView();
  }
})();
</script>
</Base>
