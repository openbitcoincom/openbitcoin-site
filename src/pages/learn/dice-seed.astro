<script is:inline>
(function(){
  /* No cryptography runs on this page and no secret is handled: there is no
     input of any kind. The one thing that can be wrong is the arithmetic that
     tells a reader how many throws they need, and understating that would
     understate their entropy, so every printed figure is recomputed and
     compared before the tables are allowed to show.

     TEST VECTORS (published values, all re-derived here):
       throws needed = ceil(bits / log2(faces))
         d6   -> 50 for 128 bits, 100 for 256      (2.585 bits per throw)
         d20  -> 30 for 128 bits,  60 for 256      (4.322 bits per throw)
         coin -> 128 for 128 bits, 256 for 256     (1.000 bit per flip)
       bit totals: 50 d6 throws = 129.2 bits, 99 d6 throws = 255.9 bits,
                   49 d6 throws = 126.7 bits
       BIP39 shape (both rows confirmed by brute force against the real
       wordlist and SHA-256 while the offline toolkit was written):
         12 words -> 128 entropy bits, 4 checksum bits, 128 final words, 7 free
         24 words -> 256 entropy bits, 8 checksum bits,   8 final words, 3 free
     plus structural vectors: every figure rendered into either table is read
     back out of the DOM and compared with the recomputed value. Any mismatch
     hides both tables and shows a visible failure state. */
  function log2(x){return Math.log(x)/Math.LN2;}
  function throwsFor(f,b){return Math.ceil(b/log2(f));}
  function bitsFrom(f,n){return (n*log2(f)).toFixed(1);}
  function shape(n){var cs=(n*11)/33;return {ent:n*11-cs,cs:cs,cand:2048/Math.pow(2,cs),free:11-cs};}

  var pass=true,detail=[];
  function want(cond,label){if(!cond){pass=false;detail.push(label);}}

  var VEC=[[6,128,50],[6,256,100],[20,128,30],[20,256,60],[2,128,128],[2,256,256]];
  for(var i=0;i<VEC.length;i++){
    want(throwsFor(VEC[i][0],VEC[i][1])===VEC[i][2],"throws d"+VEC[i][0]+" for "+VEC[i][1]);
  }
  want(bitsFrom(6,50)==="129.2","50 d6 bit total");
  want(bitsFrom(6,99)==="255.9","99 d6 bit total");
  want(bitsFrom(6,49)==="126.7","49 d6 bit total");
  want(log2(6).toFixed(3)==="2.585","d6 bits per throw");
  want(log2(20).toFixed(3)==="4.322","d20 bits per throw");

  var a=shape(12),b=shape(24);
  want(a.ent===128&&a.cs===4&&a.cand===128&&a.free===7,"12 word phrase row");
  want(b.ent===256&&b.cs===8&&b.cand===8&&b.free===3,"24 word phrase row");

  /* structural: compare every rendered figure with the recomputed one */
  var t1=document.getElementById("ds-t1"),t2=document.getElementById("ds-t2"),
      fail=document.getElementById("ds-fail"),
      b99=document.getElementById("ds-b99"),b49=document.getElementById("ds-b49"),
      wraps=document.querySelectorAll(".ds-tw");
  if(!t1||!t2||!fail)return;

  Array.prototype.forEach.call(t1.querySelectorAll("td[data-p]"),function(td){
    want(td.textContent.trim()===log2(parseInt(td.getAttribute("data-p"),10)).toFixed(3),
      "printed bits per throw d"+td.getAttribute("data-p"));
  });
  Array.prototype.forEach.call(t1.querySelectorAll("td[data-c]"),function(td){
    var f=parseInt(td.getAttribute("data-f"),10),c=parseInt(td.getAttribute("data-c"),10),
        n=throwsFor(f,c),num=td.querySelector("b"),bit=td.querySelector("i");
    want(!!num&&num.textContent.trim()===String(n),"printed throws d"+f+"/"+c);
    want(!!bit&&bit.textContent.trim()===bitsFrom(f,n)+" bits","printed bit total d"+f+"/"+c);
  });
  Array.prototype.forEach.call(t2.querySelectorAll("td[data-k]"),function(td){
    var s=shape(parseInt(td.getAttribute("data-n"),10)),k=td.getAttribute("data-k"),
        txt=td.textContent.trim(),
        exp=k==="cand"?(s.cand+" of 2048"):(s[k]+" bits");
    want(txt===exp,"printed "+k+" for "+td.getAttribute("data-n")+" words");
  });
  want(!!b99&&b99.textContent.trim()===bitsFrom(6,99),"inline 99 throw figure");
  want(!!b49&&b49.textContent.trim()===bitsFrom(6,49),"inline 49 throw figure");

  if(!pass){
    console.error("[/learn/dice-seed] self-test failed: "+detail.join(", ")+
      ". Both tables are withheld rather than shown with wrong roll counts.");
    Array.prototype.forEach.call(wraps,function(w){w.className="ds-tw is-off";});
    if(b99)b99.textContent="--";
    if(b49)b49.textContent="--";
    fail.className="ds-fail is-on";
    return;
  }
  console.log("[/learn/dice-seed] self-test passed: 6 roll-count vectors, 5 bit totals, "+
    "2 BIP39 phrase rows and every printed figure in both tables verified.");
})();
</script>
