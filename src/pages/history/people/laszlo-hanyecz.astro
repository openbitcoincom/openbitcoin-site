</main>
<style is:global>
  .pl-hero{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:28px 24px 22px;text-align:center}
  .pl-big{font:800 56px/1 var(--mono);color:var(--price-ink);font-variant-numeric:tabular-nums;letter-spacing:-2px}
  .pl-sub{font:600 12.5px var(--mono);color:var(--ink-2);margin-top:9px}
  .pl-line{font:500 13.5px/1.6 var(--sans);color:var(--ink-2);margin-top:12px}
  .pl-line b{font:700 13.5px var(--mono);color:var(--ink);font-variant-numeric:tabular-nums}
  .pl-line b.pl-up{color:var(--up)}
  .pl-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-top:18px;text-align:left}
  .pl-stat{background:rgba(124,140,168,.13);border:1px dashed rgba(255,166,60,.32);border-radius:10px;padding:10px 12px;min-width:0}
  .pl-stat b{display:block;font:700 14.5px var(--mono);color:var(--ink);font-variant-numeric:tabular-nums;white-space:nowrap}
  .pl-stat i{display:block;font:600 9px/1.5 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3);font-style:normal;margin-top:3px}
  .pl-mt{margin-top:14px}
  .pl-att{font:600 9.5px var(--mono);letter-spacing:.11em;text-transform:uppercase;color:var(--ink-3);margin-top:7px;padding-left:20px}
  .pl-tl{margin-top:14px;border:1px solid var(--line-2);border-radius:10px;background:var(--panel-2);padding:4px 16px}
  .pl-tli{display:flex;align-items:baseline;gap:14px;padding:10px 0;border-bottom:1px dotted var(--line-2)}
  .pl-tli:last-child{border-bottom:0}
  .pl-tly{flex:none;width:86px;font:700 10.5px var(--mono);letter-spacing:.04em;color:var(--acc);font-variant-numeric:tabular-nums}
  .pl-tlt{font:500 13px/1.55 var(--sans);color:var(--ink-2);min-width:0}
  .pl-about{margin-top:14px}
  .pl-about p{font:500 13.5px/1.65 var(--sans);color:var(--ink-3)}
  .pl-rs{padding:7px 0;border-bottom:1px dotted var(--line-2)}
  .pl-rs:last-child{border-bottom:0}
  .pl-rs b{display:block;font:700 16px var(--mono);color:var(--ink);font-variant-numeric:tabular-nums}
  .pl-rs i{display:block;font:600 9px var(--mono);letter-spacing:.11em;text-transform:uppercase;color:var(--ink-3);font-style:normal;margin-top:2px}
  @media(max-width:700px){
    .pl-big{font-size:42px}
    .pl-hero{padding:22px 16px 18px}
    .pl-stats{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
    .pl-stat b{white-space:normal}
    .pl-tl{padding:2px 13px}
    .pl-tli{gap:11px}
    .pl-tly{width:74px}
  }
</style>
<script is:inline>
(function(){
  var P={price:null};
  var el=document.getElementById("pl-now");
  function paint(){
    if(!P.price)return; /* no price yet: leave the ellipsis in place */
    if(el)el.textContent="$"+(10000*P.price/1e6).toFixed(1)+"M";
  }
  /* live price arrives via the chrome hook; window.OB_LIVE is only set once a
     real summary lands, so the ellipsis holds until the first real tick */
  window.obPaintFiat=function(S){if(!window.OB_LIVE)return;P.price=S.price;paint();};
})();
</script>
</Base>
