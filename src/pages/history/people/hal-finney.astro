</main>
<style is:global>
  .pf-hero{display:grid;grid-template-columns:minmax(0,1fr) 240px;gap:22px;align-items:start;
    background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:26px 24px 22px}
  .pf-hmain{min-width:0}
  .pf-big{font:800 38px/1.05 var(--mono);color:var(--price-ink);letter-spacing:-1.5px}
  .pf-bsub{font:500 13.5px/1.6 var(--sans);color:var(--ink-2);margin-top:11px;max-width:52ch}
  .pf-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-top:18px}
  .pf-stat{background:rgba(124,140,168,.13);border:1px dashed rgba(255,166,60,.32);border-radius:10px;padding:10px 12px;min-width:0}
  .pf-stat b{display:block;font:700 14.5px var(--mono);color:var(--ink);font-variant-numeric:tabular-nums;white-space:nowrap}
  .pf-stat i{display:block;font:600 9px/1.5 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3);font-style:normal;margin-top:3px}
  .pf-photo{margin:0;background:var(--panel-2);border:1px solid var(--line-2);border-radius:12px;padding:10px;min-width:0}
  .pf-photo img{width:100%;height:auto;border-radius:8px;display:block;max-width:100%}
  .pf-photo figcaption{font:500 10.5px/1.5 var(--sans);color:var(--ink-3);margin-top:7px;padding:0 2px}
  .pf-photo figcaption a{color:var(--ink-3);text-decoration:none;border-bottom:1px dotted var(--line-2)}
  .pf-photo figcaption a:hover{color:var(--acc)}
  .pf-mt{margin-top:14px}
  .pf-qsrc{font:600 10.5px var(--mono);letter-spacing:.05em;text-transform:uppercase;color:var(--ink-3)}
  .pf-tx{display:grid;gap:8px;margin-top:14px;background:var(--field);border:1px dashed rgba(255,166,60,.32);border-radius:10px;padding:14px 16px}
  .pf-txrow{display:grid;grid-template-columns:104px minmax(0,1fr);gap:14px}
  .pf-txrow b{font:700 9.5px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--acc);padding-top:2px}
  .pf-txrow span{font:500 13px/1.55 var(--sans);color:var(--ink-2);min-width:0}
  .pf-mono{font:600 11px/1.6 var(--mono);color:var(--ink);overflow-wrap:anywhere;font-variant-numeric:tabular-nums}
  .pf-about{margin-top:14px}
  .pf-about p{font:500 13.5px/1.65 var(--sans);color:var(--ink-3)}
  .pf-tl{display:grid;gap:0}
  .pf-trow{display:grid;grid-template-columns:44px minmax(0,1fr);gap:10px;padding:7px 0;border-bottom:1px dotted var(--line-2)}
  .pf-trow:last-child{border-bottom:0}
  .pf-trow b{font:700 12px var(--mono);color:var(--acc);font-variant-numeric:tabular-nums}
  .pf-trow span{font:500 11.5px/1.5 var(--sans);color:var(--ink-2)}
  @media(max-width:700px){
    .pf-hero{grid-template-columns:minmax(0,1fr);padding:22px 16px 18px}
    .pf-photo{max-width:340px}
    .pf-big{font-size:29px}
    .pf-stats{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
    .pf-stat b{white-space:normal}
    .pf-txrow{grid-template-columns:minmax(0,1fr);gap:3px}
  }
</style>
</Base>
