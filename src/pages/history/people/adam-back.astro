        <a href="/history">Bitcoin history index</a>
      </nav>
    </div>
  </aside>
  </div>
</main>
<style is:global>
  .pb-top{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:22px 24px;
    display:grid;grid-template-columns:220px minmax(0,1fr);gap:22px;align-items:start}
  .pb-port{margin:0}
  .pb-port img{width:100%;height:auto;border-radius:10px;display:block;max-width:100%}
  .pb-port figcaption{font:500 10px/1.5 var(--sans);color:var(--ink-3);margin-top:7px}
  .pb-port figcaption a{color:var(--ink-3);text-decoration:none;border-bottom:1px dotted var(--line-2)}
  .pb-port figcaption a:hover{color:var(--acc)}
  .pb-intro{min-width:0}
  .pb-p{font:500 14px/1.65 var(--sans);color:var(--ink-2);margin:0}
  .pb-facts{display:grid;gap:8px;margin-top:14px}
  .pb-fact{display:grid;grid-template-columns:92px minmax(0,1fr);gap:14px;background:var(--field);
    border:1px solid var(--line-2);border-radius:10px;padding:10px 14px}
  .pb-fact b{font:700 11px var(--mono);letter-spacing:.04em;color:var(--acc);font-variant-numeric:tabular-nums;padding-top:2px}
  .pb-fact span{font:500 13px/1.55 var(--sans);color:var(--ink-2)}
  .pb-fact a{color:var(--acc);text-decoration:none;border-bottom:1px dashed rgba(247,147,26,.35);padding-bottom:1px}
  .pb-fact a:hover{border-bottom-style:solid}
  .pb-mt{margin-top:14px}
  .pb-tl{margin-top:14px;border:1px solid var(--line-2);border-radius:10px;background:var(--panel-2);padding:4px 16px}
  .pb-tli{display:flex;align-items:baseline;gap:14px;padding:10px 0;border-bottom:1px dotted var(--line-2)}
  .pb-tli:last-child{border-bottom:0}
  .pb-tly{flex:none;width:44px;font:700 11px var(--mono);letter-spacing:.06em;color:var(--acc);font-variant-numeric:tabular-nums}
  .pb-tlt{font:500 13px/1.55 var(--sans);color:var(--ink-2);min-width:0}
  .pb-about{margin-top:14px}
  .pb-about p{font:500 13.5px/1.65 var(--sans);color:var(--ink-3)}
  .pb-rs{padding:7px 0;border-bottom:1px dotted var(--line-2)}
  .pb-rs:last-child{border-bottom:0}
  .pb-rs b{display:block;font:700 16px var(--mono);color:var(--ink);font-variant-numeric:tabular-nums}
  .pb-rs i{display:block;font:600 9px var(--mono);letter-spacing:.11em;text-transform:uppercase;color:var(--ink-3);font-style:normal;margin-top:2px}
  @media(max-width:700px){
    .pb-top{grid-template-columns:minmax(0,1fr);padding:18px 16px}
    .pb-port{max-width:300px}
    .pb-tl{padding:2px 13px}
    .pb-tli{gap:11px}
  }
  @media(max-width:560px){
    .pb-fact{grid-template-columns:1fr;gap:4px}
    .pb-fact b{padding-top:0}
  }
</style>
</Base>
