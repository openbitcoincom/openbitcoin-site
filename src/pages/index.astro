      x.font="700 "+(b.r*1.35|0)+"px system-ui";x.fillText("₿",0,b.r*.05);
      x.restore();
      x.strokeStyle="rgba(255,255,255,.28)";x.lineWidth=Math.max(1.2,b.r*.07);
      x.beginPath();x.arc(b.x,b.y,b.r*.86,0,7);x.stroke();
      if(b.r>=12){
        x.fillStyle="#1A1006";x.textAlign="center";x.textBaseline="middle";  /* dark ink on the orange balls: white was unreadable (owner, mobile) */
        x.font="700 "+Math.max(9,Math.min(22,b.r*.42)|0)+"px ui-monospace,Consolas,monospace";
        x.fillText(b.amt>=1000?fmt(b.amt,0):b.amt>=10?fmt(b.amt,1):b.amt.toFixed(2),b.x,b.y+.5);
      }
    }
    /* impact shockwaves + landing sparks */
    for(i=fxRings.length-1;i>=0;i--){var R=fxRings[i];R.r+=1.9;R.a-=.028;
      if(R.a<=0){fxRings.splice(i,1);continue;}
      x.globalAlpha=R.a;x.strokeStyle="#D3B183";x.lineWidth=2;
      x.beginPath();x.arc(R.x,R.y,R.r,Math.PI,2*Math.PI);x.stroke();}
    for(i=fxSparks.length-1;i>=0;i--){var sp=fxSparks[i];
      sp.vy+=.15;sp.x+=sp.vx;sp.y+=sp.vy;sp.a-=.022;
      if(sp.a<=0){fxSparks.splice(i,1);continue;}
      x.globalAlpha=sp.a;x.fillStyle=sp.col;
      x.beginPath();x.arc(sp.x,sp.y,2,0,7);x.fill();}
    x.globalAlpha=1;
    /* hover card: amount, fiat, vsize, txid for the ball under the cursor */
    if(hoverB&&ballList.indexOf(hoverB)>=0){
      var hb=hoverB,d2=S.cur,hv=S.price==null?null:hb.amt*S.price*fx[d2],
          hvs=hv==null?"":hv>=1e9?fmt(hv/1e9,2)+"B":hv>=1e6?fmt(hv/1e6,1)+"M":hv>=1e3?fmt(hv/1e3,0)+"k":fmt(hv,0),
          l1=fmt(hb.amt,8)+" BTC",
          l2=(hv==null?"":sym[d2]+hvs+" · ")+vsTxt(hb.vsz),
          l3=hb.id.slice(0,10)+"…"+hb.id.slice(-6);
      x.font="700 11px ui-monospace,Consolas,monospace";
      var cw=Math.max(x.measureText(l1).width,x.measureText(l2).width,x.measureText(l3).width)+20,
          ch=52,cx2=Math.max(6,Math.min(w-cw-6,hb.x-cw/2)),
          cy2=hb.y-hb.r-ch-8;if(cy2<4)cy2=hb.y+hb.r+8;
      tipRect={x:cx2,y:cy2,w:cw,h:ch};   /* tap target for the touch flow below */
      x.fillStyle="#F8EDD6";x.strokeStyle="#C6A170";x.lineWidth=1;
      x.beginPath();x.roundRect(cx2,cy2,cw,ch,7);x.fill();x.stroke();
      x.textAlign="left";x.textBaseline="alphabetic";
      x.fillStyle="#2B2017";x.fillText(l1,cx2+10,cy2+16);
      x.fillStyle="#6B5B48";x.font="600 10.5px ui-monospace,Consolas,monospace";
      x.fillText(l2,cx2+10,cy2+31);
      x.fillStyle="#C46A00";x.fillText(l3,cx2+10,cy2+45);
    }
    requestAnimationFrame(ballsLoop);
  }
  /* balls are clickable, straight to their transaction page */
  function ballAt(e){
    var rc=ballsCv.getBoundingClientRect(),mx=e.clientX-rc.left,my=e.clientY-rc.top;
    for(var i=ballList.length-1;i>=0;i--){var b=ballList[i],dx=mx-b.x,dy=my-b.y;
      if(dx*dx+dy*dy<=b.r*b.r)return b;}
    return null;
  }
  var hoverB=null,tipRect=null;
  /* Touch flow (owner call 2026-08-04): a tap on a ball opens its card, a
     tap on the open card goes to the transaction, a tap on empty felt
     closes it. Mice keep hover-to-peek and click-through unchanged. */
  var COARSE=matchMedia("(pointer:coarse)").matches;
  ballsCv.addEventListener("click",function(e){
    if(COARSE){
      var rc=ballsCv.getBoundingClientRect(),mx=e.clientX-rc.left,my=e.clientY-rc.top;
      if(hoverB&&ballList.indexOf(hoverB)>=0&&tipRect&&
         mx>=tipRect.x&&mx<=tipRect.x+tipRect.w&&my>=tipRect.y&&my<=tipRect.y+tipRect.h){
        location.href="/"+hoverB.id;return;
      }
      hoverB=ballAt(e);   /* ball opens its card; empty felt closes */
      return;
    }
    var b=ballAt(e);if(b)location.href="/"+b.id;
  });
  ballsCv.addEventListener("mousemove",function(e){if(COARSE)return;hoverB=ballAt(e);ballsCv.style.cursor=hoverB?"pointer":"default";});
  ballsCv.addEventListener("mouseleave",function(){if(!COARSE)hoverB=null;});
  function setMode(m){
    mode=m;
    ltxTable.style.display=m==="table"?"table":"none";
    lbxTable.style.display=m==="blocks"?"table":"none";
    lnxWait.style.display=(m==="nodes"&&!nodesData)?"flex":"none";
    lnxTable.style.display=(m==="nodes"&&nodesData)?"table":"none";
    ballsCv.style.display=m==="balls"?"block":"none";
    document.getElementById("lbx-foot").style.display=m==="blocks"?"flex":"none";
    document.getElementById("lnx-foot").style.display=m==="nodes"?"flex":"none";
    btnT.classList.toggle("on",m==="table");btnBl.classList.toggle("on",m==="blocks");
    btnN.classList.toggle("on",m==="nodes");btnB.classList.toggle("on",m==="balls");
    if(m==="blocks"){renderBlocks(false);if(!blocksData.length)fetchBlocks(false);}
    if(m==="nodes"&&!nodesData)fetchNodes();
    ballsRunning=m==="balls";
    if(ballsRunning)requestAnimationFrame(ballsLoop);
  }
  btnT.addEventListener("click",function(){setMode("table");});
  btnBl.addEventListener("click",function(){setMode("blocks");});
  btnN.addEventListener("click",function(){setMode("nodes");});
  btnB.addEventListener("click",function(){setMode("balls");});
  /* live tx feed: SSE rows into whichever view is active (same dust filter) */
  function onTx(d){
    if(!d||typeof d.valueSat!=="number"||typeof d.txid!=="string"||!/^[0-9a-f]{64}$/i.test(d.txid))return;
    var t={amt:d.valueSat/1e8,vsize:(typeof d.vsize==="number"&&d.vsize>0)?d.vsize:0,id:d.txid.toLowerCase()};
    txSeen=true;
    if(mode==="table")addRow(t,false);
    else if(mode==="balls"&&t.amt>=0.017)addBall(t);
  }
  function seedTxs(){
    try{
      fetch(api()+"/txfeed")
        .then(function(r){if(!r.ok)throw new Error("txfeed "+r.status);return r.json();})
        .then(function(j){
          var txs=(j&&j.txs)||[];
          for(var i=txs.length-1;i>=0;i--){var t=txs[i];   /* newest-first payload, oldest seeded first */
            if(t&&typeof t.valueSat==="number"&&typeof t.txid==="string"&&/^[0-9a-f]{64}$/i.test(t.txid)){
              txSeen=true;
              addRow({amt:t.valueSat/1e8,vsize:(typeof t.vsize==="number"&&t.vsize>0)?t.vsize:0,id:t.txid.toLowerCase()},true);
            }}
        })
        .catch(function(){});
    }catch(e){}
  }

  /* ---- news: static list, newest first, ages tick; refreshed only when
     The SSR seed (news.json) shows first; {api}/news replaces the rows on
     load and every 10 min, and the seed stays whenever the fetch fails. ---- */
  (function(){
    var ul=document.getElementById("news-list");
    if(!ul)return;
    function newsAgo(ms){var s=ms/1e3;
      return s<90?"now":s<3600?(s/60|0)+"m":s<86400?(s/3600|0)+"h":(s/86400|0)+"d";}
    function paintAges(){
      Array.prototype.forEach.call(ul.querySelectorAll("li[data-ts]"),function(li){
        var ts=Date.parse(li.getAttribute("data-ts"));
        if(!isFinite(ts))return;
        var el=li.querySelector(".nage");
        if(el)el.textContent="· "+newsAgo(Math.max(0,Date.now()-ts));
      });
    }
    paintAges();
    setInterval(paintAges,60000);
    /* no idle rotation: the list changes only when the refetch brings new
       items; a genuinely new top article gets the fresh flash */
    /* live feed: same NSRC wordmark treatment as the SSR path (map serialized
       in #nsrc-data); unknown outlet tags get the generic pill */
    var NSRC={};
    try{NSRC=JSON.parse(document.getElementById("nsrc-data").textContent)||{};}catch(e){}
    function newsRow(n){
      var b=NSRC[n.s]||[String(n.s).toUpperCase(),"#9C8B75","#161310"];
      return '<li data-ts="'+esc(n.at)+'"><a href="'+esc(n.u)+'" target="_blank" rel="noopener noreferrer nofollow">'
        +'<span class="nt">'+esc(n.t)
        +'<svg class="ext" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 5h5v5M19 5l-8 8"/><path d="M19 13.5v5a1.5 1.5 0 0 1-1.5 1.5h-12A1.5 1.5 0 0 1 4 18.5v-12A1.5 1.5 0 0 1 5.5 5H10"/></svg></span>'
        +'<span class="ns2"><i class="nlogo" style="background:'+esc(b[1])+';color:'+esc(b[2]||"#FFFFFF")+'">'+esc(b[0])+'</i><span class="nage"></span></span>'
        +'</a></li>';
    }
    function loadNews(){
      try{
        fetch(api()+"/news?limit=10")
          .then(function(r){return r.ok?r.json():null})
          .then(function(j){
            var raw=(j&&j.items)||[],rows=[];
            for(var i=0;i<raw.length&&rows.length<5;i++){var n=raw[i];
              if(n&&typeof n.title==="string"&&n.title
                 &&typeof n.url==="string"&&/^https?:\/\//i.test(n.url)
                 &&typeof n.outlet==="string"&&typeof n.date==="string")
                rows.push(newsRow({t:n.title,s:n.outlet,at:n.date,u:n.url}));
            }
            if(rows.length){
              var prevTop=(ul.querySelector("li a")||{}).getAttribute?ul.querySelector("li a").getAttribute("href"):null;
              ul.innerHTML=rows.join("");paintAges();
              var top=ul.querySelector("li a");
              if(!reduced&&top&&prevTop&&top.getAttribute("href")!==prevTop){
                var li=top.closest("li");li.classList.remove("fresh");void li.offsetHeight;li.classList.add("fresh");
              }
            }
          })
          .catch(function(){});
      }catch(e){}
    }
    /* defer the first fetch until DOMContentLoaded so Base's OB_DATA_API is set */
    if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",loadNews);
    else loadNews();
    setInterval(loadNews,600000);
  })();

  /* ---- Fear & Greed: house index, hourly refresh ---- */
  (function(){
    var vEl=document.getElementById("fg-val"),sEl=document.getElementById("fg-segs"),lEl=document.getElementById("fg-label");
    if(!vEl||!sEl)return;
    function paintFG(d){
      if(!d||typeof d.value!=="number")return;
      vEl.textContent=d.value;
      if(lEl)lEl.textContent=" · "+d.label;
      var lit=Math.max(1,Math.round(d.value/10)),segs=sEl.children;
      for(var i=0;i<segs.length;i++){segs[i].className=i<lit?("on"+(i+1)):"";}
      var host=vEl.closest(".fgmini");
      if(host)host.title="House index from our own data: "+(d.method||"");
    }
    function loadFG(){
      try{fetch(api()+"/fear-greed").then(function(r){return r.ok?r.json():null}).then(paintFG).catch(function(){});}catch(e){}
    }
    if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",loadFG);
    else loadFG();
    setInterval(loadFG,3600000);
  })();

  /* ---- 7-day sparkline: real hourly candles from /candles ---- */
  var cvS=document.getElementById("spark"),SD=[],STm=[],hoverI=null,
      DOW=["SUN","MON","TUE","WED","THU","FRI","SAT"];
  function drawSpark(){
    if(!SD.length||!cvS)return;
    var cs=getComputedStyle(root),acc=cs.getPropertyValue("--orange").trim(),
        rgb=cs.getPropertyValue("--acc-rgb").trim(),grid=cs.getPropertyValue("--line").trim(),
        ink3=cs.getPropertyValue("--ink-3").trim(),ink=cs.getPropertyValue("--ink").trim(),
        panel=cs.getPropertyValue("--panel").trim(),line2=cs.getPropertyValue("--line-2").trim();
    var dpr=window.devicePixelRatio||1,w=cvS.clientWidth,h=cvS.clientHeight;
    if(!w||!h)return;
    cvS.width=w*dpr;cvS.height=h*dpr;
    var x=cvS.getContext("2d");x.scale(dpr,dpr);
    var N=SD.length,lo=Math.min.apply(null,SD),hi=Math.max.apply(null,SD);
    var axis=18,ph=h-axis,pad=5,span=hi-lo||1,i;
    function px(v){return v/(N-1)*w;}
    function py(val){return pad+(1-(val-lo)/span)*(ph-pad*2);}
    /* horizontal grid */
    x.strokeStyle=grid;x.globalAlpha=.55;x.lineWidth=1;
    [.25,.5,.75].forEach(function(f){x.beginPath();x.moveTo(0,ph*f);x.lineTo(w,ph*f);x.stroke();});
    /* timeline: one label per UTC day, faint separators at day starts */
    x.font='600 9.5px ui-monospace,"Cascadia Mono","Segoe UI Mono",Consolas,Menlo,monospace';
    x.textAlign="center";x.textBaseline="alphabetic";
    var segs=[],start=0,curDay=new Date(STm[0]*1000).getUTCDay();
    for(i=1;i<N;i++){
      var dd=new Date(STm[i]*1000).getUTCDay();
      if(dd!==curDay){segs.push([start,i-1,curDay]);start=i;curDay=dd;}
    }
    segs.push([start,N-1,curDay]);
    segs.forEach(function(sg,k){
      if(sg[0]>0){x.globalAlpha=.3;x.strokeStyle=grid;
        x.beginPath();x.moveTo(px(sg[0]),0);x.lineTo(px(sg[0]),ph);x.stroke();}
      if(sg[1]-sg[0]>=5){x.globalAlpha=1;x.fillStyle=ink3;
        x.fillText(k===segs.length-1?"TODAY":DOW[sg[2]],px((sg[0]+sg[1])/2),h-5);}
    });
    x.globalAlpha=1;
    /* area + line + endpoint */
    var g=x.createLinearGradient(0,0,0,ph);g.addColorStop(0,"rgba("+rgb+",.20)");g.addColorStop(1,"rgba("+rgb+",0)");
    x.beginPath();x.moveTo(0,py(SD[0]));for(i=1;i<N;i++)x.lineTo(px(i),py(SD[i]));x.lineTo(w,ph);x.lineTo(0,ph);x.closePath();x.fillStyle=g;x.fill();
    x.beginPath();x.moveTo(0,py(SD[0]));for(i=1;i<N;i++)x.lineTo(px(i),py(SD[i]));x.strokeStyle=acc;x.lineWidth=2;x.lineJoin="round";x.stroke();
    x.beginPath();x.arc(w,py(SD[N-1]),3.2,0,7);x.fillStyle=acc;x.fill();
    /* hover crosshair + readout */
    if(hoverI!=null){
      var hx=px(hoverI),hv=SD[hoverI];
      x.strokeStyle=line2;x.lineWidth=1;
      x.beginPath();x.moveTo(hx,0);x.lineTo(hx,ph);x.stroke();
      x.beginPath();x.arc(hx,py(hv),4.2,0,7);x.fillStyle=acc;x.fill();
      x.lineWidth=2;x.strokeStyle=panel;x.beginPath();x.arc(hx,py(hv),4.2,0,7);x.stroke();
      var dt2=new Date(STm[hoverI]*1000),
          lab="$"+fmt(Math.round(hv),0)+" · "+DOW[dt2.getUTCDay()]+" "+("0"+dt2.getUTCHours()).slice(-2)+":00";
      x.font="700 11px ui-monospace,Consolas,monospace";
      var tw=x.measureText(lab).width+16,tx2=Math.max(4,Math.min(w-tw-4,hx-tw/2));
      x.fillStyle=panel;x.strokeStyle=line2;x.lineWidth=1;
      x.beginPath();x.roundRect(tx2,4,tw,20,5);x.fill();x.stroke();
      x.fillStyle=ink;x.textAlign="left";x.fillText(lab,tx2+8,18);
    }
  }
  cvS.addEventListener("mousemove",function(e){
    if(!SD.length)return;
    var rc=cvS.getBoundingClientRect();
    hoverI=Math.max(0,Math.min(SD.length-1,Math.round((e.clientX-rc.left)/rc.width*(SD.length-1))));
    drawSpark();
  });
  cvS.addEventListener("mouseleave",function(){hoverI=null;drawSpark();});
  window.addEventListener("resize",function(){drawSpark();});
  function loadSpark(){
    try{
      fetch(api()+"/candles?interval=1h&limit=168")
        .then(function(r){if(!r.ok)throw new Error("candles "+r.status);return r.json();})
        .then(function(j){
          var rows=(j&&Array.isArray(j.candles))?j.candles:[];
          SD=[];STm=[];
          rows.forEach(function(k){
            if(Array.isArray(k)&&k.length>=5&&isFinite(+k[0])&&isFinite(+k[4])&&+k[4]>0){STm.push(+k[0]);SD.push(+k[4]);}
          });
          if(SD.length<2){SD=[];STm=[];sparkWait();return;}
          var lo=Math.min.apply(null,SD),hi=Math.max.apply(null,SD);
          document.getElementById("rng").textContent="$"+fmt(Math.round(lo),0)+" - $"+fmt(Math.round(hi),0);
          requestAnimationFrame(drawSpark);
        })
        .catch(sparkWait);
    }catch(e){sparkWait();}
  }
  function sparkWait(){document.getElementById("rng").textContent="waiting for price history";}

  /* ---- live wiring: /summary now, then the SSE stream ---- */
  function applySummary(d){
    if(!d)return;
    var prev=S.price;
    if(d.price&&typeof d.price.usd==="number"&&d.price.usd>0){
      S.price=d.price.usd;
      if(typeof d.price.change24h==="number")S.change24h=d.price.change24h;
    }
    if(d.fees)S.fees=d.fees;
    if(typeof d.height==="number")S.height=d.height;
    if(d.lastBlockAt){var t=Date.parse(d.lastBlockAt);if(isFinite(t))S.lastMs=t;}
    if(S.price!=null){
      var dir=(prev!=null&&S.price!==prev)?(S.price>prev?"up":"down"):null;
      renderPrice(dir);
      /* The pill only ever shows movement the viewer actually watched: it
         stays hidden until the price changes during THIS visit. It used to
         seed with the 24h move in dollars on first paint, which read as the
         price jumping $600 in the seconds after load, refresh after refresh,
         while the chip below already says the same thing as a percent
         (owner report 2026-08-03). */
      if(prev!=null&&S.price!==prev)paintDelta(S.price-prev);
      lastEdited==="btc"?convB():convF();
    }
    paintStrip();
    tickSince();
  }
  function onBlockEv(d){
    if(!d)return;
    if(typeof d.height==="number")S.height=d.height;
    if(d.lastBlockAt){var t=Date.parse(d.lastBlockAt);if(isFinite(t))S.lastMs=t;}
    else S.lastMs=Date.now();
    paintStrip();
    tickSince();
    renderPrice();                 /* MCAP tracks the new supply */
    popBlock();
    sweepUntil=Date.now()+2600;    /* the pile just got mined: open the floor and drain it */
    fetchBlocks(true);
  }
  function init(){
    try{
      fetch(api()+"/summary")
        .then(function(r){if(!r.ok)throw new Error("summary "+r.status);return r.json();})
        .then(applySummary)
        .catch(function(){
          /* summary down: /network and /mempool still light the strip */
          try{
            fetch(api()+"/network").then(function(r){return r.ok?r.json():null;}).then(function(j){
              if(j&&typeof j.height==="number"){S.height=j.height;paintStrip();}
            }).catch(function(){});
          }catch(e){}
        });
    }catch(e){}
    try{
      fetch(api()+"/mempool").then(function(r){return r.ok?r.json():null;}).then(function(j){
        if(j&&typeof j.count==="number"&&!S.fees){S.memp=j.count;paintStrip();}
      }).catch(function(){});
    }catch(e){}
    seedTxs();
    fetchBlocks(false);
    loadSpark();
    if(typeof EventSource==="function"){
      try{
        var es=new EventSource(api()+"/stream");
        es.addEventListener("summary",function(ev){try{applySummary(JSON.parse(ev.data));}catch(e){}});
        es.addEventListener("block",function(ev){try{onBlockEv(JSON.parse(ev.data));}catch(e){}});
        es.addEventListener("tx",function(ev){try{onTx(JSON.parse(ev.data));}catch(e){}});
      }catch(e){}
    }
  }
  /* defer network work until DOMContentLoaded so Base's OB_DATA_API is set */
  if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",init);
  else init();
})();
</script>
</Base>
