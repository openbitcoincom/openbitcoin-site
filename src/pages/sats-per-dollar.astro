---
import Base from '../layouts/Base.astro';
import '../styles/doc.css';
---
<Base title="Sats per Dollar: How Many Satoshis One US Dollar Buys - OpenBitcoin" description="Live sats-per-dollar ticker: how many satoshis one US dollar buys right now, plus what $1, $10, $100 and $1,000 buy in sats.">
<main class="wrap doc-wrap">
  <div class="doc-head">
    <div class="doc-kicker">Sats per dollar</div>
    <h1>Sats per dollar</h1>
    <p class="doc-lede">The price ticker, inverted: how many satoshis one US dollar buys, updated live. The figure rises when the dollar price of bitcoin falls, and falls when it rises.</p>
  </div>
  <div class="doc-grid">
  <div>
    <div class="sp-card">
      <div class="sp-hlab">One US dollar buys, right now</div>
      <div class="sp-big"><span class="sp-pre">$1&nbsp;=</span> <b id="sp-n">&hellip;</b> <span class="sp-pre">sats</span></div>
      <div class="sp-sub">at <b id="sp-px">&hellip;</b> per BTC</div>
      <div class="sp-cmp">
        <div class="sp-cstat">
          <div class="sp-ck">At the all-time high</div>
          <div class="sp-cv">792 sats</div>
          <div class="sp-cs">$126,272 per BTC on October 6, 2025</div>
        </div>
        <div class="sp-cstat">
          <div class="sp-ck">Versus the top</div>
          <div class="sp-cv" id="sp-d">&hellip;</div>
          <div class="sp-cs" id="sp-dw">sats per dollar against the ATH figure</div>
        </div>
      </div>
    </div>
    <div class="sp-card" style="margin-top:14px">
      <div class="sp-tlab">What each amount buys right now</div>
      <table class="sp-table" id="sp-table" aria-label="Dollar amounts converted to satoshis">
        <thead><tr><th>Dollars</th><th>Satoshis</th><th>≈ BTC</th></tr></thead>
        <tbody>
          <tr><td>$1</td><td><b>&hellip;</b></td><td>&hellip;</td></tr>
          <tr><td>$10</td><td><b>&hellip;</b></td><td>&hellip;</td></tr>
          <tr><td>$100</td><td><b>&hellip;</b></td><td>&hellip;</td></tr>
          <tr><td>$1,000</td><td><b>&hellip;</b></td><td>&hellip;</td></tr>
        </tbody>
      </table>
    </div>
    <div class="sp-about doc-prose">
      <p>A satoshi is the smallest unit of bitcoin: 100,000,000 sats make one BTC. Sats per dollar is simply the inverse of the dollar price, so the number moves opposite to the ticker, and the ATH comparison above is arithmetic, not a forecast. The rate is a median of three exchanges, documented at <a href="/sources">/sources</a>; figures are informational, per the <a href="/terms">terms</a>.</p>
    </div>
  </div>
  <aside class="doc-rail">
    <div class="doc-tile">
      <div class="doc-tlab">Right now</div>
      <div class="sp-stat"><b id="sp-r1">&hellip;</b><i>1 BTC</i></div>
      <div class="sp-stat"><b id="sp-r2">&hellip;</b><i>1 satoshi</i></div>
    </div>
    <div class="doc-tile">
      <div class="doc-tlab">Related</div>
      <nav>
        <a href="/sats">Sats converter</a>
        <a href="/convert">Full bitcoin converter</a>
        <a href="/ath">Distance from the all-time high</a>
      </nav>
    </div>
  </aside>
  </div>
</main>
<style is:global>
  .sp-card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:22px 24px}
  .sp-hlab{font:700 9.5px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);margin-bottom:12px}
  .sp-big{font:800 clamp(34px,7vw,58px)/1.05 var(--mono);font-variant-numeric:tabular-nums;letter-spacing:-1.5px;color:var(--price-ink);white-space:nowrap}
  .sp-big b{color:var(--acc);font-weight:800}
  .sp-pre{color:var(--ink-2);font-weight:700}
  .sp-sub{font:600 12.5px var(--mono);font-variant-numeric:tabular-nums;color:var(--ink-3);margin-top:10px}
  .sp-sub b{color:var(--ink-2);font-weight:700}
  .sp-cmp{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:20px;padding-top:18px;border-top:1px dotted var(--line-2)}
  .sp-ck{font:700 9.5px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3)}
  .sp-cv{font:700 19px var(--mono);font-variant-numeric:tabular-nums;color:var(--ink);margin-top:5px}
  .sp-cv.sp-up{color:var(--up)}
  .sp-cv.sp-down{color:var(--down)}
  .sp-cs{font:500 12px/1.5 var(--sans);color:var(--ink-3);margin-top:3px}
  .sp-tlab{font:700 9.5px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);margin-bottom:10px}
  .sp-table{width:100%;border-collapse:collapse}
  .sp-table th{font:700 9.5px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3);
    text-align:left;padding:0 10px 8px 0;border-bottom:1px solid var(--line-2)}
  .sp-table td{font:600 14.5px var(--mono);color:var(--ink-2);padding:10px 10px 10px 0;border-bottom:1px dotted var(--line-2);
    font-variant-numeric:tabular-nums;white-space:nowrap}
  .sp-table tr:last-child td{border-bottom:0}
  .sp-table td:first-child{color:var(--ink);font-weight:700}
  .sp-table td b{color:var(--price-ink);font-weight:700}
  .sp-about{margin-top:14px}
  .sp-about p{font:500 13.5px/1.65 var(--sans);color:var(--ink-3)}
  .sp-stat{padding:7px 0;border-bottom:1px dotted var(--line-2)}
  .sp-stat:last-child{border-bottom:0}
  .sp-stat b{display:block;font:700 16px var(--mono);color:var(--ink);font-variant-numeric:tabular-nums}
  .sp-stat i{display:block;font:600 9px var(--mono);letter-spacing:.11em;text-transform:uppercase;color:var(--ink-3);font-style:normal;margin-top:2px}
  @media(max-width:480px){
    .sp-cmp{grid-template-columns:1fr;gap:12px}
    .sp-card{padding:18px 18px}
  }
</style>
<script is:inline>
(function(){
  /* price null until the feed answers: the hero, the comparison, the table and
     the tab title all keep what they were served until a real price lands */
  var ATH=126272, AMTS=[1,10,100,1000], P={price:null};
  function fmt(n,d){return n.toLocaleString("en-US",{minimumFractionDigits:0,maximumFractionDigits:d});}
  var elN=document.getElementById("sp-n"),elPx=document.getElementById("sp-px"),
      elD=document.getElementById("sp-d"),elDw=document.getElementById("sp-dw"),
      tb=document.querySelector("#sp-table tbody"),
      r1=document.getElementById("sp-r1"),r2=document.getElementById("sp-r2");
  function paint(){
    if(P.price===null)return;
    var spd=1e8/P.price, athSpd=1e8/ATH;
    elN.textContent=fmt(spd,0);
    elPx.textContent="$"+fmt(P.price,2);
    var more=spd>=athSpd, pct=Math.abs(spd/athSpd-1)*100;
    elD.textContent=(more?"+":"-")+fmt(pct,0)+"%";
    elD.className="sp-cv "+(more?"sp-up":"sp-down");
    elDw.textContent=(more?"more":"fewer")+" sats per dollar than at the ATH";
    tb.innerHTML=AMTS.map(function(a){
      var sats=a/P.price*1e8;
      return "<tr><td>$"+fmt(a,0)+"</td><td><b>"+fmt(sats,0)+" sats</b></td><td>"+(sats/1e8).toFixed(8)+" BTC</td></tr>";
    }).join("");
    r1.textContent="$"+fmt(P.price,0);
    r2.textContent="$"+fmt(P.price/1e8,6);
    document.title=fmt(spd,0)+" sats/$ - OpenBitcoin";
  }
  window.obPaintFiat=function(S){
    if(!S||typeof S.price!=="number"||!(S.price>0))return;
    P.price=S.price;paint();};
  /* chrome.js parses after this script, so a summary it already holds is read
     on DOMContentLoaded rather than here */
  function boot(){
    try{
      var L=window.OB_LIVE;
      if(L&&L.price&&typeof L.price.usd==="number"&&L.price.usd>0){P.price=L.price.usd;paint();}
    }catch(e){}
  }
  if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",boot);
  else boot();
})();
</script>
</Base>
