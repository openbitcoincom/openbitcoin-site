---
import Base from '../layouts/Base.astro';
import '../styles/doc.css';
---
<Base title="Bitcoin Block 1,000,000 Countdown and Estimated Date - OpenBitcoin" description="Live countdown to Bitcoin block 1,000,000: blocks remaining from the current height and the estimated arrival date at 10 minutes per block.">
<main class="wrap doc-wrap">
  <div class="doc-head">
    <div class="doc-kicker">Block 1,000,000</div>
    <h1>Countdown to block one million</h1>
    <p class="doc-lede">The chain is closing in on its seventh digit. Blocks remaining from the current height, with an arrival estimate at the long-run pace of one block every 10 minutes.</p>
  </div>
  <div class="doc-grid">
  <div>
    <div class="bm-card bm-hero">
      <div class="bm-klab">Blocks remaining</div>
      <div class="bm-big" id="bm-remain">&hellip;</div>
      <div class="bm-sub"><span id="bm-eta-len">&hellip;</span> at 10 minutes per block</div>
      <div class="bm-etarow">
        <div class="bm-cell">
          <b id="bm-eta-date">&hellip;</b>
          <i>Estimated date</i>
        </div>
        <div class="bm-cell">
          <b id="bm-height">&hellip;</b>
          <i>Current height</i>
        </div>
        <div class="bm-cell">
          <b id="bm-pct">&hellip;</b>
          <i>Of the way there</i>
        </div>
      </div>
      <div class="bm-bar" role="img" aria-label="Progress to block 1,000,000"><div class="bm-fill" id="bm-fill" style="width:0%"></div></div>
    </div>

    <div class="bm-card" style="margin-top:14px">
      <div class="bm-tlab">Milestones on the chain's clock</div>
      <table class="bm-table" aria-label="Block height milestones and their dates">
        <thead><tr><th>Milestone</th><th>Block</th><th>Date</th></tr></thead>
        <tbody>
          <tr><td>Genesis block</td><td><b>0</b></td><td>January 3, 2009</td></tr>
          <tr><td>First halving</td><td><b>210,000</b></td><td>November 28, 2012</td></tr>
          <tr><td>Second halving</td><td><b>420,000</b></td><td>July 9, 2016</td></tr>
          <tr><td>Third halving</td><td><b>630,000</b></td><td>May 11, 2020</td></tr>
          <tr><td>Fourth halving</td><td><b>840,000</b></td><td>April 20, 2024</td></tr>
          <tr><td>Block one million</td><td><b>1,000,000</b></td><td><span id="bm-eta-row">&hellip;</span> (est.)</td></tr>
        </tbody>
      </table>
    </div>

    <div class="bm-prose doc-prose">
      <p>Bitcoin does not keep time in hours; it keeps time in blocks. A height is unambiguous in a way a calendar date never is: every node agrees on it, and the consensus rules themselves, from halvings to timelocks, are written against it. Block 1,000,000 changes nothing on its own, but it is the next round number on that native clock, and once it passes, the next scheduled stop is the <a href="/halving">fifth halving</a> at block 1,050,000, expected in 2028.</p>
    </div>

    <div class="bm-about doc-prose">
      <p>This page counts down from the current block height to height 1,000,000. The date shown is an estimate that assumes the long-run average of one block every 10 minutes, so it drifts slightly as real blocks arrive faster or slower; past milestone dates are the dates the actual blocks were mined. Where the height feed comes from is documented at <a href="/sources">/sources</a>.</p>
    </div>
  </div>
  <aside class="doc-rail">
    <div class="doc-tile">
      <div class="doc-tlab">Right now</div>
      <div class="bm-stat"><b id="bm-r-height">&hellip;</b><i>Current height</i></div>
      <div class="bm-stat"><b id="bm-r-remain">&hellip;</b><i>Blocks to go</i></div>
    </div>
    <div class="doc-tile">
      <div class="doc-tlab">Related</div>
      <nav>
        <a href="/halving">Halving countdown</a>
        <a href="/">Look up any block</a>
      </nav>
    </div>
  </aside>
  </div>
</main>
<style is:global>
  .bm-card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:22px 24px}
  .bm-hero{text-align:center;padding:30px 24px 26px}
  .bm-klab{font:700 9.5px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3)}
  .bm-big{font:800 56px/1.05 var(--mono);letter-spacing:-1.5px;color:var(--price-ink);
    font-variant-numeric:tabular-nums;margin-top:10px}
  .bm-sub{font:600 13.5px var(--mono);color:var(--ink-2);margin-top:8px;font-variant-numeric:tabular-nums}
  .bm-etarow{display:flex;justify-content:center;gap:0;margin-top:20px;border-top:1px dotted var(--line-2);padding-top:16px;flex-wrap:wrap}
  .bm-cell{flex:1;min-width:130px;padding:2px 14px;border-right:1px dotted var(--line-2)}
  .bm-cell:last-child{border-right:0}
  .bm-cell b{display:block;font:700 17px var(--mono);color:var(--ink);font-variant-numeric:tabular-nums}
  .bm-cell i{display:block;font:600 9px var(--mono);letter-spacing:.11em;text-transform:uppercase;
    color:var(--ink-3);font-style:normal;margin-top:3px}
  .bm-bar{height:8px;border-radius:4px;background:rgba(124,140,168,.13);border:1px dashed rgba(255,166,60,.32);
    overflow:hidden;margin-top:18px}
  .bm-fill{height:100%;background:linear-gradient(90deg,var(--orange),var(--acc));border-radius:4px}
  .bm-tlab{font:700 9.5px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);margin-bottom:10px}
  .bm-table{width:100%;border-collapse:collapse}
  .bm-table th{font:700 9.5px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3);
    text-align:left;padding:0 10px 8px 0;border-bottom:1px solid var(--line-2)}
  .bm-table td{font:600 14px var(--mono);color:var(--ink-2);padding:10px 10px 10px 0;border-bottom:1px dotted var(--line-2);
    font-variant-numeric:tabular-nums;white-space:nowrap}
  .bm-table tr:last-child td{border-bottom:0}
  .bm-table td:first-child{color:var(--ink);font-weight:700;font-family:var(--sans);white-space:normal}
  .bm-table td b{color:var(--price-ink);font-weight:700}
  @media(max-width:700px){.bm-table{display:block;overflow-x:auto}}
  .bm-prose{margin-top:14px}
  .bm-about{margin-top:14px}
  .bm-about p{font:500 13.5px/1.65 var(--sans);color:var(--ink-3)}
  .bm-stat{padding:7px 0;border-bottom:1px dotted var(--line-2)}
  .bm-stat:last-child{border-bottom:0}
  .bm-stat b{display:block;font:700 16px var(--mono);color:var(--ink);font-variant-numeric:tabular-nums}
  .bm-stat i{display:block;font:600 9px var(--mono);letter-spacing:.11em;text-transform:uppercase;color:var(--ink-3);font-style:normal;margin-top:2px}
  @media(max-width:700px){
    .bm-big{font-size:42px}
    .bm-cell{min-width:110px;padding:2px 10px}
  }
</style>
<script is:inline>
(function(){
  /* H is 0 until a real height lands; nothing renders from a baked one */
  var TARGET=1000000,H=0;
  var elRemain=document.getElementById("bm-remain"),
      elLen=document.getElementById("bm-eta-len"),
      elDate=document.getElementById("bm-eta-date"),
      elRow=document.getElementById("bm-eta-row"),
      elH=document.getElementById("bm-height"),
      elPct=document.getElementById("bm-pct"),
      elFill=document.getElementById("bm-fill"),
      elRH=document.getElementById("bm-r-height"),
      elRR=document.getElementById("bm-r-remain");
  function fmt(n){return n.toLocaleString("en-US");}
  function lenTxt(days){
    if(days>=365){
      var y=Math.floor(days/365.25),d=Math.round(days-y*365.25);
      return "about "+y+(y===1?" year ":" years ")+d+(d===1?" day":" days");
    }
    var r=Math.round(days);
    return "about "+r+(r===1?" day":" days");
  }
  function render(){
    if(!H)return;
    var remain=Math.max(0,TARGET-H);
    var mins=remain*10,days=mins/1440;
    var eta=new Date(Date.now()+mins*60000);
    var dateTxt=eta.toLocaleDateString("en-US",{year:"numeric",month:"long",day:"numeric"});
    elRemain.textContent=fmt(remain);
    elH.textContent=fmt(H);
    elRH.textContent=fmt(H);
    elRR.textContent=fmt(remain);
    if(remain===0){
      elLen.textContent="block 1,000,000 has been mined";
      elDate.textContent="Reached";
      elRow.textContent="Reached";
    }else{
      elLen.textContent=lenTxt(days);
      elDate.textContent=dateTxt;
      elRow.textContent=dateTxt;
    }
    var pct=Math.min(100,H/TARGET*100);
    elPct.textContent=pct.toFixed(2)+"%";
    elFill.style.width=pct.toFixed(2)+"%";
  }
  function setH(h){
    if(typeof h!=="number"||!(h>H))return false;
    H=h;render();return true;
  }
  /* live height arrives via the chrome hook (also fires after new blocks).
     chrome.js calls the hook once with its own pre-fetch baseline before any
     summary has landed; window.OB_LIVE is only set once a real summary has,
     so that first call is ignored. */
  window.obPaintFiat=function(S){if(window.OB_LIVE&&S)setH(S.height);};
  /* on load: the newest summary if the chrome already holds one, otherwise a
     direct height fetch. OB_DATA_API is set by Base.astro after this script
     parses, so wait for DOMContentLoaded. */
  function boot(){
    try{
      if(window.OB_LIVE&&setH(window.OB_LIVE.height))return;
      var api=(typeof window.OB_DATA_API==="string"&&window.OB_DATA_API)?window.OB_DATA_API:"/api/v1";
      fetch(api+"/height").then(function(r){return r.json();}).then(function(d){
        if(d)setH(d.height);
      }).catch(function(){});
    }catch(e){}
  }
  if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",boot);
  else boot();
})();
</script>
</Base>
