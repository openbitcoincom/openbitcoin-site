  var LIST_SHA="2f5eed53a4727b4bf8880d8f3f199efc90e58503646d9ff8eff3a2ed3b24dbda";
  var VEC={abandon:0,ability:1,about:3,acid:15,legal:1019,letter:1028,winner:2015,wrong:2037,zone:2046,zoo:2047};

  var IDX={},i;
  for(i=0;i<WL.length;i++)IDX[WL[i]]=i;

  var el=document.getElementById("wc-in"),
      res=document.getElementById("wc-res"),
      sugWrap=document.getElementById("wc-sugwrap"),
      sugLab=document.getElementById("wc-suglab"),
      sug=document.getElementById("wc-sug"),
      OK=false,deb=null;

  function esc(s){return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");}
  function num(n){return n.toLocaleString("en-US");}

  /* ---------------- self-test ---------------- */
  function syncTests(){
    var out=[],seen={},k,w,p;
    out.push(["V1 length 2048",WL.length===2048]);
    out.push(["V2 abandon/zoo",WL[0]==="abandon"&&WL[WL.length-1]==="zoo"]);
    var shape=true;
    for(k=0;k<WL.length;k++){
      w=WL[k];
      if(!/^[a-z]{3,8}$/.test(w)){shape=false;break;}
      if(k>0&&!(WL[k-1]<w)){shape=false;break;}
    }
    out.push(["V3 sorted lowercase 3-8",shape]);
    var uniq=true;
    for(k=0;k<WL.length;k++){
      p=WL[k].length>=4?WL[k].slice(0,4):WL[k];
      if(seen[p]){uniq=false;break;}
      seen[p]=1;
    }
    out.push(["V4 four-letter prefixes unique",uniq]);
    var vecOk=true;
    for(k in VEC)if(IDX[k]!==VEC[k])vecOk=false;
    out.push(["V5 known indices",vecOk]);
    return out;
  }
  function sha256hex(str){
    var b=new TextEncoder().encode(str);
    return crypto.subtle.digest("SHA-256",b).then(function(buf){
      var a=new Uint8Array(buf),s="",n;
      for(n=0;n<a.length;n++)s+=("0"+a[n].toString(16)).slice(-2);
      return s;
    });
  }
  function report(rows){
    var passed=0,n;
    for(n=0;n<rows.length;n++){
      if(rows[n][1])passed++;
      else console.error("[bip39 word check] SELF-TEST FAIL: "+rows[n][0]);
    }
    var line="[bip39 word check] self-test "+passed+"/"+rows.length+" passed";
    if(passed===rows.length)console.log(line);
    else console.error(line+" - results suppressed");
    return passed===rows.length;
  }
  function selfTest(){
    var rows=syncTests();
    return sha256hex(WL.join("\n")+"\n").then(function(h){
      rows.push(["V6 list SHA-256 "+LIST_SHA.slice(0,12),h===LIST_SHA]);
      return report(rows);
    }).catch(function(e){
      rows.push(["V6 list SHA-256 (crypto.subtle unavailable)",false]);
      console.error("[bip39 word check] hash check could not run",e);
      report(rows);
      return false;
    });
  }

  /* ---------------- lookup helpers ---------------- */
  function prefixMatches(q,cap){
    var r=[],n;
    for(n=0;n<WL.length&&r.length<cap;n++)if(WL[n].indexOf(q)===0)r.push(WL[n]);
    return r;
  }
  function prefixCount(q){
    var c=0,n;
    for(n=0;n<WL.length;n++)if(WL[n].indexOf(q)===0)c++;
    return c;
  }
  function dist(a,b,cut){
    if(Math.abs(a.length-b.length)>cut)return cut+1;
    var prev=[],cur=[],x,y,best;
    for(y=0;y<=b.length;y++)prev[y]=y;
    for(x=1;x<=a.length;x++){
      cur[0]=x;best=x;
      for(y=1;y<=b.length;y++){
        cur[y]=Math.min(prev[y]+1,cur[y-1]+1,prev[y-1]+(a.charAt(x-1)===b.charAt(y-1)?0:1));
        if(cur[y]<best)best=cur[y];
      }
      if(best>cut)return cut+1;
      prev=cur.slice();
    }
    return prev[b.length];
  }
  function nearMisses(q,cap){
    var hits=[],n,d;
    for(n=0;n<WL.length;n++){
      d=dist(q,WL[n],2);
      if(d<=2)hits.push([WL[n],d]);
    }
    hits.sort(function(a,b){return a[1]-b[1]||(a[0]<b[0]?-1:1);});
    return hits.slice(0,cap).map(function(h){return h[0];});
  }

  /* ---------------- painting ---------------- */
  function showSug(label,words,note){
    if(!words.length){sugWrap.hidden=true;sug.innerHTML="";return;}
    sugLab.textContent=label;
    var html=words.map(function(w){return '<button type="button" data-w="'+esc(w)+'">'+esc(w)+"</button>";}).join("");
    if(note)html+="<em>"+esc(note)+"</em>";
    sug.innerHTML=html;
    sugWrap.hidden=false;
  }
  function paint(html){res.innerHTML=html;}
  function badges(list){
    return '<div class="wc-badges">'+list.map(function(b){return "<span>"+esc(b)+"</span>";}).join("")+"</div>";
  }
  function paintIdle(){
    paint('<div class="wc-status wc-mut">Waiting for a word</div>'
      +'<div class="wc-note">Type or paste a single word. Partial words get autocomplete; words that are not on the list get the closest matches.</div>');
    showSug("",[]);
  }
  function paintFailed(){
    paint('<div class="wc-status wc-bad">Self-test failed</div>'
      +'<div class="wc-note">Either the wordlist built into this page did not match its published checksum, or the checksum could not be computed in this browser. Rather than risk a wrong answer about a backup word, the page will not answer at all. The console has the detail. Reload; if it keeps failing, check your word against a copy of BIP39 you obtained yourself.</div>');
    showSug("",[]);
  }
  function paintValid(w){
    var idx=IDX[w],
        pre=w.length>=4?w.slice(0,4):w,
        bits=idx.toString(2),
        note;
    while(bits.length<11)bits="0"+bits;
    if(w.length>=4){
      note="The first four letters, <code>"+esc(pre)+"</code>, name this word on their own: no other word on the list starts with them. That is what a four-character metal backup is recording.";
    }else{
      note="This word is only "+w.length+" letters, so there is nothing to shorten: write all "+w.length+". A backup that stores four characters per word stores this one whole.";
    }
    paint('<div class="wc-status wc-ok">&#10003; On the BIP39 English list</div>'
      +badges(["position "+num(idx+1)+" of 2,048","index "+num(idx),"bits "+bits])
      +'<div class="wc-note">'+note+"</div>"
      +'<div class="wc-note">Being on the list does not mean it belongs in your phrase, or sits in the right place. Only a full check, done offline, can say that.</div>');
    showSug("",[]);
  }
  function paintPartial(w,hits){
    var total=prefixCount(w);
    paint('<div class="wc-status wc-mut">Not a whole word yet</div>'
      +badges([total===1?"1 word starts with "+w:num(total)+" words start with "+w])
      +'<div class="wc-note">'+(total===1
        ? "Only one word on the list begins <b>"+esc(w)+"</b>, so those letters already identify it."
        : "Keep typing, or pick one below. Four letters is always enough to reach exactly one word.")+"</div>");
    showSug("Starts with "+w,hits,total>hits.length?"and "+num(total-hits.length)+" more":"");
  }
  function paintMissing(w){
    var near=nearMisses(w,8);
    paint('<div class="wc-status wc-bad">&#10007; Not on the BIP39 English list</div>'
      +badges(["not a BIP39 word"])
      +'<div class="wc-note">'+(near.length
        ? "No word on the list is spelled <b>"+esc(w)+"</b>. The closest entries are below; check the first four letters of yours against them, since that is the part that identifies a word."
        : "No word on the list is spelled <b>"+esc(w)+"</b>, and nothing on it is close. Check the word against your backup rather than guessing at it.")
      +"</div>"
      +'<div class="wc-note">Other language lists exist (Japanese, Spanish, French and more). This page only holds the English one, which is what almost every wallet uses.</div>');
    showSug("Closest words",near,"");
  }
  function paintTooMany(){
    paint('<div class="wc-status wc-bad">&#10007; That was more than one word</div>'
      +'<div class="wc-note">The field has been cleared and nothing was checked. Never paste a seed phrase into a website, including this one. If you need to check a whole phrase or repair a damaged one, use the <a href="/tools/seed-recovery">offline seed toolkit</a> with the machine disconnected.</div>'
      +'<div class="wc-alert">Field cleared. Nothing left the browser.</div>');
    showSug("",[]);
  }

  /* ---------------- input handling ---------------- */
  /* Strip everything that is not a letter, keep ONE word. Two or three words
     are trimmed to the first with a note; four or more wipes the field. */
  function handle(raw){
    if(!OK){paintFailed();return;}
    var toks=String(raw).toLowerCase().replace(/[^a-z]+/g," ").split(" ").filter(Boolean);
    if(toks.length>=4){el.value="";paintTooMany();return;}
    if(!toks.length){paintIdle();return;}
    var w=toks[0],trimmed=toks.length>1;
    if(el.value!==w)el.value=w;
    if(w.length>8){paintMissing(w);return;}
    if(Object.prototype.hasOwnProperty.call(IDX,w)){paintValid(w);}
    else{
      var hits=prefixMatches(w,12);
      if(hits.length)paintPartial(w,hits);
      else paintMissing(w);
    }
    if(trimmed){
      res.insertAdjacentHTML("beforeend",
        '<div class="wc-alert">Only the first word was kept. This page checks one word at a time, by design.</div>');
    }
  }

  el.addEventListener("input",function(){
    clearTimeout(deb);
    deb=setTimeout(function(){handle(el.value);},90);
  });
  el.addEventListener("paste",function(){
    setTimeout(function(){handle(el.value);},0);
  });
  document.querySelectorAll(".wc-ex button").forEach(function(b){
    b.addEventListener("click",function(){
      if(!OK)return;
      el.value=b.dataset.ex;handle(el.value);el.focus();
    });
  });
  sug.addEventListener("click",function(e){
    var b=e.target.closest("button");
    if(!b||!OK)return;
    el.value=b.dataset.w;handle(el.value);el.focus();
  });

  selfTest().then(function(pass){
    OK=pass;
    if(!pass){el.disabled=true;paintFailed();return;}
    el.disabled=false;
    paintIdle();
  });
})();
</script>
</Base>
