  }

  function gb(x,i){return ((x>>>i)&1)!==0;}
  function formatBits(mask){                  /* EC level M is 00 */
    var d=(0<<3)|mask,rem=d,i;
    for(i=0;i<10;i++)rem=(rem<<1)^((rem>>>9)*0x537);
    return (((d<<10)|rem)^0x5412)&0x7FFF;
