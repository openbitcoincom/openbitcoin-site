  var READY=false,run=0,deb=null,cur=null;
  var P={price:64362.18};

  function esc(s){return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");}
  function show(el,on){el.classList.toggle("tq-hide",!on);}
  function fmt(n,d){return n.toLocaleString("en-US",{minimumFractionDigits:d||0,maximumFractionDigits:d||0});}

  /* Amount parsing is done on the string, not on a float, so eight decimal
     places survive intact and the satoshi figure is exact. */
  function canonAmount(raw){
    var s=String(raw).replace(/\s|,/g,"");
    if(!s)return {empty:true};
    if(!/^[0-9]*\.?[0-9]*$/.test(s)||s===".")return {bad:true};
    var parts=s.split("."),ip=parts[0]||"0",fp=parts[1]||"";
    if(fp.length>8)return {bad:true,why:"Bitcoin has eight decimal places, no more."};
    ip=ip.replace(/^0+(?=[0-9])/,"");
    var trimmed=fp.replace(/0+$/,"");
    var sats=parseInt(ip,10)*1e8+parseInt((fp+"00000000").slice(0,8),10);
    /* zero is "still typing", not an error: no code is drawn, no red state */
    if(!isFinite(sats)||sats<=0)return {pending:true};
    if(sats>21000000*1e8)return {bad:true,why:"That is more bitcoin than will ever exist."};
    return {str:trimmed?ip+"."+trimmed:ip,sats:sats};
  }

  function validateAddr(s){
    var lower=s.toLowerCase();
    if(/^(bc1|tb1|bcrt1)/.test(lower)){
      if(s!==lower&&s!==s.toUpperCase())
        return Promise.resolve({err:"Bech32 addresses are all lowercase or all uppercase, never mixed."});
      var r=bech32Check(lower);
      if(r){r.addr=lower;return Promise.resolve(r);}
      return Promise.resolve({err:"Checksum fails. Re-copy the address from its source; the validator will point at a single wrong character."});
    }
    if(/^[13mn2]/.test(s)){
      return b58Check(s).then(function(r){
        if(r){r.addr=s;return r;}
        return {err:"Checksum fails. Re-copy the address from its source; the validator will point at a single wrong character."};
      });
    }
    return Promise.resolve({err:"Not recognised as a bitcoin address. Extended public keys, payment codes and Lightning invoices are not addresses."});
  }

  function echoHtml(a){
    if(a.length<16)return esc(a);
