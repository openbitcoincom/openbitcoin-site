    }
    var right,vert,xx,yy,up;
    for(right=size-1;right>=1;right-=2){
      if(right===6)right=5;
      for(vert=0;vert<size;vert++){
        for(j=0;j<2;j++){
          xx=right-j;up=((right+1)&2)===0;yy=up?size-1-vert:vert;
          if(!m.fn[yy][xx])bits.push(g[yy][xx]);
