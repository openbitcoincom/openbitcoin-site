---
import Base from '../../layouts/Base.astro';
import '../../styles/doc.css';
---
<Base title="Bitcoin Payment QR Code Generator - OpenBitcoin" description="Make a scannable bitcoin payment QR code in your browser: the address checksum is verified, and amount and label are optional. Nothing is sent.">
<main class="wrap doc-wrap">
  <div class="doc-head">
    <div class="doc-kicker">Payment QR</div>
    <h1>Bitcoin payment QR code</h1>
    <p class="doc-lede">Turn an address into a scannable payment code. The checksum is verified first, the amount is optional and in BTC, and the code is drawn in your browser. Nothing you type is sent anywhere.</p>
  </div>
  <div class="doc-grid">
  <div>
    <div class="tq-card">
      <div class="tq-lab">Receiving address</div>
      <input id="tq-addr" class="tq-input" autocomplete="off" spellcheck="false" autocapitalize="off" autocorrect="off" placeholder="bc1q... / bc1p... / 3... / 1..." aria-label="Receiving bitcoin address">
      <div class="tq-ex" aria-label="Example addresses">
        <span>Try:</span>
        <button type="button" data-ex="bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4">segwit</button>
        <button type="button" data-ex="bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqzk5jj0">taproot</button>
        <button type="button" data-ex="1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa">legacy</button>
      </div>

      <div class="tq-two">
        <div class="tq-field">
          <div class="tq-lab">Amount <i>optional, in BTC</i></div>
          <div class="tq-wrap">
            <input id="tq-amt" inputmode="decimal" autocomplete="off" spellcheck="false" placeholder="0.00000000" aria-label="Amount in bitcoin">
            <span>BTC</span>
          </div>
          <div class="tq-hint" id="tq-amthint">Leave it blank to let the payer choose the amount.</div>
        </div>
        <div class="tq-field">
          <div class="tq-lab">Label <i>optional</i></div>
          <div class="tq-wrap">
            <input id="tq-label" maxlength="50" autocomplete="off" spellcheck="false" placeholder="Invoice 104" aria-label="Label shown by the payer's wallet">
          </div>
          <div class="tq-hint" id="tq-lhint">Some wallets show this next to the payment. Keep it short and public.</div>
        </div>
      </div>

      <label class="tq-bare-row">
        <input type="checkbox" id="tq-bare">
        <span>Encode the address only, without the <code>bitcoin:</code> prefix</span>
      </label>
      <div class="tq-hint tq-bare-hint tq-hide" id="tq-barehint">Address-only mode: the amount and label ride in the bitcoin: format, so they are ignored while this is on.</div>

      <div class="tq-stage" role="status" aria-live="polite">
        <div class="tq-status tq-mut" id="tq-status">Waiting for an address</div>
        <div class="tq-badges tq-hide" id="tq-badges"></div>
        <div class="tq-plate tq-hide" id="tq-plate">
          <canvas id="tq-cv" role="img" aria-label="Payment QR code"></canvas>
        </div>
        <div class="tq-echowrap tq-hide" id="tq-echowrap">
          <div class="tq-echolab">Encoded address</div>
          <div class="tq-echo" id="tq-echo"></div>
          <div class="tq-echonote">Read this against the address you were given, character for character, before anyone scans it.</div>
        </div>
        <div class="tq-note" id="tq-note">Paste the address you want paid. Legacy (1...), script hash (3...), native segwit (bc1q...) and taproot (bc1p...) are all supported.</div>
      </div>

      <div class="tq-uriwrap tq-hide" id="tq-uriwrap">
        <div class="tq-lab" id="tq-urilab">BIP-21 URI in the code</div>
        <div class="tq-uri" id="tq-uri"></div>
        <div class="tq-acts">
          <button type="button" id="tq-copy">Copy URI</button>
          <button type="button" id="tq-png">Download PNG</button>
        </div>
      </div>

      <p class="tq-priv">The code is drawn by arithmetic in this page; the address, amount and label are never sent anywhere. This page makes no network requests with what you type.</p>
    </div>

    <div class="doc-card tq-mt">
      <div class="doc-sec doc-prose">
        <h2>A QR code is unreadable to you, so check the text</h2>
        <p>Nobody can look at a grid of squares and tell whose address is inside it. That gap is exactly where address swapping lives: clipboard malware that rewrites an address between copy and paste, a compromised page that renders someone else's code, a screenshot passed along and quietly edited. The defence is boringly effective. Compare the address echoed under the code against the address from its original source, character by character, paying attention to the middle and not only the ends, since a swapped address is usually chosen to match the first and last few characters. Then have the payer check the address their wallet displays after scanning, before they confirm. Two independent looks at the same string beat any amount of trust in the image. To check an address on its own first, use the <a href="/tools/validate">address validator</a>.</p>
      </div>
      <div class="doc-sec doc-prose">
        <h2>The amount is optional, and it is in bitcoin</h2>
        <p>The amount field writes a BIP-21 <code>amount=</code> parameter into the URI, and that parameter is defined in BTC, never in dollars, pounds or any other currency. A code carrying <code>amount=0.001</code> asks for one hundred thousand satoshis whatever the exchange rate does between now and the moment it is scanned. That is a feature for an invoice you expect paid in minutes and a trap for a code printed on a sign and left up for a month, because the bitcoin figure will not move with the price. Leaving the amount blank is the honest choice for a tip jar or a donation page: the payer types what they mean to send. The dollar figure this page shows beside the amount is a sanity check against a misplaced decimal point and is not encoded; to work in the other direction, <a href="/convert">convert between BTC and fiat</a> first, then enter the bitcoin amount here.</p>
      </div>
      <div class="doc-sec doc-prose">
        <h2>One address, one payment</h2>
        <p>Every address you hand out is a public label, and the chain remembers every payment made to it forever. Reuse the same address across a dozen invoices and anyone can total them, watch the balance, and tie the lot to whoever learns the address once. Reuse it in public, on a website or a printed sign, and you have published a running account statement to the world. Take a fresh receiving address from your wallet for every payment instead; wallets generate them endlessly and for free, which is the entire point of the design. If a code has to stay up permanently, understand you are trading privacy for convenience and keep the amounts small. <a href="/learn/privacy">Bitcoin privacy</a> covers what an observer can piece together from a reused address, and what it costs you.</p>
      </div>
    </div>

    <div class="tq-about doc-prose">
      <p>The URI format is BIP-21: the scheme <code>bitcoin:</code>, the address, then optional <code>amount</code> and <code>label</code> parameters. Wallets that do not understand the parameters fall back to reading the address alone, so a code built here still works in older software. The address is checked before anything is drawn, using the same arithmetic as the <a href="/tools/validate">validator</a>: the BCH checksum from BIP-173 and BIP-350 for bech32 and bech32m, and the double SHA-256 checksum for base58. A valid checksum proves an address is well formed, never that it belongs to who you think it does, which is why the address is echoed in full under the code. Figures and tools here are informational under the <a href="/terms">terms</a>; data provenance for the rest of the site is documented at <a href="/sources">/sources</a>.</p>
    </div>
  </div>
  <aside class="doc-rail">
    <div class="doc-tile">
      <div class="doc-tlab">This code</div>
      <div class="tq-stat"><b id="tq-sv">none yet</b><i>QR version</i></div>
      <div class="tq-stat"><b id="tq-ss">none yet</b><i>modules</i></div>
      <div class="tq-stat"><b id="tq-sb">none yet</b><i>bytes encoded</i></div>
      <div class="tq-stat"><b>M</b><i>error correction, about 15% recoverable</i></div>
    </div>
    <div class="doc-tile">
      <div class="doc-tlab">In the URI</div>
      <div class="tq-t"><b>address</b><i>The only required part. Everything else is a hint the wallet may ignore.</i></div>
      <div class="tq-t"><b>amount</b><i>Decimal BTC, up to eight places. Not a fiat figure.</i></div>
      <div class="tq-t"><b>label</b><i>Free text shown to the payer. Assume it is public.</i></div>
    </div>
    <div class="doc-tile">
      <div class="doc-tlab">Related</div>
      <nav>
        <a href="/tools/validate">Check an address</a>
        <a href="/convert">Convert BTC and fiat</a>
        <a href="/learn/privacy">Bitcoin privacy</a>
      </nav>
    </div>
  </aside>
  </div>
</main>
<style is:global>
  .tq-card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:22px 24px}
  .tq-mt{margin-top:14px}
  .tq-hide{display:none !important}
  .tq-lab{font:700 9.5px var(--mono);letter-spacing:.13em;text-transform:uppercase;color:var(--ink-3);margin-bottom:8px}
  .tq-lab i{font-style:normal;color:var(--ink-3);opacity:.75;letter-spacing:.1em;margin-left:6px}
  .tq-input{width:100%;box-sizing:border-box;background:rgba(124,140,168,.13);border:1px dashed rgba(255,166,60,.32);
    border-radius:10px;color:var(--price-ink);font:700 16.5px var(--mono);padding:13px 15px;outline:none}
  .tq-input:focus{border-style:solid;border-color:rgba(255,166,60,.55)}
  .tq-input::placeholder{color:var(--ph);font-weight:600}
  .tq-ex{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:10px}
  .tq-ex span{font:700 9.5px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3)}
  .tq-ex button{background:transparent;border:1px solid var(--line-2);border-radius:8px;color:var(--ink-2);
    font:700 10.5px var(--mono);letter-spacing:.08em;padding:6px 11px;cursor:pointer}
  .tq-ex button:hover{background:rgba(36,51,78,.55);color:var(--ink)}
  .tq-two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px;margin-top:18px}
  .tq-field{min-width:0}
  .tq-wrap{display:flex;align-items:center;gap:8px;background:var(--field);border:1px solid var(--line-2);
    border-radius:10px;padding:0 13px}
  .tq-wrap:focus-within{border-color:rgba(255,166,60,.55)}
  .tq-wrap.is-bad{border-color:var(--down)}
  .tq-wrap input{width:100%;min-width:0;background:none;border:0;outline:none;color:var(--price-ink);
    font:700 15px var(--mono);font-variant-numeric:tabular-nums;padding:11px 0}
  .tq-wrap input::placeholder{color:var(--ph);font-weight:600}
  .tq-wrap span{font:700 9px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3);flex:none}
  .tq-hint{font:500 11.5px/1.55 var(--sans);color:var(--ink-3);margin-top:7px}
  .tq-bare-row{display:flex;align-items:center;gap:9px;margin-top:14px;cursor:pointer;
    font:600 12.5px/1.5 var(--sans);color:var(--ink-2)}
  .tq-bare-row input{width:15px;height:15px;accent-color:var(--orange);cursor:pointer}
  .tq-bare-row code{font:700 12px var(--mono);color:var(--acc)}
  .tq-bare-hint{margin-top:5px;padding-left:24px}
  .tq-field input:disabled{opacity:.45;cursor:not-allowed}
  .tq-hint.is-bad{color:var(--down)}
  .tq-stage{margin-top:18px;padding-top:16px;border-top:1px dotted var(--line-2)}
  .tq-status{font:700 15px var(--mono);letter-spacing:.02em}
  .tq-status.tq-ok{color:var(--up)}
  .tq-status.tq-bad{color:var(--down)}
  .tq-status.tq-mut{color:var(--ink-3)}
  .tq-badges{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}
  .tq-badges span{background:rgba(124,140,168,.13);border:1px dashed rgba(255,166,60,.32);border-radius:8px;
    font:700 10px var(--mono);letter-spacing:.09em;text-transform:uppercase;color:var(--ink);padding:5px 10px;white-space:nowrap}
  .tq-badges span.tq-warn{border:1px solid var(--down);color:var(--down);background:rgba(246,70,93,.1)}
  .tq-plate{margin-top:14px;display:flex;justify-content:center;background:#FFFFFF;border:1px solid var(--line-2);
    border-radius:12px;padding:10px}
  .tq-plate canvas{display:block;max-width:100%;height:auto}
  .tq-echowrap{margin-top:14px}
  .tq-echolab{font:700 9.5px var(--mono);letter-spacing:.13em;text-transform:uppercase;color:var(--ink-3);margin-bottom:6px}
  .tq-echo{background:var(--panel-2);border:1px solid var(--line-2);border-radius:8px;padding:12px 14px;
    font:700 17px/1.6 var(--mono);color:var(--ink);word-break:break-all;letter-spacing:.4px}
  .tq-echo b{color:var(--acc)}
  .tq-echonote{font:500 11.5px/1.55 var(--sans);color:var(--ink-3);margin-top:7px}
  .tq-note{font:500 13px/1.6 var(--sans);color:var(--ink-2);margin-top:10px}
  .tq-uriwrap{margin-top:18px;padding-top:16px;border-top:1px dotted var(--line-2)}
  .tq-uri{background:var(--field);border:1px solid var(--line-2);border-radius:8px;padding:11px 13px;
    font:600 13px/1.65 var(--mono);color:var(--ink-2);word-break:break-all}
  .tq-acts{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
  .tq-acts button{background:var(--panel-2);border:1px solid var(--line-2);border-radius:8px;color:var(--ink-2);
    font:700 10.5px var(--mono);letter-spacing:.08em;text-transform:uppercase;padding:9px 14px;cursor:pointer}
  .tq-acts button:hover{color:var(--acc);border-color:rgba(255,166,60,.5)}
  .tq-priv{font:600 11px var(--mono);letter-spacing:.05em;color:var(--ink-3);margin:16px 0 0}
  .tq-fine{font:500 11.5px/1.5 var(--sans);color:var(--ink-3);margin:7px 0 0}
  .tq-about{margin-top:14px}
  .tq-about p{font:500 13.5px/1.65 var(--sans);color:var(--ink-3)}
  .tq-stat{padding:7px 0;border-bottom:1px dotted var(--line-2)}
  .tq-stat:last-child{border-bottom:0}
  .tq-stat b{display:block;font:700 16px var(--mono);color:var(--ink);font-variant-numeric:tabular-nums}
  .tq-stat i{display:block;font:600 9px var(--mono);letter-spacing:.11em;text-transform:uppercase;color:var(--ink-3);font-style:normal;margin-top:2px}
  .tq-t{padding:7px 0;border-bottom:1px dotted var(--line-2)}
  .tq-t:last-child{border-bottom:0}
  .tq-t b{display:block;font:700 13px var(--mono);color:var(--acc)}
  .tq-t i{display:block;font:500 11px/1.5 var(--sans);color:var(--ink-3);font-style:normal;margin-top:2px}
  @media(max-width:700px){
    .tq-card{padding:18px 18px 20px}
    .tq-two{grid-template-columns:minmax(0,1fr)}
    .tq-input{font-size:13.5px}
    .tq-echo{font-size:15px}
    .tq-acts button{flex:1 1 auto;text-align:center}
  }
</style>
<script is:inline>
(function(){
  /* =====================================================================
     /tools/qr

     Everything here is local arithmetic. There is no fetch, no XHR, no
     beacon and no image load anywhere in this file: the zero-network
     claim printed on the page depends on that staying true. crypto.subtle
     .digest is local math, not a request.

     ---------------------------------------------------------------------
     TEST VECTORS. selftest() runs all of these on load, logs a pass/fail
     line to the console, and if anything fails the tool refuses to draw a
     code and shows a "self-test failed" state instead of a wrong one.

     QR tables (a wrong entry in TOTAL, ECPB or NBLK shows up here)
       Byte-mode capacity, EC level M, versions 1..10, published table:
         14 26 42 62 84 106 122 152 180 213
       Data codewords, EC level M, versions 1..10, published table:
         16 28 44 64 86 108 124 154 182 216
       Both are recomputed from TOTAL/ECPB/NBLK and compared.

     Reed-Solomon over GF(256), primitive polynomial 0x11D
       gfMul(0x80, 0x02) = 0x1D          x^8 reduces to x^4+x^3+x^2+1
       ISO/IEC 18004 annex I worked example, version 1-M, "01234567":
         data 10 20 0C 56 61 80 EC 11 EC 11 EC 11 EC 11 EC 11
         ecc  A5 24 D4 C1 ED 36 C7 87 2C 55

     Format information, BCH(15,5) generator 0x537, masked with 0x5412
       level M, mask 0 -> 101010000010010
       level M, mask 4 -> 100010111111001

     Version information, BCH(18,6) generator 0x1F25
       version 7 -> 000111110010010100

     Placement round trip
       A sample URI is encoded, then the finished matrix is read back
       through the inverse of the mask and the inverse of the zigzag scan
       and compared with the codewords that were placed. This catches
       reserved-area, mask and scan-order mistakes that the table vectors
       above cannot see.

     bech32 / bech32m, BIP-173 and BIP-350
       bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4                     valid P2WPKH
       bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqzk5jj0 valid P2TR
       bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t5                     invalid, v0 with the bech32m constant

     base58check, double SHA-256 via crypto.subtle
       1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa   valid P2PKH, the genesis address
       3P14159f73E4gFr7JterCCQh9QjiTjiZrG   valid P2SH
       1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNb   invalid checksum
     ===================================================================== */

  /* ---------------- bech32 / bech32m (BIP-173 / BIP-350) ---------------- */
  var CS="qpzry9x8gf2tvdw0s3jn54khce6mua7l";
  var GEN=[0x3b6a57b2,0x26508e6d,0x1ea119fa,0x3d4233dd,0x2a1462b3];
  function polymod(v){
    var chk=1,i,j,top;
    for(i=0;i<v.length;i++){
      top=chk>>>25;chk=((chk&0x1ffffff)<<5)^v[i];
      for(j=0;j<5;j++)if((top>>>j)&1)chk^=GEN[j];
    }
    return chk>>>0;
  }
  function hrpExpand(h){
    var r=[],i;
    for(i=0;i<h.length;i++)r.push(h.charCodeAt(i)>>5);
    r.push(0);
    for(i=0;i<h.length;i++)r.push(h.charCodeAt(i)&31);
    return r;
  }
  function convert5to8(d){
    var acc=0,bits=0,out=[],i;
    for(i=0;i<d.length;i++){
      acc=(acc<<5)|d[i];bits+=5;
      while(bits>=8){bits-=8;out.push((acc>>bits)&255);}
    }
    if(bits>=5||((acc<<(8-bits))&255))return null;
    return out;
  }
  function bech32Check(a){
    if(a.length>90)return null;
    var pos=a.lastIndexOf("1");
    if(pos<1||pos+7>a.length)return null;
    var hrp=a.slice(0,pos);
    if(hrp!=="bc"&&hrp!=="tb"&&hrp!=="bcrt")return null;
    var data=[],i,d;
    for(i=pos+1;i<a.length;i++){
      d=CS.indexOf(a[i]);
      if(d<0)return null;
      data.push(d);
    }
    var pm=polymod(hrpExpand(hrp).concat(data));
    var enc=pm===1?"bech32":(pm===0x2bc830a3?"bech32m":null);
    if(!enc)return null;
    var ver=data[0];
    if(ver>16)return null;
    if(ver===0&&enc!=="bech32")return null;
    if(ver>0&&enc!=="bech32m")return null;
    var prog=convert5to8(data.slice(1,data.length-6));
    if(!prog||prog.length<2||prog.length>40)return null;
    if(ver===0&&prog.length!==20&&prog.length!==32)return null;
    var type=ver===0?(prog.length===20?"P2WPKH":"P2WSH")
            :(ver===1&&prog.length===32)?"P2TR"
            :"witness v"+ver;
    return {enc:enc,type:type,net:hrp==="bc"?"mainnet":(hrp==="tb"?"testnet":"regtest")};
  }

  /* ---------------------------- base58check ---------------------------- */
  var B58="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
  function b58decode(s){
    if(!s.length||s.length>40)return null;
    var bytes=[0],i,j,v,carry,x;
    for(i=0;i<s.length;i++){
      v=B58.indexOf(s[i]);
      if(v<0)return null;
      carry=v;
      for(j=0;j<bytes.length;j++){
        x=bytes[j]*58+carry;
        bytes[j]=x&255;carry=x>>8;
      }
      while(carry){bytes.push(carry&255);carry>>=8;}
    }
    for(i=0;i<s.length&&s[i]==="1";i++)bytes.push(0);
    return bytes.reverse();
  }
  function sha256d(bytes){
    return crypto.subtle.digest("SHA-256",new Uint8Array(bytes)).then(function(a){
      return crypto.subtle.digest("SHA-256",a);
    }).then(function(b){return new Uint8Array(b);});
  }
  var B58VER={0:["P2PKH","mainnet"],5:["P2SH","mainnet"],111:["P2PKH","testnet"],196:["P2SH","testnet"]};
  function b58Check(s){
    var bytes=b58decode(s);
    if(!bytes||bytes.length!==25||!B58VER[bytes[0]])return Promise.resolve(null);
    return sha256d(bytes.slice(0,21)).then(function(h){
      for(var i=0;i<4;i++)if(h[i]!==bytes[21+i])return null;
      return {enc:"base58check",type:B58VER[bytes[0]][0],net:B58VER[bytes[0]][1]};
    });
  }

  /* ====================== QR ENCODER: byte mode, EC level M ============= */
  /* Versions 1 to 10 only, which is far more than a BIP-21 URI ever needs.
     Total codewords per version, EC codewords per block at level M, and the
     block count per version at level M. All three are cross-checked on load
     against the two published capacity tables quoted at the top of this
     file, so none of them can drift silently. */
  var TOTAL=[0,26,44,70,100,134,172,196,242,292,346];
  var ECPB =[0,10,16,26, 18, 24, 16, 18, 22, 22, 26];
  var NBLK =[0, 1, 1, 1,  2,  2,  4,  4,  4,  5,  5];
  var ALIGN=[[],[],[6,18],[6,22],[6,26],[6,30],[6,34],[6,22,38],[6,24,42],[6,26,46],[6,28,50]];
  var MAXV=10;

  function dataCodewords(v){return TOTAL[v]-ECPB[v]*NBLK[v];}
  function cciBits(v){return v<10?8:16;}                 /* character count indicator */
  function capacity(v){return Math.floor((dataCodewords(v)*8-4-cciBits(v))/8);}

  /* GF(256) multiply, primitive polynomial 0x11D. Russian peasant, bit by
     bit, so there is no log table to get wrong. z never leaves eight bits:
     the shift only sets bit 8 when z was at least 0x80, and 0x11D also has
     bit 8 set, so the exclusive or clears it again. */
  function gfMul(x,y){
    var z=0,i;
    for(i=7;i>=0;i--){
      z=(z<<1)^((z>>>7)*0x11D);
      z^=((y>>>i)&1)*x;
    }
    return z;
