  function buildMatrix(v,inter){
    var size=v*4+17,mods=[],fn=[],y,x,i,j;
    for(y=0;y<size;y++){
      mods.push([]);fn.push([]);
      for(x=0;x<size;x++){mods[y].push(0);fn[y].push(0);}
    }
    function setF(x,y,d){
      if(x<0||y<0||x>=size||y>=size)return;
      mods[y][x]=d?1:0;fn[y][x]=1;
    }
    /* Timing patterns first, across the whole row 6 and column 6. The finder
       patterns are drawn second and deliberately overwrite the stretch of
       timing that runs through them: inside a finder, row 6 and column 6
       belong to the finder, not to the timing line. Drawing these two the
       other way round leaves three malformed finders and a code that most
       scanners refuse. */
    for(i=0;i<size;i++){setF(6,i,i%2===0);setF(i,6,i%2===0);}
    /* finder patterns, with their separators drawn by the same loop */
    function finder(cx,cy){
      var dx,dy,d;
      for(dy=-4;dy<=4;dy++)for(dx=-4;dx<=4;dx++){
        d=Math.max(Math.abs(dx),Math.abs(dy));
        setF(cx+dx,cy+dy,d!==2&&d!==4);
