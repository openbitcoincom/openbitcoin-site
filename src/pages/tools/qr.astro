    drawVersion();

    /* zigzag data placement, two columns at a time, skipping column 6 */
    var idx=0,total=inter.length*8,right,vert,xx,yy,up;
    for(right=size-1;right>=1;right-=2){
      if(right===6)right=5;
      for(vert=0;vert<size;vert++){
        for(j=0;j<2;j++){
          xx=right-j;up=((right+1)&2)===0;yy=up?size-1-vert:vert;
          if(!fn[yy][xx]&&idx<total){
