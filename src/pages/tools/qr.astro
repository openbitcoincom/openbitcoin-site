    cv.width=Math.round(px*dpr);cv.height=Math.round(px*dpr);
    cv.style.width=px+"px";cv.style.height=px+"px";
    var g=cv.getContext("2d");
    g.setTransform(dpr,0,0,dpr,0,0);
    g.fillStyle="#FFFFFF";g.fillRect(0,0,px,px);
    g.fillStyle="#0B0B0B";
    var x,y;
    for(y=0;y<m.size;y++)for(x=0;x<m.size;x++)
      if(m.mods[y][x])g.fillRect((x+q)*scale,(y+q)*scale,scale,scale);
  }

  /* The drawn size is chosen to fit the plate at a whole number of pixels per
     module, so the browser never has to resample a QR code down and drop
     modules out of it. Capped at 288px, which keeps it well inside a phone. */
  function stageTarget(){
    var w=elPlate.clientWidth||300;
    return Math.max(140,Math.min(288,w-22));
  }
  function clearOut(msg,cls){
    cur=null;
    elStatus.className="tq-status "+cls;
    elStatus.textContent=msg;
    show(elBadges,false);show(elPlate,false);show(elEchoWrap,false);show(elUriWrap,false);
    elSv.textContent="none yet";elSs.textContent="none yet";elSb.textContent="none yet";
  }

  function paintAmountHint(a){
    elAmtWrap.classList.remove("is-bad");
    elAmtHint.classList.remove("is-bad");
    if(a.empty){
      elAmtHint.textContent="Leave it blank to let the payer choose the amount.";
      return;
    }
    if(a.pending){
      elAmtHint.textContent="Enter an amount above zero, or clear the field to let the payer choose.";
      return;
    }
    if(a.bad){
      elAmtWrap.classList.add("is-bad");
      elAmtHint.classList.add("is-bad");
      elAmtHint.textContent=a.why||"That is not a number of bitcoin.";
      return;
    }
    var usd=a.sats/1e8*P.price;
    elAmtHint.textContent=fmt(a.sats)+" sats, about $"+fmt(usd,usd>=100?0:2)+
      " today. The dollar figure is a check for you and is not in the code.";
  }

  function refresh(){
    if(!READY)return;
    var token=++run;
    var raw=elAddr.value.replace(/\s+/g,"");
    var amount=canonAmount(elAmt.value);
    paintAmountHint(amount);
    if(!raw){
      clearOut("Waiting for an address","tq-mut");
      elNote.textContent="Paste the address you want paid. Legacy (1...), script hash (3...), native segwit (bc1q...) and taproot (bc1p...) are all supported.";
      return;
    }
    if(raw.length>110){
      clearOut("✗ Not recognised as a bitcoin address","tq-bad");
      elNote.textContent="That is longer than any bitcoin address.";
      return;
    }
    if(amount.bad){
      clearOut("✗ Fix the amount first","tq-bad");
      elNote.textContent="No code is drawn while the amount is unreadable, so a wrong figure cannot end up encoded.";
      return;
    }
    if(amount.pending){
      clearOut("Waiting for the amount","tq-mut");
      elNote.textContent="The amount field is part way through a number. Finish it, or clear the field to let the payer choose what to send.";
      return;
    }
    validateAddr(raw).then(function(r){
      if(token!==run)return;
      if(r.err){
        clearOut("✗ Address rejected","tq-bad");
        elNote.innerHTML=esc(r.err)+' Use the <a href="/tools/validate">address validator</a> to find the mistake.';
        return;
      }
      var bare=elBare&&elBare.checked;
      var uri,q=[];
      if(bare){
        uri=r.addr;
      }else{
        uri="bitcoin:"+r.addr;
        if(!amount.empty&&amount.str)q.push("amount="+amount.str);
        var label=elLabel.value.replace(/\s+/g," ").replace(/^ | $/g,"");
        if(label)q.push("label="+encodeURIComponent(label));
        if(q.length)uri+="?"+q.join("&");
      }
      elUriLab.textContent=bare?"Text in the code":"BIP-21 URI in the code";

      var m=qrEncode(uri);
      if(!m){
        clearOut("✗ Too much to encode","tq-bad");
        elNote.textContent="Shorten the label. This encoder covers QR versions 1 to 10, which is well past what an address and an amount need.";
        return;
      }
      cur={m:m,uri:uri};
      elStatus.className="tq-status tq-ok";
      elStatus.textContent="✓ Code ready";
      var badges=[r.type,r.net,r.enc,"QR v"+m.v+", level M"];
      var html=badges.map(function(b){return "<span>"+esc(b)+"</span>";}).join("");
      if(r.net!=="mainnet")html+='<span class="tq-warn">'+esc(r.net)+" only</span>";
      elBadges.innerHTML=html;
      show(elBadges,true);
      show(elPlate,true);
      drawQR(m,elCv,stageTarget(),4);
      elCv.setAttribute("aria-label","QR code for "+uri);
      elEcho.innerHTML=echoHtml(r.addr);
      show(elEchoWrap,true);
      elUri.textContent=uri;
      show(elUriWrap,true);
      elNote.textContent=r.net==="mainnet"
        ?"A valid checksum proves the address is well formed, not that it belongs to who you think it does. Check the text below the code against its source."
        :"This is a "+r.net+" address. Coins on the main network cannot be sent to it.";
      elSv.textContent=String(m.v);
      elSs.textContent=m.size+" × "+m.size;
      elSb.textContent=String(m.bytes);
    });
  }

  elCopy.addEventListener("click",function(){
    if(!cur)return;
    var done=function(){
      elCopy.textContent="Copied";
      setTimeout(function(){elCopy.textContent="Copy URI";},1400);
    };
    if(navigator.clipboard&&navigator.clipboard.writeText)
      navigator.clipboard.writeText(cur.uri).then(done,function(){});
    else{
      var t=document.createElement("textarea");
      t.value=cur.uri;document.body.appendChild(t);t.select();
      try{document.execCommand("copy");done();}catch(e){}
      document.body.removeChild(t);
    }
  });
  /* Local canvas export, drawn larger than the on-screen copy so the file is
     usable in print. toDataURL touches no network. */
  elPng.addEventListener("click",function(){
    if(!cur)return;
    var off=document.createElement("canvas");
    drawQR(cur.m,off,(cur.m.size+8)*10,4);
    var a=document.createElement("a");
    a.href=off.toDataURL("image/png");
    a.download="bitcoin-payment-qr.png";
    document.body.appendChild(a);a.click();document.body.removeChild(a);
  });

  var rz=null;
  window.addEventListener("resize",function(){
    clearTimeout(rz);
    rz=setTimeout(function(){if(cur)drawQR(cur.m,elCv,stageTarget(),4);},180);
  });

  function bump(){clearTimeout(deb);deb=setTimeout(refresh,140);}
  elAddr.addEventListener("input",bump);
  elAmt.addEventListener("input",bump);
  elLabel.addEventListener("input",bump);
  if(elBare)elBare.addEventListener("change",function(){
    var on=elBare.checked;
    elAmt.disabled=on;elLabel.disabled=on;
    var bh=document.getElementById("tq-barehint");
    if(bh)bh.classList.toggle("tq-hide",!on);
    bump();
  });
  document.querySelectorAll(".tq-ex button").forEach(function(b){
    b.addEventListener("click",function(){
      elAddr.value=b.dataset.ex;
      refresh();
      elAddr.focus();
    });
  });

  /* Live price arrives via the chrome hook. It only moves the sanity-check
     line beside the amount; nothing in the encoded URI depends on it. */
  window.obPaintFiat=function(S){
    if(S&&isFinite(S.price)&&S.price>0){P.price=S.price;paintAmountHint(canonAmount(elAmt.value));}
  };

  /* Nothing is drawn until the self-test has passed. */
  selftest().then(function(fails){
    if(fails.length){
      READY=false;
      console.error("[/tools/qr] self-test FAILED: "+fails.join(", "));
      elStatus.className="tq-status tq-bad";
      elStatus.textContent="✗ Self-test failed";
      elNote.textContent="The encoder in this page did not reproduce its own known test vectors, so it will not draw a code that could be wrong. Nothing here is safe to scan; use another tool and report this page.";
      show(elBadges,false);show(elPlate,false);show(elEchoWrap,false);show(elUriWrap,false);
      elAddr.disabled=true;elAmt.disabled=true;elLabel.disabled=true;
      return;
    }
    READY=true;
    console.log("[/tools/qr] self-test passed: QR tables, GF(256), Reed-Solomon (ISO 18004 annex I), format and version bits, placement round trip, bech32, bech32m, base58check.");
    refresh();
  });
})();
</script>
</Base>
