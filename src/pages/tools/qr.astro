  /* Reed-Solomon divisor polynomial of the given degree: the product of
     (x - 2^i) for i in 0..degree-1, coefficients from second-highest term
     down to the constant term. */
  function rsDivisor(degree){
    var r=[],i,j;
    for(i=0;i<degree-1;i++)r.push(0);
    r.push(1);
    var root=1;
    for(i=0;i<degree;i++){
      for(j=0;j<r.length;j++){
        r[j]=gfMul(r[j],root);
        if(j+1<r.length)r[j]^=r[j+1];
      }
      root=gfMul(root,2);
    }
    return r;
  }
  function rsRemainder(data,div){
    var r=[],i,j;
    for(i=0;i<div.length;i++)r.push(0);
    for(i=0;i<data.length;i++){
      var factor=data[i]^r.shift();
      r.push(0);
      for(j=0;j<div.length;j++)r[j]^=gfMul(div[j],factor);
    }
