      if(v<7)return;
      var bits=versionBits(v),k,bit,aa,bbv;
      for(k=0;k<18;k++){
        bit=gb(bits,k);aa=size-11+(k%3);bbv=Math.floor(k/3);
        setF(aa,bbv,bit);setF(bbv,aa,bit);
