    finder(3,3);finder(size-4,3);finder(3,size-4);
    /* alignment patterns, skipping the three finder corners */
    var ap=ALIGN[v],n=ap.length,a,b,dx,dy;
    for(a=0;a<n;a++)for(b=0;b<n;b++){
      if((a===0&&b===0)||(a===0&&b===n-1)||(a===n-1&&b===0))continue;
      for(dy=-2;dy<=2;dy++)for(dx=-2;dx<=2;dx++)
        setF(ap[a]+dx,ap[b]+dy,Math.max(Math.abs(dx),Math.abs(dy))!==1);
    }
    function drawFormat(mask){
      var bits=formatBits(mask),k;
      for(k=0;k<=5;k++)setF(8,k,gb(bits,k));
      setF(8,7,gb(bits,6));
      setF(8,8,gb(bits,7));
      setF(7,8,gb(bits,8));
      for(k=9;k<15;k++)setF(14-k,8,gb(bits,k));
      for(k=0;k<8;k++)setF(size-1-k,8,gb(bits,k));
      for(k=8;k<15;k++)setF(8,size-15+k,gb(bits,k));
      setF(8,size-8,1);            /* the always dark module */
    }
