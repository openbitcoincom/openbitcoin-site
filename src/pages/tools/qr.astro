  /* Split into blocks, append the EC codewords to each block, then
     interleave block by block. Short blocks carry a padding byte during the
     interleave that is skipped on the way out. */
  function interleave(v,data){
    var nb=NBLK[v],ecLen=ECPB[v],raw=TOTAL[v];
    var shortLen=Math.floor(raw/nb),nShort=nb-(raw%nb);
    var div=rsDivisor(ecLen),blocks=[],i,k=0;
    for(i=0;i<nb;i++){
      var take=shortLen-ecLen+(i<nShort?0:1);
      var dat=data.slice(k,k+take);k+=take;
      var ecc=rsRemainder(dat,div);
      var blk=dat.slice();
      if(i<nShort)blk.push(0);
      blocks.push(blk.concat(ecc));
    }
    var out=[],j;
    for(i=0;i<blocks[0].length;i++){
      for(j=0;j<nb;j++){
        if(i!==shortLen-ecLen||j>=nShort)out.push(blocks[j][i]);
      }
