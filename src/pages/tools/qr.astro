          if(mods[y][x]===mods[y][x-1]){run++;if(run===5)p+=3;else if(run>5)p+=1;}
          else run=1;
        }
      }
      for(x=0;x<size;x++){
        run=1;
        for(y=1;y<size;y++){
          if(mods[y][x]===mods[y-1][x]){run++;if(run===5)p+=3;else if(run>5)p+=1;}
          else run=1;
        }
      }
      for(y=0;y<size-1;y++)for(x=0;x<size-1;x++){
        c=mods[y][x];
        if(c===mods[y][x+1]&&c===mods[y+1][x]&&c===mods[y+1][x+1])p+=3;
      }
      function scan(line){
        var t=0,q;
        for(q=0;q+11<=line.length;q++){
          seg=line.substr(q,11);
          if(seg==="10111010000"||seg==="00001011101")t+=40;
        }
        return t;
      }
      for(y=0;y<size;y++){s="";for(x=0;x<size;x++)s+=mods[y][x];p+=scan(s);}
      for(x=0;x<size;x++){s="";for(y=0;y<size;y++)s+=mods[y][x];p+=scan(s);}
      for(y=0;y<size;y++)for(x=0;x<size;x++)if(mods[y][x])dark++;
      k=Math.floor(Math.abs((dark*100/(size*size))-50)/5);
