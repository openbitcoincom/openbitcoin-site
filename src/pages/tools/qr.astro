  }

  /* Data codewords for a byte-mode message at the smallest version that
     fits. Returns null when the message is too long for version 10. */
  function makeDataCodewords(bytes){
    var v=0,i;
    for(i=1;i<=MAXV;i++){if(bytes.length<=capacity(i)){v=i;break;}}
    if(!v)return null;
    var cap=dataCodewords(v)*8,bb=[];
    function put(val,len){var k;for(k=len-1;k>=0;k--)bb.push((val>>>k)&1);}
    put(4,4);                       /* mode indicator 0100 = byte mode */
    put(bytes.length,cciBits(v));
    for(i=0;i<bytes.length;i++)put(bytes[i],8);
    for(i=0;i<4&&bb.length<cap;i++)bb.push(0);   /* terminator */
    while(bb.length%8!==0)bb.push(0);            /* to a byte boundary */
    var pad=[0xEC,0x11],p=0;
    while(bb.length<cap){put(pad[p&1],8);p++;}   /* pad codewords */
    var out=[],j,b;
    for(i=0;i<bb.length;i+=8){
      b=0;
      for(j=0;j<8;j++)b=(b<<1)|bb[i+j];
