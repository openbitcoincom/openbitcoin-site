        out+=row("uint16 LE",grp(String(b[0]|(b[1]<<8))),{cls:"hx-num"});
        out+=row("uint16 BE",grp(String((b[0]<<8)|b[1])),{cls:"hx-num"});
      }
      if(b.length===4){
        out+=row("uint32 LE",grp(String(((b[0]|(b[1]<<8)|(b[2]<<16))>>>0)+b[3]*16777216)),{cls:"hx-num"});
        out+=row("uint32 BE",grp(String(((b[3]|(b[2]<<8)|(b[1]<<16))>>>0)+b[0]*16777216)),{cls:"hx-num"});
      }
      if(b.length===8&&typeof BigInt!=="undefined"){
        var lo=BigInt(0),hi=BigInt(0),k,sats;
        for(k=7;k>=0;k--)lo=(lo*BigInt(256))+BigInt(b[k]);
        for(k=0;k<8;k++)hi=(hi*BigInt(256))+BigInt(b[k]);
        out+=row("uint64 LE",grp(lo.toString()),{cls:"hx-num"});
        out+=row("uint64 BE",grp(hi.toString()),{cls:"hx-num"});
        sats=lo.toString();
        while(sats.length<9)sats="0"+sats;
        out+=row("As BTC",grp(sats.slice(0,sats.length-8))+"."+sats.slice(sats.length-8),{cls:"hx-num"});
        out+=note("Transaction output amounts are exactly this: eight bytes of little endian satoshis, which is why the LE reading is the one a decoder uses.");
      }
      if(b.length===32)out+=note("Thirty-two bytes, so this is the length of a txid, a block hash or a merkle root, and the reversed line is the other way round from however you got it.");
      return Promise.resolve(out);
    }
  };

  function decodeB58(raw){
    var s=String(raw).trim();
    if(!s)return Promise.resolve(st("mut","Waiting for a base58 string")
      +note("Legacy addresses starting with 1 or 3, or testnet addresses starting with m, n or 2. Private keys are refused."));
    var b=b58decode(s);
    if(!b)return Promise.resolve(st("bad","Not base58")
      +note("Base58 leaves out the digit 0, capital O, capital I and lower case l, because they are easy to confuse. One of those, a space or a punctuation mark is in this string.",true));
    if(b.length<5)return Promise.resolve(st("bad","Too short")
      +note("A Base58Check string needs at least a version byte and a four-byte checksum.",true));
    var pre4=toHex(b.slice(0,4));
    if(B58SECRET[b[0]]||(XPREFIX[pre4]&&XPREFIX[pre4][1])){
      EL.b58d.i.value="";
      return Promise.resolve(st("bad","Refused: that is a private key")
        +note("The version byte says this is "+(B58SECRET[b[0]]||XPREFIX[pre4][0])+", so it was cleared and nothing was decoded. Anything that can spend coins belongs on an offline machine, never in a web page, and a key that has been pasted into a browser should be treated as spent already.",true));
    }
    var body=b.slice(0,b.length-4),tail=b.slice(b.length-4);
    return sha256d(body).then(function(c){
      var good=c[0]===tail[0]&&c[1]===tail[1]&&c[2]===tail[2]&&c[3]===tail[3];
      var out=good?st("ok","Checksum valid"):st("bad","Checksum fails");
      var xp=XPREFIX[pre4]&&b.length===82?XPREFIX[pre4][0]:null;
      var meta=B58VER[b[0]];
      out+=row("Total",plural(b.length,"byte")+", "+plural(s.length,"character")+" of base58",{cls:"hx-num"});
      if(xp){
        out+=row("Version",pre4+", "+xp);
        out+=row("Checksum",toHex(tail)+(good?", matches":", expected "+toHex(c.slice(0,4))));
        out+=note("The payload is not printed. An extended public key derives every address in a wallet, so pasting one anywhere exposes the whole history at once; treat it as private even though it cannot spend.");
        return out;
      }
      out+=row("Version",("0x"+(b[0]<16?"0":"")+b[0].toString(16))+", "+(meta?meta[0]+", "+meta[1]:"not a version bitcoin uses"));
      out+=row("Payload",toHex(body.slice(1)),{cls:"hx-key",copy:toHex(body.slice(1))});
      out+=row("Payload size",plural(body.length-1,"byte"),{cls:"hx-num"});
      out+=row("Checksum",toHex(tail)+(good?", matches the double SHA-256":", but the body hashes to "+toHex(c.slice(0,4))));
      if(good&&meta)out+=note("The payload is the "+meta[2]+".");
      else if(good)out+=note("The string is internally consistent, but that version byte is not one bitcoin assigns to an address.");
      else out+=note("One or more characters are wrong. Do not send anything to this string. The address validator can often point at the single character that changed.",true);
      return out;
    });
  }

  function decodeB32(raw){
    var s=String(raw).trim();
    if(!s)return st("mut","Waiting for a bech32 string")
      +note("Native segwit addresses starting with bc1q, taproot addresses starting with bc1p, or any other bech32 string you want the checksum checked on.");
    var r=bech32Parse(s);
    if(r&&r.err)return st("bad","Cannot parse")+note(r.err,true);
    var out=r.ok?st("ok","Checksum valid, "+r.enc):st("bad","Checksum fails");
    out+=row("Human part",r.hrp+(r.hrp==="bc"?", mainnet":(r.hrp==="tb"?", testnet":(r.hrp==="bcrt"?", regtest":""))),{cls:"hx-key"});
    out+=row("Encoding",r.enc?(r.enc==="bech32"?"bech32, checksum constant 1":"bech32m, checksum constant 0x2bc830a3"):"neither constant matches");
    out+=row("Data groups",plural(r.groups,"group")+" of 5 bits, plus a 6-character checksum",{cls:"hx-num"});
    if(!r.ok){
      out+=note("At least one character is wrong. Bech32 catches up to four such errors with certainty, so a failure here is real; do not send to this string.",true);
      return out;
    }
    if(r.prog){
      out+=row("Witness version",String(r.ver)+(r.ver===0?", segwit v0":(r.type==="P2TR"?", taproot":"")),{cls:"hx-num"});
      out+=row("Program",toHex(r.prog),{cls:"hx-key",copy:toHex(r.prog)});
      out+=row("Program size",plural(r.prog.length,"byte"),{cls:"hx-num"});
      out+=row("Script",r.script,{copy:r.script});
      out+=row("Type",r.type);
      if(!r.encOk)out+=note("Version "+r.ver+" must use "+(r.ver===0?"bech32":"bech32m")+", but this string uses "+r.enc+". BIP-350 split the two after a flaw was found in the original constant, and wallets reject the mismatch.",true);
      else if(r.len>90)out+=note("Longer than the 90 characters BIP-173 allows for an address, so the checksum guarantee no longer holds even though it matches here.",true);
      else out+=note("The script line is the scriptPubKey this address pays to: the witness version as an opcode, a push of the program length, then the program.");
    }else if(r.progErr){
      out+=note("The checksum is good, so this was typed correctly, but it is not a usable address: "+r.progErr+". A wallet would reject it.",true);
    }else{
      out+=note(r.len>90
        ? "The checksum is good, but the data does not decode as a witness program, and at "+r.len+" characters this is longer than an address. Lightning invoices and other bech32 payloads look like this."
        : "The checksum is good, but the data does not decode as a witness program, so this is bech32 carrying something other than an address.");
    }
    return out;
  }

  /* ---------- driving the cards ---------- */
  function runByteCard(id){
    if(failed||!ready)return;
    /* the token moves first, so a hash still in flight from an earlier
       keystroke can never paint over a refusal or an error below */
    var t=++TOK[id],raw=EL[id].i.value;
    if(MODE==="text"&&looksLikeSeed(raw)){
      EL[id].i.value="";
      if(FOLLOW[id]){IN.value="";shared();}
      showSeed();
      ++TOK[id];
      put(id,st("bad","Refused")+note("That looked like a recovery phrase, so it was cleared and nothing was computed.",true));
      count(id,"");
      return;
    }
    var r=toBytes(raw);
    if(r.err){put(id,st("bad","Cannot read the input")+note(r.err,true));count(id,"");return;}
    count(id,plural(r.bytes.length,"byte")+" in");
    CALC[id](r.bytes).then(function(html){
      if(t!==TOK[id])return;
      put(id,html);
    })["catch"](function(){
      if(t!==TOK[id])return;
      put(id,st("bad","Computation failed")+note("This browser refused to run the hash. crypto.subtle needs a secure context, which every visit to this site over https has.",true));
    });
  }
  function runStrCard(id){
    if(failed||!ready)return;
    if(id==="b32d"){put(id,decodeB32(EL[id].i.value));return;}
    var t=++TOK[id];
    decodeB58(EL[id].i.value).then(function(html){
      if(t!==TOK[id])return;
      put(id,html);
    });
  }
  function runAll(){
    BYTECARDS.forEach(runByteCard);
    STRCARDS.forEach(runStrCard);
  }
  function showSeed(){
    SEED.hidden=false;
    try{SEED.scrollIntoView({block:"nearest"});}catch(e){}
  }
  function shared(){
    var v=IN.value;
    if(MODE==="text"&&looksLikeSeed(v)){
      IN.value="";
      BYTECARDS.forEach(function(id){if(FOLLOW[id])EL[id].i.value="";});
      showSeed();
      CNT.textContent="0 bytes";
      BYTECARDS.forEach(runByteCard);
      return;
    }
    var r=toBytes(v);
    CNT.textContent=r.err?"unreadable":plural(r.bytes.length,"byte");
    BYTECARDS.forEach(function(id){
      if(FOLLOW[id])EL[id].i.value=v;
      runByteCard(id);
    });
  }
  function setFollow(id,on){
    FOLLOW[id]=on?1:0;
    EL[id].f.textContent=on?"following shared input":"own input";
    EL[id].f.classList.toggle("is-own",!on);
    var btn=document.querySelector('.hx-re[data-fn="'+id+'"]');
    if(btn)btn.hidden=!!on;
  }

  /* ---------- self-test ---------- */
  function fail(why){
    failed=true;
    console.error("[/tools/hash] self-test FAILED: "+why);
    FAILWHY.textContent="A check this page runs on load did not match its known answer ("+why
      +"). Rather than show a digest that might be wrong, every card has been switched off. Please tell us so it can be fixed.";
    FAILBOX.hidden=false;
    if(STLAB){STLAB.textContent="Self-test failed";STLAB.style.color="var(--down)";}
    if(STDESC)STDESC.textContent=why;
    ALL.forEach(function(id){
      EL[id].i.setAttribute("disabled","disabled");
      put(id,st("bad","Self-test failed")+note("This function is switched off until the page checks out against its known answers.",true));
      count(id,"");
    });
    IN.setAttribute("disabled","disabled");
    if(VER)VER.setAttribute("disabled","disabled");
    document.querySelectorAll(".hx-ex button, .hx-m, .hx-re").forEach(function(b){b.setAttribute("disabled","disabled");});
  }
  function selfTest(){
    var checks=0;
    function eq(name,got,want){
      checks++;
      if(String(got)!==String(want))throw new Error(name+": got "+got+", expected "+want);
    }
    if(!window.crypto||!crypto.subtle||!crypto.subtle.digest){
      fail("crypto.subtle is unavailable in this browser");
      return;
    }
    if(typeof TextEncoder==="undefined"){
      fail("TextEncoder is unavailable in this browser");
      return;
    }
    var T=function(s){return Array.prototype.slice.call(new TextEncoder().encode(s));};
    var PUB="0450863ad64a87ae8a2fe83c1af1a8403cb53f53e486d8511dad8a04887e5b23522cd470243453a299fa9e77237716103abc11a1df38855ed6f2ee187e9c582ba6";
    var MERKLE="3ba3edfd7a7b12b27ac72c3e67768f617fc81bc3888a51323a9fb8aa4b1e5e4a";
    try{
      /* RIPEMD-160, the vectors from the 1996 specification */
      eq('ripemd160("")',toHex(ripemd160(T(""))),"9c1185a5c5e9fc54612808977ee8f548b2258d31");
      eq('ripemd160("a")',toHex(ripemd160(T("a"))),"0bdc9d2d256b3ee9daae347be6f4dc835a467ffe");
      eq('ripemd160("abc")',toHex(ripemd160(T("abc"))),"8eb208f7e05d987a9b044a8e98c6b087f15a0bfc");
      eq('ripemd160("message digest")',toHex(ripemd160(T("message digest"))),"5d0689ef49d2fae572b881b123a85ffa21595f36");
      eq("ripemd160(alphabet)",toHex(ripemd160(T("abcdefghijklmnopqrstuvwxyz"))),"f71c27109c692c1b56bbdceb5b9d2865b3708dbc");
      eq("ripemd160(80 digits)",toHex(ripemd160(T("12345678901234567890123456789012345678901234567890123456789012345678901234567890"))),"9b752e45573d4b39f4dbd3323cab82bf63326bfb");
      /* base58 edge cases: leading zeros and the base itself */
      eq("b58encode([0])",b58encode([0]),"1");
      eq("b58encode([0,0,1])",b58encode([0,0,1]),"112");
      eq("b58encode([58])",b58encode([58]),"21");
      /* bech32 and bech32m, BIP-173 and BIP-350 */
      var w=bech32Parse("bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4");
      eq("BIP-173 encoding",w.enc,"bech32");
      eq("BIP-173 hrp",w.hrp,"bc");
      eq("BIP-173 witness version",w.ver,0);
      eq("BIP-173 program",toHex(w.prog),"751e76e8199196d454941c45d1b3a323f1433bd6");
      eq("BIP-173 script",w.script,"0014751e76e8199196d454941c45d1b3a323f1433bd6");
      eq("BIP-173 type",w.type,"P2WPKH");
      var p=bech32Parse("bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqzk5jj0");
      eq("BIP-350 encoding",p.enc,"bech32m");
      eq("BIP-350 witness version",p.ver,1);
      eq("BIP-350 program",toHex(p.prog),"79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798");
      eq("BIP-350 script",p.script,"512079be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798");
      eq("BIP-350 type",p.type,"P2TR");
      eq("tampered bech32 rejected",bech32Parse("bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t5").ok,false);
      eq("BIP-173 A12UEL5L valid",bech32Parse("A12UEL5L").ok,true);
      eq("BIP-173 A12UEL5L hrp",bech32Parse("A12UEL5L").hrp,"a");
      eq("mixed case rejected",!!bech32Parse("bc1QW508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4").err,true);
      /* byte order */
      eq("merkle root reversed",toHex(fromHex(MERKLE).reverse()),
        "4a5e1e4baab89f3a32518a88c31bc87f618f76673e2cc77ab2127b7afdeda33b");
      /* the seed guard has to actually fire */
      eq("seed guard fires",looksLikeSeed("abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"),true);
      eq("seed guard leaves prose alone",looksLikeSeed("the quick brown fox jumps over the lazy dog"),false);
    }catch(e){fail(e&&e.message?e.message:"an assertion failed");return;}
    /* the asynchronous half: SHA-256, HASH160 and both address formats */
    Promise.all([
      sha256(T("")),sha256(T("abc")),sha256d(T("")),sha256d(T("abc")),
      hash160(fromHex(PUB)),
      decodeB58("1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa"),
      decodeB58("3P14159f73E4gFr7JterCCQh9QjiTjiZrG"),
      decodeB58("1A1zP1eP5QGefi2DMPTfTL5SLmv7Divfna")
    ]).then(function(r){
      var h;
      eq('sha256("")',toHex(r[0]),"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
      eq('sha256("abc")',toHex(r[1]),"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
      eq('sha256d("")',toHex(r[2]),"5df6e0e2761359d30a8275058e299fcc0381534545f55cf43e41983f5d4c9456");
      eq('sha256d("abc")',toHex(r[3]),"4f8b42c22dd3729b519ba6f68d2da7cc5b2d606d05daed5ad5128cc03e6c6358");
      eq("hash160(public key)",toHex(r[4]),"010966776006953d5567439e5e39f86a0d273bee");
      /* the genesis address decodes, the P2SH one names its version, and a
         single wrong character has to be caught */
      eq("genesis address checksum",r[5].indexOf("Checksum valid")>=0,true);
      eq("genesis address payload",r[5].indexOf("62e907b15cbf27d5425399ebf6f0fb50ebb88f18")>=0,true);
      eq("genesis address version",r[5].indexOf("0x00, P2PKH address, mainnet")>=0,true);
      eq("P2SH address version",r[6].indexOf("0x05, P2SH address, mainnet")>=0,true);
      eq("one wrong character caught",r[7].indexOf("Checksum fails")>=0,true);
      /* base58check encode, round tripping the same hash160 back to 16UwLL... */
      var payload=[0].concat(Array.prototype.slice.call(r[4]));
      return sha256d(payload).then(function(c){
        h=b58encode(payload.concat([c[0],c[1],c[2],c[3]]));
        eq("base58check encode",h,"16UwLL9Risc3QfPqBUvKofHmBQ7wMtjvM");
        ready=true;
        console.log("[/tools/hash] self-test passed, "+checks+" checks (SHA-256 on the empty string and abc, double SHA-256, six RIPEMD-160 specification vectors, HASH160 and a Base58Check round trip to 16UwLL9Risc3QfPqBUvKofHmBQ7wMtjvM, genesis and P2SH address decode with a one-character tamper caught, BIP-173 and BIP-350 address decode, byte order flip)");
        if(STLAB)STLAB.textContent=checks+" checks passed";
        if(STDESC)STDESC.textContent="SHA-256 on the empty string and abc, double SHA-256, six RIPEMD-160 vectors from the specification, HASH160 and a Base58Check round trip, the genesis address decoded, BIP-173 and BIP-350 addresses decoded, and a byte order flip.";
        shared();
        STRCARDS.forEach(runStrCard);
      });
    })["catch"](function(e){fail(e&&e.message?e.message:"an assertion failed");});
  }

  /* ---------- wiring ---------- */
  var deb=null;
  IN.addEventListener("input",function(){
    SEED.hidden=true;
    clearTimeout(deb);
    deb=setTimeout(shared,120);
  });
  document.querySelectorAll(".hx-m").forEach(function(b){
    b.addEventListener("click",function(){
      MODE=b.dataset.m;
      document.querySelectorAll(".hx-m").forEach(function(x){x.classList.toggle("is-on",x===b);});
      IN.placeholder=MODE==="hex"?"616263":"abc";
      BYTECARDS.forEach(function(id){EL[id].i.placeholder=MODE==="hex"?"hex bytes":"text";});
      shared();
    });
  });
  document.querySelectorAll(".hx-ex button[data-ex]").forEach(function(b){
    b.addEventListener("click",function(){
      var ex=EX[b.dataset.ex];
      SEED.hidden=true;
      if(ex.mode!==MODE){
        var m=document.querySelector('.hx-m[data-m="'+ex.mode+'"]');
        MODE=ex.mode;
        document.querySelectorAll(".hx-m").forEach(function(x){x.classList.toggle("is-on",x===m);});
        IN.placeholder=MODE==="hex"?"616263":"abc";
        BYTECARDS.forEach(function(id){EL[id].i.placeholder=MODE==="hex"?"hex bytes":"text";});
      }
      IN.value=ex.v;
      BYTECARDS.forEach(function(id){setFollow(id,true);});
      shared();
    });
  });
  BYTECARDS.forEach(function(id){
    EL[id].i.addEventListener("input",function(){
      if(EL[id].i.value!==IN.value)setFollow(id,false);
      runByteCard(id);
    });
  });
  STRCARDS.forEach(function(id){
    EL[id].i.addEventListener("input",function(){runStrCard(id);});
  });
  document.querySelectorAll(".hx-re").forEach(function(b){
    b.addEventListener("click",function(){
      var id=b.dataset.fn;
      setFollow(id,true);
      EL[id].i.value=IN.value;
      runByteCard(id);
    });
  });
  VER.addEventListener("change",function(){runByteCard("b58e");});
  document.querySelectorAll("button[data-b58]").forEach(function(b){
    b.addEventListener("click",function(){
      EL.b58d.i.value=b.dataset.b58;
      runStrCard("b58d");
    });
  });
  document.querySelectorAll("button[data-b32]").forEach(function(b){
    b.addEventListener("click",function(){
      EL.b32d.i.value=b.dataset.b32;
      runStrCard("b32d");
    });
  });
  document.addEventListener("click",function(e){
    var b=e.target&&e.target.closest?e.target.closest(".hx-cp"):null;
    if(!b)return;
    var v=b.getAttribute("data-c"),label=b.textContent;
    function done(t){b.textContent=t;setTimeout(function(){b.textContent=label;},1200);}
    if(navigator.clipboard&&navigator.clipboard.writeText){
      navigator.clipboard.writeText(v).then(function(){done("copied");},function(){done("select it");});
    }else done("select it");
  });

  IN.value="abc";
  BYTECARDS.forEach(function(id){EL[id].i.placeholder="text";});
  selfTest();
})();
</script>
</Base>
