---
import Base from '../../../layouts/Base.astro';
import '../../../styles/doc.css';
import { fmtUsd, fmtPct, MONTH_NAMES } from '../../../lib/prices.js';
import { liveSeries } from '../../../lib/prices-live.js';
import HeroEmblem from '../../../components/HeroEmblem.astro';

export const prerender = false;

const S = await liveSeries();
const { year } = Astro.params;
if (!/^\d{4}$/.test(year) || !S.has(year)) return new Response(null, { status: 404, statusText: 'Not Found' });
const s = S.yearSummary(year);
const ms = S.monthsOf(year);
const ys = S.years();
const idx = ys.indexOf(year);
const prevY = idx > 0 ? ys[idx - 1] : null;
const nextY = idx < ys.length - 1 ? ys[idx + 1] : null;
const partialNote = year === ys[0]
  ? 'The series begins July 17, 2010, the first day a bitcoin price was quoted; the first weeks are computed from the preserved Mt. Gox trade log.'
  : (year === ys[ys.length - 1] ? 'The current year fills in day by day; each UTC day joins its month once the day completes.'
  : (s.closeOnly ? 'Months in the Mt. Gox era carry daily closes only; full open, high and low begin August 18, 2011.' : ''));
---
<Base title={`Bitcoin Price in ${year}: Daily and Monthly History - OpenBitcoin`} description={`The bitcoin price through ${year}: opened at $${fmtUsd(s.open)}, closed at $${fmtUsd(s.close)} (${fmtPct(s.changePct)}), high $${fmtUsd(s.high)}, low $${fmtUsd(s.low)}. Every month and every day, browsable.`}>
<main class="wrap doc-wrap">
  <div class="doc-head">
    <div class="doc-kicker"><a class="py-crumb" href="/price/calendar">Price calendar</a> / {year}</div>
    <h1>Bitcoin price in {year}</h1>
    <HeroEmblem name="calendar" />
    <p class="doc-lede">Bitcoin {s.changePct >= 0 ? 'gained' : 'lost'} {fmtPct(Math.abs(s.changePct)).replace('+','')} in {year}: from ${fmtUsd(s.open)} at the open to ${fmtUsd(s.close)} at the close. Pick a month for every day's prices.</p>
  </div>
  <div class="doc-grid">
  <div>
    
    <div class="py-nav py-mb">
      {prevY ? <a href={`/price/${prevY}`}>&#8592; {prevY}</a> : <span></span>}
      <a href="/price/calendar">All years</a>
      {nextY ? <a href={`/price/${nextY}`}>{nextY} &#8594;</a> : <span></span>}
    </div>
    <div class="py-stats">
      <div class="py-stat"><b>${fmtUsd(s.open)}</b><i>Year open</i></div>
      <div class="py-stat"><b>${fmtUsd(s.close)}</b><i>Year close</i></div>
      <div class="py-stat"><b>${fmtUsd(s.high)}</b><i>High</i></div>
      <div class="py-stat"><b>${fmtUsd(s.low)}</b><i>Low</i></div>
      <div class="py-stat"><b class={s.changePct >= 0 ? 'up' : 'down'}>{fmtPct(s.changePct)}</b><i>Change</i></div>
    </div>

    <div class="py-card py-mt">
      <div class="py-tlab">Every month of {year}</div>
      <div class="py-months">
        {ms.map((m) => { const mm = S.monthSummary(year, m); return (
          <a class={'py-month ' + (mm.changePct >= 0 ? 'was-up' : 'was-down')} href={`/price/${year}/${m}`}>
            <b>{MONTH_NAMES[parseInt(m, 10) - 1]}</b>
            <span class="py-mclose">${fmtUsd(mm.close)}</span>
            <span class={'py-mchg ' + (mm.changePct >= 0 ? 'up' : 'down')}>{fmtPct(mm.changePct)}</span>
            <span class="py-mhl">H ${fmtUsd(mm.high)} · L ${fmtUsd(mm.low)}</span>
          </a>
        ); })}
      </div>
      {partialNote && <p class="py-fine">{partialNote}</p>}
    </div>

  </div>
  <aside class="doc-rail">
    <div class="doc-tile">
      <div class="doc-tlab">Related</div>
      <nav>
        <a href="/price">Bitcoin price now</a>
        <a href="/tools/price-on-date">Price on a date lookup</a>
        <a href="/ath">All-time high</a>
        <a href="/history">The timeline</a>
      </nav>
    </div>
  </aside>
  </div>
</main>
<style is:global>
  .py-crumb{color:var(--acc);text-decoration:none}
  .py-crumb:hover{text-decoration:underline}
  .py-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px}
  .py-stat{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px 14px;min-width:0}
  .py-stat b{display:block;font:700 17px var(--mono);color:var(--ink);font-variant-numeric:tabular-nums}
  .py-stat b.up{color:var(--up)}
  .py-stat b.down{color:var(--down)}
  .py-stat i{display:block;font:600 9px var(--mono);letter-spacing:.11em;text-transform:uppercase;color:var(--ink-3);font-style:normal;margin-top:3px}
  .py-card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:20px 24px 22px}
  .py-mt{margin-top:14px}
  .py-mb{margin-bottom:14px}
  .py-tlab{font:700 9.5px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);margin-bottom:12px}
  .py-months{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
  .py-month{display:block;background:var(--field);border:1px solid var(--line-2);border-radius:10px;padding:11px 13px;
    text-decoration:none;min-width:0;text-align:center}
  
  .py-month.was-up{background:rgba(46,189,133,.07);border-color:rgba(46,189,133,.30)}
  .py-month.was-down{background:rgba(246,70,93,.06);border-color:rgba(246,70,93,.28)}
  .py-month:hover{border-color:rgba(255,166,60,.45)}
  .py-month b{display:block;font:700 17px var(--sans);color:var(--ink);margin-bottom:2px}
  .py-mclose{display:block;font:700 13px var(--mono);color:var(--ink);font-variant-numeric:tabular-nums;margin-top:4px}
  .py-mchg{display:inline-block;font:700 10.5px var(--mono);font-variant-numeric:tabular-nums;margin-top:2px}
  .py-mchg.up{color:var(--up)}
  .py-mchg.down{color:var(--down)}
  .py-mhl{display:block;font:600 9.5px var(--mono);color:var(--ink-3);font-variant-numeric:tabular-nums;margin-top:3px}
  .py-fine{font:500 11.5px/1.6 var(--sans);color:var(--ink-3);margin:12px 0 0}
  .py-nav{display:flex;justify-content:space-between;gap:10px}
  .py-nav a{font:700 12px var(--mono);letter-spacing:.05em;color:var(--acc);text-decoration:none;
    background:var(--panel);border:1px solid var(--line);border-radius:9px;padding:9px 14px}
  .py-nav a:hover{border-color:rgba(255,166,60,.45)}
  @media(max-width:700px){
    .py-card{padding:18px 16px}
    .py-months{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
</style>
</Base>
