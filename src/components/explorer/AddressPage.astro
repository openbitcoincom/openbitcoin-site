/* Confirmation counts on the transaction cards. The rows carry their block
   height; the count needs the chain tip, which the page never fabricates: each
   card ships an ellipsis and fills in only once a real tip arrives, from the
   chrome's live summary (window.OB_LIVE) or its repaint hook. With no live
   data the ellipsis simply stays. */
(function(){
  var els=document.querySelectorAll(".confn[data-h]");
  if(!els.length)return;
  function fill(h){
    if(typeof h!=="number"||!isFinite(h))return;
    els.forEach(function(n){
      var bh=Number(n.getAttribute("data-h"));
      if(!isFinite(bh)||bh<0||h<bh)return;
      n.textContent=(h-bh+1).toLocaleString("en-US");
    });
  }
  window.obPaintFiat=function(S){if(S)fill(S.height);};
  document.addEventListener("DOMContentLoaded",function(){
    if(window.OB_LIVE)fill(window.OB_LIVE.height);
  });
})();

/* Balance-history tab. Fetch waits for DOMContentLoaded because Base sets
   window.OB_DATA_API in a script at the end of <body>. The tab only appears
   when the API says available with 2+ points; any failure, available:false,
   or a short history leaves the page exactly as shipped. */
(function(){
  var MON=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  function initBalanceChart(points,asOf){
    var HIST=points.map(function(p){return[p[0],p[1]/1e8];});
    var tab=document.getElementById("charttab"),
        chartwrap=document.getElementById("chartwrap"),
        cv=document.getElementById("bchart"),
        txwrap=document.getElementById("txwrap"),
        pager=document.getElementById("pager"),
        filter=document.getElementById("txtabs");
    if(!tab||!chartwrap||!cv||!txwrap)return;

    /* mini sparkline teaser inside the tab button: thin orange line, every
       4th point plus the last, proto style */
    (function(){
      var s=document.getElementById("sparkcv");if(!s)return;
      var c=s.getContext("2d"),w=s.width,h=s.height;
      var pts=HIST.filter(function(p,i){return i%4===0||i===HIST.length-1;}).map(function(p){return p[1];});
      if(pts.length<2)pts=HIST.map(function(p){return p[1];});
      var hi=0;pts.forEach(function(p){if(p>hi)hi=p;});
      if(!hi)hi=1;
      c.strokeStyle="#F7931A";c.lineWidth=1.5;c.lineJoin="round";c.beginPath();
      pts.forEach(function(p,i){
        var x2=2+i*(w-4)/(pts.length-1),y2=h-2-(p/hi)*(h-4);
        i?c.lineTo(x2,y2):c.moveTo(x2,y2);
      });
      c.stroke();
    })();
    tab.style.display="";

    /* big chart: balance is a step function, hold each value until the next
       point, then extend the last value to now */
    var hoverX=null;
    function fmtBal(v){return v>=100?v.toFixed(2):v>=1?v.toFixed(4):v.toFixed(8);}
    function fmtAxis(v){return v>=1000?Math.round(v).toLocaleString("en-US"):v>=10?v.toFixed(1):v>=1?v.toFixed(2):v>=0.01?v.toFixed(4):v.toFixed(6);}
    function dayLabel(t){var d=new Date(t*1000);return MON[d.getUTCMonth()]+" "+d.getUTCDate()+", "+d.getUTCFullYear();}
    function drawChart(){
      var cs=getComputedStyle(document.documentElement),
          acc=(cs.getPropertyValue("--orange")||"#F7931A").trim(),
          grid=(cs.getPropertyValue("--line")||"#332C23").trim(),
          ink3=(cs.getPropertyValue("--ink-3")||"#877C6B").trim(),
          line2=(cs.getPropertyValue("--line-2")||"#4A4033").trim(),
          rgb=(cs.getPropertyValue("--acc-rgb")||"247,147,26").trim();
      var dpr=window.devicePixelRatio||1,w=cv.clientWidth,h=cv.clientHeight;
      if(!w||!h)return;
      cv.width=Math.round(w*dpr);cv.height=Math.round(h*dpr);
      var x=cv.getContext("2d");x.setTransform(dpr,0,0,dpr,0,0);
      var last=HIST[HIST.length-1],
          t0=HIST[0][0],
          tN=Math.max(last[0]+1,asOf||Math.floor(Date.now()/1000)),
          span=Math.max(1,tN-t0);
      var axis=18,ph=h-axis,pad=8;
      var hi=0;HIST.forEach(function(p){if(p[1]>hi)hi=p[1];});hi=hi>0?hi*1.12:1;
      x.font="600 9.5px ui-monospace,Consolas,monospace";
      var gut=46;
      [0.25,0.5,0.75,1].forEach(function(f){
        var lw=x.measureText(fmtAxis(hi*f)).width+12;if(lw>gut)gut=lw;
      });
      var pw=w-gut;
      function px(t){return ((t-t0)/span)*pw;}
      function py(v){return pad+(1-v/hi)*(ph-pad*2);}
      x.textAlign="left";
      [0.25,0.5,0.75,1].forEach(function(f){
        var v=hi*f,yy=py(v);
        x.strokeStyle=grid;x.globalAlpha=.45;x.lineWidth=1;
        x.beginPath();x.moveTo(0,yy);x.lineTo(pw,yy);x.stroke();x.globalAlpha=1;
        x.fillStyle=ink3;x.fillText(fmtAxis(v),pw+6,yy+3);
      });
      function trace(){
        x.beginPath();x.moveTo(px(HIST[0][0]),py(HIST[0][1]));
        for(var i=1;i<HIST.length;i++){
          x.lineTo(px(HIST[i][0]),py(HIST[i-1][1]));
          x.lineTo(px(HIST[i][0]),py(HIST[i][1]));
        }
        x.lineTo(pw,py(last[1]));
      }
      trace();x.lineTo(pw,ph);x.lineTo(px(HIST[0][0]),ph);x.closePath();
      var g=x.createLinearGradient(0,0,0,ph);
      g.addColorStop(0,"rgba("+rgb+",.22)");g.addColorStop(1,"rgba("+rgb+",0)");
      x.fillStyle=g;x.fill();
      trace();
      x.strokeStyle=acc;x.lineWidth=2.2;x.lineJoin="round";
      x.shadowColor="rgba("+rgb+",.5)";x.shadowBlur=6;x.stroke();x.shadowBlur=0;
      x.beginPath();x.arc(pw-2,py(last[1]),3.6,0,7);x.fillStyle=acc;x.fill();
      /* x axis: year labels for long spans, month labels otherwise
         (January shows the year instead of "Jan") */
      x.textAlign="center";x.fillStyle=ink3;
      var ticks=[],d0=new Date(t0*1000);
      if(span>730*86400){
        var y0=d0.getUTCFullYear()+1,y1=new Date(tN*1000).getUTCFullYear(),
            ystep=Math.max(1,Math.ceil((y1-y0+1)/7));
        for(var y=y0;y<=y1;y+=ystep)ticks.push([Date.UTC(y,0,1)/1000,String(y)]);
      }else{
        var my=d0.getUTCFullYear(),mm=d0.getUTCMonth()+1;
        if(mm>11){mm=0;my++;}
        var months=Math.ceil(span/(30.44*86400)),mstep=months>21?3:months>7?2:1;
        /* align to multiples of the step so January, which carries the year
           label, always lands on the grid */
        while(mm%mstep){mm++;if(mm>11){mm=0;my++;}}
        for(;;){
          var tt=Date.UTC(my,mm,1)/1000;
          if(tt>=tN)break;
          if(tt>t0)ticks.push([tt,mm===0?String(my):MON[mm]]);
          mm+=mstep;while(mm>11){mm-=12;my++;}
        }
      }
      ticks.forEach(function(tk){
        var xx=px(tk[0]);
        if(xx>18&&xx<pw-34)x.fillText(tk[1],xx,h-4);
      });
      x.fillText("now",pw-14,h-4);
      if(hoverX!=null&&hoverX>=0&&hoverX<=pw){
        var tm=t0+(hoverX/pw)*span,v=HIST[0][1];
        for(var i3=0;i3<HIST.length;i3++){if(HIST[i3][0]<=tm)v=HIST[i3][1];else break;}
        x.strokeStyle=line2;x.lineWidth=1;
        x.beginPath();x.moveTo(hoverX,0);x.lineTo(hoverX,ph);x.stroke();
        var yy2=py(v);
        x.beginPath();x.arc(hoverX,yy2,4.2,0,7);x.fillStyle=acc;x.fill();
        x.lineWidth=2;x.strokeStyle="#1C2840";x.beginPath();x.arc(hoverX,yy2,4.2,0,7);x.stroke();
        var lab=fmtBal(v)+" BTC · "+dayLabel(tm);
        x.font="700 11px ui-monospace,Consolas,monospace";
        var tw=x.measureText(lab).width+16,tx2=Math.max(4,Math.min(pw-tw-4,hoverX-tw/2));
        x.fillStyle="#1C2840";x.strokeStyle="#2C3A55";x.lineWidth=1;
        x.beginPath();
        if(x.roundRect)x.roundRect(tx2,4,tw,20,5);else x.rect(tx2,4,tw,20);
        x.fill();x.stroke();
        x.fillStyle="#DCE3EF";x.textAlign="left";x.fillText(lab,tx2+8,18);
      }
    }
    cv.addEventListener("mousemove",function(e){
      var rc=cv.getBoundingClientRect();hoverX=e.clientX-rc.left;drawChart();});
    cv.addEventListener("mouseleave",function(){hoverX=null;drawChart();});
    window.addEventListener("resize",function(){
      if(chartwrap.style.display==="block")drawChart();});

    /* tab switch: BALANCE HISTORY swaps the tx list, its filter and pager
       for the chart; TRANSACTIONS restores stylesheet defaults */
    var stabs=document.querySelectorAll("#secttabs button");
    stabs.forEach(function(b){
      b.addEventListener("click",function(){
        stabs.forEach(function(z){z.classList.remove("on");});
        b.classList.add("on");
        var t=b.getAttribute("data-t");
        chartwrap.style.display=t==="chart"?"block":"none";
        txwrap.style.display=t==="chart"?"none":"";
        if(pager)pager.style.display=t==="chart"?"none":"";
        if(filter)filter.style.display=t==="chart"?"none":"";
        if(t==="chart")requestAnimationFrame(drawChart);
      });
    });
  }

  document.addEventListener("DOMContentLoaded",function(){
    var api=(typeof window.OB_DATA_API==="string"&&window.OB_DATA_API)?window.OB_DATA_API:"/api/v1";
    var el=document.getElementById("addr");if(!el)return;
    var addr=el.textContent.trim(),tries=0,shown=false;
    /* big addresses are computed by a background worker on first visit; while
       the API says computing we poll, so the tab appears mid-visit rather
       than on the next reload. 24 polls x 10s covers ~15k transactions. */
    function take(j){
      if(!j)return;
      if(j.available===true&&Array.isArray(j.points)&&j.points.length>=2){
        /* asOf is an ISO string from the API; the numeric epoch stays as a
           fallback in case that ever changes back */
        var asOf=null;
        if(typeof j.asOf==="string"){
          var ms=Date.parse(j.asOf);
          if(isFinite(ms))asOf=Math.floor(ms/1000);
        }else if(typeof j.asOf==="number"&&isFinite(j.asOf))asOf=j.asOf;
        if(!shown){shown=true;initBalanceChart(j.points,asOf);}
        if(!j.computing)return;   /* stale-but-shown: keep polling for the rebuild */
      }
      if(j.computing&&tries<24){
        tries+=1;
        setTimeout(load,10000);
      }
    }
    function load(){
      fetch(api+"/address/"+encodeURIComponent(addr)+"/balance-history",{cache:"no-store"})
        .then(function(r){if(!r.ok)throw new Error("http "+r.status);return r.json();})
        .then(take).catch(function(){});
    }
    load();
  });
})();
</script>

