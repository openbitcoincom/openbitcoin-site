---
import { fmtInt, fmtBtc, utcStamp, agoText } from '../../lib/explorer.js';
const { a, txPage, usdNow, dir = null, compact = false } = Astro.props;

const balSat = a.confirmedSat + (a.unconfirmedSat || 0);
const fiat = usdNow != null ? (balSat / 1e8) * usdNow : null;
const fmtUsd = (v) => '$' + Math.round(v).toLocaleString('en-US');
const fmtVal = (v) => v >= 1 ? '$' + Math.round(v).toLocaleString('en-US')
  : v >= 0.01 ? '$' + v.toFixed(2)
  : '< $0.01';
const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const ELL = '…';
const dateShort = (unix) => {
  const d = new Date(unix * 1000);
  return `${MON[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
};
const whenText = (unix) => {
  if (Math.floor(Date.now() / 1000) - unix < 3 * 86400) return agoText(unix);
  const d = new Date(unix * 1000);
  return `${MON[d.getUTCMonth()]} ${String(d.getUTCDate()).padStart(2, '0')}, ${d.getUTCFullYear()}`;
};
const orEll = (n) => n != null ? fmtInt(n) : ELL;
const TYPE_TAG = {
  witness_v0_keyhash: 'P2WPKH', witness_v0_scripthash: 'P2WSH', witness_v1_taproot: 'P2TR',
  pubkeyhash: 'P2PKH', scripthash: 'P2SH', pubkey: 'P2PK', nulldata: 'OP_RETURN', multisig: 'BARE MULTISIG',
};
const typeTag = (ty) => TYPE_TAG[ty] || (ty ? String(ty).toUpperCase() : 'UNKNOWN');
const mkPath = (p, d = dir, c = compact) =>
  `/${a.address}${d ? (d === 'in' ? '/received' : '/sent') : ''}${c ? '/compact' : ''}${p > 1 ? `/${p}` : ''}`;
const viewHref = (mode) => mkPath(1, dir, mode === 'compact');
const txs = Array.isArray(txPage?.txs) ? txPage.txs : [];
const curPage = Number(txPage?.page) || 1;
const totPages = Number(txPage?.pages) || 0;
const latestOnly = txPage?.latestOnly === true;
const pageHref = (p) => mkPath(p);
---
<main class="wrap apage">
  <section class="card ahero">
    <div class="rrow">
      <div class="rmain">
        <span class="micro">Bitcoin address</span>
        <div class="addr-line"><code id="addr">{a.address}</code>
          <button class="cico" id="copybtn" type="button" title="Copy address" aria-label="Copy address">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2.5"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
          </button></div>
        <span class="micro" style="display:block;margin-top:20px">Balance</span>
        <div class={'bal' + (a.unconfirmedSat !== 0 ? ' unconf' : '')}>{fmtBtc(balSat)}<em>BTC</em></div>
        {fiat != null && <div class="bfiat">&#8776; {fmtUsd(fiat)} USD</div>}
        {a.unconfirmedSat !== 0 && (
          <div class="pendline unconf"><b>{a.unconfirmedSat > 0 ? '+' : ''}{fmtBtc(a.unconfirmedSat)} BTC pending</b>{a.mempoolCount > 0 ? <span>&nbsp;· {fmtInt(a.mempoolCount)} tx in mempool</span> : null}</div>
        )}
        <div class="ah-stats">
          {a.totalReceivedSat != null && (
            <span class="ast ast-btc"><b><span class="arr up" aria-hidden="true">&darr;</span>{fmtBtc(a.totalReceivedSat)}<em>BTC</em></b><i>Total received</i></span>
          )}
          {a.totalSentSat != null && (
            <span class="ast ast-btc"><b><span class="arr dn" aria-hidden="true">&uarr;</span>{fmtBtc(a.totalSentSat)}<em>BTC</em></b><i>Total sent</i></span>
          )}
          <span class="ast"><b>{orEll(a.txCount)}</b><i>Transactions</i></span>
          <span class="ast"><b>{orEll(a.utxoCount)}</b><i>Unspent outputs</i></span>
          {a.firstSeen?.time && <span class="ast"><b>{dateShort(a.firstSeen.time)}</b><i>First seen</i></span>}
          {a.lastActivity?.time && (
            <span class="ast"><b>{agoText(a.lastActivity.time)}</b><i>Last activity</i></span>
          )}
        </div>
        {a.historyTruncated === true && (
          a.totalReceivedSat != null
            ? <p class="truncnote">Too many transactions to list one by one; the balance, totals and count above are complete, from our full-chain index.</p>
            : <p class="truncnote">History is longer than the index returns; totals may be incomplete.</p>
        )}
      </div>
      <div class="arail">
        <div class="qrtile"><span class="qrbox"><canvas id="qrcv" width="444" height="444" data-addr={a.address}></canvas></span>
          <div class="qcap">Scan address</div></div>
        <div class="abadges"><i>{a.typeLabel}</i></div>
      </div>
    </div>
    <div class="cstrip">
      <div class="sgrp">
        <div class="tgl" id="secttabs">
          <button type="button" class="on" data-t="tx">TRANSACTIONS · {orEll(a.txCount)}</button>
          <button type="button" data-t="chart" id="charttab" style="display:none">BALANCE HISTORY <canvas class="spark" id="sparkcv" width="56" height="16"></canvas></button>
        </div>
        <div class="acheck">
          <a class="cbtn" href={`https://www.chainabuse.com/address/${a.address}`} target="_blank" rel="nofollow noopener">SCAM REPORTS <span class="extm">&#8599;</span></a>
        </div>
      </div>
      <a class="cchip" href="#discussion">COMMENTS <span class="extm">&#8595;</span></a>
    </div>
  </section>

  <section class="card acard">
    <div class="sect-head">
      <div class="live-toggle" id="txtabs">
        <a class={dir ? undefined : 'on'} href={mkPath(1, null, compact)}>All</a>
        <a class={dir === 'in' ? 'on' : undefined} href={mkPath(1, 'in', compact)}>Received</a>
        <a class={dir === 'out' ? 'on' : undefined} href={mkPath(1, 'out', compact)}>Sent</a>
        <a class="lt-view" href={viewHref(compact ? 'full' : 'compact')}>{compact ? 'Full' : 'Compact'}</a>
      </div>
    </div>
    <div id="chartwrap"><canvas id="bchart"></canvas></div>
    <div id="txwrap">
      {compact ? txs.map((t) => {
        // compact row: the full txid and the signed amount, nothing else
        const d = t.deltaSat;
        const sign = t.dir === 'in' ? '+' : t.dir === 'out' ? '−' : '';
        const cls = t.dir === 'in' ? 'up' : t.dir === 'out' ? 'dn' : '';
        return (
          <div class="cmrow">
            <span class="cmleft">
              <a class="cmid" href={`/${t.txid}`}>{t.txid}</a>
              <span class="cmwhen">{t.height != null ? `Block ${fmtInt(t.height)}` : 'PENDING'}{t.time ? ` · ${utcStamp(t.time)}` : ''}</span>
            </span>
            {d != null && <span class={`cmamt ${cls}`}>{sign}{fmtBtc(Math.abs(d))}<em>BTC</em></span>}
          </div>
        );
      }) : txs.map((t) => {
        // one card per transaction: direction badge, txid, stamp, signed
        // amount, both sides of the transaction, then the meta line
        const pending = t.height == null;
        const d = t.deltaSat;
        const dirCls = d == null ? '' : t.dir === 'in' ? ' in' : t.dir === 'out' ? ' out' : ' self';
        const glyph = t.dir === 'in' ? '↓' : t.dir === 'out' ? '↑' : '↻';
        const dirWord = t.dir === 'in' ? 'Received' : t.dir === 'out' ? 'Sent' : 'Self transfer';
        const sign = t.dir === 'in' ? '+' : t.dir === 'out' ? '−' : '';
        const btc = d == null ? null : Math.abs(d) / 1e8;
        const rate = t.feeSat != null && t.vsize ? Math.round((t.feeSat / t.vsize) * 10) / 10 : null;
        const valThen = t.usdThen != null && btc != null ? btc * t.usdThen : null;
        const valNow = usdNow != null && btc != null ? btc * usdNow : null;
        const ins = Array.isArray(t.ins) ? t.ins : [];
        const outs = Array.isArray(t.outs) ? t.outs : [];
        const insTotal = t.insTotal != null ? t.insTotal : ins.length;
        const outsTotal = t.outsTotal != null ? t.outsTotal : outs.length;
        // a side total is only real when every leg of that side is on this
        // card and carries a value; otherwise the header shows the count alone
        const insSum = ins.length === insTotal && ins.length > 0 && ins.every((x) => !x.coinbase && x.valueSat != null)
          ? ins.reduce((s, x) => s + x.valueSat, 0) : null;
        const outsSum = outs.length === outsTotal && outs.length > 0 && outs.every((x) => x.valueSat != null)
          ? outs.reduce((s, x) => s + x.valueSat, 0) : null;
        return (
        <div class={`txc${dirCls}${pending ? ' pend' : ''}`}>
          <div class="txc-h">
            {d != null && <span class="dir" role="img" aria-label={dirWord}>{glyph}</span>}
            <a class="txid" href={`/${t.txid}`}>{t.txid}</a>
            {pending
              ? <span class="pendpill"><span class="pdot" aria-hidden="true"></span>UNCONFIRMED · IN MEMPOOL</span>
              : t.time ? <span class="txc-when" title={utcStamp(t.time)}>{whenText(t.time)}</span> : null}
            {btc != null && <span class="txc-amt">{sign}{fmtBtc(Math.abs(d))} BTC</span>}
          </div>
          {(ins.length > 0 || outs.length > 0) && (
          <div class="txc-io">
            <div class="txd-col">
              <h4>{fmtInt(insTotal)} input{insTotal === 1 ? '' : 's'} {insSum != null && <b>{fmtBtc(insSum)} BTC</b>}</h4>
              {ins.map((i) => (
                <div class={i.mine ? 'iorow me' : 'iorow'}>
                  <span class="io-l">
                    {i.coinbase
                      ? <span class="a" style="cursor:default">Coinbase (newly created coins)</span>
                      : i.address
                        ? <a class="a" href={`/${i.address}`}>{i.address}</a>
                        : <span class="a" style="cursor:default;color:var(--ink-3)">Input details arrive with confirmation</span>}
                    {i.coinbase && <span class="iotag mine">BLOCK REWARD</span>}
                    {i.mine && <span class="iotag">THIS ADDRESS</span>}
                  </span>
                  {i.valueSat != null && <span class="v">{fmtBtc(i.valueSat)} BTC</span>}
                </div>
              ))}
              {insTotal > ins.length && (
                <div class="iomore">Showing {fmtInt(ins.length)} of {fmtInt(insTotal)} inputs · <a href={`/${t.txid}`}>see the transaction</a></div>
              )}
            </div>
            <div class="txd-arrow" aria-hidden="true">&rarr;</div>
            <div class="txd-col">
              <h4>{fmtInt(outsTotal)} output{outsTotal === 1 ? '' : 's'} {outsSum != null && <b>{fmtBtc(outsSum)} BTC</b>}</h4>
              {outs.map((o) => (
                <div class={o.mine ? 'iorow me' : 'iorow'}>
                  <span class="io-l">
                    {o.address
                      ? <a class="a" href={`/${o.address}`}>{o.address}</a>
                      : <span class="a" style="cursor:default">{typeTag(o.type)}</span>}
                    {o.mine
                      ? <span class="iotag">{t.dir === 'out' ? 'CHANGE · THIS ADDRESS' : 'THIS ADDRESS'}</span>
                      : o.type === 'nulldata' ? <span class="iotag">DATA</span> : null}
                  </span>
                  {o.valueSat != null && <span class="v">{fmtBtc(o.valueSat)} BTC</span>}
                </div>
              ))}
              {outsTotal > outs.length && (
                <div class="iomore">Showing {fmtInt(outs.length)} of {fmtInt(outsTotal)} outputs · <a href={`/${t.txid}`}>see the transaction</a></div>
              )}
            </div>
          </div>
          )}
          <div class="txc-meta">
            {t.feeSat != null && <span>Fee <b>{fmtInt(t.feeSat)} sats</b></span>}
            {rate != null && <span><b>{rate} sat/vB</b></span>}
            {t.height != null && <span>Block <b>{fmtInt(t.height)}</b></span>}
            {t.height != null
              ? <span><b class="confn" data-h={t.height}>{ELL}</b> conf</span>
              : <span><b>0</b> conf · est. next block</span>}
            {(valThen != null || valNow != null) && (
              <span class="txc-vals">value {valThen != null && <b>{fmtVal(valThen)} then</b>}{valThen != null && valNow != null && ' · '}{valNow != null && <b class="now">{fmtVal(valNow)} now</b>}</span>
            )}
          </div>
        </div>
        );
      })}
      {txs.length === 0 && (
        <p class="txempty">{a.historyUnavailable && a.txCount > 0
          ? `This address has ${fmtInt(a.txCount)} transactions, more than the transaction lister can walk. The balance and lifetime totals above are complete.`
          : dir
            ? 'No transactions match this filter.'
            : a.txCount === 0
              ? 'No transactions yet. This address has never appeared on the blockchain.'
              : 'No transactions on this page.'}</p>
      )}
    </div>
    {latestOnly && txs.length > 0 && (
      <p class="txempty">Latest {fmtInt(txs.length)} transactions, read from the newest blocks. The full history of {fmtInt(a.txCount)} is beyond per-transaction listing; the totals above cover all of it.</p>
    )}
    {!latestOnly && (txs.length > 0 || curPage > 1) && (
    <div class="pager" id="pager">
      {curPage > 1 ? <a class="pbtn" href={pageHref(curPage - 1)}>&lsaquo; PREV</a> : <span class="pbtn" aria-disabled="true">&lsaquo; PREV</span>}
      <span class="pinfo">Page <b>{fmtInt(curPage)}</b>{totPages > 0 ? <Fragment> of <b>{fmtInt(totPages)}</b></Fragment> : null}</span>
      {curPage < totPages ? <a class="pbtn" href={pageHref(curPage + 1)}>NEXT &rsaquo;</a> : <span class="pbtn" aria-disabled="true">NEXT &rsaquo;</span>}
    </div>
    )}
  </section>

  <section class="card acard" id="discussion">
    <span class="micro">Comments</span>
    <p class="cmt-note">No account needed. Comments are reviewed before public listing. Plain text; no links to scams.</p>
    <script is:inline defer src="/comments/comentario.js"></script>
    <comentario-comments theme="dark" no-fonts="true"></comentario-comments>
  </section>
</main>

<script is:inline>
(function(){
  var cb=document.getElementById("copybtn");
  if(cb)cb.addEventListener("click",function(){
    try{navigator.clipboard.writeText(document.getElementById("addr").textContent).then(function(){
      cb.classList.add("ok");setTimeout(function(){cb.classList.remove("ok");},1200);
    });}catch(e){}
  });
  /* The All/Received/Sent tabs are plain links to ?dir=in / ?dir=out; the
     API filters and pages, so there is no client-side row hiding here. */

  /* QR: byte mode, ECC H, mask 0; smallest version 5-10 whose ECC-H data
     capacity fits the payload (44/58/64/84/98/119 bytes). Verified
     module-identical to the python qrcode reference at versions 5 to 10. */
  function qrMatrix(data){
    var EXP=new Array(512),LOG=new Array(256),x=1,i,j;
    for(i=0;i<255;i++){EXP[i]=x;LOG[x]=i;x<<=1;if(x&256)x^=0x11d;}
    for(i=255;i<512;i++)EXP[i]=EXP[i-255];
    function polyMul(a,b){var r=new Array(a.length+b.length-1).fill(0);
      for(var p=0;p<a.length;p++)for(var q=0;q<b.length;q++){if(a[p]&&b[q])r[p+q]^=EXP[(LOG[a[p]]+LOG[b[q]])%255];}
      return r;}
    function rsEcc(d,n){var g=[1];for(var p=0;p<n;p++)g=polyMul(g,[1,EXP[p]]);
      var buf=d.concat(new Array(n).fill(0));
      for(var p=0;p<d.length;p++){var c0=buf[p];if(!c0)continue;var l=LOG[c0];
        for(var q=0;q<g.length;q++)buf[p+q]^=EXP[(LOG[g[q]]+l)%255];}
      return buf.slice(d.length);}
    /* per version: [ecc codewords per block, data codewords per block, alignment coords] */
    var VT={5:[22,[11,11,12,12],[6,30]],6:[28,[15,15,15,15],[6,34]],
            7:[26,[13,13,13,13,14],[6,22,38]],8:[26,[14,14,14,14,15,15],[6,24,42]],
            9:[24,[12,12,12,12,13,13,13,13],[6,26,46]],10:[28,[15,15,15,15,15,15,16,16],[6,28,50]]};
    var ver=0,dcw=0;
    for(var v3=5;v3<=10;v3++){
      var cw=0;VT[v3][1].forEach(function(n){cw+=n;});
      if(4+(v3<=9?8:16)+data.length*8<=cw*8){ver=v3;dcw=cw;break;}
    }
    if(!ver)return null;
    var ecn=VT[ver][0],blks=VT[ver][1],ali=VT[ver][2];
    var bits=[];function push(v,n){for(var k=n-1;k>=0;k--)bits.push((v>>k)&1);}
    push(4,4);push(data.length,ver<=9?8:16);
    for(i=0;i<data.length;i++)push(data.charCodeAt(i),8);
    var CAP=dcw*8;push(0,Math.min(4,CAP-bits.length));
    while(bits.length%8)bits.push(0);
    var bytes=[];for(i=0;i<bits.length;i+=8){var b=0;for(j=0;j<8;j++)b=(b<<1)|bits[i+j];bytes.push(b);}
    var pads=[0xEC,0x11],pi2=0;while(bytes.length<dcw)bytes.push(pads[pi2++%2]);
    var db=[],off=0;blks.forEach(function(n){db.push(bytes.slice(off,off+n));off+=n;});
    var eb=db.map(function(d){return rsEcc(d,ecn);});
    var seq=[];
    for(i=0;i<blks[blks.length-1];i++)db.forEach(function(d){if(i<d.length)seq.push(d[i]);});
    for(i=0;i<ecn;i++)eb.forEach(function(e){seq.push(e[i]);});
    var N2=17+4*ver,M=[],F=[];
    for(i=0;i<N2;i++){M.push(new Array(N2).fill(0));F.push(new Array(N2).fill(false));}
    function set(r,c,v){M[r][c]=v;F[r][c]=true;}
    function finder(r,c){for(var dr=-1;dr<=7;dr++)for(var dc=-1;dc<=7;dc++){
      var rr=r+dr,cc=c+dc;if(rr<0||rr>=N2||cc<0||cc>=N2)continue;
      var v=(dr>=0&&dr<=6&&dc>=0&&dc<=6&&(dr===0||dr===6||dc===0||dc===6||(dr>=2&&dr<=4&&dc>=2&&dc<=4)))?1:0;
      set(rr,cc,v);}}
    finder(0,0);finder(0,N2-7);finder(N2-7,0);
    for(i=8;i<N2-8;i++){if(!F[6][i])set(6,i,i%2===0?1:0);if(!F[i][6])set(i,6,i%2===0?1:0);}
    ali.forEach(function(ar){ali.forEach(function(ac){
      if((ar===6&&ac===6)||(ar===6&&ac===N2-7)||(ar===N2-7&&ac===6))return;
      for(var dr2=-2;dr2<=2;dr2++)for(var dc2=-2;dc2<=2;dc2++)
        set(ar+dr2,ac+dc2,(Math.max(Math.abs(dr2),Math.abs(dc2))!==1)?1:0);
    });});
    set(4*ver+9,8,1);
    for(i=0;i<9;i++){if(!F[8][i])set(8,i,0);if(!F[i][8])set(i,8,0);}
    for(i=0;i<8;i++){if(!F[8][N2-1-i])set(8,N2-1-i,0);if(!F[N2-1-i][8])set(N2-1-i,8,0);}
    if(ver>=7){
      var d4=ver<<12;
      for(i=17;i>=12;i--)if((d4>>i)&1)d4^=0x1F25<<(i-12);
      var vinf=(ver<<12)|d4;
      for(i=0;i<18;i++){var vb=(vinf>>i)&1;
        set(Math.floor(i/3),N2-11+i%3,vb);
        set(N2-11+i%3,Math.floor(i/3),vb);}
    }
    var ba=[];seq.forEach(function(b2){for(var k=7;k>=0;k--)ba.push((b2>>k)&1);});
    var bi=0,up=true;
    for(var col=N2-1;col>0;col-=2){
      if(col===6)col--;
      for(var k=0;k<N2;k++){
        var r2=up?N2-1-k:k;
        for(var dc3=0;dc3<2;dc3++){
          var c2=col-dc3;
          if(F[r2][c2])continue;
          var v2=bi<ba.length?ba[bi++]:0;
          if((r2+c2)%2===0)v2^=1;
          M[r2][c2]=v2;
        }
      }
      up=!up;
    }
    var fmt=(2<<3)|0,d2=fmt<<10,g2=0x537;
    for(i=14;i>=10;i--)if((d2>>i)&1)d2^=g2<<(i-10);
    var f2=((fmt<<10)|d2)^0x5412;
    for(i=0;i<15;i++){
      var m2=(f2>>i)&1;
      if(i<6)M[i][8]=m2;else if(i<8)M[i+1][8]=m2;else M[N2-15+i][8]=m2;
      if(i<8)M[8][N2-1-i]=m2;else if(i<9)M[8][15-i]=m2;else M[8][14-i]=m2;
    }
    return M;
  }
  var cv2=document.getElementById("qrcv");
  if(cv2){
    var ME=cv2.getAttribute("data-addr"),SZ=cv2.width,c=cv2.getContext("2d");
    var M=qrMatrix(ME)||[],N2=M.length,Q=2,cell=SZ/(N2+Q*2);
    c.fillStyle="#C6D0E0";c.fillRect(0,0,SZ,SZ);
    c.fillStyle="#0E1524";
    for(var r=0;r<N2;r++)for(var cc2=0;cc2<N2;cc2++)
      if(M[r][cc2])c.fillRect((cc2+Q)*cell,(r+Q)*cell,cell+0.35,cell+0.35);
    var cx=SZ/2,rad=SZ*0.082;
    c.fillStyle="#C6D0E0";c.beginPath();c.arc(cx,cx,rad+SZ*0.016,0,7);c.fill();
    var D=rad*2,s3=D/64;
    c.save();c.translate(cx-D/2,cx-D/2);c.scale(s3,s3);
    c.fillStyle="#F7931A";
    c.fill(new Path2D("m63.033,39.744c-4.274,17.143-21.637,27.576-38.782,23.301-17.138-4.274-27.571-21.638-23.295-38.78,4.272-17.145,21.635-27.579,38.775-23.305,17.144,4.274,27.576,21.64,23.302,38.784z"));
    c.fillStyle="#FFFFFF";
