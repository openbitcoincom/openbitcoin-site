---
import { GA_ID } from '../lib/config.js';
import { consentHtml, CONSENT_STORE } from '../lib/consent-snippet.js';
const { analytics = true } = Astro.props;
const on = !!GA_ID && analytics;
---
{on && (
  <>
    <Fragment set:html={CONSENT_STORE} />
    <Fragment set:html={consentHtml(GA_ID)} />
  </>
)}
